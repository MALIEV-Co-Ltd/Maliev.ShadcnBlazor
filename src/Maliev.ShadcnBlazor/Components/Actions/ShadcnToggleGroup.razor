@typeparam TValue
@using System.Globalization
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase

<CascadingValue Value="@_context">
    <div @ref="GroupReference"
         @attributes="ForwardedAttributes"
         class="@MergeClass("shadcn-toggle-group")"
         style="@MergeStyle(GroupStyle)"
         role="group"
         data-slot="toggle-group"
         data-orientation="@OrientationValue"
         data-variant="@VariantValue"
         data-size="@SizeValue"
         data-spacing="@Spacing.ToString(CultureInfo.InvariantCulture)">
        @ChildContent
    </div>
</CascadingValue>

@code {
    [Parameter] public IReadOnlyCollection<TValue> Values { get; set; } = Array.Empty<TValue>();
    [Parameter] public EventCallback<IReadOnlyCollection<TValue>> ValuesChanged { get; set; }
    [Parameter] public bool Multiple { get; set; }
    [Parameter] public ShadcnToggleGroupOrientation Orientation { get; set; } = ShadcnToggleGroupOrientation.Horizontal;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public double Spacing { get; set; } = 2;
    [Parameter] public ShadcnToggleVariant Variant { get; set; } = ShadcnToggleVariant.Default;
    [Parameter] public ShadcnToggleSize Size { get; set; } = ShadcnToggleSize.Default;
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private ShadcnToggleGroupContext<TValue> _context = default!;
    private ElementReference GroupReference;
    private IJSObjectReference? Module;
    private int RenderedRegistrationVersion = -1;
    private string GroupStyle => $"--shadcn-toggle-group-gap: {Spacing.ToString(CultureInfo.InvariantCulture)}";
    private string VariantValue => ShadcnToggleValues.Variant(Variant);
    private string SizeValue => ShadcnToggleValues.Size(Size);
    private string OrientationValue => Orientation switch
    {
        ShadcnToggleGroupOrientation.Horizontal => "horizontal",
        ShadcnToggleGroupOrientation.Vertical => "vertical",
        _ => throw new ArgumentOutOfRangeException(nameof(Orientation), Orientation, "Unknown Shadcn toggle group orientation.")
    };
    private IReadOnlyDictionary<string, object> ForwardedAttributes => AttributesExcept("role", "data-slot", "data-orientation", "data-variant", "data-size", "data-spacing");

    protected override void OnInitialized() => _context = new(ToggleAsync);

    protected override void OnParametersSet()
    {
        Values ??= Array.Empty<TValue>();
        if (!Enum.IsDefined(Orientation)) throw new ArgumentOutOfRangeException(nameof(Orientation), Orientation, "Unknown Shadcn toggle group orientation.");
        _ = ShadcnToggleValues.Variant(Variant);
        _ = ShadcnToggleValues.Size(Size);
        if (!double.IsFinite(Spacing) || Spacing < 0) throw new ArgumentOutOfRangeException(nameof(Spacing), Spacing, "Spacing must be finite and non-negative.");
        if (!Multiple && Values.Count > 1) throw new ArgumentException("A single-select toggle group accepts at most one value.", nameof(Values));
        _context.Update(Values, Multiple, Disabled, Variant, Size, Spacing);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        Module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Maliev.ShadcnBlazor/js/shadcn-selection.js");
        await Module.InvokeVoidAsync("attachRovingGroup", GroupReference, "toggle", OrientationValue, false);

        if (RenderedRegistrationVersion != _context.RegistrationVersion)
        {
            RenderedRegistrationVersion = _context.RegistrationVersion;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task ToggleAsync(TValue value)
    {
        if (Disabled) return Task.CompletedTask;
        var selected = Values.Contains(value, EqualityComparer<TValue>.Default);
        IReadOnlyCollection<TValue> next = Multiple
            ? selected
                ? Values.Where(item => !EqualityComparer<TValue>.Default.Equals(item, value)).ToArray()
                : Values.Append(value).ToArray()
            : selected ? Array.Empty<TValue>() : new[] { value };
        return ValuesChanged.InvokeAsync(next);
    }

    public async ValueTask DisposeAsync()
    {
        if (Module is null)
            return;

        try
        {
            await Module.InvokeVoidAsync("detach", GroupReference);
            await Module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
