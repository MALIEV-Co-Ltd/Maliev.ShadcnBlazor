@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
<img @key="Source" @attributes="ForwardedAttributes" class="@MergeClass("shadcn-avatar-image")" style="@MergeStyle(null)" data-slot="avatar-image" data-state="@(Context?.ImageLoaded == true ? "loaded" : "loading")" src="@Source" alt="@Alt" @onload="HandleLoadAsync" @onerror="HandleErrorAsync" />
@code {
    [CascadingParameter] private ShadcnAvatarContext? Context { get; set; }
    [Parameter, EditorRequired] public string Source { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Alt { get; set; } = string.Empty;
    [Parameter] public EventCallback<EventArgs> OnLoad { get; set; }
    [Parameter] public EventCallback<EventArgs> OnError { get; set; }
    private string? _lastSource;
    private IReadOnlyDictionary<string, object> ForwardedAttributes => AttributesExcept("data-slot", "data-state", "src", "alt");
    private async Task HandleLoadAsync(EventArgs args) { if (Context is not null) await Context.SetImageLoadedAsync(true); await OnLoad.InvokeAsync(args); }
    private async Task HandleErrorAsync(EventArgs args) { if (Context is not null) await Context.SetImageLoadedAsync(false); await OnError.InvokeAsync(args); }
    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(Source)) { Context?.ResetImage(); _lastSource = Source; return; }
        if (_lastSource is not null && !string.Equals(_lastSource, Source, StringComparison.Ordinal)) Context?.ResetImage();
        _lastSource = Source;
    }
}
