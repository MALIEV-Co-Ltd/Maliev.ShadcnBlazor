@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
<kbd @attributes="ForwardedAttributes" class="@MergeClass("shadcn-kbd-group")" style="@MergeStyle(null)" data-slot="kbd-group">@ChildContent</kbd>
@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private IReadOnlyDictionary<string, object> ForwardedAttributes => AttributesExcept("role", "data-slot");
}
