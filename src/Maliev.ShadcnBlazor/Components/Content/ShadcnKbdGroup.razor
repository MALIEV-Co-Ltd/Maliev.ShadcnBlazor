@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
<span @attributes="ForwardedAttributes" class="@MergeClass("shadcn-kbd-group")" style="@MergeStyle(null)" role="group" data-slot="kbd-group">@ChildContent</span>
@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private IReadOnlyDictionary<string, object> ForwardedAttributes => AttributesExcept("role", "data-slot");
}
