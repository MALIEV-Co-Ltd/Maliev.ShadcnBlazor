@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
@implements IDisposable
<button @attributes="ForwardedAttributes" class="@MergeClass("shadcn-carousel-next")" style="@MergeStyle(null)" data-slot="carousel-next" type="button" aria-label="@Context?.NextLabel" disabled="@Disabled" @onclick="HandleClickAsync"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"></path></svg></button>
@code {
    [CascadingParameter] private ShadcnCarouselContext? Context { get; set; }
    private ShadcnCarouselContext? _observedContext;
    private bool Disabled => Context is null || Context.Disabled || (!Context.Options.Loop && Context.SelectedIndex >= Context.Count - 1);
    private IReadOnlyDictionary<string, object> ForwardedAttributes => AttributesExcept("data-slot", "type", "aria-label", "disabled");
    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_observedContext, Context)) return;
        if (_observedContext is not null) _observedContext.Changed -= HandleContextChanged;
        _observedContext = Context;
        if (_observedContext is not null) _observedContext.Changed += HandleContextChanged;
    }
    private Task HandleClickAsync() => Context?.NextAsync().AsTask() ?? Task.CompletedTask;
    private void HandleContextChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() { if (_observedContext is not null) _observedContext.Changed -= HandleContextChanged; }
}
