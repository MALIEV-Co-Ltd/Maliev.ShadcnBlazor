@using System.Globalization
@using Maliev.ShadcnBlazor.Theming
@implements IAsyncDisposable
@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
@inject IJSRuntime Js
@inject IShadcnIdAllocator IdAllocator
<figure @ref="_root" @attributes="ForwardedAttributes" class="@MergeClass("shadcn-chart")" style="@ChartStyle" data-slot="chart" data-chart="@ChartId" data-animated="@Animated.ToString().ToLowerInvariant()" aria-labelledby="@TitleId" aria-describedby="@(!string.IsNullOrWhiteSpace(Description) ? DescriptionId : null)" aria-busy="@(Loading ? "true" : null)" @onmouseleave="Deactivate">
    <style data-slot="chart-style">@((MarkupString)Config.ToScopedCss(ChartId))</style>
    <figcaption id="@TitleId" class="shadcn-chart-title" data-slot="chart-title">@Title</figcaption>
    @if (!string.IsNullOrWhiteSpace(Description)) { <p id="@DescriptionId" class="shadcn-chart-description" data-slot="chart-description">@Description</p> }
    @if (ShowLegend && LegendPlacement == ShadcnChartLegendPlacement.Top) { @LegendContent }
    @if (Loading) { <div role="status" data-slot="chart-loading">@LoadingText</div> }
    else if (!string.IsNullOrWhiteSpace(Error)) { <div role="alert" data-slot="chart-error">@Error</div> }
    else if (!HasData) { <div data-slot="chart-empty">@EmptyText</div> }
    else
    {
        <svg data-slot="chart-surface" viewBox="0 0 @F(_width) @F(_height)" preserveAspectRatio="@(IsRadial ? "xMidYMid meet" : "none")" role="group" aria-label="@Title" tabindex="0" @onkeydown="OnKeyDown" @onmousemove="OnMouseMove" @onmouseleave="Deactivate">
            @if ((ShowGrid || ShowMajorGrid) && !IsRadial)
            {
                @for (var grid = 0; grid <= 4; grid++) { <line data-slot="chart-grid-line" data-grid-level="major" x1="36" y1="@F(12 + grid * Math.Max(1, _height - 40) / 4)" x2="@F(_width - 12)" y2="@F(12 + grid * Math.Max(1, _height - 40) / 4)" /> }
            }
            @if (ShowMinorGrid && !IsRadial)
            {
                @for (var grid = 0; grid < 4; grid++) { <line data-slot="chart-grid-line" data-grid-level="minor" x1="36" y1="@F(12 + (grid + .5) * Math.Max(1, _height - 40) / 4)" x2="@F(_width - 12)" y2="@F(12 + (grid + .5) * Math.Max(1, _height - 40) / 4)" /> }
            }
            @if (ShowPrimaryYAxis && !IsRadial)
            {
                <line data-slot="chart-axis" data-axis="primary" data-side="start" x1="@F(PrimaryAxisX)" y1="12" x2="@F(PrimaryAxisX)" y2="@F(_height - 28)" aria-hidden="true" />
            }
            @if (ShowSecondaryYAxis && !IsRadial)
            {
                <line data-slot="chart-axis" data-axis="secondary" data-side="end" x1="@F(SecondaryAxisX)" y1="12" x2="@F(SecondaryAxisX)" y2="@F(_height - 28)" aria-hidden="true" />
            }
            @if (_activeIndex >= 0 && Type == ShadcnChartType.Bar)
            {
                <rect data-slot="chart-tooltip-cursor" x="@F(36 + _activeIndex * Math.Max(1, _width - 48) / Categories.Count)" y="12" width="@F(Math.Max(1, _width - 48) / Categories.Count)" height="@F(Math.Max(1, _height - 40))" fill="var(--shadcn-muted)" fill-opacity="0.5" pointer-events="none" />
            }
            <g>
                @foreach (var shape in Geometry.Shapes)
                {
                    if (shape.Kind == "rect") { var shapePoint = shape.PointIndex; <rect data-series="@shape.SeriesKey" data-point="@shapePoint" role="img" tabindex="0" aria-label="@PointLabel(shapePoint)" x="@F(shape.Values[0])" y="@F(shape.Values[1])" width="@F(shape.Values[2])" height="@F(shape.Values[3])" rx="@BarRadius" fill="var(--color-@shape.SeriesKey)" @onfocus="() => Activate(shapePoint)" @onmouseenter="() => Activate(shapePoint)" @onmousemove:stopPropagation @onmousemove="() => Activate(shapePoint)" @onpointerenter="() => Activate(shapePoint)" @onclick="() => Activate(shapePoint)" /> }
                    else if (shape.Kind == "polyline") { <polyline data-series="@shape.SeriesKey" points="@Points(shape.Values)" fill="none" stroke="var(--color-@shape.SeriesKey)" stroke-width="@StrokeWidth" /> }
                    else if (shape.Kind == "area") { <polygon data-series="@shape.SeriesKey" points="@Points(shape.Values)" fill="var(--color-@shape.SeriesKey)" fill-opacity="0.25" stroke="var(--color-@shape.SeriesKey)" stroke-width="@StrokeWidth" /> }
                    else if (shape.Kind == "arc") { var shapePoint = shape.PointIndex; <path data-chart-shape="arc" data-series="@shape.SeriesKey" data-point="@shapePoint" data-active="@(_activeIndex == shapePoint ? "true" : null)" style="@RadialOffsetStyle(shape.Values)" role="img" tabindex="0" aria-label="@PointLabel(shapePoint)" d="@ArcPath(shape.Values)" transform="@RadialTransform(shape.Values, _activeIndex == shapePoint)" fill="var(--color-@RadialColorKey(shape.SeriesKey, shapePoint))" @onfocus="() => Activate(shapePoint)" @onpointerenter="() => Activate(shapePoint)" @onclick="() => Activate(shapePoint)" /> }
                    else if (shape.Kind == "baseline" && ShowAxis) { <line x1="@F(shape.Values[0])" y1="@F(shape.Values[1])" x2="@F(shape.Values[2])" y2="@F(shape.Values[3])" /> }
                }
            </g>
            @if (Type is ShadcnChartType.Line or ShadcnChartType.Area)
            {
                @for (var pointIndex = 0; pointIndex < (VisibleSeries.Count > 0 ? Categories.Count : 0); pointIndex++)
                {
                    var capturedIndex = pointIndex;
                    <circle data-slot="chart-point" data-point="@capturedIndex" data-active="@(_activeIndex == capturedIndex ? "true" : null)" role="img" tabindex="0" aria-label="@PointLabel(capturedIndex)" cx="@F(PointX(capturedIndex))" cy="@F(PointY(capturedIndex))" r="8" @onfocus="() => Activate(capturedIndex)" @onpointerenter="() => Activate(capturedIndex)" @onmouseover="() => Activate(capturedIndex)" @onclick="() => Activate(capturedIndex)" />
                }
            }
            @if (ShowTicks && !IsRadial)
            {
                @for (var tick = 0; tick < Categories.Count; tick++) { @Tick(tick) }
            }
        </svg>
        @if (_activeIndex >= 0)
        {
            @if (TooltipTemplate is not null) { @TooltipTemplate(new(Categories[_activeIndex], _activeIndex, VisibleSeries)) }
            else { <ShadcnChartTooltipContent Config="@Config" Category="@TooltipLabel(_activeIndex)" Series="@VisibleSeries" PointIndex="@_activeIndex" AnchorXPercent="@TooltipXPercent" AnchorY="@TooltipY" Indicator="@Indicator" HideLabel="@HideTooltipLabel" HideIndicator="@HideTooltipIndicator" NameKey="@NameKey" ValueFormatter="@ValueFormatter" /> }
        }
        @if (ShowLegend && LegendPlacement == ShadcnChartLegendPlacement.Bottom) { @LegendContent }
        <table class="shadcn-sr-only" data-slot="chart-accessible-table">
            <caption>@Title</caption><thead><tr><th scope="col">@CategoryLabel</th>@foreach (var item in VisibleSeries) { <th scope="col">@SeriesLabel(item.Key)</th> }</tr></thead>
            <tbody>@for (var index = 0; index < Categories.Count; index++) { <tr><th scope="row">@Categories[index]</th>@foreach (var item in VisibleSeries) { <td data-slot="chart-accessible-value">@Format(item.Values[index])</td> }</tr> }</tbody>
        </table>
    }
</figure>

@code {
    [Parameter] public string? Id { get; set; }
    [Parameter] public ShadcnChartType Type { get; set; } = ShadcnChartType.Bar;
    [Parameter, EditorRequired] public ShadcnChartConfig Config { get; set; } = new();
    [Parameter, EditorRequired] public IReadOnlyList<string> Categories { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<ShadcnChartSeries> Series { get; set; } = [];
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public double InitialWidth { get; set; } = 320;
    [Parameter] public double InitialHeight { get; set; } = 200;
    [Parameter] public bool Stacked { get; set; }
    [Parameter] public bool ShowAxis { get; set; } = true;
    [Parameter] public bool ShowGrid { get; set; }
    [Parameter] public bool ShowPrimaryYAxis { get; set; } = true;
    [Parameter] public bool ShowSecondaryYAxis { get; set; }
    [Parameter] public bool ShowMajorGrid { get; set; }
    [Parameter] public bool ShowMinorGrid { get; set; }
    [Parameter] public bool ShowTicks { get; set; } = true;
    [Parameter] public bool ShowLegend { get; set; } = true;
    [Parameter] public bool HideLegendIcon { get; set; }
    [Parameter] public ShadcnChartLegendPlacement LegendPlacement { get; set; } = ShadcnChartLegendPlacement.Bottom;
    [Parameter] public bool LegendInteractive { get; set; }
    [Parameter] public RenderFragment<IReadOnlyList<ShadcnChartSeries>>? LegendTemplate { get; set; }
    [Parameter] public RenderFragment<ShadcnChartTooltipContext>? TooltipTemplate { get; set; }
    [Parameter] public ShadcnChartIndicator Indicator { get; set; } = ShadcnChartIndicator.Dot;
    [Parameter] public bool HideTooltipLabel { get; set; }
    [Parameter] public bool HideTooltipIndicator { get; set; }
    [Parameter] public string? NameKey { get; set; }
    [Parameter] public string? LabelKey { get; set; }
    // Shadcn chart bars use a crisp, square edge by default. Consumers can opt
    // into rounded bars explicitly when their visual language calls for it.
    [Parameter] public double BarRadius { get; set; }
    [Parameter] public double StrokeWidth { get; set; } = 2;
    [Parameter] public ShadcnDirection Direction { get; set; } = ShadcnDirection.LeftToRight;
    [Parameter] public bool Animated { get; set; } = true;
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public string LoadingText { get; set; } = "Loading chart...";
    [Parameter] public string EmptyText { get; set; } = "No chart data.";
    [Parameter] public string CategoryLabel { get; set; } = "Category";
    [Parameter] public Func<double, string> ValueFormatter { get; set; } = value => value.ToString("N0", CultureInfo.CurrentCulture);
    private ElementReference _root; private IJSObjectReference? _module; private IJSObjectReference? _observer; private DotNetObjectReference<ShadcnChart>? _reference; private int _activeIndex = -1;
    private double _width; private double _height; private string? _generatedId;
    private readonly HashSet<string> _hiddenSeries = new(StringComparer.Ordinal);
    private string ChartId => string.IsNullOrWhiteSpace(Id) ? _generatedId ?? throw new InvalidOperationException("Chart identifier was not initialized.") : $"chart-{Id.Trim()}";
    private string TitleId => $"{ChartId}-title"; private string DescriptionId => $"{ChartId}-description";
    private IReadOnlyList<ShadcnChartSeries> VisibleSeries => Series.Where(item => item.Visible && !_hiddenSeries.Contains(item.Key)).ToList();
    private bool IsRadial => Type is ShadcnChartType.Pie or ShadcnChartType.Donut;
    private double PrimaryAxisX => Direction == ShadcnDirection.RightToLeft ? _width - 12 : 36;
    private double SecondaryAxisX => Direction == ShadcnDirection.RightToLeft ? 36 : _width - 12;
    private bool HasData => Series.Any(item => item.Visible && item.Values.Any(value => value.HasValue));
    private ShadcnChartGeometry Geometry => VisibleSeries.Count == 0 ? new(_width, _height, [], 0, 1) : ShadcnChartGeometry.Create(Type, Categories, VisibleSeries, _width, _height, Stacked);
    private string ChartStyle => MergeStyle($"--shadcn-chart-initial-width: {F(InitialWidth)}px; --shadcn-chart-initial-height: {F(InitialHeight)}px")!;
    private IReadOnlyDictionary<string, object> ForwardedAttributes => AttributesExcept("data-slot", "data-chart", "aria-labelledby", "aria-describedby", "aria-busy");
    protected override void OnInitialized()
    {
        _generatedId = IdAllocator.NextId("chart");
    }
    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(Title)) throw new ArgumentException("Chart title is required.", nameof(Title));
        if (_width <= 0) _width = InitialWidth;
        if (_height <= 0) _height = InitialHeight;
        Config.Validate();
        if (Series.Any(item => !Config.ContainsKey(item.Key))) throw new ArgumentException("Every chart series requires a matching config entry.", nameof(Series));
        if (!Enum.IsDefined(Indicator)) throw new ArgumentOutOfRangeException(nameof(Indicator));
        if (!Enum.IsDefined(Direction)) throw new ArgumentOutOfRangeException(nameof(Direction));
        if (!Enum.IsDefined(LegendPlacement)) throw new ArgumentOutOfRangeException(nameof(LegendPlacement));
        if (HasData) _ = Geometry;
        _hiddenSeries.IntersectWith(Series.Select(item => item.Key));
        if (_activeIndex >= Categories.Count || VisibleSeries.Count == 0) _activeIndex = -1;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { _module = await Js.InvokeAsync<IJSObjectReference>("import", "./_content/Maliev.ShadcnBlazor/js/shadcn-chart.js"); _reference = DotNetObjectReference.Create(this); _observer = await _module.InvokeAsync<IJSObjectReference>("observe", _root, _reference); }
        catch (InvalidOperationException) { }
        catch (JSException) { }
    }
    /// <summary>Receives a finite observed chart size and recomputes responsive SVG geometry.</summary>
    [JSInvokable]
    public Task OnChartResize(double width, double height)
    {
        if (!double.IsFinite(width) || !double.IsFinite(height) || width <= 0 || height <= 0) return Task.CompletedTask;
        return InvokeAsync(() => { _width = width; _height = height; StateHasChanged(); });
    }
    private void OnKeyDown(KeyboardEventArgs args)
    {
        if (Categories.Count == 0) return;
        var horizontal = Direction == ShadcnDirection.RightToLeft ? -1 : 1;
        _activeIndex = args.Key switch { "Home" => 0, "End" => Categories.Count - 1, "ArrowRight" => (_activeIndex + horizontal + Categories.Count) % Categories.Count, "ArrowLeft" => (_activeIndex - horizontal + Categories.Count) % Categories.Count, "ArrowDown" => (_activeIndex + 1 + Categories.Count) % Categories.Count, "ArrowUp" => (_activeIndex - 1 + Categories.Count) % Categories.Count, "Escape" => -1, _ => _activeIndex };
    }
    private void Activate(int index) => _activeIndex = index;
    private void Deactivate() => _activeIndex = -1;
    private void OnMouseMove(MouseEventArgs args)
    {
        if (Categories.Count == 0 || IsRadial) return;
        var plotWidth = Math.Max(1, _width - 48);
        var index = (int)Math.Floor((args.OffsetX - 36) / plotWidth * Categories.Count);
        if (index >= 0 && index < Categories.Count && index != _activeIndex) Activate(index);
    }
    private double PointX(int index)
    {
        var arc = Geometry.Shapes.FirstOrDefault(shape => shape.Kind == "arc" && shape.PointIndex == index);
        if (arc is not null) return arc.Values[0] + (arc.Values[2] + arc.Values[3]) / 2 * Math.Cos((arc.Values[4] + arc.Values[5]) / 2);
        return Type == ShadcnChartType.Bar
            ? 36 + (index + .5) * Math.Max(1, _width - 48) / Categories.Count
            : 36 + index * Math.Max(1, _width - 48) / Math.Max(1, Categories.Count - 1);
    }
    private double PointY(int index)
    {
        var arc = Geometry.Shapes.FirstOrDefault(shape => shape.Kind == "arc" && shape.PointIndex == index);
        if (arc is not null) return arc.Values[1] + (arc.Values[2] + arc.Values[3]) / 2 * Math.Sin((arc.Values[4] + arc.Values[5]) / 2);
        var value = VisibleSeries.Select(item => item.Values[index]).FirstOrDefault(item => item.HasValue) ?? 0;
        return 12 + (Geometry.Maximum - value) / (Geometry.Maximum - Geometry.Minimum) * Math.Max(1, _height - 40);
    }
    private string PointLabel(int index) => $"{Categories[index]}: {string.Join(", ", VisibleSeries.Select(item => $"{SeriesLabel(item.Key)} {Format(item.Values[index])}"))}";
    private string TooltipLabel(int index) => Config.TryGetValue(LabelKey ?? string.Empty, out var label) ? label.Label : Categories[index];
    private double TooltipXPercent => Math.Clamp(PointX(_activeIndex) / Math.Max(1, _width) * 100, 0, 100);
    private double TooltipY => Math.Max(12, PointY(_activeIndex) - 92);
    private string RadialColorKey(string seriesKey, int pointIndex) => Config.ContainsKey($"{seriesKey}-{pointIndex}") ? $"{seriesKey}-{pointIndex}" : seriesKey;
    private void ToggleLegend(string key) { if (!_hiddenSeries.Add(key)) _hiddenSeries.Remove(key); if (_activeIndex >= 0 && VisibleSeries.Count == 0) _activeIndex = -1; }
    private RenderFragment LegendContent => builder =>
    {
        if (LegendTemplate is not null) { builder.AddContent(0, LegendTemplate(VisibleSeries)); return; }
        if (IsRadial)
        {
            builder.OpenElement(1, "div"); builder.AddAttribute(2, "class", "shadcn-chart-legend"); builder.AddAttribute(3, "data-slot", "chart-legend");
            var sequence = 4;
            for (var index = 0; index < Categories.Count; index++)
            {
                foreach (var series in Series.Where(item => item.Visible))
                {
                    var key = series.Key;
                    var colorKey = RadialColorKey(key, index);
                    if (LegendInteractive) { builder.OpenElement(sequence++, "button"); builder.AddAttribute(sequence++, "type", "button"); builder.AddAttribute(sequence++, "aria-pressed", !_hiddenSeries.Contains(key) ? "true" : "false"); builder.AddAttribute(sequence++, "onclick", EventCallback.Factory.Create(this, () => ToggleLegend(key))); }
                    else builder.OpenElement(sequence++, "div");
                    builder.AddAttribute(sequence++, "class", "shadcn-chart-legend-item"); builder.AddAttribute(sequence++, "data-slot", "chart-legend-item"); builder.AddAttribute(sequence++, "data-legend-series", key); builder.AddAttribute(sequence++, "data-legend-point", index);
                    if (!HideLegendIcon) { builder.OpenElement(sequence++, "span"); builder.AddAttribute(sequence++, "class", "shadcn-chart-legend-icon"); builder.AddAttribute(sequence++, "style", $"background: var(--color-{colorKey})"); builder.CloseElement(); }
                    builder.OpenElement(sequence++, "span"); builder.AddContent(sequence++, $"{Categories[index]} {SeriesLabel(key)}"); builder.CloseElement(); builder.CloseElement();
                }
            }
            builder.CloseElement(); return;
        }
        builder.OpenComponent<ShadcnChartLegendContent>(1);
        builder.AddAttribute(2, nameof(ShadcnChartLegendContent.Config), Config);
        builder.AddAttribute(3, nameof(ShadcnChartLegendContent.Series), Series.Where(item => item.Visible).ToList());
        builder.AddAttribute(4, nameof(ShadcnChartLegendContent.HideIcon), HideLegendIcon);
        builder.AddAttribute(5, nameof(ShadcnChartLegendContent.NameKey), NameKey);
        builder.AddAttribute(6, nameof(ShadcnChartLegendContent.Interactive), LegendInteractive);
        builder.AddAttribute(7, nameof(ShadcnChartLegendContent.Toggled), EventCallback.Factory.Create<string>(this, ToggleLegend));
        builder.AddAttribute(8, nameof(ShadcnChartLegendContent.HiddenKeys), _hiddenSeries);
        builder.CloseComponent();
    };
    private RenderFragment Tick(int index) => builder =>
    {
        builder.OpenElement(0, "text"); builder.AddAttribute(1, "data-slot", "chart-tick"); builder.AddAttribute(2, "x", F(PointX(index))); builder.AddAttribute(3, "y", F(_height - 8)); builder.AddAttribute(4, "text-anchor", "middle"); builder.AddContent(5, Categories[index]); builder.CloseElement();
    };
    private string SeriesLabel(string key)
    {
        var series = Series.First(item => item.Key == key);
        var resolved = NameKey is not null && series.Names.TryGetValue(NameKey, out var named) ? named : key;
        return Config.TryGetValue(resolved, out var configured) ? configured.Label : resolved;
    }
    private string Format(double? value) => value.HasValue ? ValueFormatter(value.Value) : "—";
    private static string F(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);
    private static string Points(IReadOnlyList<double> values) => string.Join(' ', Enumerable.Range(0, values.Count / 2).Select(index => $"{F(values[index * 2])},{F(values[index * 2 + 1])}"));
    private static string ArcPath(IReadOnlyList<double> v)
    {
        var (cx, cy, radius, inner, start, end) = (v[0], v[1], v[2], v[3], v[4], v[5]); var large = end - start > Math.PI ? 1 : 0;
        var x1 = cx + radius * Math.Cos(start); var y1 = cy + radius * Math.Sin(start); var x2 = cx + radius * Math.Cos(end); var y2 = cy + radius * Math.Sin(end);
        if (inner <= 0) return $"M {F(cx)} {F(cy)} L {F(x1)} {F(y1)} A {F(radius)} {F(radius)} 0 {large} 1 {F(x2)} {F(y2)} Z";
        var ix2 = cx + inner * Math.Cos(end); var iy2 = cy + inner * Math.Sin(end); var ix1 = cx + inner * Math.Cos(start); var iy1 = cy + inner * Math.Sin(start);
        return $"M {F(x1)} {F(y1)} A {F(radius)} {F(radius)} 0 {large} 1 {F(x2)} {F(y2)} L {F(ix2)} {F(iy2)} A {F(inner)} {F(inner)} 0 {large} 0 {F(ix1)} {F(iy1)} Z";
    }
    private static string? RadialTransform(IReadOnlyList<double> values, bool active)
    {
        if (!active) return null;
        var angle = (values[4] + values[5]) / 2;
        const double distance = 7;
        return $"translate({F(distance * Math.Cos(angle))} {F(distance * Math.Sin(angle))})";
    }
    private static string RadialOffsetStyle(IReadOnlyList<double> values)
    {
        var angle = (values[4] + values[5]) / 2;
        const double distance = 7;
        return $"--shadcn-chart-slice-x: {F(distance * Math.Cos(angle))}px; --shadcn-chart-slice-y: {F(distance * Math.Sin(angle))}px";
    }
    public async ValueTask DisposeAsync()
    {
        if (_observer is not null) { try { await _observer.InvokeVoidAsync("dispose"); } catch (JSDisconnectedException) { } await _observer.DisposeAsync(); }
        if (_module is not null) await _module.DisposeAsync();
        _reference?.Dispose();
    }
}
