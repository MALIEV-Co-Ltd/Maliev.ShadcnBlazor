@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
<tfoot @attributes="ForwardedAttributes" class="@MergeClass("shadcn-table-footer")" style="@MergeStyle(null)" data-slot="table-footer"><CascadingValue Value="SectionContext" IsFixed="true">@ChildContent</CascadingValue></tfoot>
@code {
    [CascadingParameter] private ShadcnTableCompositionContext? Parent { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private IReadOnlyDictionary<string, object> ForwardedAttributes => AttributesExcept("data-slot");
    private static ShadcnTableCompositionContext SectionContext { get; } = new(ShadcnTableCompositionKind.Section);
    protected override void OnParametersSet() => ShadcnTableHeader.ValidateSection(Parent, ChildContent, "Table footer");
}
