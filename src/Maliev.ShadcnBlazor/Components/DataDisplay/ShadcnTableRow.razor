@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
<tr @attributes="ForwardedAttributes" class="@MergeClass($"shadcn-table-row{(Disabled ? " shadcn-table-row-disabled" : string.Empty)}")" style="@MergeStyle(null)" data-slot="table-row" data-state="@(Selected && !Disabled ? "selected" : null)" data-expanded="@(Expanded ? "true" : null)" aria-disabled="@(Disabled ? "true" : null)"><CascadingValue Value="RowContext" IsFixed="true">@ChildContent</CascadingValue></tr>
@code {
    [CascadingParameter] private ShadcnTableCompositionContext? Parent { get; set; }
    [Parameter] public bool Selected { get; set; }
    [Parameter] public bool Expanded { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private IReadOnlyDictionary<string, object> ForwardedAttributes => AttributesExcept("data-slot", "data-state", "data-expanded", "aria-expanded", "aria-disabled");
    private static ShadcnTableCompositionContext RowContext { get; } = new(ShadcnTableCompositionKind.Row);
    protected override void OnParametersSet()
    {
        if (Parent?.Kind != ShadcnTableCompositionKind.Section) throw new InvalidOperationException("Table row must be a direct table section child.");
        if (ChildContent is null) throw new InvalidOperationException("Table row content is required.");
    }
}
