@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
<div class="shadcn-table-container" data-slot="table-container">
    <table @attributes="ForwardedAttributes" class="@MergeClass("shadcn-table")" style="@MergeStyle(null)" data-slot="table"><CascadingValue Value="TableContext" IsFixed="true">@ChildContent</CascadingValue></table>
</div>
@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private IReadOnlyDictionary<string, object> ForwardedAttributes => AttributesExcept("data-slot");
    private static ShadcnTableCompositionContext TableContext { get; } = new(ShadcnTableCompositionKind.Table);
    protected override void OnParametersSet()
    {
        if (ChildContent is null) throw new InvalidOperationException("Table content is required.");
    }
}
