@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
<thead @attributes="ForwardedAttributes" class="@MergeClass("shadcn-table-header")" style="@MergeStyle(null)" data-slot="table-header"><CascadingValue Value="SectionContext" IsFixed="true">@ChildContent</CascadingValue></thead>
@code {
    [CascadingParameter] private ShadcnTableCompositionContext? Parent { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private IReadOnlyDictionary<string, object> ForwardedAttributes => AttributesExcept("data-slot");
    private static ShadcnTableCompositionContext SectionContext { get; } = new(ShadcnTableCompositionKind.Section);
    protected override void OnParametersSet() => ValidateSection(Parent, ChildContent, "Table header");
    internal static void ValidateSection(ShadcnTableCompositionContext? parent, RenderFragment? content, string name)
    {
        if (parent?.Kind != ShadcnTableCompositionKind.Table) throw new InvalidOperationException($"{name} must be a direct table child.");
        if (content is null) throw new InvalidOperationException($"{name} content is required.");
    }
}
