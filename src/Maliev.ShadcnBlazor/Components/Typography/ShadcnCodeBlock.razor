@using Microsoft.JSInterop
@using Maliev.ShadcnBlazor.Components.Forms
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IServiceProvider IdAllocator
@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase

<div @attributes="ForwardedAttributes" class="@MergeClass("shadcn-code-block")" style="@MergeStyle(null)" data-slot="code-block" data-language="@SelectedLanguage">
    <div class="shadcn-code-block-toolbar" data-slot="code-block-toolbar">
        @if (SourceByLanguage.Count > 1)
        {
            <label class="shadcn-sr-only" for="@LanguageId">@LanguageLabel</label>
            <ShadcnSelect TValue="string"
                          id="@LanguageId"
                          Class="shadcn-code-block-language-select"
                          Value="@SelectedLanguage"
                          ValueChanged="@ChangeLanguageAsync"
                          Options="@LanguageOptions"
                          Placeholder="@LanguageLabel"
                          Size="ShadcnControlSize.Small" />
        }
        else
        {
            <span class="shadcn-code-block-language" data-slot="code-block-language">@SelectedLanguage</span>
        }
        <button type="button" class="shadcn-code-block-copy" data-testid="copy-source" data-copied="@_copied.ToString().ToLowerInvariant()" data-copy-state="@(_copied ? "copied" : "idle")" aria-label="@CopyButtonLabel" title="@CopyButtonLabel" @onclick="CopyAsync">
            @if (_copied)
            {
                <span @key="_copyFeedbackId" class="shadcn-code-block-copy-feedback" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="m5 12.5 4.2 4.2L19 7" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </span>
            }
            else
            {
                <span class="shadcn-code-block-copy-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><rect x="8" y="8" width="11" height="11" rx="2" fill="none" stroke="currentColor" stroke-width="1.7" /><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></svg>
                </span>
            }
            <span class="shadcn-sr-only">@CopyButtonLabel</span>
        </button>
    </div>
    <pre tabindex="0" aria-label="@CodeLabel(SelectedLanguage)" data-slot="code-block-content"><code data-slot="code-block-code">@((MarkupString)HighlightedSource)</code></pre>
    <p class="shadcn-code-block-announcement component-code__announcement" aria-live="polite">@_announcement</p>
    @if (_showFallback)
    {
        <label class="shadcn-sr-only" for="@FallbackId">@FallbackLabel</label>
        <textarea id="@FallbackId" readonly rows="8">@SelectedSource</textarea>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Source { get; set; } = string.Empty;
    [Parameter] public string Language { get; set; } = "razor";
    [Parameter] public IReadOnlyDictionary<string, string>? Sources { get; set; }
    /// <summary>Gets or sets the accessible label for the language selector.</summary>
    [Parameter] public string LanguageLabel { get; set; } = "Code language";
    /// <summary>Gets or sets the accessible label for the copy action.</summary>
    [Parameter] public string CopyLabel { get; set; } = "Copy source";
    /// <summary>Gets or sets the accessible label shown after a successful copy.</summary>
    [Parameter] public string CopiedLabel { get; set; } = "Copied";
    /// <summary>Gets or sets the live-region message announced after a successful copy.</summary>
    [Parameter] public string CopySuccessAnnouncement { get; set; } = "Source copied to clipboard.";
    /// <summary>Gets or sets the accessible label for the manual-copy fallback.</summary>
    [Parameter] public string FallbackLabel { get; set; } = "Selectable source fallback";
    /// <summary>Gets or sets the formatter for the code example's accessible label.</summary>
    [Parameter] public Func<string, string> CodeLabel { get; set; } = language => $"{language} code example";

    private IJSObjectReference? _module;
    private string _selectedLanguage = string.Empty;
    private string _announcement = string.Empty;
    private bool _copied;
    private bool _showFallback;
    private int _copyFeedbackId;
    private CancellationTokenSource? _copyResetCancellation;
    private static readonly TimeSpan CopyFeedbackDuration = TimeSpan.FromMilliseconds(1800);
    private string LanguageId = null!;
    private string FallbackId = null!;

    protected override void OnInitialized()
    {
        LanguageId = IdAllocator.NextId("shadcn-code-language");
        FallbackId = IdAllocator.NextId("shadcn-code-fallback");
    }

    private IReadOnlyDictionary<string, string> SourceByLanguage => Sources is { Count: > 0 } ? Sources : new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase) { [Language] = Source };
    private IReadOnlyList<ShadcnSelectOption<string>> LanguageOptions => SourceByLanguage.Keys.Select(language => new ShadcnSelectOption<string>(language, language)).ToArray();
    private string SelectedLanguage => SourceByLanguage.ContainsKey(_selectedLanguage) ? _selectedLanguage : SourceByLanguage.Keys.First();
    private string SelectedSource => SourceByLanguage.TryGetValue(SelectedLanguage, out var source) ? source : Source;
    private string HighlightedSource => Highlight(SelectedSource, SelectedLanguage);
    private string CopyButtonLabel => _copied ? CopiedLabel : CopyLabel;
    private IReadOnlyDictionary<string, object> ForwardedAttributes => AttributesExcept("class", "style", "data-slot", "data-language");

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (string.IsNullOrWhiteSpace(Language)) throw new ArgumentException("Language is required.", nameof(Language));
        if (SourceByLanguage.Count == 0) throw new ArgumentException("At least one source is required.", nameof(Source));
        if (!SourceByLanguage.ContainsKey(_selectedLanguage)) _selectedLanguage = SourceByLanguage.ContainsKey(Language) ? Language : SourceByLanguage.Keys.First();
    }

    private Task ChangeLanguageAsync(string? next)
    {
        if (!string.IsNullOrWhiteSpace(next) && SourceByLanguage.ContainsKey(next))
        {
            CancelCopyReset();
            _selectedLanguage = next;
            _copied = false;
            _announcement = string.Empty;
        }
        return Task.CompletedTask;
    }

    private async Task CopyAsync()
    {
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Maliev.ShadcnBlazor/js/shadcn-code-block.js");
            await _module.InvokeVoidAsync("copyText", SelectedSource);
            _copied = true;
            _copyFeedbackId++;
            _showFallback = false;
            _announcement = CopySuccessAnnouncement;
            BeginCopyReset();
        }
        catch (JSException)
        {
            CancelCopyReset();
            _copied = false;
            _showFallback = true;
            _announcement = "Copy failed. Select the source below and copy it manually.";
        }
    }

    private void BeginCopyReset()
    {
        CancelCopyReset();
        var cancellation = new CancellationTokenSource();
        _copyResetCancellation = cancellation;
        _ = ResetCopyStateAsync(cancellation);
    }

    private async Task ResetCopyStateAsync(CancellationTokenSource cancellation)
    {
        try
        {
            await Task.Delay(CopyFeedbackDuration, cancellation.Token);
            if (cancellation.IsCancellationRequested) return;

            await InvokeAsync(() =>
            {
                if (cancellation.IsCancellationRequested) return;
                _copied = false;
                _announcement = string.Empty;
                StateHasChanged();
            });
        }
        catch (OperationCanceledException)
        {
            // A second copy or language change intentionally cancels this feedback cycle.
        }
        catch (ObjectDisposedException)
        {
            // The component can be disposed while the transient feedback is pending.
        }
        finally
        {
            if (ReferenceEquals(_copyResetCancellation, cancellation))
            {
                _copyResetCancellation = null;
                cancellation.Dispose();
            }
        }
    }

    private void CancelCopyReset()
    {
        _copyResetCancellation?.Cancel();
        _copyResetCancellation?.Dispose();
        _copyResetCancellation = null;
    }

    private static string Highlight(string source, string language)
    {
        if (string.IsNullOrEmpty(source)) return string.Empty;
        var markupLanguage = language.Equals("razor", StringComparison.OrdinalIgnoreCase)
            || language.Equals("html", StringComparison.OrdinalIgnoreCase)
            || language.Equals("markup", StringComparison.OrdinalIgnoreCase);
        var output = new System.Text.StringBuilder(source.Length + 128);
        var index = 0;
        var razorCodeDepth = 0;
        var markupElementDepth = 0;
        while (index < source.Length)
        {
            if (markupLanguage && source[index] == '<' && source.AsSpan(index).StartsWith("<!--", StringComparison.Ordinal))
            {
                var end = source.IndexOf("-->", index + 4, StringComparison.Ordinal);
                end = end < 0 ? source.Length : end + 3;
                AppendToken(output, "comment", source[index..end]); index = end; continue;
            }
            if (source[index] == '@' && index + 1 < source.Length && source[index + 1] == '*')
            {
                var end = source.IndexOf("*@", index + 2, StringComparison.Ordinal);
                end = end < 0 ? source.Length : end + 2;
                AppendToken(output, "comment", source[index..end]); index = end; continue;
            }
            if (source[index] == '/' && index + 1 < source.Length && source[index + 1] == '/')
            {
                var end = source.IndexOf('\n', index); if (end < 0) end = source.Length;
                AppendToken(output, "comment", source[index..end]); index = end; continue;
            }
            if (source[index] == '/' && index + 1 < source.Length && source[index + 1] == '*')
            {
                var end = source.IndexOf("*/", index + 2, StringComparison.Ordinal);
                end = end < 0 ? source.Length : end + 2;
                AppendToken(output, "comment", source[index..end]); index = end; continue;
            }
            // In Razor/HTML, apostrophes and quotes in rendered text are not
            // strings. Only parse quotes in C# mode (or inside a brace-delimited
            // Razor expression); attribute values are handled by AppendMarkupTag.
            if (source[index] is '"' or '\'' && (!markupLanguage || razorCodeDepth > 0))
            {
                var quote = source[index]; var end = index + 1;
                while (end < source.Length) { if (source[end] == '\\') { end += Math.Min(2, source.Length - end); continue; } if (source[end] == quote) { end++; break; } end++; }
                AppendToken(output, "string", source[index..end]); index = end; continue;
            }
            if (markupLanguage && source[index] == '<' && index + 1 < source.Length && (char.IsLetter(source[index + 1]) || source[index + 1] == '/'))
            {
                var end = FindMarkupTagEnd(source, index + 1);
                var tag = source[index..end];
                AppendMarkupTag(output, tag);
                if (IsClosingMarkupTag(tag))
                {
                    markupElementDepth = Math.Max(0, markupElementDepth - 1);
                }
                else if (!IsSelfClosingMarkupTag(tag))
                {
                    markupElementDepth++;
                }

                index = end; continue;
            }
            if (char.IsDigit(source[index]))
            {
                var end = index + 1; while (end < source.Length && (char.IsDigit(source[end]) || source[end] == '.')) end++;
                AppendToken(output, "number", source[index..end]); index = end; continue;
            }
            if (source[index] == '@' && index + 1 < source.Length && IsIdentifierStart(source[index + 1]))
            {
                var end = index + 2;
                while (end < source.Length && IsIdentifierPart(source[end])) end++;
                var token = source[index..end];
                var normalized = token[1..];
                AppendToken(output, IsDirective(normalized) ? "directive" : ResolveIdentifierKind(normalized, source, index, end), token);
                index = end; continue;
            }
            if (char.IsLetter(source[index]) || source[index] is '_' or '@')
            {
                var end = index + 1; while (end < source.Length && (char.IsLetterOrDigit(source[end]) || source[end] is '_' or '-')) end++;
                var token = source[index..end];
                // Text rendered inside a Razor/HTML element is user content,
                // not C# source. Keep it in the editor foreground instead of
                // applying the uppercase/type heuristic (for example,
                // "Hey" and "I" in a chat bubble). Code outside markup, and
                // code inside Razor braces, still receives syntax tokens.
                var kind = markupLanguage && markupElementDepth > 0 && razorCodeDepth == 0
                    ? string.Empty
                    : ResolveIdentifierKind(token, source, index, end);
                if (kind.Length > 0) AppendToken(output, kind, token); else output.Append(System.Net.WebUtility.HtmlEncode(token));
                index = end; continue;
            }
            if (IsOperator(source[index]))
            {
                var end = index + 1;
                while (end < source.Length && IsOperator(source[end]))
                {
                    // A question mark immediately followed by a closing Razor
                    // tag is text plus markup, not one operator token. Keep the
                    // opening angle bracket available for the markup parser.
                    if (markupLanguage && source[end] == '<' && end + 1 < source.Length
                        && (char.IsLetter(source[end + 1]) || source[end + 1] == '/')) break;
                    end++;
                }
                AppendToken(output, "operator", source[index..end]); index = end; continue;
            }
            if (IsPunctuation(source[index]))
            {
                if (markupLanguage && source[index] == '{') razorCodeDepth++;
                else if (markupLanguage && source[index] == '}' && razorCodeDepth > 0) razorCodeDepth--;
                AppendToken(output, "punctuation", source[index].ToString()); index++; continue;
            }
            output.Append(System.Net.WebUtility.HtmlEncode(source[index].ToString())); index++;
        }
        return output.ToString();
    }

    private static int FindMarkupTagEnd(string source, int start)
    {
        var quote = '\0';
        for (var index = start; index < source.Length; index++)
        {
            var character = source[index];
            if (quote != '\0')
            {
                if (character == '\\') { index++; continue; }
                if (character == quote) quote = '\0';
                continue;
            }
            if (character is '"' or '\'') { quote = character; continue; }
            if (character == '>') return index + 1;
        }
        return source.Length;
    }

    private static bool IsClosingMarkupTag(string tag)
        => tag.AsSpan().TrimStart().StartsWith("</", StringComparison.Ordinal);

    private static bool IsSelfClosingMarkupTag(string tag)
        => tag.AsSpan().TrimEnd().EndsWith("/>", StringComparison.Ordinal);

    private static void AppendMarkupTag(System.Text.StringBuilder output, string value)
    {
        var index = 0;
        AppendToken(output, "punctuation", value[index].ToString()); index++;
        if (index < value.Length && value[index] == '/')
        {
            AppendToken(output, "punctuation", "/"); index++;
        }

        var tagStart = index;
        while (index < value.Length && IsMarkupNamePart(value[index])) index++;
        if (index > tagStart) AppendToken(output, "tag", value[tagStart..index]);

        while (index < value.Length)
        {
            if (char.IsWhiteSpace(value[index]))
            {
                var whitespaceStart = index;
                while (index < value.Length && char.IsWhiteSpace(value[index])) index++;
                output.Append(System.Net.WebUtility.HtmlEncode(value[whitespaceStart..index]));
                continue;
            }
            if (value[index] == '>' || (value[index] == '/' && index + 1 < value.Length && value[index + 1] == '>'))
            {
                if (value[index] == '/') { AppendToken(output, "punctuation", "/"); index++; }
                if (index < value.Length && value[index] == '>') { AppendToken(output, "punctuation", ">"); index++; }
                continue;
            }

            var attributeStart = index;
            while (index < value.Length && !char.IsWhiteSpace(value[index]) && value[index] is not '=' and not '>' and not '/') index++;
            if (index == attributeStart)
            {
                AppendToken(output, "punctuation", value[index].ToString()); index++; continue;
            }
            AppendToken(output, "attribute", value[attributeStart..index]);
            while (index < value.Length && char.IsWhiteSpace(value[index]))
            {
                var whitespaceStart = index;
                while (index < value.Length && char.IsWhiteSpace(value[index])) index++;
                output.Append(System.Net.WebUtility.HtmlEncode(value[whitespaceStart..index]));
            }
            if (index < value.Length && value[index] == '=')
            {
                AppendToken(output, "operator", "="); index++;
                while (index < value.Length && char.IsWhiteSpace(value[index]))
                {
                    var whitespaceStart = index;
                    while (index < value.Length && char.IsWhiteSpace(value[index])) index++;
                    output.Append(System.Net.WebUtility.HtmlEncode(value[whitespaceStart..index]));
                }
                if (index < value.Length && value[index] is '"' or '\'')
                {
                    index = AppendMarkupAttributeValue(output, value, index);
                }
            }
        }
    }

    private static int AppendMarkupAttributeValue(System.Text.StringBuilder output, string value, int index)
    {
        var quote = value[index++];
        AppendToken(output, "string", quote.ToString());
        var plainStart = index;
        while (index < value.Length && value[index] != quote)
        {
            if (value[index] != '@')
            {
                index++;
                continue;
            }

            if (index > plainStart) AppendToken(output, "string", value[plainStart..index]);
            AppendToken(output, "directive", "@");
            index++;
            while (index < value.Length && value[index] != quote && !char.IsWhiteSpace(value[index]))
            {
                if (IsIdentifierStart(value[index]))
                {
                    var identifierStart = index++;
                    while (index < value.Length && IsIdentifierPart(value[index])) index++;
                    var identifier = value[identifierStart..index];
                    var kind = identifierStart > 0 && value[identifierStart - 1] == '.' ? "property" : ResolveIdentifierKind(identifier, value, identifierStart, index);
                    if (kind.Length == 0) output.Append(System.Net.WebUtility.HtmlEncode(identifier));
                    else AppendToken(output, kind, identifier);
                    continue;
                }

                if (IsPunctuation(value[index])) AppendToken(output, "punctuation", value[index].ToString());
                else if (IsOperator(value[index])) AppendToken(output, "operator", value[index].ToString());
                else output.Append(System.Net.WebUtility.HtmlEncode(value[index].ToString()));
                index++;
            }
            plainStart = index;
        }

        if (index > plainStart) AppendToken(output, "string", value[plainStart..index]);
        if (index < value.Length && value[index] == quote)
        {
            AppendToken(output, "string", quote.ToString());
            index++;
        }
        return index;
    }

    private static string ResolveIdentifierKind(string token, string source, int start, int end)
    {
        if (Keywords.Contains(token)) return "keyword";
        if (Literals.Contains(token)) return "literal";
        var next = end;
        while (next < source.Length && char.IsWhiteSpace(source[next])) next++;
        if (next < source.Length && source[next] == '(') return "method";
        if (Types.Contains(token) || (token.Length > 0 && char.IsUpper(token[0]))) return "type";
        if (start > 0 && source[start - 1] == '.') return "property";
        return string.Empty;
    }

    private static bool IsDirective(string token) => token is "page" or "using" or "inject" or "inherits" or "implements" or "attribute" or "typeparam" or "code" or "functions";

    private static bool IsIdentifierStart(char value) => char.IsLetter(value) || value is '_' or '@';
    private static bool IsIdentifierPart(char value) => char.IsLetterOrDigit(value) || value is '_' or '-';
    private static bool IsMarkupNamePart(char value) => char.IsLetterOrDigit(value) || value is '_' or '-' or ':' or '.';
    private static bool IsOperator(char value) => value is '=' or '+' or '-' or '*' or '/' or '!' or '&' or '|' or '?' or '%' or '<' or '>';
    private static bool IsPunctuation(char value) => value is '{' or '}' or '(' or ')' or '[' or ']' or ';' or ':' or ',' or '.';

    private static readonly HashSet<string> Keywords = new(StringComparer.Ordinal)
    {
        "abstract", "as", "async", "await", "base", "break", "case", "catch", "class", "const", "continue", "default", "delegate",
        "do", "else", "enum", "event", "explicit", "extern", "finally", "fixed", "for", "foreach", "goto", "if", "implicit", "in",
        "interface", "internal", "is", "lock", "namespace", "new", "operator", "out", "override", "params", "private", "protected",
        "public", "readonly", "ref", "return", "sealed", "sizeof", "stackalloc", "static", "struct", "switch", "this", "throw",
        "try", "typeof", "unchecked", "unsafe", "using", "var", "virtual", "void", "volatile", "while", "with", "yield", "inject", "inherits"
    };

    private static readonly HashSet<string> Literals = new(StringComparer.Ordinal) { "true", "false", "null", "default" };

    private static readonly HashSet<string> Types = new(StringComparer.Ordinal)
    {
        "bool", "byte", "char", "decimal", "double", "float", "int", "long", "object", "sbyte", "short", "string", "uint", "ulong", "ushort",
        "DateTime", "DateOnly", "TimeOnly", "Task", "ValueTask", "EventCallback", "RenderFragment", "IEnumerable", "IReadOnlyList", "IReadOnlyDictionary",
        "CancellationToken", "Guid", "StringBuilder", "MarkupString"
    };

    private static void AppendToken(System.Text.StringBuilder output, string kind, string value)
    {
        output.Append("<span class=\"shadcn-code-token shadcn-code-token-"); output.Append(kind); output.Append(" code-token code-token-"); output.Append(kind); output.Append("\">"); output.Append(System.Net.WebUtility.HtmlEncode(value)); output.Append("</span>");
    }

    public async ValueTask DisposeAsync()
    {
        CancelCopyReset();
        if (_module is null) return;
        try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
    }
}
