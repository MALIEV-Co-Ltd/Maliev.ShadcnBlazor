@using Microsoft.Extensions.Options
@inject IOptions<ShadcnOptions> ConfiguredOptions
@inject IJSRuntime JavaScript
@implements IAsyncDisposable

<div @attributes="AdditionalAttributes"
     class="@RootClass"
     style="@RootStyle"
     data-shadcn-scope
     data-shadcn-theme="@(EffectiveDarkMode ? "dark" : "light")"
     data-shadcn-reduced-motion="@ReducedMotionPolicy"
     dir="@(EffectiveDirection == ShadcnDirection.RightToLeft ? "rtl" : "ltr")">
    <CascadingValue Value="@Context">@ChildContent</CascadingValue>
</div>

@code {
    private ShadcnOptions _options = null!;
    private IJSObjectReference? _module;
    private IJSObjectReference? _systemThemeObserver;
    private DotNetObjectReference<ShadcnSystemThemeObserverCallback>? _observerCallbackReference;

    [Parameter] public bool? IsDarkMode { get; set; }
    [Parameter] public bool ObserveSystemDarkModeChange { get; set; }
    [Parameter] public EventCallback<bool> SystemDarkModeChanged { get; set; }
    [Parameter] public ShadcnDirection? Direction { get; set; }
    [Parameter] public ShadcnTheme? Theme { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private bool EffectiveDarkMode => IsDarkMode ?? _options.DefaultDarkMode;
    private ShadcnDirection EffectiveDirection => Direction ?? _options.DefaultDirection;
    private ShadcnTheme? EffectiveTheme => Theme ?? _options.Theme;
    private ShadcnContext Context => new(EffectiveDarkMode, EffectiveDirection);
    private string RootClass => JoinValues(ShadcnCss.ScopeClass, Class, GetAdditionalAttribute("class"));
    private string? ReducedMotionPolicy => EffectiveTheme?.Metrics.ReducedMotionBehavior switch
    {
        ShadcnReducedMotionBehavior.RespectSystemPreference => "system",
        ShadcnReducedMotionBehavior.AlwaysReduce => "always",
        _ => null
    };
    private string RootStyle => JoinStyles(
        Style,
        GetAdditionalAttribute("style"),
        EffectiveTheme is null
            ? $"--shadcn-font-sans: {_options.FontFamily}"
            : ShadcnThemeCssWriter.WriteProperties(EffectiveTheme, EffectiveDarkMode));

    protected override void OnInitialized() => _options = ConfiguredOptions.Value;

    protected override void OnParametersSet()
    {
        if (!Enum.IsDefined(EffectiveDirection))
            throw new ArgumentOutOfRangeException(nameof(Direction), EffectiveDirection,
                "Shadcn direction must be LeftToRight or RightToLeft.");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!ObserveSystemDarkModeChange)
        {
            await DisposeObserverAsync();
            return;
        }

        if (_systemThemeObserver is not null)
            return;

        try
        {
            _module ??= await JavaScript.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Maliev.ShadcnBlazor/js/shadcn-theme-provider.js");
            _observerCallbackReference ??= DotNetObjectReference.Create(
                new ShadcnSystemThemeObserverCallback(HandleSystemDarkModeChangedAsync));
            _systemThemeObserver = await _module.InvokeAsync<IJSObjectReference>("observeSystemDarkMode", _observerCallbackReference);
            await SystemDarkModeChanged.InvokeAsync(await _systemThemeObserver.InvokeAsync<bool>("getCurrent"));
        }
        catch (InvalidOperationException)
        {
            // JavaScript is unavailable during static prerendering; hydration retries this hook.
        }
        catch (JSDisconnectedException)
        {
            // The circuit ended while the observer was being attached.
        }
    }

    private Task HandleSystemDarkModeChangedAsync(bool isDarkMode) => ObserveSystemDarkModeChange
        ? SystemDarkModeChanged.InvokeAsync(isDarkMode)
        : Task.CompletedTask;

    private string? GetAdditionalAttribute(string name) => AdditionalAttributes?
        .FirstOrDefault(attribute => string.Equals(attribute.Key, name, StringComparison.OrdinalIgnoreCase))
        .Value?.ToString();

    private static string JoinValues(params string?[] values) => string.Join(" ", values
        .Where(value => !string.IsNullOrWhiteSpace(value))
        .Select(value => value!.Trim()));

    private static string JoinStyles(params string?[] values) => string.Join("; ", values
        .Where(value => !string.IsNullOrWhiteSpace(value))
        .Select(value => value!.Trim().TrimEnd(';')));

    private async ValueTask DisposeObserverAsync()
    {
        if (_systemThemeObserver is null)
            return;

        try
        {
            await _systemThemeObserver.InvokeVoidAsync("dispose");
            await _systemThemeObserver.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        finally { _systemThemeObserver = null; }
    }

    public async ValueTask DisposeAsync()
    {
        await DisposeObserverAsync();
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        _observerCallbackReference?.Dispose();
    }
}
