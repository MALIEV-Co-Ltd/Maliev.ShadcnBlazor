@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
<div @attributes="Forwarded" class="@MergeClass("shadcn-dropdown-menu-radio-item")" style="@MergeStyle(null)" data-slot="dropdown-menu-radio-item" data-state="@(Selected?"checked":"unchecked")" data-disabled="@(Disabled?"true":null)" data-inset="@(Inset?"true":null)" role="menuitemradio" aria-checked="@(Selected?"true":"false")" aria-disabled="@(Disabled?"true":null)" tabindex="-1" @onclick="SelectAsync"><span class="shadcn-dropdown-menu-item-indicator" data-slot="dropdown-menu-radio-item-indicator" aria-hidden="true">@if(Selected){<svg data-slot="dropdown-menu-item-indicator" viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="12" r="4" /></svg>}</span>@ChildContent</div>
@code {
    [CascadingParameter] private ShadcnMenuRadioContext Group { get; set; } = default!;
    [CascadingParameter] private ShadcnMenuContext? Context { get; set; }
    [Parameter, EditorRequired] public string Value { get; set; } = string.Empty;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Inset { get; set; }
    [Parameter] public bool CloseOnSelect { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private bool Selected => Group.Value == Value;
    private IReadOnlyDictionary<string, object> Forwarded => AttributesExcept("data-slot", "data-state", "data-disabled", "data-inset", "role", "aria-checked", "aria-disabled", "tabindex");
    protected override void OnParametersSet() => ShadcnMenuValues.RequireValue(Value);
    private async Task SelectAsync() { if (Disabled) return; await Group.SelectAsync(Value); if (CloseOnSelect && Context is not null) await Context.Owner.SetOpenAsync(false); }
}
