@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JavaScript
@if(Context.Owner.EffectiveOpen){<div @ref="_element" @attributes="Forwarded" id="@Context.Owner.ContentId" class="@MergeClass("shadcn-context-menu-content")" style="@ContentStyle" data-slot="context-menu-content" data-state="open" data-anchor-x="@Owner.AnchorX" data-anchor-y="@Owner.AnchorY" role="menu" tabindex="-1">@ChildContent</div>}
@code {
    [CascadingParameter] private ShadcnMenuContext Context { get; set; } = default!; [Parameter] public RenderFragment? ChildContent { get; set; }
    private ShadcnContextMenu Owner => (ShadcnContextMenu)Context.Owner; private ElementReference _element; private IJSObjectReference? _module; private DotNetObjectReference<ShadcnContextMenu>? _ownerRef; private bool _attached;
    private string ContentStyle => $"position: fixed; {MergeStyle(null)}";
    private IReadOnlyDictionary<string,object> Forwarded => AttributesExcept("id","data-slot","data-state","data-anchor-x","data-anchor-y","role","tabindex");
    protected override async Task OnAfterRenderAsync(bool first) { if (!Context.Owner.EffectiveOpen) return; if (_attached && _module is not null && await _module.InvokeAsync<bool>("isMenuAttached", _element)) { await _module.InvokeVoidAsync("placeContextMenu", _element, 8); return; } if (_attached) await ResetAsync(); _module = await JavaScript.InvokeAsync<IJSObjectReference>("import", "./_content/Maliev.ShadcnBlazor/js/shadcn-overlays-menus.js"); _ownerRef = DotNetObjectReference.Create(Owner); await _module.InvokeVoidAsync("attachContextMenu", _element, Context.Owner.TriggerId, _ownerRef, 8); _attached = true; }
    private async ValueTask ResetAsync() { if (_module is not null) try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { } _ownerRef?.Dispose(); _ownerRef=null; _module=null; _attached=false; }
    public async ValueTask DisposeAsync() { if (_attached && _module is not null) try { await _module.InvokeVoidAsync("detachMenu", _element); } catch (JSDisconnectedException) { } await ResetAsync(); }
}
