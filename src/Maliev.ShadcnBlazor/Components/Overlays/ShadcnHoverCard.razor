    [JSInvokable]
    public async Task RequestOpenAsync(bool value)
    {
        if (_open == value) return;
        _open = value;
        _last = value;
        if (OpenChanged.HasDelegate) await OpenChanged.InvokeAsync(value);
        await InvokeAsync(StateHasChanged);
    }
}
