@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase

<CascadingValue Value="Context" IsFixed="true">
    <div @attributes="ForwardedAttributes" class="@MergeClass("shadcn-dialog")" style="@MergeStyle(null)" data-slot="dialog" data-state="@(EffectiveOpen ? "open" : "closed")">@ChildContent</div>
</CascadingValue>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public bool Modal { get; set; } = true;
    [Parameter] public bool CloseOnEscape { get; set; } = true;
    [Parameter] public bool CloseOnOutsidePress { get; set; } = true;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private static long _nextId;
    private readonly ShadcnDialogContext _context;
    private bool _effectiveOpen;
    private bool _lastParameterOpen;
    private bool _initialized;
    public ShadcnDialog() { var id = Interlocked.Increment(ref _nextId); _context = new(this, $"shadcn-dialog-{id}-content"); }
    private ShadcnDialogContext Context => _context;
    internal bool EffectiveOpen => _effectiveOpen;
    private IReadOnlyDictionary<string, object> ForwardedAttributes => AttributesExcept("data-slot", "data-state");
    protected override void OnParametersSet() { if (!_initialized || Open != _lastParameterOpen) _effectiveOpen = Open; _lastParameterOpen = Open; _initialized = true; }
    internal async ValueTask SetOpenAsync(bool value) { if (_effectiveOpen == value) return; if (OpenChanged.HasDelegate) await OpenChanged.InvokeAsync(value); else { _effectiveOpen = value; await InvokeAsync(StateHasChanged); } }
}
