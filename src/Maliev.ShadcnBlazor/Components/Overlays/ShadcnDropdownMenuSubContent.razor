@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JavaScript
@if(Sub.EffectiveOpen){<div @ref="_element" @attributes="Forwarded" id="@Sub.ContentId" class="@MergeClass("shadcn-dropdown-menu-sub-content")" style="@MergeStyle(null)" data-slot="dropdown-menu-sub-content" data-state="open" data-side="@SideValue" data-align="@AlignValue" role="menu" aria-labelledby="@Sub.TriggerId" tabindex="-1" @onkeydown="KeyDownAsync" @onkeydown:stopPropagation>@ChildContent</div>}
@code {
    [CascadingParameter] private ShadcnDropdownMenuSub Sub { get; set; } = default!;
    [Parameter] public ShadcnOverlaySide Side { get; set; } = ShadcnOverlaySide.Right;
    [Parameter] public ShadcnOverlayAlign Align { get; set; } = ShadcnOverlayAlign.Start;
    [Parameter] public double SideOffset { get; set; } = 4;
    [Parameter] public double AlignOffset { get; set; } = -4;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private ElementReference _element;
    private IJSObjectReference? _module;
    private bool _attached;
    private string SideValue => ShadcnPositionedOverlayValues.Side(Side);
    private string AlignValue => ShadcnPositionedOverlayValues.Align(Align);
    private IReadOnlyDictionary<string, object> Forwarded => AttributesExcept("id", "data-slot", "data-state", "data-side", "data-align", "role", "aria-labelledby", "tabindex");
    protected override async Task OnAfterRenderAsync(bool first) { if (!Sub.EffectiveOpen) return; if (_attached && _module is not null && await _module.InvokeAsync<bool>("isPositionedAttached", _element)) return; if (_attached) await DetachAsync(); _module = await JavaScript.InvokeAsync<IJSObjectReference>("import", "./_content/Maliev.ShadcnBlazor/js/shadcn-overlays-menus.js"); await _module.InvokeVoidAsync("attachPositioned", _element, Sub.TriggerId, SideValue, AlignValue, SideOffset, AlignOffset, 8, null, false, false, false); _attached = true; }
    private async Task KeyDownAsync(KeyboardEventArgs args) { if (args.Key != "Escape") return; if (_module is not null) await _module.InvokeVoidAsync("focusSubTrigger", _element); await Sub.SetOpenAsync(false); }
    private async ValueTask DetachAsync() { if (_module is not null) { try { await _module.InvokeVoidAsync("detachPositioned", _element); await _module.DisposeAsync(); } catch (JSDisconnectedException) { } } _module = null; _attached = false; }
    public async ValueTask DisposeAsync() => await DetachAsync();
}
