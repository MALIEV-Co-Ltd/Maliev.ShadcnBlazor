@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnFocusableComponentBase
<button @ref="FocusElement" @attributes="Forwarded" id="@Context.TriggerId" class="@MergeClass("shadcn-popover-trigger")" style="@MergeStyle(null)" data-slot="popover-trigger" type="button" disabled="@Disabled" aria-haspopup="dialog" aria-controls="@Context.ContentId" aria-expanded="@(Context.Owner.EffectiveOpen?"true":"false")" @onclick="ToggleAsync">@ChildContent</button>
@code { [CascadingParameter]private ShadcnPopoverContext Context{get;set;}=default!;[Parameter]public bool Disabled{get;set;}[Parameter]public RenderFragment? ChildContent{get;set;}private IReadOnlyDictionary<string,object> Forwarded=>AttributesExcept("id","data-slot","type","disabled","aria-haspopup","aria-controls","aria-expanded");private async Task ToggleAsync(){if(!Disabled)await Context.Owner.SetOpenAsync(!Context.Owner.EffectiveOpen);} }
