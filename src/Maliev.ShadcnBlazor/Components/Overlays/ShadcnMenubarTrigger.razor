@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
<button @attributes="Forwarded" id="@Context.Owner.TriggerId" class="@MergeClass("shadcn-menubar-trigger")" style="@MergeStyle(null)" data-slot="menubar-trigger" data-text-value="@TextValue" type="button" role="menuitem" disabled="@Disabled" aria-haspopup="menu" aria-controls="@Context.Owner.ContentId" aria-expanded="@(Context.Owner.EffectiveOpen?"true":"false")" tabindex="@TabIndex" @onclick="ToggleAsync">@ChildContent</button>
@code { [CascadingParameter]private ShadcnMenuContext Context{get;set;}=default!; [CascadingParameter]private ShadcnMenubarMenuContext Menu{get;set;}=default!; [CascadingParameter]private ShadcnMenubarMenu Owner{get;set;}=default!; [Parameter]public bool Disabled{get;set;} [Parameter]public string? TextValue{get;set;} [Parameter]public RenderFragment? ChildContent{get;set;} private int TabIndex=>Menu.Index==0?0:-1; private IReadOnlyDictionary<string,object> Forwarded=>AttributesExcept("id","data-slot","data-text-value","type","role","disabled","aria-haspopup","aria-controls","aria-expanded","tabindex"); private async Task ToggleAsync(){if(!Disabled)await Owner.ToggleAsync();} }
