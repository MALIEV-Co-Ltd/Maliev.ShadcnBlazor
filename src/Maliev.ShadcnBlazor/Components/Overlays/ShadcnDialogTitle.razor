@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
<h2 @attributes="ForwardedAttributes" id="@Id" class="@MergeClass("shadcn-dialog-title")" style="@MergeStyle(null)" data-slot="dialog-title">@ChildContent</h2>
@code {
    [CascadingParameter] private ShadcnDialogContext Context { get; set; } = default!;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private string Id => $"{Context.ContentId}-title";
    protected override void OnInitialized() => Context.TitleId = Id;
    private IReadOnlyDictionary<string, object> ForwardedAttributes => AttributesExcept("id", "data-slot");
}
