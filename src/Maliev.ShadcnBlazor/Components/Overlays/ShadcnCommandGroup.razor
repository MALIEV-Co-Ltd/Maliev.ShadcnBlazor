@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
<div @attributes="Forwarded" class="@MergeClass("shadcn-command-group")" style="@MergeStyle(null)" data-slot="command-group" role="group" aria-labelledby="@(Heading is null?null:_headingId)">@if(Heading is not null){<div id="@_headingId" class="shadcn-command-group-heading" data-slot="command-group-heading">@Heading</div>}@ChildContent</div>
@code { [Parameter]public string? Heading{get;set;} [Parameter]public RenderFragment? ChildContent{get;set;} private readonly string _headingId=$"shadcn-command-heading-{Guid.NewGuid():N}"; private IReadOnlyDictionary<string,object> Forwarded=>AttributesExcept("data-slot","role","aria-labelledby"); }
