@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JavaScript
@if(Context.Owner.EffectiveOpen){<div @ref="_element" @attributes="Forwarded" id="@Context.ContentId" class="@MergeClass("shadcn-tooltip-content")" style="@MergeStyle(null)" data-slot="tooltip-content" data-state="open" data-side="@SideValue" data-align="@AlignValue" data-side-offset="@SideOffsetText" data-align-offset="@AlignOffsetText" data-collision-padding="@CollisionPaddingText" role="tooltip">@ChildContent<span class="shadcn-tooltip-arrow" data-slot="tooltip-arrow" aria-hidden="true"></span></div>}
@code {
    [CascadingParameter] private ShadcnTooltipContext Context { get; set; } = default!;
    [Parameter] public ShadcnOverlaySide Side { get; set; } = ShadcnOverlaySide.Top;
    [Parameter] public ShadcnOverlayAlign Align { get; set; } = ShadcnOverlayAlign.Center;
    [Parameter] public double SideOffset { get; set; } = 4;
    [Parameter] public double AlignOffset { get; set; }
    [Parameter] public double CollisionPadding { get; set; } = 8;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private ElementReference _element;
    private IJSObjectReference? _module;
    private DotNetObjectReference<ShadcnTooltip>? _ownerRef;
    private bool _attached;
    private string SideValue => ShadcnPositionedOverlayValues.Side(Side);
    private string AlignValue => ShadcnPositionedOverlayValues.Align(Align);
    private string SideOffsetText => Format(SideOffset);
    private string AlignOffsetText => Format(AlignOffset);
    private string CollisionPaddingText => Format(CollisionPadding);
    private string FocusTargetId => Context.TriggerDisabled ? Context.AnchorId : Context.TriggerId;
    private IReadOnlyDictionary<string, object> Forwarded => AttributesExcept("id", "data-slot", "data-state", "data-side", "data-align", "data-side-offset", "data-align-offset", "data-collision-padding", "role");

    protected override void OnParametersSet()
    {
        _ = SideValue; _ = AlignValue;
        ShadcnPositionedOverlayValues.ValidateOffset(SideOffset, nameof(SideOffset));
        ShadcnPositionedOverlayValues.ValidateOffset(AlignOffset, nameof(AlignOffset));
        if (CollisionPadding is < 0 or > 256 || !double.IsFinite(CollisionPadding)) throw new ArgumentOutOfRangeException(nameof(CollisionPadding));
    }

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (!Context.Owner.EffectiveOpen) return;
        if (_attached && _module is not null && await _module.InvokeAsync<bool>("isPositionedAttached", _element)) return;
        if (_attached) await ResetAsync();
        _module = await JavaScript.InvokeAsync<IJSObjectReference>("import", "./_content/Maliev.ShadcnBlazor/js/shadcn-overlays-menus.js");
        _ownerRef = DotNetObjectReference.Create(Context.Owner);
        await _module.InvokeVoidAsync("attachPositioned", _element, FocusTargetId, SideValue, AlignValue, SideOffset, AlignOffset, CollisionPadding, _ownerRef, true, false, false, FocusTargetId, false);
        _attached = true;
    }

    private static string Format(double value) => value.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture);
    private async ValueTask ResetAsync() { if (_module is not null) try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { } _ownerRef?.Dispose(); _ownerRef = null; _module = null; _attached = false; }
    public async ValueTask DisposeAsync() { if (_attached && _module is not null) try { await _module.InvokeVoidAsync("detachPositioned", _element); } catch (JSDisconnectedException) { } await ResetAsync(); }
}
