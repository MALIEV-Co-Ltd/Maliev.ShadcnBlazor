@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
<button @attributes="Forwarded" id="@Context.Owner.TriggerId" class="@MergeClass("shadcn-dropdown-menu-trigger")" style="@MergeStyle(null)" data-slot="dropdown-menu-trigger" type="button" disabled="@Disabled" aria-haspopup="menu" aria-controls="@Context.Owner.ContentId" aria-expanded="@(Context.Owner.EffectiveOpen?"true":"false")" @onclick="ToggleAsync">@ChildContent</button>
@code { [CascadingParameter]private ShadcnMenuContext Context{get;set;}=default!;[Parameter]public bool Disabled{get;set;}[Parameter]public RenderFragment? ChildContent{get;set;}private IReadOnlyDictionary<string,object> Forwarded=>AttributesExcept("id","data-slot","type","disabled","aria-haspopup","aria-controls","aria-expanded");private async Task ToggleAsync(){if(!Disabled)await Context.Owner.SetOpenAsync(!Context.Owner.EffectiveOpen);} }
