@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
<button @attributes="ForwardedAttributes" class="@MergeClass("shadcn-dialog-close")" style="@MergeStyle(null)" data-slot="dialog-close" type="button" aria-label="@Label" disabled="@Disabled" @onclick="CloseAsync">@(ChildContent ?? DefaultContent)</button>
@code {
    [CascadingParameter] private ShadcnDialogContext Context { get; set; } = default!;
    [Parameter] public string Label { get; set; } = "Close";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private RenderFragment DefaultContent => builder => builder.AddContent(0, "×");
    private IReadOnlyDictionary<string, object> ForwardedAttributes => AttributesExcept("data-slot", "type", "aria-label", "disabled");
    private async Task CloseAsync() { if (!Disabled) await Context.Owner.SetOpenAsync(false); }
}
