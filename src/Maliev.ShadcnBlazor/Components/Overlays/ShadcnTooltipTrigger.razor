@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JavaScript
<span @ref="_interactionElement" id="@Context.AnchorId" class="shadcn-tooltip-trigger-wrapper" data-slot="tooltip-trigger-wrapper" tabindex="@(Disabled ? "0" : null)" role="@(Disabled ? "button" : null)" aria-disabled="@(Disabled ? "true" : null)" aria-label="@(Disabled ? AccessibleLabel : null)" aria-describedby="@(Disabled && Context.Owner.EffectiveOpen ? Context.ContentId : null)"><button @attributes="Forwarded" id="@Context.TriggerId" class="@MergeClass("shadcn-tooltip-trigger")" style="@MergeStyle(null)" data-slot="tooltip-trigger" type="button" disabled="@Disabled" aria-hidden="@(Disabled ? "true" : null)" aria-describedby="@(!Disabled && Context.Owner.EffectiveOpen?Context.ContentId:null)">@ChildContent</button></span>
@code {
    [CascadingParameter] private ShadcnTooltipContext Context { get; set; } = default!;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? AccessibleLabel { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private ElementReference _interactionElement;
    private IJSObjectReference? _module;
    private DotNetObjectReference<ShadcnTooltip>? _ownerRef;
    private string? _attachmentSignature;
    private IReadOnlyDictionary<string, object> Forwarded => AttributesExcept("id", "data-slot", "type", "disabled", "aria-describedby");

    protected override void OnParametersSet()
    {
        if (Disabled && string.IsNullOrWhiteSpace(AccessibleLabel)) throw new ArgumentException("A disabled tooltip trigger requires an accessible label.", nameof(AccessibleLabel));
        Context.TriggerDisabled = Disabled;
    }

    protected override async Task OnAfterRenderAsync(bool first)
    {
        _module ??= await JavaScript.InvokeAsync<IJSObjectReference>("import", "./_content/Maliev.ShadcnBlazor/js/shadcn-tooltip.js");
        _ownerRef ??= DotNetObjectReference.Create(Context.Owner);
        var signature = $"{Context.Owner.OpenDelayMs}:{Context.Owner.CloseDelayMs}:{Context.ContentId}";
        if (_attachmentSignature == signature) return;
        if (_attachmentSignature is not null) await _module.InvokeVoidAsync("detachDelayedTrigger", _interactionElement);
        await _module.InvokeVoidAsync("attachDelayedTrigger", _interactionElement, _ownerRef, Context.Owner.OpenDelayMs, Context.Owner.CloseDelayMs, Context.ContentId);
        _attachmentSignature = signature;
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("detachDelayedTrigger", _interactionElement); await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        _ownerRef?.Dispose();
    }
}
