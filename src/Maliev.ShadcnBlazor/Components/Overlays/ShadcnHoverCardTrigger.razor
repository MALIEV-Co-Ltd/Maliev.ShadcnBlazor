@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
@implements IAsyncDisposable
@implements Maliev.ShadcnBlazor.Components.Primitives.IShadcnFocusable
@inject IJSRuntime JavaScript
<a @ref="_element"
   @attributes="Forwarded"
   id="@Context.TriggerId"
   class="@MergeClass("shadcn-hover-card-trigger")"
   style="@MergeStyle(null)"
   data-slot="hover-card-trigger"
   data-state="@(Context.Owner.EffectiveOpen ? "open" : "closed")"
   href="@Href"
   aria-controls="@Context.ContentId"
   aria-expanded="@(Context.Owner.EffectiveOpen ? "true" : "false")"
   aria-describedby="@(Context.Owner.EffectiveOpen ? Context.ContentId : null)">@ChildContent</a>

@code {
    [CascadingParameter] private ShadcnHoverCardContext Context { get; set; } = default!;
    [Parameter] public string? Href { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private ElementReference _element;
    private IJSObjectReference? _module;
    private DotNetObjectReference<ShadcnHoverCard>? _ownerRef;
    private IReadOnlyDictionary<string, object> Forwarded => AttributesExcept("id", "data-slot", "data-state", "href", "aria-controls", "aria-expanded", "aria-describedby");

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (!first) return;
        _module = await JavaScript.InvokeAsync<IJSObjectReference>("import", "./_content/Maliev.ShadcnBlazor/js/shadcn-overlays-menus.js");
        _ownerRef = DotNetObjectReference.Create(Context.Owner);
        await _module.InvokeVoidAsync("attachHoverCardTrigger", _element, _ownerRef, Context.Owner.OpenDelayMs, Context.Owner.CloseDelayMs, Context.ContentId);
    }

    /// <summary>Focuses the hover-card anchor.</summary>
    public ValueTask FocusAsync(bool preventScroll = false) => _element.FocusAsync(preventScroll);

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("detachHoverCardTrigger", _element); await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        _ownerRef?.Dispose();
    }
}
