@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
<div @attributes="Forwarded" class="@MergeClass("shadcn-context-menu-sub-trigger")" style="@MergeStyle(null)" data-slot="context-menu-sub-trigger" data-state="@(Sub.Open?"open":"closed")" role="menuitem" aria-haspopup="menu" aria-expanded="@(Sub.Open?"true":"false")" aria-controls="@Sub.ContentId" tabindex="-1" @onclick="ToggleAsync">@ChildContent<span aria-hidden="true">›</span></div>
@code { [CascadingParameter]private ShadcnContextMenuSub Sub{get;set;}=default!;[Parameter]public RenderFragment? ChildContent{get;set;}private IReadOnlyDictionary<string,object> Forwarded=>AttributesExcept("data-slot","data-state","role","aria-haspopup","aria-expanded","aria-controls","tabindex");private Task ToggleAsync()=>Sub.SetOpenAsync(!Sub.Open).AsTask(); }
