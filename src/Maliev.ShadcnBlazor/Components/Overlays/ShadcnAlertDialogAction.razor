@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
<button @attributes="ForwardedAttributes" class="@MergeClass("shadcn-alert-dialog-action")" style="@MergeStyle(null)" data-slot="alert-dialog-action" type="button" disabled="@Disabled" @onclick="ClickAsync">@ChildContent</button>
@code { [CascadingParameter] private ShadcnAlertDialogContext Context { get; set; } = default!; [Parameter] public bool Disabled { get; set; } [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; } [Parameter] public RenderFragment? ChildContent { get; set; } private IReadOnlyDictionary<string, object> ForwardedAttributes => AttributesExcept("data-slot", "type", "disabled"); private async Task ClickAsync(MouseEventArgs args) { if (Disabled) return; await OnClick.InvokeAsync(args); await Context.Owner.SetOpenAsync(false); } }
