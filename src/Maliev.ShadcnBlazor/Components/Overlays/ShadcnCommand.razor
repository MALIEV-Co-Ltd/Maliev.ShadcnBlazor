@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
@implements IAsyncDisposable
@implements Maliev.ShadcnBlazor.Components.Primitives.IShadcnFocusable
@inject IJSRuntime JavaScript
@inject IShadcnIdAllocator IdAllocator

<CascadingValue Value="Context" IsFixed="true"><div @ref="_element" @attributes="Forwarded" class="@MergeClass("shadcn-command")" style="@MergeStyle(null)" data-slot="command" data-search="@Context.Search" data-should-filter="@(ShouldFilter ? "true" : "false")" aria-label="@Label">@ChildContent</div></CascadingValue>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public bool Loop { get; set; } = true;
    [Parameter] public bool ShouldFilter { get; set; } = true;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private ShadcnCommandContext Context = null!;
    private ElementReference _element;
    private IJSObjectReference? _module;
    protected override void OnInitialized() => Context = new ShadcnCommandContext(() => _ = InvokeAsync(StateHasChanged), IdAllocator.NextId("shadcn-command-list"));
    private IReadOnlyDictionary<string, object> Forwarded => AttributesExcept("data-slot", "data-search", "data-should-filter", "aria-label");
    protected override void OnParametersSet() { if (string.IsNullOrWhiteSpace(Label)) throw new ArgumentException("Command label cannot be empty.", nameof(Label)); Context.Label = Label; Context.ShouldFilter = ShouldFilter; }
    protected override async Task OnAfterRenderAsync(bool first) { if (_module is null) { _module = await JavaScript.InvokeAsync<IJSObjectReference>("import", "./_content/Maliev.ShadcnBlazor/js/shadcn-overlays-menus.js"); await _module.InvokeVoidAsync("attachCommand", _element, Loop); } else await _module.InvokeVoidAsync("refreshCommand", _element); }
    /// <summary>Focuses the command input when present; otherwise no action is taken.</summary>
    public async ValueTask FocusAsync(bool preventScroll = false) { _module ??= await JavaScript.InvokeAsync<IJSObjectReference>("import", "./_content/Maliev.ShadcnBlazor/js/shadcn-overlays-menus.js"); await _module.InvokeVoidAsync("focusCompositeTarget", _element, "[data-slot='command-input']:not(:disabled)", preventScroll); }
    public async ValueTask DisposeAsync() { if (_module is null) return; try { await _module.InvokeVoidAsync("detachCommand", _element); await _module.DisposeAsync(); } catch (JSDisconnectedException) { } }
}
