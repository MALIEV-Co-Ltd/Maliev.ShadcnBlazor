@using Maliev.ShadcnBlazor.Components.Actions
@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnFocusableComponentBase
<button @ref="FocusElement" @attributes="Forwarded" class="@MergeClass("shadcn-drawer-close")" style="@MergeStyle(null)" data-slot="drawer-close" data-variant="@VariantValue" type="button" disabled="@Disabled" @onclick="CloseAsync">@ChildContent</button>
@code {
    [CascadingParameter] private ShadcnDrawerContext Context { get; set; } = default!;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public ShadcnButtonVariant Variant { get; set; } = ShadcnButtonVariant.Outline;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private string VariantValue => Variant switch
    {
        ShadcnButtonVariant.Default => "default",
        ShadcnButtonVariant.Destructive => "destructive",
        ShadcnButtonVariant.Outline => "outline",
        ShadcnButtonVariant.Secondary => "secondary",
        ShadcnButtonVariant.Ghost => "ghost",
        ShadcnButtonVariant.Link => "link",
        _ => throw new ArgumentOutOfRangeException(nameof(Variant), Variant, "Unknown Shadcn drawer close variant.")
    };
    private IReadOnlyDictionary<string, object> Forwarded => AttributesExcept("data-slot", "data-variant", "type", "disabled");
    private async Task CloseAsync(MouseEventArgs args)
    {
        if (Disabled)
            return;

        await OnClick.InvokeAsync(args);
        await Context.Owner.SetOpenAsync(false);
    }
}
