@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
<CascadingValue Value="Context" IsFixed="true"><div @attributes="ForwardedAttributes" class="@MergeClass("shadcn-alert-dialog")" style="@MergeStyle(null)" data-slot="alert-dialog" data-state="@(EffectiveOpen ? "open" : "closed")">@ChildContent</div></CascadingValue>
@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
