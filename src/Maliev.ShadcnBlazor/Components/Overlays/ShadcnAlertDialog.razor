    [Parameter] public RenderFragment? ChildContent { get; set; }
    private static long _nextId; private readonly ShadcnAlertDialogContext _context; private bool _effectiveOpen; private bool _last; private bool _initialized;
    public ShadcnAlertDialog() { var id = Interlocked.Increment(ref _nextId); _context = new(this, $"shadcn-alert-dialog-{id}-content"); }
