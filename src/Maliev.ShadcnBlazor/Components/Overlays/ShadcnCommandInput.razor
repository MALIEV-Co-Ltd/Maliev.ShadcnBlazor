@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
@implements Maliev.ShadcnBlazor.Components.Primitives.IShadcnFocusable

<div class="shadcn-command-input-wrapper" data-slot="command-input-wrapper">
    <div class="shadcn-command-input-composition" data-slot="command-input-composition">
        <span data-slot="command-input-addon" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.3-4.3"></path>
            </svg>
        </span>
        <input @ref="InputElement"
               @attributes="Forwarded"
               class="@MergeClass("shadcn-command-input")"
               style="@MergeStyle(null)"
               data-slot="command-input"
               type="search"
               role="combobox"
               aria-label="@EffectiveAccessibleLabel"
               aria-controls="@Context.ListId"
               aria-expanded="true"
               aria-haspopup="listbox"
               aria-autocomplete="list"
               autocomplete="off"
               placeholder="@Placeholder"
               value="@Context.Search"
               @oninput="InputAsync" />
    </div>
</div>

@code {
    [CascadingParameter] private ShadcnCommandContext Context { get; set; } = default!;
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? AccessibleLabel { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    private ElementReference InputElement;
    private string? _lastValue;
    private bool _initialized;
    private string EffectiveAccessibleLabel => string.IsNullOrWhiteSpace(AccessibleLabel) ? Context.Label : AccessibleLabel;
    private IReadOnlyDictionary<string, object> Forwarded => AttributesExcept("data-slot", "type", "role", "aria-label", "aria-controls", "aria-expanded", "aria-haspopup", "aria-autocomplete", "aria-activedescendant", "autocomplete", "placeholder", "value");

    protected override void OnParametersSet()
    {
        if (!_initialized || Value != _lastValue)
            Context.SetSearch(Value);
        _lastValue = Value;
        _initialized = true;
    }

    private async Task InputAsync(ChangeEventArgs args)
    {
        var value = args.Value?.ToString() ?? string.Empty;
        Context.SetSearch(value);
        await ValueChanged.InvokeAsync(value);
    }

    /// <summary>Moves focus to the rendered native command search input after the component has rendered.</summary>
    /// <param name="preventScroll">Whether the browser should avoid scrolling the focused input into view.</param>
    public ValueTask FocusAsync(bool preventScroll = false) => InputElement.FocusAsync(preventScroll);
}
