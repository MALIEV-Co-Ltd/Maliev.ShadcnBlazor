@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JavaScript

@if (Context.Owner.EffectiveOpen)
{
    <div class="shadcn-dialog-portal" data-slot="dialog-portal">
        @if (Context.Owner.Modal)
        {
            <div class="shadcn-dialog-overlay" data-slot="dialog-overlay" data-state="open" @onclick="OutsideAsync"></div>
        }
        <div @ref="_element" @attributes="ForwardedAttributes" id="@Context.ContentId" class="@MergeClass("shadcn-dialog-content")" style="@MergeStyle(null)" data-slot="dialog-content" data-state="open" role="dialog" aria-modal="@(Context.Owner.Modal ? "true" : null)" aria-labelledby="@Context.TitleId" aria-describedby="@Context.DescriptionId" tabindex="-1">
            @ChildContent
            @if (ShowCloseButton) { <ShadcnDialogClose Label="@CloseLabel" /> }
        </div>
    </div>
}

@code {
    [CascadingParameter] private ShadcnDialogContext Context { get; set; } = default!;
    [Parameter] public bool ShowCloseButton { get; set; } = true;
    [Parameter] public string CloseLabel { get; set; } = "Close";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private ElementReference _element;
    private IJSObjectReference? _module;
    private DotNetObjectReference<ShadcnDialogContent>? _selfReference;
    private bool _attached;
    private string? _attachedElementId;
    private bool _ariaSynchronized;
    private IReadOnlyDictionary<string, object> ForwardedAttributes => AttributesExcept("id", "data-slot", "data-state", "role", "aria-modal", "aria-labelledby", "aria-describedby", "tabindex");
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Context.Owner.EffectiveOpen) { await DetachAsync(); return; }
        if (Context.TitleId is null) throw new InvalidOperationException("ShadcnDialogContent requires a ShadcnDialogTitle.");
        if (!_ariaSynchronized) { _ariaSynchronized = true; await InvokeAsync(StateHasChanged); return; }
        if (_attached && _attachedElementId == _element.Id && _module is not null && await _module.InvokeAsync<bool>("isDialogAttached", _element)) return;
        if (_attached) await ResetInteropAsync();
        _module = await JavaScript.InvokeAsync<IJSObjectReference>("import", "./_content/Maliev.ShadcnBlazor/js/shadcn-overlays-menus.js");
        _selfReference = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("attachDialog", _element, _selfReference, Context.Owner.Modal, Context.Owner.CloseOnEscape, Context.Owner.Modal, Context.Owner.CloseOnOutsidePress);
        _attached = true;
        _attachedElementId = _element.Id;
    }
    private async Task OutsideAsync() { if (Context.Owner.CloseOnOutsidePress) await Context.Owner.SetOpenAsync(false); }
    [JSInvokable] public Task RequestCloseAsync() => Context.Owner.SetOpenAsync(false).AsTask();
    private async ValueTask DetachAsync()
    {
        if (_module is not null)
        {
            try { if (_attached) await _module.InvokeVoidAsync("detachDialog", _element); await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        ResetInterop();
    }
    private async ValueTask ResetInteropAsync() { if (_module is not null) { try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { } } ResetInterop(); }
    private void ResetInterop() { _selfReference?.Dispose(); _selfReference = null; _module = null; _attached = false; _attachedElementId = null; }
    public ValueTask DisposeAsync() => DetachAsync();
}
