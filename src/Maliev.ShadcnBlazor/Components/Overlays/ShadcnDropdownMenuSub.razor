@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
<div @attributes="Forwarded" class="@MergeClass("shadcn-dropdown-menu-sub")" style="@MergeStyle(null)" data-slot="dropdown-menu-sub" data-state="@(EffectiveOpen?"open":"closed")"><CascadingValue Value="this" IsFixed="true">@ChildContent</CascadingValue></div>
@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private static long _next;
    private readonly long _id = Interlocked.Increment(ref _next);
    private bool _open, _last, _initialized;
    internal bool EffectiveOpen => _open;
    internal string TriggerId => $"shadcn-dropdown-sub-{_id}-trigger";
    internal string ContentId => $"shadcn-dropdown-sub-{_id}-content";
    private IReadOnlyDictionary<string, object> Forwarded => AttributesExcept("data-slot", "data-state");
    protected override void OnParametersSet() { if (!_initialized || Open != _last) _open = Open; _last = Open; _initialized = true; }
    internal Task ToggleAsync() => SetOpenAsync(!EffectiveOpen);
    internal async Task SetOpenAsync(bool value) { if (_open == value) return; if (OpenChanged.HasDelegate) await OpenChanged.InvokeAsync(value); else { _open = value; await InvokeAsync(StateHasChanged); } }
}
