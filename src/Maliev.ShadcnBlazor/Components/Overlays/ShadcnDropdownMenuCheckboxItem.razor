@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnFocusableComponentBase
<div @ref="FocusElement" @attributes="Forwarded" class="@MergeClass("shadcn-dropdown-menu-checkbox-item")" style="@MergeStyle(null)" data-slot="dropdown-menu-checkbox-item" data-state="@(EffectiveChecked?"checked":"unchecked")" data-disabled="@(Disabled?"true":null)" data-inset="@(Inset?"true":null)" role="menuitemcheckbox" aria-checked="@(EffectiveChecked?"true":"false")" aria-disabled="@(Disabled?"true":null)" tabindex="-1" @onclick="SelectAsync"><span class="shadcn-dropdown-menu-item-indicator" data-slot="dropdown-menu-checkbox-item-indicator" aria-hidden="true">@if(EffectiveChecked){<svg data-slot="dropdown-menu-item-indicator" viewBox="0 0 24 24" focusable="false"><path d="m5 12 4 4L19 6" /></svg>}</span>@ChildContent</div>
@code {
    [CascadingParameter] private ShadcnMenuContext? Context { get; set; }
