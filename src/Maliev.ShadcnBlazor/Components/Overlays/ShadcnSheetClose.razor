@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
<button @attributes="Forwarded" class="@MergeClass("shadcn-sheet-close")" style="@MergeStyle(null)" data-slot="sheet-close" type="button" aria-label="@Label" disabled="@Disabled" @onclick="CloseAsync">@(ChildContent??DefaultContent)</button>
@code { [CascadingParameter] private ShadcnSheetContext Context { get; set; }=default!; [Parameter] public string Label { get; set; }="Close"; [Parameter] public bool Disabled { get; set; } [Parameter] public RenderFragment? ChildContent { get; set; } private RenderFragment DefaultContent=>b=>b.AddContent(0,"×");private IReadOnlyDictionary<string,object> Forwarded=>AttributesExcept("data-slot","type","aria-label","disabled");private async Task CloseAsync(){if(!Disabled)await Context.Owner.SetOpenAsync(false);} }
