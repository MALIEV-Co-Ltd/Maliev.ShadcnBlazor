@using Maliev.ShadcnBlazor.Components.Actions
@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
<button @attributes="Forwarded" class="@MergeClass(ChildContent is null ? "shadcn-sheet-close shadcn-sheet-close-icon" : "shadcn-sheet-close")" style="@MergeStyle(null)" data-slot="sheet-close" data-variant="@VariantValue" type="button" aria-label="@(ChildContent is null ? Label : null)" disabled="@Disabled" @onclick="CloseAsync">@(ChildContent??DefaultContent)</button>
@code {
    [CascadingParameter] private ShadcnSheetContext Context { get; set; } = default!;
    [Parameter] public string Label { get; set; } = "Close";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public ShadcnButtonVariant Variant { get; set; } = ShadcnButtonVariant.Outline;
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string VariantValue => ChildContent is null
        ? "ghost"
        : Variant switch
        {
            ShadcnButtonVariant.Default => "default",
            ShadcnButtonVariant.Destructive => "destructive",
            ShadcnButtonVariant.Outline => "outline",
            ShadcnButtonVariant.Secondary => "secondary",
            ShadcnButtonVariant.Ghost => "ghost",
            ShadcnButtonVariant.Link => "link",
            _ => throw new ArgumentOutOfRangeException(nameof(Variant), Variant, "Unknown Shadcn sheet close variant.")
        };

    private RenderFragment DefaultContent => builder =>
    {
        builder.OpenElement(0, "svg");
        builder.AddAttribute(1, "viewBox", "0 0 24 24");
        builder.AddAttribute(2, "aria-hidden", "true");
        builder.AddAttribute(3, "focusable", "false");
        builder.OpenElement(4, "path");
        builder.AddAttribute(5, "d", "M18 6 6 18M6 6l12 12");
        builder.AddAttribute(6, "fill", "none");
        builder.AddAttribute(7, "stroke", "currentColor");
        builder.AddAttribute(8, "stroke-linecap", "round");
        builder.AddAttribute(9, "stroke-linejoin", "round");
        builder.AddAttribute(10, "stroke-width", "2");
        builder.CloseElement();
        builder.CloseElement();
    };

    private IReadOnlyDictionary<string, object> Forwarded => AttributesExcept("data-slot", "data-variant", "type", "aria-label", "disabled");
    private async Task CloseAsync(MouseEventArgs args)
    {
        if (Disabled)
            return;

        await OnClick.InvokeAsync(args);
        await Context.Owner.SetOpenAsync(false);
    }
}
