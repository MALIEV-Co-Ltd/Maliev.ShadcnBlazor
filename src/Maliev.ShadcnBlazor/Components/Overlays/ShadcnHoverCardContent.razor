@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JavaScript
@if (Context.Owner.EffectiveOpen)
{
    <div @ref="_element"
         @attributes="Forwarded"
         id="@Context.ContentId"
         class="@MergeClass("shadcn-hover-card-content")"
         style="@MergeStyle(null)"
         data-slot="hover-card-content"
         data-state="open"
         data-side="@SideValue"
         data-align="@AlignValue"
         data-positioned="false">@ChildContent</div>
}

@code {
    [CascadingParameter] private ShadcnHoverCardContext Context { get; set; } = default!;
    [Parameter] public ShadcnOverlaySide Side { get; set; } = ShadcnOverlaySide.Bottom;
    [Parameter] public ShadcnOverlayAlign Align { get; set; } = ShadcnOverlayAlign.Center;
    [Parameter] public double SideOffset { get; set; } = 4;
    [Parameter] public double AlignOffset { get; set; } = 4;
    [Parameter] public double CollisionPadding { get; set; } = 8;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private ElementReference _element;
    private IJSObjectReference? _module;
    private DotNetObjectReference<ShadcnHoverCard>? _ownerRef;
    private bool _attached;
    private string SideValue => ShadcnPositionedOverlayValues.Side(Side);
    private string AlignValue => ShadcnPositionedOverlayValues.Align(Align);
    private IReadOnlyDictionary<string, object> Forwarded => AttributesExcept("id", "data-slot", "data-state", "data-side", "data-align", "data-positioned");

    protected override void OnParametersSet()
    {
        _ = SideValue;
        _ = AlignValue;
        ShadcnPositionedOverlayValues.ValidateOffset(SideOffset, nameof(SideOffset));
        ShadcnPositionedOverlayValues.ValidateOffset(AlignOffset, nameof(AlignOffset));
    }

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (!Context.Owner.EffectiveOpen) return;
        if (_attached && _module is not null && await _module.InvokeAsync<bool>("isPositionedAttached", _element)) return;
        if (_attached) await ResetAsync();
        _module = await JavaScript.InvokeAsync<IJSObjectReference>("import", "./_content/Maliev.ShadcnBlazor/js/shadcn-overlays-menus.js");
        _ownerRef = DotNetObjectReference.Create(Context.Owner);
        await _module.InvokeVoidAsync("attachPositioned", _element, Context.TriggerId, SideValue, AlignValue, SideOffset, AlignOffset, CollisionPadding, _ownerRef, true, true, false, Context.TriggerId, false);
        await _module.InvokeVoidAsync("attachHoverCardContent", _element, Context.TriggerId, _ownerRef, Context.Owner.CloseDelayMs);
        _attached = true;
    }

    private async ValueTask ResetAsync()
    {
        if (_module is not null) try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
        _ownerRef?.Dispose();
        _ownerRef = null;
        _module = null;
        _attached = false;
    }

    public async ValueTask DisposeAsync()
    {
        if (_attached && _module is not null)
        {
            try { await _module.InvokeVoidAsync("detachHoverCardContent", _element); await _module.InvokeVoidAsync("detachPositioned", _element); }
            catch (JSDisconnectedException) { }
        }
        await ResetAsync();
    }
}
