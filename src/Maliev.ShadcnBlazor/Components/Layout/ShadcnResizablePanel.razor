@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
@implements IDisposable
<div @attributes="ForwardedAttributes" class="@MergeClass("shadcn-resizable-panel")" style="@MergeStyle(PanelStyle)" data-slot="resizable-panel" data-panel-id="@Id">@ChildContent</div>
@code {
    [CascadingParameter] private ShadcnResizableContext Context { get; set; } = default!;
    [Parameter, EditorRequired] public string Id { get; set; } = string.Empty;
    [Parameter] public double MinimumSize { get; set; } = 10;
    [Parameter] public double MaximumSize { get; set; } = 100;
    [Parameter] public double DefaultSize { get; set; } = 50;
    [Parameter] public bool Collapsible { get; set; }
    [Parameter] public double CollapsedSize { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private string? _registeredId;
    private string PanelStyle => FormattableString.Invariant($"--shadcn-resizable-size: {Context.Owner.SizeAt(Context.IndexOf(Id)):0.###}%");
    private IReadOnlyDictionary<string, object> ForwardedAttributes => AttributesExcept("data-slot", "data-panel-id");
    protected override void OnInitialized() { Validate(); Context.Register(new(Id, MinimumSize, MaximumSize, DefaultSize, Collapsible, CollapsedSize)); _registeredId = Id; }
    protected override void OnParametersSet() { Validate(); if (_registeredId is not null) { Context.Update(_registeredId, new(Id, MinimumSize, MaximumSize, DefaultSize, Collapsible, CollapsedSize)); _registeredId = Id; } }
    private void Validate() { if (string.IsNullOrWhiteSpace(Id)) throw new ArgumentException("Resizable panel IDs cannot be empty.", nameof(Id)); if (!double.IsFinite(MinimumSize) || !double.IsFinite(MaximumSize) || MinimumSize < 0 || MaximumSize > 100 || MinimumSize > MaximumSize) throw new ArgumentOutOfRangeException(nameof(MinimumSize)); if (DefaultSize < MinimumSize || DefaultSize > MaximumSize) throw new ArgumentOutOfRangeException(nameof(DefaultSize)); if (CollapsedSize < 0 || CollapsedSize > MaximumSize) throw new ArgumentOutOfRangeException(nameof(CollapsedSize)); }
    public void Dispose() { if (_registeredId is not null) Context.Unregister(_registeredId); }
}
