@using System.Globalization
@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
@inject IServiceProvider IdAllocator

<CascadingValue Value="ProgressContext" IsFixed="true">
    <CascadingValue Value="ProgressVersion" Name="ShadcnProgressVersion">
        <div @attributes="ForwardedAttributes" class="@MergeClass("shadcn-progress")" style="@MergeStyle(null)" data-slot="progress" data-state="@ProgressContext.State" role="progressbar" aria-label="@Label" aria-labelledby="@(Label is null && ProgressContext.HasLabel ? ProgressContext.LabelId : null)" aria-valuemin="@Invariant(Minimum)" aria-valuemax="@Invariant(Maximum)" aria-valuenow="@(ClampedValue is null ? null : Invariant(ClampedValue.Value))" aria-valuetext="@(ClampedValue is null ? null : FormattedValue)">
            @if (ChildContent is not null) { @ChildContent }
            else if (Label is not null) { <ShadcnProgressLabel>@Label</ShadcnProgressLabel> }
            @if (ShowValue && ClampedValue is not null) { <ShadcnProgressValue>@FormattedValue</ShadcnProgressValue> }
            <ShadcnProgressTrack><ShadcnProgressIndicator /></ShadcnProgressTrack>
        </div>
    </CascadingValue>
</CascadingValue>

@code {
    [Parameter] public double Minimum { get; set; }
    [Parameter] public double Maximum { get; set; } = 100;
    [Parameter] public double? Value { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public bool ShowValue { get; set; }
    [Parameter] public Func<double, string>? ValueFormatter { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private ShadcnProgressContext ProgressContext = null!;
    private long ProgressVersion { get; set; }
    protected override void OnInitialized() => ProgressContext = new(IdAllocator.NextId("shadcn-progress-label"), () => _ = InvokeAsync(StateHasChanged));
    private double? ClampedValue => Value is null ? null : Math.Clamp(Value.Value, Minimum, Maximum);
    private double? Percent => ClampedValue is null ? null : (ClampedValue.Value - Minimum) / (Maximum - Minimum) * 100;
    private string FormattedValue => ValueFormatter?.Invoke(ClampedValue!.Value) ?? $"{Percent:0.#}%";
    private IReadOnlyDictionary<string, object> ForwardedAttributes => AttributesExcept("data-slot", "data-state", "role", "aria-label", "aria-labelledby", "aria-valuemin", "aria-valuemax", "aria-valuenow", "aria-valuetext");
    protected override void OnParametersSet()
    {
        if (!double.IsFinite(Minimum)) throw new ArgumentOutOfRangeException(nameof(Minimum));
        if (!double.IsFinite(Maximum) || Maximum <= Minimum) throw new ArgumentOutOfRangeException(nameof(Maximum));
        if (Value is not null && !double.IsFinite(Value.Value)) throw new ArgumentOutOfRangeException(nameof(Value));
        ProgressContext.Update(ClampedValue, Percent, ClampedValue is null ? string.Empty : FormattedValue);
        ProgressVersion++;
    }
    private static string Invariant(double value) => value.ToString("0.################", CultureInfo.InvariantCulture);
}
