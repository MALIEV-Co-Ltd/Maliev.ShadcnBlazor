@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase

<CascadingValue Value="Context" IsFixed="true">
    <div @attributes="ForwardedAttributes" class="@MergeClass("shadcn-collapsible")" style="@MergeStyle(null)" data-slot="collapsible" data-state="@(EffectiveOpen ? "open" : "closed")" data-disabled="@(Disabled ? "true" : null)">@ChildContent</div>
</CascadingValue>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private static long _nextId;
    private readonly string _id = $"shadcn-collapsible-{Interlocked.Increment(ref _nextId)}";
    private bool _effectiveOpen;
    private bool _lastParameterOpen;
    private bool _initialized;
    internal bool EffectiveOpen => _effectiveOpen;
    private ShadcnCollapsibleContext Context => new(this, $"{_id}-trigger", $"{_id}-content");
    private IReadOnlyDictionary<string, object> ForwardedAttributes => AttributesExcept("data-slot", "data-state", "data-disabled");

    protected override void OnParametersSet()
    {
        if (!_initialized || Open != _lastParameterOpen) _effectiveOpen = Open;
        _lastParameterOpen = Open;
        _initialized = true;
    }

    internal async ValueTask ToggleAsync()
    {
        if (Disabled) return;
        var next = !_effectiveOpen;
        if (OpenChanged.HasDelegate) await OpenChanged.InvokeAsync(next);
        else { _effectiveOpen = next; await InvokeAsync(StateHasChanged); }
    }
}
