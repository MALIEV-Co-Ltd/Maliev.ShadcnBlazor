@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnFocusableComponentBase

<button @ref="FocusElement" @attributes="ForwardedAttributes" class="@MergeClass("shadcn-collapsible-trigger")" style="@MergeStyle(null)" data-slot="collapsible-trigger" data-state="@(Context.Open ? "open" : "closed")" id="@Context.TriggerId" type="button" disabled="@Context.Owner.Disabled" aria-expanded="@(Context.Open ? "true" : "false")" aria-controls="@Context.ContentId" @onclick="ToggleAsync">@ChildContent</button>

@code {
    [CascadingParameter] private ShadcnCollapsibleContext Context { get; set; } = default!;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private IReadOnlyDictionary<string, object> ForwardedAttributes => AttributesExcept("data-slot", "data-state", "id", "type", "disabled", "aria-expanded", "aria-controls");
    private Task ToggleAsync() => Context.Owner.ToggleAsync().AsTask();
}
