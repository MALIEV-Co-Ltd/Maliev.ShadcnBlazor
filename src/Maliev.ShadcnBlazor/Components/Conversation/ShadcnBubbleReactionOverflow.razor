@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
@inject IShadcnIdAllocator IdAllocator

<span @attributes="ForwardedAttributes"
      class="@MergeClass("shadcn-bubble-reaction-overflow")"
      style="@MergeStyle(null)"
      data-slot="bubble-reaction-overflow"
      data-state="@(_expanded ? "open" : "closed")">
    @if (_expanded)
    {
        <span id="@ContentId" class="shadcn-bubble-reaction-overflow-content" data-slot="bubble-reaction-overflow-content">@ChildContent</span>
    }
    <button class="shadcn-bubble-reaction-overflow-trigger"
            data-slot="bubble-reaction-overflow-trigger"
            type="button"
            aria-label="@TriggerLabel"
            aria-expanded="@(_expanded ? "true" : "false")"
            aria-controls="@ContentId"
            @onclick="ToggleAsync">+@Count</button>
</span>

@code {
    [CascadingParameter] private ShadcnBubbleReactions? Owner { get; set; }
    [Parameter] public int Count { get; set; }
    [Parameter] public string? AccessibleName { get; set; }
    [Parameter] public bool DefaultExpanded { get; set; }
    [Parameter] public EventCallback<bool> ExpandedChanged { get; set; }
    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }

    private string ContentId = null!;
    private bool _expanded;
    private bool _initialized;
    private string TriggerLabel => AccessibleName ?? (_expanded ? $"Hide {Count} additional reactions" : $"Show {Count} more reactions");
    private IReadOnlyDictionary<string, object> ForwardedAttributes
        => AttributesExcept("data-slot", "data-state");

    protected override void OnInitialized() => ContentId = IdAllocator.NextId("shadcn-bubble-reaction-overflow");

    protected override void OnParametersSet()
    {
        if (Owner is null)
            throw new InvalidOperationException("ShadcnBubbleReactionOverflow must be inside ShadcnBubbleReactions.");
        if (!_initialized)
        {
            _expanded = DefaultExpanded;
            _initialized = true;
        }
        if (Count < 1)
            throw new ArgumentOutOfRangeException(nameof(Count), Count, "Reaction overflow count must be greater than zero.");
        if (ChildContent is null)
            throw new InvalidOperationException("ShadcnBubbleReactionOverflow requires additional reactions.");
    }

    private async Task ToggleAsync()
    {
        _expanded = !_expanded;
        await ExpandedChanged.InvokeAsync(_expanded);
    }
}
