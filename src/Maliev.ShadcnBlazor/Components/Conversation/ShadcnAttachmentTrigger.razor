@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
@if (Href is not null)
{ <a @attributes="ForwardedAttributes" class="@MergeClass("shadcn-attachment-trigger")" style="@MergeStyle(null)" data-slot="attachment-trigger" aria-label="@AccessibleName" href="@Href">@ChildContent</a> }
else
{ <button @attributes="ForwardedAttributes" class="@MergeClass("shadcn-attachment-trigger")" style="@MergeStyle(null)" data-slot="attachment-trigger" type="button" aria-label="@AccessibleName" aria-haspopup="@(DialogTarget is null?null:"dialog")" aria-controls="@DialogTarget" disabled="@Disabled" @onclick="HandleActivateAsync">@ChildContent</button> }
@code {
    [CascadingParameter] private ShadcnAttachment? Owner { get; set; }
    [Parameter, EditorRequired] public string? AccessibleName { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter] public string? DialogTarget { get; set; }
    [Parameter] public EventCallback OnActivate { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private IReadOnlyDictionary<string, object> ForwardedAttributes => AttributesExcept("data-slot", "type", "aria-label", "aria-haspopup", "aria-controls", "disabled", "href");
    protected override void OnParametersSet() { if (Owner is null) throw new InvalidOperationException("ShadcnAttachmentTrigger must be inside ShadcnAttachment."); if (string.IsNullOrWhiteSpace(AccessibleName)) throw new InvalidOperationException("Attachment triggers require an accessible name."); if (Href is not null && (OnActivate.HasDelegate || DialogTarget is not null || Disabled)) throw new InvalidOperationException("Link attachment triggers cannot also own button or dialog behavior."); if (DialogTarget is not null && string.IsNullOrWhiteSpace(DialogTarget)) throw new InvalidOperationException("Dialog targets must be non-empty."); }
    private Task HandleActivateAsync() => Disabled ? Task.CompletedTask : OnActivate.InvokeAsync();
}
