@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
<label @attributes="ForwardedAttributes" class="@MergeClass("shadcn-questionnaire-choice")" style="@MergeStyle(null)" data-slot="questionnaire-choice" data-checked="@(Checked?"true":"false")" data-disabled="@(Disabled?"true":null)"><input data-slot="questionnaire-choice-input" type="@(Owner!.Definition.Multiple?"checkbox":"radio")" name="@Owner.Name" value="@Value" checked="@Checked" disabled="@Disabled" aria-invalid="@(Owner.Invalid?"true":null)" aria-describedby="@Owner.Owner!.DescribedBy(Owner.Name!,Owner.Invalid)" aria-controls="@(Choice.Custom?Owner.Owner.IdFor(Owner.Name!,"custom-input"):null)" aria-expanded="@(Choice.Custom?(Checked?"true":"false"):null)" @onchange="Changed" /><span data-slot="questionnaire-choice-label">@ChildContent</span></label>
@code { [CascadingParameter] private ShadcnQuestionnaireItem? Owner{get;set;} [Parameter,EditorRequired] public string? Value{get;set;} [Parameter] public RenderFragment? ChildContent{get;set;} private ShadcnQuestionnaireChoiceDefinition Choice=>Owner!.Definition.Choices!.Single(choice=>choice.Value==Value); private bool Checked=>Owner!.Answer.SelectedValues.Contains(Value!,StringComparer.Ordinal); private bool Disabled=>Choice.Disabled||Owner!.Definition.Disabled; private IReadOnlyDictionary<string,object> ForwardedAttributes=>AttributesExcept("data-slot","data-checked","data-disabled"); protected override void OnParametersSet(){if(Owner is null||string.IsNullOrWhiteSpace(Value))throw new InvalidOperationException("QuestionnaireChoice requires an item and value.");_ = Choice;} private Task Changed(ChangeEventArgs args)=>Owner!.Owner!.ChoiceAsync(Owner.Name!,Value!,Owner.Definition.Multiple?args.Value as bool?==true:true); }
