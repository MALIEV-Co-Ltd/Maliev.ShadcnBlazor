@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
<span @attributes="ForwardedAttributes" class="@MergeClass("shadcn-marker-icon")" style="@MergeStyle(null)" data-slot="marker-icon" data-streaming="@(Owner?.Live == true ? "true" : null)" aria-hidden="true">@ChildContent</span>
@code { [CascadingParameter] private ShadcnMarker? Owner{get;set;} [Parameter] public RenderFragment? ChildContent{get;set;} private IReadOnlyDictionary<string,object> ForwardedAttributes=>AttributesExcept("data-slot","data-streaming","aria-hidden"); protected override void OnParametersSet(){if(Owner is null)throw new InvalidOperationException("ShadcnMarkerIcon must be inside ShadcnMarker.");} }
