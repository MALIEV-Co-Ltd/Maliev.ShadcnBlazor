@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
@if (Href is not null) { <a @attributes="ForwardedAttributes" class="@MergeClass("shadcn-bubble-content")" style="@MergeStyle(null)" data-slot="bubble-content" href="@Href">@ChildContent</a> }
else if (OnActivate.HasDelegate) { <button @attributes="ForwardedAttributes" class="@MergeClass("shadcn-bubble-content")" style="@MergeStyle(null)" data-slot="bubble-content" type="button" @onclick="OnActivate">@ChildContent</button> }
else { <div @attributes="ForwardedAttributes" class="@MergeClass("shadcn-bubble-content")" style="@MergeStyle(null)" data-slot="bubble-content">@ChildContent</div> }
@code { [CascadingParameter] private ShadcnBubble? Owner{get;set;} [Parameter] public string? Href{get;set;} [Parameter] public EventCallback OnActivate{get;set;} [Parameter] public RenderFragment? ChildContent{get;set;} private IReadOnlyDictionary<string,object> ForwardedAttributes=>AttributesExcept("data-slot","href","type"); protected override void OnParametersSet(){if(Owner is null)throw new InvalidOperationException("ShadcnBubbleContent must be inside ShadcnBubble.");if(Href is not null&&OnActivate.HasDelegate)throw new InvalidOperationException("Bubble content cannot be both a link and a button.");} }
