@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
<div @attributes="ForwardedAttributes" class="@MergeClass("shadcn-questionnaire-progress")" style="@MergeStyle(null)" data-slot="questionnaire-progress" role="progressbar" aria-label="@AccessibleName" aria-valuemin="1" aria-valuemax="@Owner!.State.Total" aria-valuenow="@Owner.State.Current">@if(ChildContent is null){<bdi data-slot="questionnaire-progress-value" dir="ltr">@Owner.State.Current / @Owner.State.Total</bdi>}else{@ChildContent}</div>
@code { [CascadingParameter] private ShadcnQuestionnaire? Owner{get;set;} [Parameter,EditorRequired] public string? AccessibleName{get;set;} [Parameter] public RenderFragment? ChildContent{get;set;} private IReadOnlyDictionary<string,object> ForwardedAttributes=>AttributesExcept("data-slot","role","aria-label","aria-valuemin","aria-valuemax","aria-valuenow"); protected override void OnParametersSet(){if(Owner is null||string.IsNullOrWhiteSpace(AccessibleName))throw new InvalidOperationException("QuestionnaireProgress requires a questionnaire and accessible name.");} }
