@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
<div @attributes="ForwardedAttributes" class="@MergeClass("shadcn-message")" style="@MergeStyle(null)" data-slot="message" data-align="@AlignValue"><CascadingValue Value="this" IsFixed="true">@ChildContent</CascadingValue></div>
@code { [Parameter] public ShadcnLogicalAlign Align{get;set;} [Parameter,EditorRequired] public RenderFragment? ChildContent{get;set;} private string AlignValue=>ShadcnConversationValues.Align(Align); private IReadOnlyDictionary<string,object> ForwardedAttributes=>AttributesExcept("data-slot","data-align"); protected override void OnParametersSet(){if(ChildContent is null)throw new InvalidOperationException("ShadcnMessage requires content.");if(!Enum.IsDefined(Align))throw new ArgumentOutOfRangeException(nameof(Align));} }
