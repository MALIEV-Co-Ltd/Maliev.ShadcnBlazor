@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
<div @attributes="ForwardedAttributes" class="@MergeClass("shadcn-bubble")" style="@MergeStyle(null)" data-slot="bubble" data-variant="@VariantValue" data-align="@AlignValue"><CascadingValue Value="this" IsFixed="true">@ChildContent</CascadingValue></div>
@code {
 [Parameter] public ShadcnBubbleVariant Variant { get; set; } = ShadcnBubbleVariant.Ghost;
 [Parameter] public ShadcnLogicalAlign Align { get; set; }
 [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }
 private string VariantValue => Variant switch { ShadcnBubbleVariant.Default=>"default",ShadcnBubbleVariant.Secondary=>"secondary",ShadcnBubbleVariant.Muted=>"muted",ShadcnBubbleVariant.Tinted=>"tinted",ShadcnBubbleVariant.Outline=>"outline",ShadcnBubbleVariant.Ghost=>"ghost",ShadcnBubbleVariant.Destructive=>"destructive",_=>throw new ArgumentOutOfRangeException(nameof(Variant))};
 private string AlignValue => ShadcnConversationValues.Align(Align);
 private IReadOnlyDictionary<string,object> ForwardedAttributes => AttributesExcept("data-slot","data-variant","data-align");
 protected override void OnParametersSet(){if(ChildContent is null)throw new InvalidOperationException("ShadcnBubble requires child content.");if(!Enum.IsDefined(Variant))throw new ArgumentOutOfRangeException(nameof(Variant));if(!Enum.IsDefined(Align))throw new ArgumentOutOfRangeException(nameof(Align));}
}
