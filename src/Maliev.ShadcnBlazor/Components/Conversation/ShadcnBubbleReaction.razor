@using Maliev.ShadcnBlazor.Components.Content
@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase

@if (IsInteractive)
{
    <button @attributes="ForwardedAttributes"
            type="button"
            class="@MergeClass("shadcn-bubble-reaction")"
            style="@MergeStyle(null)"
            data-slot="bubble-reaction"
            data-interactive="true"
            data-pressed="@PressedValue"
            aria-label="@InteractiveAccessibleName"
            aria-pressed="@PressedValue"
            disabled="@Disabled"
            @onclick="ToggleAsync">
        @ReactionVisual
        @if (Count is not null)
        {
            <span class="shadcn-bubble-reaction-count" data-slot="bubble-reaction-count" aria-hidden="true">@Count</span>
        }
    </button>
}
else
{
    <span @attributes="ForwardedAttributes"
          class="@MergeClass("shadcn-bubble-reaction")"
          style="@MergeStyle(null)"
          data-slot="bubble-reaction"
          role="img"
          aria-label="@AccessibleName">
        @ReactionVisual
        @if (Count is not null)
        {
            <span class="shadcn-bubble-reaction-count" data-slot="bubble-reaction-count" aria-hidden="true">@Count</span>
        }
    </span>
}

@code {
    [CascadingParameter] private ShadcnBubbleReactions? Owner { get; set; }
    [Parameter, EditorRequired] public string AccessibleName { get; set; } = string.Empty;
    [Parameter] public string? Source { get; set; }
    [Parameter, EditorRequired] public string Fallback { get; set; } = string.Empty;
    [Parameter] public int? Count { get; set; }
    [Parameter] public bool Pressed { get; set; }
    [Parameter] public EventCallback<bool> PressedChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private bool IsInteractive => PressedChanged.HasDelegate;
    private string PressedValue => Pressed ? "true" : "false";
    private string InteractiveAccessibleName => Count is int count ? $"{AccessibleName}, {count}" : AccessibleName;
    private RenderFragment ReactionVisual => builder =>
    {
        if (!string.IsNullOrWhiteSpace(Source))
        {
            builder.OpenComponent<ShadcnAvatar>(0);
            builder.AddAttribute(1, nameof(ShadcnAvatar.Size), ShadcnAvatarSize.Small);
            builder.AddAttribute(2, nameof(ShadcnAvatar.ChildContent), (RenderFragment)(avatar =>
            {
                avatar.OpenComponent<ShadcnAvatarImage>(0);
                avatar.AddAttribute(1, nameof(ShadcnAvatarImage.Source), Source);
                avatar.AddAttribute(2, nameof(ShadcnAvatarImage.Alt), string.Empty);
                avatar.CloseComponent();
                avatar.OpenComponent<ShadcnAvatarFallback>(3);
                avatar.AddAttribute(4, nameof(ShadcnAvatarFallback.ChildContent), (RenderFragment)(fallback => fallback.AddContent(0, Fallback)));
                avatar.CloseComponent();
            }));
            builder.CloseComponent();
            return;
        }

        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", "shadcn-bubble-reaction-value");
        builder.AddAttribute(2, "data-slot", "bubble-reaction-value");
        builder.AddAttribute(3, "aria-hidden", "true");
        builder.AddContent(4, Fallback);
        builder.CloseElement();
    };

    private IReadOnlyDictionary<string, object> ForwardedAttributes
        => AttributesExcept("type", "data-slot", "data-interactive", "data-pressed", "role", "aria-label", "aria-pressed", "disabled");

    private Task ToggleAsync() => PressedChanged.InvokeAsync(!Pressed);

    protected override void OnParametersSet()
    {
        if (Owner is null)
            throw new InvalidOperationException("ShadcnBubbleReaction must be inside ShadcnBubbleReactions.");
        if (string.IsNullOrWhiteSpace(AccessibleName))
            throw new InvalidOperationException("ShadcnBubbleReaction requires an accessible name describing the reactor and reaction.");
        if (string.IsNullOrWhiteSpace(Fallback))
            throw new InvalidOperationException("ShadcnBubbleReaction requires fallback content.");
        if (Count is < 0)
            throw new ArgumentOutOfRangeException(nameof(Count), "Reaction count cannot be negative.");
    }
}
