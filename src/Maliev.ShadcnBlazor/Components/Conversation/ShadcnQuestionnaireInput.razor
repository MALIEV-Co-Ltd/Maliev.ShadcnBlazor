@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
@if (Visible)
{
    <input @attributes="ForwardedAttributes" class="@MergeClass("shadcn-questionnaire-input")" style="@MergeStyle(null)" data-slot="questionnaire-input" data-custom="@(HasCustomChoice?"true":null)" id="@Owner!.Owner!.IdFor(Owner.Name!,"custom-input")" type="@Type" name="@Owner.Name" value="@Owner.Answer.InputValue" aria-label="@AccessibleName" aria-invalid="@(Owner.Invalid?"true":null)" aria-describedby="@Owner.Owner.DescribedBy(Owner.Name!,Owner.Invalid)" disabled="@Owner.Definition.Disabled" @oninput="Changed" />
}
@code { [CascadingParameter] private ShadcnQuestionnaireItem? Owner{get;set;} [Parameter] public string Type{get;set;}="text"; [Parameter,EditorRequired] public string? AccessibleName{get;set;} private IReadOnlyList<ShadcnQuestionnaireChoiceDefinition> Choices=>Owner!.Definition.Choices??Array.Empty<ShadcnQuestionnaireChoiceDefinition>();private bool HasCustomChoice=>Choices.Any(choice=>choice.Custom);private bool Visible=>!HasCustomChoice||Choices.Any(choice=>choice.Custom&&Owner!.Answer.SelectedValues.Contains(choice.Value,StringComparer.Ordinal));private IReadOnlyDictionary<string,object> ForwardedAttributes=>AttributesExcept("data-slot","data-custom","id","type","name","value","aria-label","aria-invalid","disabled"); protected override void OnParametersSet(){if(Owner is null||string.IsNullOrWhiteSpace(AccessibleName))throw new InvalidOperationException("QuestionnaireInput requires an item and accessible name.");if(!Owner.Definition.AllowsFreeform)throw new InvalidOperationException("QuestionnaireInput requires AllowsFreeform on its item definition.");} private Task Changed(ChangeEventArgs args)=>Owner!.Owner!.InputAsync(Owner.Name!,args.Value?.ToString()); }
