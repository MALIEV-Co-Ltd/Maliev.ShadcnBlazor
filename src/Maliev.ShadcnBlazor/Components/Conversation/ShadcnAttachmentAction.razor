@using Microsoft.AspNetCore.Components.Web
@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnFocusableComponentBase
<button @ref="FocusElement" @attributes="ForwardedAttributes" class="@MergeClass("shadcn-attachment-action")" style="@MergeStyle(null)" data-slot="attachment-action" data-action="@ActionValue" type="button" aria-label="@AccessibleName" disabled="@Disabled" @onclick="HandleActionAsync">@ChildContent</button>
@code {
    [CascadingParameter] private ShadcnAttachment? Owner { get; set; }
    [Parameter] public ShadcnAttachmentActionKind Action { get; set; }
    [Parameter, EditorRequired] public string? AccessibleName { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<ShadcnAttachmentActionKind> OnAction { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private string ActionValue => Action.ToString().ToLowerInvariant();
    private IReadOnlyDictionary<string, object> ForwardedAttributes => AttributesExcept("data-slot", "data-action", "type", "aria-label", "disabled");
    protected override void OnParametersSet() { if (Owner is null) throw new InvalidOperationException("ShadcnAttachmentAction must be inside ShadcnAttachment."); if (!Enum.IsDefined(Action) || Action is ShadcnAttachmentActionKind.None) throw new ArgumentOutOfRangeException(nameof(Action)); if (string.IsNullOrWhiteSpace(AccessibleName)) throw new InvalidOperationException("Attachment actions require an accessible name."); }
    private async Task HandleActionAsync() { if (Disabled) return; await Owner!.RequestStateAsync(Action switch { ShadcnAttachmentActionKind.Remove => ShadcnAttachmentState.Idle, ShadcnAttachmentActionKind.Retry => ShadcnAttachmentState.Uploading, _ => Owner.EffectiveState }); await OnAction.InvokeAsync(Action); }
}
