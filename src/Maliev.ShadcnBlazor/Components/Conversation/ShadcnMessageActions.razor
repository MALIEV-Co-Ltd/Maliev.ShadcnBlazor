@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase

<div @attributes="ForwardedAttributes" class="@MergeClass("shadcn-message-actions")" style="@MergeStyle(null)" data-slot="message-actions"><CascadingValue Value="this" IsFixed="true">@ChildContent</CascadingValue></div>

@code {
    [CascadingParameter] private ShadcnMessageFooter? Owner { get; set; }
    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }

    private IReadOnlyDictionary<string, object> ForwardedAttributes => AttributesExcept("data-slot");

    protected override void OnParametersSet()
    {
        if (Owner is null) throw new InvalidOperationException("ShadcnMessageActions must be inside ShadcnMessageFooter.");
        if (ChildContent is null) throw new InvalidOperationException("ShadcnMessageActions requires content.");
    }
}
