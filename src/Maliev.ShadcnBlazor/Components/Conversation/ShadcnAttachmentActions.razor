@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
<div @attributes="ForwardedAttributes" class="@MergeClass("shadcn-attachment-actions")" style="@MergeStyle(null)" data-slot="attachment-actions">@ChildContent</div>
