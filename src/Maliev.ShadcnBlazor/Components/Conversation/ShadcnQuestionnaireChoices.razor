@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
<div @attributes="ForwardedAttributes" class="@MergeClass("shadcn-questionnaire-choices")" style="@MergeStyle(null)" data-slot="questionnaire-choices" data-shortcuts="@ShortcutValue">@ChildContent</div>
@code { [CascadingParameter] private ShadcnQuestionnaireItem? Owner{get;set;} [Parameter,EditorRequired] public RenderFragment? ChildContent{get;set;} private string ShortcutValue=>Owner!.Owner!.ShortcutMode.ToString().ToLowerInvariant(); private IReadOnlyDictionary<string,object> ForwardedAttributes=>AttributesExcept("data-slot","data-shortcuts"); protected override void OnParametersSet(){if(Owner is null||ChildContent is null)throw new InvalidOperationException("QuestionnaireChoices requires an item and content.");} }
