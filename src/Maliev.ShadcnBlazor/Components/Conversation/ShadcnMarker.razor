@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
@if (Href is not null)
{ <a @attributes="ForwardedAttributes" class="@MergeClass("shadcn-marker")" style="@MergeStyle(null)" data-slot="marker" data-variant="@VariantValue" aria-label="@AccessibleName" href="@Href"><CascadingValue Value="this" IsFixed="true">@ChildContent</CascadingValue></a> }
else if (OnActivate.HasDelegate)
{ <button @attributes="ForwardedAttributes" class="@MergeClass("shadcn-marker")" style="@MergeStyle(null)" data-slot="marker" data-variant="@VariantValue" aria-label="@AccessibleName" type="button" disabled="@Disabled" @onclick="ActivateAsync"><CascadingValue Value="this" IsFixed="true">@ChildContent</CascadingValue></button> }
else
{ <div @attributes="ForwardedAttributes" class="@MergeClass("shadcn-marker")" style="@MergeStyle(null)" data-slot="marker" data-variant="@VariantValue" role="@(Live?"status":null)" aria-live="@(Live?"polite":null)"><CascadingValue Value="this" IsFixed="true">@ChildContent</CascadingValue></div> }
@code {
 [Parameter] public ShadcnMarkerVariant Variant{get;set;} [Parameter] public bool Live{get;set;} [Parameter] public string? Href{get;set;} [Parameter] public EventCallback OnActivate{get;set;} [Parameter] public string? AccessibleName{get;set;} [Parameter] public bool Disabled{get;set;} [Parameter,EditorRequired] public RenderFragment? ChildContent{get;set;}
 private string VariantValue=>Variant switch{ShadcnMarkerVariant.Default=>"default",ShadcnMarkerVariant.Separator=>"separator",ShadcnMarkerVariant.Border=>"border",_=>throw new ArgumentOutOfRangeException(nameof(Variant))};
 private IReadOnlyDictionary<string,object> ForwardedAttributes=>AttributesExcept("data-slot","data-variant","role","aria-live","aria-label","href","type","disabled");
 protected override void OnParametersSet(){if(ChildContent is null)throw new InvalidOperationException("ShadcnMarker requires content.");if(!Enum.IsDefined(Variant))throw new ArgumentOutOfRangeException(nameof(Variant));if(Href is not null&&OnActivate.HasDelegate)throw new InvalidOperationException("Marker cannot be both a link and a button.");if((Href is not null||OnActivate.HasDelegate)&&string.IsNullOrWhiteSpace(AccessibleName))throw new InvalidOperationException("Interactive markers require an accessible name.");if(Href is not null&&Disabled)throw new InvalidOperationException("Link markers cannot be disabled.");if(Live&&(Href is not null||OnActivate.HasDelegate))throw new InvalidOperationException("Live status markers cannot also be interactive.");}
 private Task ActivateAsync()=>Disabled?Task.CompletedTask:OnActivate.InvokeAsync();
}
