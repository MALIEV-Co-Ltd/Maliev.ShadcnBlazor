@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
<button @attributes="ForwardedAttributes" class="@MergeClass("shadcn-message-scroller-button")" style="@MergeStyle(null)" data-slot="message-scroller-button" data-direction="@DirectionValue" data-active="@ActiveValue" type="button" aria-label="@AccessibleName" disabled="@(!Active)" @onclick="HandleClickAsync">@ChildContent</button>
@code { [CascadingParameter] private ShadcnMessageScrollerProvider? Owner{get;set;} [Parameter] public ShadcnMessageScrollDirection Direction{get;set;}=ShadcnMessageScrollDirection.End; [Parameter] public ShadcnMessageScrollBehavior Behavior{get;set;}=ShadcnMessageScrollBehavior.Smooth; [Parameter,EditorRequired] public string? AccessibleName{get;set;} [Parameter] public RenderFragment? ChildContent{get;set;} private bool Active=>Direction is ShadcnMessageScrollDirection.Start?Owner?.State.Scrollable.Start==true:Owner?.State.Scrollable.End==true; private string ActiveValue=>Active?"true":"false"; private string DirectionValue=>Direction switch{ShadcnMessageScrollDirection.Start=>"start",ShadcnMessageScrollDirection.End=>"end",_=>throw new ArgumentOutOfRangeException(nameof(Direction))}; private IReadOnlyDictionary<string,object> ForwardedAttributes=>AttributesExcept("data-slot","data-direction","data-active","type","aria-label","disabled"); protected override void OnParametersSet(){if(Owner is null||string.IsNullOrWhiteSpace(AccessibleName))throw new InvalidOperationException("ShadcnMessageScrollerButton requires a provider and accessible name.");if(!Enum.IsDefined(Direction)||!Enum.IsDefined(Behavior))throw new ArgumentOutOfRangeException();} private Task HandleClickAsync()=>Owner!.ScrollAsync(Direction,Behavior); }
