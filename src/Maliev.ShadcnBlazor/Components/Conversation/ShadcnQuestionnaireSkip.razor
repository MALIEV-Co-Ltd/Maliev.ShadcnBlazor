@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
<button @attributes="ForwardedAttributes" class="@MergeClass("shadcn-questionnaire-navigation")" style="@MergeStyle(null)" data-slot="questionnaire-skip" type="button" hidden="@(Owner!.Definition(Owner.State.ActiveItemName).Required)" disabled="@Owner.Busy" @onclick="Owner.SkipAsync">@ChildContent</button>
@code { [CascadingParameter] private ShadcnQuestionnaire? Owner{get;set;} [Parameter] public RenderFragment? ChildContent{get;set;} private IReadOnlyDictionary<string,object> ForwardedAttributes=>AttributesExcept("data-slot","type","hidden","disabled"); protected override void OnParametersSet(){if(Owner is null)throw new InvalidOperationException("QuestionnaireSkip must be inside a questionnaire.");} }
