 private ShadcnQuestionnaireController? _controller; private IReadOnlyList<ShadcnQuestionnaireItemDefinition>? _lastItems;
 private IReadOnlyDictionary<string,ShadcnQuestionnaireAnswer>? _lastAnswers;
 private ElementReference _root; private IJSObjectReference? _module; private IJSObjectReference? _instance; private DotNetObjectReference<ShadcnQuestionnaire>? _reference; private string? _generatedId; private string? _focusPending; private bool _registrationsChanged; private readonly HashSet<string> _descriptions=new(StringComparer.Ordinal);private readonly HashSet<string> _errors=new(StringComparer.Ordinal);
 private sealed class PendingFieldMutation(Action mutation,TaskCompletionSource completion){public Action Mutation{get;set;}=mutation;public List<TaskCompletionSource> Completions{get;}=[completion];}
 private readonly Dictionary<string,PendingFieldMutation> _pendingFieldMutations=new(StringComparer.Ordinal);private bool _processingFieldMutations;
 public bool Busy{get;private set;} internal ShadcnQuestionnaireState State=>_controller!.State; internal ShadcnQuestionnaireShortcutMode ShortcutMode=>Shortcuts; private string RootId=>Id??_generatedId!;private string ShortcutValue=>Shortcuts.ToString().ToLowerInvariant();
