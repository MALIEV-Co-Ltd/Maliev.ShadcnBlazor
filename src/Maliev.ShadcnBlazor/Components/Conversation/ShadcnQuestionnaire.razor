 [Parameter] public ShadcnQuestionnaireValidateItem? ValidateItem{get;set;} [Parameter] public ShadcnQuestionnaireValidate? Validate{get;set;} [Parameter] public EventCallback<ShadcnQuestionnaireState> StateChanged{get;set;} [Parameter] public EventCallback<ShadcnQuestionnaireState> OnSubmit{get;set;}
 [Parameter] public string? Id{get;set;}
