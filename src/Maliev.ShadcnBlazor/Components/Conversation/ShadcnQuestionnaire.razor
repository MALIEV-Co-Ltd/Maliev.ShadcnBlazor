@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject Maliev.ShadcnBlazor.Components.DataDisplay.IShadcnIdAllocator IdAllocator
<form @ref="_root" @attributes="ForwardedAttributes" class="@MergeClass("shadcn-questionnaire")" style="@MergeStyle(null)" data-slot="questionnaire" data-shortcuts="@ShortcutValue" id="@RootId" aria-label="@AccessibleName" aria-busy="@(Busy?"true":null)" @onsubmit="HandleNativeSubmit" @onsubmit:preventDefault="true"><CascadingValue Value="this">@ChildContent</CascadingValue></form>
@code {
 [Parameter,EditorRequired] public IReadOnlyList<ShadcnQuestionnaireItemDefinition>? Items{get;set;}
 [Parameter] public string? DefaultItem{get;set;} [Parameter] public string? Item{get;set;} [Parameter] public EventCallback<string> ItemChanged{get;set;}
 [Parameter] public IReadOnlyDictionary<string,ShadcnQuestionnaireAnswer>? DefaultAnswers{get;set;} [Parameter] public ShadcnQuestionnaireShortcutMode Shortcuts{get;set;}
