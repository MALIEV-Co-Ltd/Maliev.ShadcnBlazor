 internal async Task SkipAsync(){if(Busy)return;Busy=true;StateHasChanged();try{_controller!.Skip(State.ActiveItemName);var result=await _controller.NextAsync();_focusPending=result.FocusItemName;await ChangedAsync();}finally{Busy=false;StateHasChanged();}}
 internal async Task PreviousAsync(){if(Busy)return;Busy=true;StateHasChanged();try{if(_controller!.Previous()){_focusPending=State.ActiveItemName;await ChangedAsync();}}finally{Busy=false;StateHasChanged();}}
 internal Task NextAsync()=>NextCoreAsync();
 internal Task SubmitAsync()=>SubmitCoreAsync();
 private async Task SubmitCoreAsync(){if(Busy)return;Busy=true;StateHasChanged();try{var result=await _controller!.NextAsync();if(result.Submitted&&Validate is not null){var errors=await Validate(State,CancellationToken.None);_controller.SetErrors(errors);var firstError=errors.Keys.FirstOrDefault();if(firstError is not null)_controller.SetActiveItem(firstError);result=result with{Submitted=errors.Count==0,Succeeded=errors.Count==0,FocusItemName=firstError};} _focusPending=result.FocusItemName;await ChangedAsync();if(result.Submitted)await OnSubmit.InvokeAsync(State);}finally{Busy=false;StateHasChanged();}}
 private async Task NextCoreAsync(){if(Busy)return;Busy=true;StateHasChanged();try{var result=await _controller!.NextAsync();_focusPending=result.FocusItemName;await ChangedAsync();}finally{Busy=false;StateHasChanged();}}
 private async Task MutateAsync(Action mutation){if(Busy)return;Busy=true;StateHasChanged();try{mutation();await ChangedAsync();}finally{Busy=false;StateHasChanged();}}
 private async Task QueueFieldMutationAsync(string key,Action mutation){var completion=new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);if(_pendingFieldMutations.TryGetValue(key,out var pending)){pending.Mutation=mutation;pending.Completions.Add(completion);}else _pendingFieldMutations[key]=new(mutation,completion);if(!_processingFieldMutations)_=ProcessFieldMutationsAsync();await completion.Task;}
 private async Task ProcessFieldMutationsAsync(){if(_processingFieldMutations)return;_processingFieldMutations=true;Busy=true;StateHasChanged();try{while(_pendingFieldMutations.Count>0){var pair=_pendingFieldMutations.First();_pendingFieldMutations.Remove(pair.Key);try{pair.Value.Mutation();await ChangedAsync();foreach(var completion in pair.Value.Completions)completion.TrySetResult();}catch(Exception exception){foreach(var completion in pair.Value.Completions)completion.TrySetException(exception);}}}finally{Busy=false;_processingFieldMutations=false;StateHasChanged();}}
 private async Task ChangedAsync(){if(AnswersChanged.HasDelegate)await AnswersChanged.InvokeAsync(State.Answers);if(Answers is not null)_controller!.SetAnswers(Answers,preserveErrors:true);if(ItemChanged.HasDelegate)await ItemChanged.InvokeAsync(State.ActiveItemName);await StateChanged.InvokeAsync(State);StateHasChanged();}
 public Task ResetAsync()=>MutateAsync(()=>{_controller!.Reset();_focusPending=State.ActiveItemName;});
 public Task ResumeAsync(string itemName,IReadOnlyDictionary<string,ShadcnQuestionnaireAnswer>? answers=null)=>MutateAsync(()=>{if(answers is not null)_controller!.SetAnswers(answers);_controller!.SetActiveItem(itemName);_focusPending=itemName;});
 [JSInvokable] public async Task OnShortcutAsync(int index){if(Busy||Shortcuts is ShadcnQuestionnaireShortcutMode.None)return;var definition=Definition(State.ActiveItemName);var choice=definition.Choices?.Where(candidate=>!candidate.Disabled).ElementAtOrDefault(index);if(choice is not null)await ChoiceAsync(definition.Name,choice.Value,true);}
 private Task HandleNativeSubmit()=>SubmitAsync();
 protected override async Task OnAfterRenderAsync(bool firstRender){if(firstRender){_module=await JS.InvokeAsync<IJSObjectReference>("import","./_content/Maliev.ShadcnBlazor/js/shadcn-questionnaire.js");_reference=DotNetObjectReference.Create(this);_instance=await _module.InvokeAsync<IJSObjectReference>("attach",_root,_reference);}if(_registrationsChanged){_registrationsChanged=false;await InvokeAsync(StateHasChanged);}if(!Busy&&_focusPending is not null&&_instance is not null){var item=_focusPending;_focusPending=null;await _instance.InvokeVoidAsync("focusItem",item);}}
 public async ValueTask DisposeAsync(){if(_instance is not null){try{await _instance.InvokeVoidAsync("dispose");await _instance.DisposeAsync();}catch(JSDisconnectedException){}}if(_module is not null){try{await _module.DisposeAsync();}catch(JSDisconnectedException){}}_reference?.Dispose();}
}
