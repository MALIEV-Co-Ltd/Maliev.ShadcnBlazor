 protected override void OnParametersSet(){if(Items is null||Items.Count==0||ChildContent is null||string.IsNullOrWhiteSpace(AccessibleName))throw new InvalidOperationException("Questionnaire requires items, accessible name, and content.");if(Item is not null&&!ItemChanged.HasDelegate)throw new InvalidOperationException("Controlled Questionnaire Item requires ItemChanged.");if(Answers is not null&&!AnswersChanged.HasDelegate)throw new InvalidOperationException("Controlled Questionnaire Answers requires AnswersChanged.");if(!Enum.IsDefined(Shortcuts))throw new ArgumentOutOfRangeException(nameof(Shortcuts));if(_controller is null){_controller=new(Items,Item??DefaultItem,Answers??DefaultAnswers,ValidateItem);_lastItems=Items;_lastAnswers=Answers;}else if(!ReferenceEquals(_lastItems,Items)){_controller.SetItems(Items);_lastItems=Items;}if(Answers is not null&&!ReferenceEquals(_lastAnswers,Answers)){_controller.SetAnswers(Answers);_lastAnswers=Answers;}if(Item is not null&&Item!=_controller.State.ActiveItemName)_controller.SetActiveItem(Item);}
 internal ShadcnQuestionnaireItemDefinition Definition(string name)=>Items!.Single(item=>item.Name==name);
 internal ShadcnQuestionnaireAnswer Answer(string name)=>State.Answers.GetValueOrDefault(name,ShadcnQuestionnaireAnswer.Empty); internal string? Error(string name)=>State.Errors.GetValueOrDefault(name);
 internal string IdFor(string name,string part)=>$"{RootId}-{name}-{part}";internal string? DescribedBy(string name,bool invalid){var ids=new List<string>();if(_descriptions.Contains(name))ids.Add(IdFor(name,"description"));if(invalid&&_errors.Contains(name))ids.Add(IdFor(name,"error"));return ids.Count==0?null:string.Join(' ',ids);}internal void RegisterDescription(string name){if(_descriptions.Add(name))_registrationsChanged=true;}internal void RegisterError(string name){if(_errors.Add(name))_registrationsChanged=true;}
