@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
<p @attributes="ForwardedAttributes" class="@MergeClass("shadcn-questionnaire-error")" style="@MergeStyle(null)" data-slot="questionnaire-error" id="@Owner!.ErrorId" role="alert" hidden="@(Error is null)">@(ChildContent is null?Error:null)@ChildContent</p>
@code { [CascadingParameter] private ShadcnQuestionnaireItem? Owner{get;set;} [Parameter] public RenderFragment? ChildContent{get;set;} private string? Error=>Owner!.Owner!.Error(Owner.Name!); private IReadOnlyDictionary<string,object> ForwardedAttributes=>AttributesExcept("data-slot","id","role","hidden"); protected override void OnParametersSet(){if(Owner is null)throw new InvalidOperationException("QuestionnaireError must be inside an item.");Owner.Owner!.RegisterError(Owner.Name!);} }
