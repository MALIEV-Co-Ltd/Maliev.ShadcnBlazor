@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
<div @attributes="ForwardedAttributes" class="@MergeClass("shadcn-bubble-reactions")" style="@MergeStyle(null)" data-slot="bubble-reactions" data-side="@SideValue" data-align="@AlignValue" role="@(AccessibleName is null?null:"img")" aria-label="@AccessibleName">@ChildContent</div>
@code { [CascadingParameter] private ShadcnBubble? Owner{get;set;} [Parameter] public ShadcnReactionSide Side{get;set;}=ShadcnReactionSide.Bottom; [Parameter] public ShadcnLogicalAlign Align{get;set;}=ShadcnLogicalAlign.End; [Parameter] public string? AccessibleName{get;set;} [Parameter] public RenderFragment? ChildContent{get;set;} private string SideValue=>Side switch{ShadcnReactionSide.Top=>"top",ShadcnReactionSide.Bottom=>"bottom",_=>throw new ArgumentOutOfRangeException(nameof(Side))}; private string AlignValue=>ShadcnConversationValues.Align(Align); private IReadOnlyDictionary<string,object> ForwardedAttributes=>AttributesExcept("data-slot","data-side","data-align","role","aria-label"); protected override void OnParametersSet(){if(Owner is null)throw new InvalidOperationException("ShadcnBubbleReactions must be inside ShadcnBubble.");if(!Enum.IsDefined(Side)||!Enum.IsDefined(Align))throw new ArgumentOutOfRangeException();} }
