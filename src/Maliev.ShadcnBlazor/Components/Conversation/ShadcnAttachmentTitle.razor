@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
<span @attributes="ForwardedAttributes" class="@MergeClass("shadcn-attachment-title")" style="@MergeStyle(null)" data-slot="attachment-title">@ChildContent</span>
@code { [CascadingParameter] private ShadcnAttachment? Owner { get; set; } [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; } private IReadOnlyDictionary<string, object> ForwardedAttributes => AttributesExcept("data-slot"); protected override void OnParametersSet() { if (Owner is null || ChildContent is null) throw new InvalidOperationException("ShadcnAttachmentTitle requires an attachment and content."); } }
