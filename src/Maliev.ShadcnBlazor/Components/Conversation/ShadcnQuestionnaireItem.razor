@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
<fieldset @attributes="ForwardedAttributes" class="@MergeClass("shadcn-questionnaire-item")" style="@MergeStyle(null)" data-slot="questionnaire-item" data-status="@StatusValue" name="@Name" disabled="@Definition.Disabled" hidden="@(!Active)" inert="@(!Active?string.Empty:null)" aria-invalid="@(Invalid?"true":null)" aria-describedby="@DescribedBy"><CascadingValue Value="this">@ChildContent</CascadingValue></fieldset>
@code { [CascadingParameter] internal ShadcnQuestionnaire? Owner{get;set;} [Parameter,EditorRequired] public string? Name{get;set;} [Parameter,EditorRequired] public RenderFragment? ChildContent{get;set;} internal ShadcnQuestionnaireItemDefinition Definition=>Owner!.Definition(Name!); internal ShadcnQuestionnaireAnswer Answer=>Owner!.Answer(Name!); internal bool Active=>Owner?.State.ActiveItemName==Name; internal bool Invalid=>Owner?.Error(Name!) is not null; internal string DescriptionId=>Owner!.IdFor(Name!,"description"); internal string ErrorId=>Owner!.IdFor(Name!,"error"); private string? DescribedBy=>Owner!.DescribedBy(Name!,Invalid); private string StatusValue=>Answer.Status.ToString().ToLowerInvariant(); private IReadOnlyDictionary<string,object> ForwardedAttributes=>AttributesExcept("data-slot","data-status","name","disabled","hidden","inert","aria-invalid","aria-describedby"); protected override void OnParametersSet(){if(Owner is null||string.IsNullOrWhiteSpace(Name)||ChildContent is null)throw new InvalidOperationException("QuestionnaireItem requires a questionnaire, stable name, and content.");_ = Definition;} }
