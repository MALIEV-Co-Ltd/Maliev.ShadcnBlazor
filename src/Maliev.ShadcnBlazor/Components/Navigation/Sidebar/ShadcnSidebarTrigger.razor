@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnFocusableComponentBase
@if (Context.Owner.CanToggleTarget(TargetId))
{
    <button @ref="FocusElement" @attributes="ForwardedAttributes" class="@MergeClass("shadcn-sidebar-trigger")" style="@MergeStyle(null)" data-slot="sidebar-trigger" data-target="@TargetId" type="button" aria-label="@Context.Owner.ToggleLabel" aria-expanded="@((Context.IsMobile ? Context.MobileOpen : Context.Open) ? "true" : "false")" aria-controls="@Context.Owner.ControlsFor(TargetId)" @onclick="ToggleAsync">@if (ChildContent is not null) { @ChildContent } else { <svg aria-hidden="true" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M9 3v18" /></svg> }</button>
}
@code { [CascadingParameter] private ShadcnSidebarContext Context { get; set; } = default!; [Parameter] public string? TargetId { get; set; } [Parameter] public RenderFragment? ChildContent { get; set; } private IReadOnlyDictionary<string, object> ForwardedAttributes => AttributesExcept("data-slot", "data-target", "type", "disabled", "aria-label", "aria-expanded", "aria-controls"); private Task ToggleAsync() => Context.Owner.ToggleAsync(TargetId).AsTask(); }
