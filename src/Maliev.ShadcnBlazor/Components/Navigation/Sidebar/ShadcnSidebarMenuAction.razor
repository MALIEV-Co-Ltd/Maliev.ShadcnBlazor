@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnFocusableComponentBase
<button @ref="FocusElement" @attributes="ForwardedAttributes" class="@MergeClass("shadcn-sidebar-menu-action")" style="@MergeStyle(null)" data-slot="sidebar-menu-action" data-show-on-hover="@(ShowOnHover ? "true" : null)" type="button" disabled="@Disabled" aria-label="@Label" @onclick="HandleClickAsync">@ChildContent</button>
@code { [Parameter] public bool ShowOnHover { get; set; } [Parameter] public bool Disabled { get; set; } [Parameter] public string? Label { get; set; } [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; } [Parameter] public RenderFragment? ChildContent { get; set; } private IReadOnlyDictionary<string, object> ForwardedAttributes => AttributesExcept("data-slot", "data-show-on-hover", "type", "disabled", "aria-label"); private Task HandleClickAsync(MouseEventArgs args) => Disabled ? Task.CompletedTask : OnClick.InvokeAsync(args); }
