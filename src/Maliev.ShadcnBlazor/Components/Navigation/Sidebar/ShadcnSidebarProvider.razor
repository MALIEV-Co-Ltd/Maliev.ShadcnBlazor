        if (firstRender) { _dotNet = DotNetObjectReference.Create(this); _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Maliev.ShadcnBlazor/js/shadcn-disclosure-navigation.js"); await _module.InvokeVoidAsync("attachSidebarProvider", Root, _dotNet, Shortcut); }
        if (!_loaded && StateStore is not null && StateKey is not null) { _loaded = true; try { var loaded = await StateStore.LoadAsync(StateKey); if (loaded.HasValue) { if (OpenChanged.HasDelegate) await OpenChanged.InvokeAsync(loaded.Value); else { _effectiveOpen = loaded.Value; await InvokeAsync(StateHasChanged); } } } catch (Exception error) { await OnPersistenceError.InvokeAsync(error); } }
    }
