@using Microsoft.JSInterop
@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JS
<CascadingValue Value="Context" IsFixed="true"><div @ref="Root" @attributes="ForwardedAttributes" class="@MergeClass("shadcn-sidebar-wrapper")" style="@MergeStyle(ProviderStyle)" data-slot="sidebar-wrapper" data-state="@(EffectiveOpen ? "expanded" : "collapsed")" data-device="@(IsMobile ? "mobile" : "desktop")">@ChildContent</div></CascadingValue>
@code {
    [Parameter] public bool Open { get; set; } = true;
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public bool MobileOpen { get; set; }
    [Parameter] public EventCallback<bool> MobileOpenChanged { get; set; }
    [Parameter] public string Width { get; set; } = "16rem";
    [Parameter] public string MobileWidth { get; set; } = "18rem";
    [Parameter] public string IconWidth { get; set; } = "3rem";
    [Parameter] public string Shortcut { get; set; } = "b";
    [Parameter] public string ToggleLabel { get; set; } = "Toggle sidebar";
    [Parameter] public string CloseLabel { get; set; } = "Close sidebar";
    [Parameter] public string? StateKey { get; set; }
    [Parameter] public IShadcnSidebarStateStore? StateStore { get; set; }
    [Parameter] public EventCallback<Exception> OnPersistenceError { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
