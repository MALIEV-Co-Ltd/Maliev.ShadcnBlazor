    internal void UnregisterSidebar(string id, object owner) { if (_sidebars.TryGetValue(id, out var existing) && ReferenceEquals(existing.Owner, owner)) _sidebars.Remove(id); }
    internal async ValueTask SetOpenAsync(bool value) { if (value == _effectiveOpen) return; if (OpenChanged.HasDelegate) await OpenChanged.InvokeAsync(value); else { _effectiveOpen = value; await InvokeAsync(StateHasChanged); } if (StateStore is not null && StateKey is not null) try { await StateStore.SaveAsync(StateKey, value); } catch (Exception error) { await OnPersistenceError.InvokeAsync(error); } }
    internal async ValueTask SetMobileOpenAsync(bool value) { if (value == _effectiveMobileOpen) return; if (MobileOpenChanged.HasDelegate) await MobileOpenChanged.InvokeAsync(value); else { _effectiveMobileOpen = value; await InvokeAsync(StateHasChanged); } }
