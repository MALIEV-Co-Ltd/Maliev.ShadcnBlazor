    internal ShadcnSidebarContext Context => new(this);
    private string ProviderStyle => $"--shadcn-sidebar-width: {Safe(Width, nameof(Width))}; --shadcn-sidebar-width-mobile: {Safe(MobileWidth, nameof(MobileWidth))}; --shadcn-sidebar-width-icon: {Safe(IconWidth, nameof(IconWidth))}";
    private IReadOnlyDictionary<string, object> ForwardedAttributes => AttributesExcept("data-slot", "data-state", "data-device");
    protected override void OnParametersSet()
    {
        _ = ProviderStyle;
        if (Shortcut.Length != 1 || char.IsControl(Shortcut[0])) throw new ArgumentOutOfRangeException(nameof(Shortcut), "Sidebar shortcut must be one printable character.");
        if ((StateStore is null) != string.IsNullOrWhiteSpace(StateKey)) throw new InvalidOperationException("Sidebar StateStore and StateKey must be supplied together.");
        if (!_initialized || Open != _lastOpen) _effectiveOpen = Open;
