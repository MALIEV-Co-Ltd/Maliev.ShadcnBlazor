    internal ValueTask ToggleAsync(string? id = null) => !CanToggleTarget(id) ? ValueTask.CompletedTask : IsMobile ? SetMobileOpenAsync(!_effectiveMobileOpen) : SetOpenAsync(!_effectiveOpen);
