@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
@if (Href is not null) { <a @attributes="ForwardedAttributes" class="@MergeClass("shadcn-sidebar-menu-sub-button")" style="@MergeStyle(null)" data-slot="sidebar-menu-sub-button" data-active="@(Active ? "true" : null)" href="@(Disabled ? null : Href)" aria-current="@(Active ? "page" : null)" aria-disabled="@(Disabled ? "true" : null)" tabindex="@(Disabled ? "-1" : null)">@ChildContent</a> }
else { <button @attributes="ForwardedAttributes" class="@MergeClass("shadcn-sidebar-menu-sub-button")" style="@MergeStyle(null)" data-slot="sidebar-menu-sub-button" data-active="@(Active ? "true" : null)" type="button" disabled="@Disabled" aria-current="@(Active ? "page" : null)">@ChildContent</button> }
@code { [Parameter] public string? Href { get; set; } [Parameter] public bool Active { get; set; } [Parameter] public bool Disabled { get; set; } [Parameter] public RenderFragment? ChildContent { get; set; } private IReadOnlyDictionary<string, object> ForwardedAttributes => AttributesExcept("data-slot", "data-active", "href", "type", "disabled", "aria-current", "aria-disabled", "tabindex"); }
