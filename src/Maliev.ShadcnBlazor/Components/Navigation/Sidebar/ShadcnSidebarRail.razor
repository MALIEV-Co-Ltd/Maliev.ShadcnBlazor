@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
<button @attributes="ForwardedAttributes" class="@MergeClass("shadcn-sidebar-rail")" style="@MergeStyle(null)" data-slot="sidebar-rail" data-target="@TargetId" type="button" disabled="@(!Context.Owner.CanToggleTarget(TargetId))" aria-label="@Context.Owner.ToggleLabel" tabindex="-1" @onclick="ToggleAsync"></button>
@code { [CascadingParameter] private ShadcnSidebarContext Context { get; set; } = default!; [Parameter] public string? TargetId { get; set; } private IReadOnlyDictionary<string, object> ForwardedAttributes => AttributesExcept("data-slot", "data-target", "type", "disabled", "aria-label", "tabindex"); private Task ToggleAsync() => Context.Owner.ToggleAsync(TargetId).AsTask(); }
