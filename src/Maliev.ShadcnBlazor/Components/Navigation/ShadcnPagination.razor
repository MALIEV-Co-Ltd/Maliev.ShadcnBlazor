@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
<nav @attributes="ForwardedAttributes" class="@MergeClass("shadcn-pagination")" style="@MergeStyle(null)" data-slot="pagination" role="navigation" aria-label="@Label">@ChildContent</nav>
@code { [Parameter] public string Label { get; set; } = "Pagination"; [Parameter] public RenderFragment? ChildContent { get; set; } private IReadOnlyDictionary<string, object> ForwardedAttributes => AttributesExcept("data-slot", "role", "aria-label"); }
