@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnFocusableComponentBase
@if (Href is not null) { <a @ref="FocusElement" @attributes="ForwardedAttributes" class="@MergeClass("shadcn-pagination-direction")" style="@MergeStyle(null)" data-slot="pagination-previous" href="@(Disabled ? null : Href)" aria-label="@Label" aria-disabled="@(Disabled ? "true" : null)" tabindex="@(Disabled ? "-1" : null)" @onclick="HandleClickAsync"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6" /></svg><span>@Label</span></a> }
else { <button @ref="FocusElement" @attributes="ForwardedAttributes" class="@MergeClass("shadcn-pagination-direction")" style="@MergeStyle(null)" data-slot="pagination-previous" type="button" disabled="@Disabled" aria-label="@Label" @onclick="HandleClickAsync"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6" /></svg><span>@Label</span></button> }
@code {
    [Parameter] public string? Href { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string Label { get; set; } = "Previous";
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    private IReadOnlyDictionary<string, object> ForwardedAttributes => AttributesExcept("data-slot", "href", "type", "disabled", "aria-label", "aria-disabled", "tabindex");
    private Task HandleClickAsync(MouseEventArgs args) => Disabled ? Task.CompletedTask : OnClick.InvokeAsync(args);
}
