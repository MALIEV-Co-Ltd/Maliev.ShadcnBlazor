@using Microsoft.JSInterop
@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
@implements IAsyncDisposable
@implements Maliev.ShadcnBlazor.Components.Primitives.IShadcnFocusable
@inject IJSRuntime JS

<CascadingValue Value="Context" IsFixed="true"><div @ref="_root" @attributes="ForwardedAttributes" class="@MergeClass("shadcn-tabs")" style="@MergeStyle(null)" data-slot="tabs" data-orientation="@OrientationValue" data-activation="@ActivationValue" data-loop="@(Loop ? "true" : "false")" data-disabled="@(Disabled ? "true" : null)">@ChildContent</div></CascadingValue>

@code {
    [CascadingParameter] private ShadcnContext? Shadcn { get; set; }
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public ShadcnTabsOrientation Orientation { get; set; } = ShadcnTabsOrientation.Horizontal;
    [Parameter] public ShadcnTabsActivationMode ActivationMode { get; set; } = ShadcnTabsActivationMode.Automatic;
    [Parameter] public bool Loop { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private string _effectiveValue = string.Empty;
    private string _lastParameterValue = string.Empty;
    private bool _initialized;
    private string? _lastRecoveryRequest;
    private IJSObjectReference? _module;
    private ElementReference _root;
    private string? _guardSignature;
    private ShadcnTabsContext Context { get; set; } = default!;
    internal string EffectiveValue => _effectiveValue;
    internal string FocusedValue { get; private set; } = string.Empty;
    internal bool IsRtl => Shadcn?.Direction == ShadcnDirection.RightToLeft;
    private string OrientationValue => Orientation == ShadcnTabsOrientation.Horizontal ? "horizontal" : "vertical";
    private string ActivationValue => ActivationMode == ShadcnTabsActivationMode.Automatic ? "automatic" : "manual";
    private IReadOnlyDictionary<string, object> ForwardedAttributes => AttributesExcept("data-slot", "data-orientation", "data-activation", "data-loop", "data-disabled");

    protected override void OnInitialized() => Context = new(this);
    protected override void OnParametersSet()
    {
        if (!Enum.IsDefined(Orientation)) throw new ArgumentOutOfRangeException(nameof(Orientation), Orientation, "Unknown tabs orientation.");
        if (!Enum.IsDefined(ActivationMode)) throw new ArgumentOutOfRangeException(nameof(ActivationMode), ActivationMode, "Unknown tabs activation mode.");
        if (string.IsNullOrWhiteSpace(Value)) throw new ArgumentException("Tabs require a non-empty value.", nameof(Value));
        if (!_initialized || !string.Equals(Value, _lastParameterValue, StringComparison.Ordinal))
        {
            _effectiveValue = Value;
            FocusedValue = Value;
        }
        _lastParameterValue = Value;
        _initialized = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var selected = Context.Items.FirstOrDefault(item => item.Value == _effectiveValue);
        if (selected is null || selected.Disabled)
        {
            var fallback = Context.Items.FirstOrDefault(item => !item.Disabled);
            if (fallback is not null && !string.Equals(_lastRecoveryRequest, fallback.Value, StringComparison.Ordinal))
            {
                _lastRecoveryRequest = fallback.Value;
                await ActivateAsync(fallback.Value, false, true);
            }
        }
        else
        {
            _lastRecoveryRequest = null;
        }

        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Maliev.ShadcnBlazor/js/shadcn-disclosure-navigation.js");
        var keys = Orientation == ShadcnTabsOrientation.Horizontal ? new[] { "Home", "End", "ArrowLeft", "ArrowRight" } : new[] { "Home", "End", "ArrowUp", "ArrowDown" };
        var signature = string.Join('|', keys);
        if (_guardSignature != signature) { if (_guardSignature is not null) await _module.InvokeVoidAsync("detachKeyGuard", _root); await _module.InvokeVoidAsync("attachKeyGuard", _root, keys, "[data-slot='tabs-trigger']", "[data-slot='tabs']"); _guardSignature = signature; }

    }

    internal async ValueTask ActivateAsync(string value, bool itemDisabled, bool force = false)
    {
        if (Disabled || itemDisabled || (!force && value == _effectiveValue)) return;
        FocusedValue = value;
        if (ValueChanged.HasDelegate) await ValueChanged.InvokeAsync(value);
        else { _effectiveValue = value; await InvokeAsync(StateHasChanged); }
    }

    internal async ValueTask SetFocusedValueAsync(string value, bool itemDisabled)
    {
        if (Disabled || itemDisabled || string.Equals(FocusedValue, value, StringComparison.Ordinal)) return;
        FocusedValue = value;
        await InvokeAsync(StateHasChanged);
    }

    internal async ValueTask HandleKeyAsync(string value, bool itemDisabled, string key)
    {
        if (Disabled || itemDisabled) return;
        if (ActivationMode == ShadcnTabsActivationMode.Manual && key is "Enter" or " ") return;
        var enabled = Context.Items.Where(item => !item.Disabled).ToArray();
        var current = Array.FindIndex(enabled, item => item.Value == value);
        var delta = key switch
        {
            "Home" => -int.MaxValue,
            "End" => int.MaxValue,
            "ArrowDown" when Orientation == ShadcnTabsOrientation.Vertical => 1,
            "ArrowUp" when Orientation == ShadcnTabsOrientation.Vertical => -1,
            "ArrowRight" when Orientation == ShadcnTabsOrientation.Horizontal => IsRtl ? -1 : 1,
            "ArrowLeft" when Orientation == ShadcnTabsOrientation.Horizontal => IsRtl ? 1 : -1,
            _ => 0
        };
        if (current < 0 || delta == 0 || enabled.Length == 0) return;
        var target = delta == -int.MaxValue ? 0 : delta == int.MaxValue ? enabled.Length - 1 : current + delta;
        target = Loop ? (target + enabled.Length) % enabled.Length : Math.Clamp(target, 0, enabled.Length - 1);
        await SetFocusedValueAsync(enabled[target].Value, false);
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Maliev.ShadcnBlazor/js/shadcn-disclosure-navigation.js");
        await _module.InvokeVoidAsync("focusById", enabled[target].TriggerId);
        if (ActivationMode == ShadcnTabsActivationMode.Automatic) await ActivateAsync(enabled[target].Value, false);
    }

    /// <summary>Focuses the selected tab, then the current roving tab, then the first enabled tab.</summary>
    public async ValueTask FocusAsync(bool preventScroll = false)
    {
        var enabled = Context.Items.Where(item => !Disabled && !item.Disabled).ToArray();
        var target = enabled.FirstOrDefault(item => item.Value == EffectiveValue)
            ?? enabled.FirstOrDefault(item => item.Value == FocusedValue)
            ?? enabled.FirstOrDefault();
        if (target is null) return;
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Maliev.ShadcnBlazor/js/shadcn-disclosure-navigation.js");
        await _module.InvokeVoidAsync("focusById", target.TriggerId, preventScroll);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("detachKeyGuard", _root);
            await _module.DisposeAsync();
        }
    }
}
