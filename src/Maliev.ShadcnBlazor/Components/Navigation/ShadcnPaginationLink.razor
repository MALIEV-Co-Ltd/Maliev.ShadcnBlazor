@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
@if (Href is not null)
{
    <a @attributes="ForwardedAttributes" class="@MergeClass("shadcn-pagination-link")" style="@MergeStyle(null)" data-slot="pagination-link" data-size="@SizeValue" data-current="@(Current ? "true" : null)" href="@(Disabled ? null : Href)" aria-current="@(Current ? "page" : null)" aria-disabled="@(Disabled ? "true" : null)" tabindex="@(Disabled ? "-1" : null)" @onclick="HandleClickAsync">@ChildContent</a>
}
else
{
    <button @attributes="ForwardedAttributes" class="@MergeClass("shadcn-pagination-link")" style="@MergeStyle(null)" data-slot="pagination-link" data-size="@SizeValue" data-current="@(Current ? "true" : null)" type="button" disabled="@Disabled" aria-current="@(Current ? "page" : null)" @onclick="HandleClickAsync">@ChildContent</button>
}
@code {
    [Parameter] public string? Href { get; set; }
    [Parameter] public bool Current { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public ShadcnPaginationLinkSize Size { get; set; } = ShadcnPaginationLinkSize.Icon;
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private string SizeValue => Size switch { ShadcnPaginationLinkSize.Default => "default", ShadcnPaginationLinkSize.Icon => "icon", _ => throw new ArgumentOutOfRangeException(nameof(Size), Size, "Unknown pagination link size.") };
    private IReadOnlyDictionary<string, object> ForwardedAttributes => AttributesExcept("data-slot", "data-size", "data-current", "href", "type", "disabled", "aria-current", "aria-disabled", "tabindex");
    private Task HandleClickAsync(MouseEventArgs args) => Disabled ? Task.CompletedTask : OnClick.InvokeAsync(args);
}
