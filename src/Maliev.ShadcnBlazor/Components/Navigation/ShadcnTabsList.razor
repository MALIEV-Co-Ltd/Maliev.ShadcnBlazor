@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
<div @attributes="ForwardedAttributes" class="@MergeClass("shadcn-tabs-list")" style="@MergeStyle(null)" data-slot="tabs-list" data-variant="@VariantValue" role="tablist" aria-label="@Label" aria-orientation="@OrientationValue">@ChildContent</div>
@code {
    [CascadingParameter] private ShadcnTabsContext Context { get; set; } = default!;
    [Parameter] public string? Label { get; set; }
    [Parameter] public ShadcnTabsListVariant Variant { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private string OrientationValue => Context.Owner.Orientation == ShadcnTabsOrientation.Horizontal ? "horizontal" : "vertical";
    private string VariantValue => Variant == ShadcnTabsListVariant.Default ? "default" : "line";
    private IReadOnlyDictionary<string, object> ForwardedAttributes => AttributesExcept("data-slot", "data-variant", "role", "aria-label", "aria-orientation");

    protected override void OnParametersSet()
    {
        if (!Enum.IsDefined(Variant)) throw new ArgumentOutOfRangeException(nameof(Variant), Variant, "Unknown tabs list variant.");
    }
}
