@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase

<nav @attributes="ForwardedAttributes" class="@MergeClass("shadcn-breadcrumb")" style="@MergeStyle(null)" data-slot="breadcrumb" aria-label="@Label">@ChildContent</nav>

@code {
    [Parameter] public string Label { get; set; } = "Breadcrumb";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private IReadOnlyDictionary<string, object> ForwardedAttributes => AttributesExcept("data-slot", "aria-label");
}
