@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
@if (Href is not null) { <a @attributes="ForwardedAttributes" class="@MergeClass("shadcn-pagination-direction")" style="@MergeStyle(null)" data-slot="pagination-next" href="@(Disabled ? null : Href)" aria-label="@Label" aria-disabled="@(Disabled ? "true" : null)" tabindex="@(Disabled ? "-1" : null)" @onclick="HandleClickAsync"><span>@Label</span><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6" /></svg></a> }
else { <button @attributes="ForwardedAttributes" class="@MergeClass("shadcn-pagination-direction")" style="@MergeStyle(null)" data-slot="pagination-next" type="button" disabled="@Disabled" aria-label="@Label" @onclick="HandleClickAsync"><span>@Label</span><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6" /></svg></button> }
@code {
    [Parameter] public string? Href { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string Label { get; set; } = "Next";
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    private IReadOnlyDictionary<string, object> ForwardedAttributes => AttributesExcept("data-slot", "href", "type", "disabled", "aria-label", "aria-disabled", "tabindex");
    private Task HandleClickAsync(MouseEventArgs args) => Disabled ? Task.CompletedTask : OnClick.InvokeAsync(args);
}
