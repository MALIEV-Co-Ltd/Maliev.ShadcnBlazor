@typeparam TValue
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inherits ShadcnFormComponentBase<TValue>

<div class="@MergeClass("shadcn-native-select-wrapper")" style="@MergeStyle()" data-slot="native-select-wrapper" data-size="@SizeValue" data-readonly="@(ReadOnly ? "true" : null)" data-disabled="@(EffectiveDisabled ? "true" : null)">
    <select @ref="SelectElement" @attributes="ForwardedAttributes"
            class="@MergeClass("shadcn-native-select", ControlClass)"
            style="@MergeStyle(ControlStyle)"
            data-slot="native-select"
            data-size="@SizeValue"
            name="@Name"
            value="@CurrentValueAsString"
            disabled="@EffectiveDisabled"
            required="@Required"
            aria-readonly="@(ReadOnly ? "true" : null)"
            aria-invalid="@(EffectiveInvalid ? "true" : null)"
            aria-describedby="@DescribedBy"
            @onchange="HandleChangeAsync">
        @ChildContent
    </select>
    <svg class="shadcn-native-select-icon" data-slot="native-select-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
</div>

@code {
    [Parameter] public ShadcnControlSize Size { get; set; } = ShadcnControlSize.Default;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? ControlClass { get; set; }
    [Parameter] public string? ControlStyle { get; set; }
    private ElementReference SelectElement;
    private IJSObjectReference? Module;

    private string SizeValue => Size switch
    {
        ShadcnControlSize.Default => "default",
        ShadcnControlSize.Small => "sm",
        _ => throw new ArgumentOutOfRangeException(nameof(Size), Size, "Unknown Shadcn control size.")
    };
    private IReadOnlyDictionary<string, object> ForwardedAttributes => AttributesExcept(
        "data-slot", "data-size", "name", "value", "disabled", "required", "aria-readonly", "aria-invalid", "aria-describedby");

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        _ = SizeValue;
    }

    private async Task HandleChangeAsync(ChangeEventArgs args)
    {
        if (ReadOnly)
        {
            Module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Maliev.ShadcnBlazor/js/shadcn-forms.js");
            await Module.InvokeVoidAsync("restoreSelectValue", SelectElement, CurrentValueAsString);
            return;
        }
        await SetCurrentValueFromStringAsync(args.Value?.ToString());
    }

    public async ValueTask DisposeAsync()
    {
        Dispose();
        if (Module is not null) try { await Module.DisposeAsync(); } catch (JSDisconnectedException) { }
    }
}
