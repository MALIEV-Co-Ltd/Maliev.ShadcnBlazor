@using System.Globalization
@using Maliev.ShadcnBlazor.Theming
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase

<div @ref="Root" @attributes="ForwardedAttributes" class="@MergeClass("shadcn-calendar")" style="@MergeStyle(null)" data-slot="calendar" dir="@DirectionValue" aria-invalid="@(Invalid ? "true" : null)">
    <div class="shadcn-calendar-nav" data-slot="calendar-nav">
        <button type="button" data-slot="calendar-previous" aria-label="@PreviousLabel" disabled="@(!CanNavigatePrevious || Disabled)" @onclick="PreviousAsync"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6" /></svg></button>
        @if (CaptionLayout == ShadcnCalendarCaptionLayout.Label)
        {
            <div class="shadcn-calendar-caption" data-slot="calendar-caption" aria-live="polite">@MonthLabel</div>
        }
        else
        {
            <div class="shadcn-calendar-dropdowns" data-slot="calendar-caption" aria-label="@MonthLabel">
                <div class="shadcn-calendar-dropdown" data-slot="calendar-month-select">
                    <ShadcnSelect TValue="int" Value="EffectiveMonth.Month" ValueChanged="ChangeMonthAsync" Options="MonthOptions" Size="ShadcnControlSize.Small" Disabled="Disabled" ReadOnly="ReadOnly" aria-label="@MonthSelectLabel" />
                </div>
                <div class="shadcn-calendar-dropdown" data-slot="calendar-year-select">
                    <ShadcnSelect TValue="int" Value="EffectiveMonth.Year" ValueChanged="ChangeYearAsync" Options="YearOptions" Size="ShadcnControlSize.Small" Disabled="Disabled" ReadOnly="ReadOnly" aria-label="@YearSelectLabel" />
                </div>
            </div>
        }
        <button type="button" data-slot="calendar-next" aria-label="@NextLabel" disabled="@(!CanNavigateNext || Disabled)" @onclick="NextAsync"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6" /></svg></button>
    </div>
    <div class="shadcn-calendar-grid" role="grid" aria-label="@MonthLabel" aria-multiselectable="@(Mode == ShadcnCalendarSelectionMode.Range ? "true" : null)" aria-readonly="@(ReadOnly ? "true" : null)" aria-disabled="@(Disabled ? "true" : null)" data-slot="calendar-grid">
        <div class="shadcn-calendar-weekdays" role="row">
            @if (ShowWeekNumbers) { <div class="shadcn-calendar-week-number" role="columnheader" aria-label="@WeekLabel" data-slot="calendar-week-number-header">#</div> }
            @foreach (var weekday in Weekdays) { <div class="shadcn-calendar-weekday" role="columnheader" data-slot="calendar-weekday"><abbr dir="auto" title="@weekday.Full">@weekday.Short</abbr></div> }
        </div>
        @foreach (var week in Weeks)
        {
            <div class="shadcn-calendar-week" role="row" data-slot="calendar-week">
                @if (ShowWeekNumbers) { <div class="shadcn-calendar-week-number" role="rowheader">@WeekNumber(week[0])</div> }
                @foreach (var date in week)
                {
                    var outside = date.Month != EffectiveMonth.Month;
                    var disabled = IsDisabled(date);
                    <div class="shadcn-calendar-day" role="gridcell" data-slot="calendar-cell" data-outside="@(outside ? "true" : null)" data-selected="@(IsSelected(date) ? "true" : null)" data-range-start="@(IsRangeStart(date) ? "true" : null)" data-range-middle="@(IsRangeMiddle(date) ? "true" : null)" data-range-end="@(IsRangeEnd(date) ? "true" : null)" data-range-complete="@(IsCompletedRangeDate(date) ? "true" : "false")" aria-selected="@IsSelected(date).ToString().ToLowerInvariant()">
                        @if (ShowOutsideDays || !outside)
                        {
                            <button class="shadcn-calendar-day-button" type="button" data-slot="calendar-day" data-day="@date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" data-today="@(date == Today ? "true" : null)" data-outside="@(outside ? "true" : null)" data-selected-single="@(Mode == ShadcnCalendarSelectionMode.Single && IsSelected(date) ? "true" : null)" data-invalid="@(Invalid && IsSelected(date) ? "true" : null)" data-range-start="@(IsRangeStart(date) ? "true" : null)" data-range-middle="@(IsRangeMiddle(date) ? "true" : null)" data-range-end="@(IsRangeEnd(date) ? "true" : null)" data-range-complete="@(IsCompletedRangeDate(date) ? "true" : "false")" aria-label="@date.ToString("dddd, d MMMM yyyy", Culture)" aria-current="@(date == Today ? "date" : null)" aria-invalid="@(Invalid && IsSelected(date) ? "true" : null)" aria-disabled="@(disabled ? "true" : null)" disabled="@(Disabled || disabled)" tabindex="@(date == FocusedDate && !disabled ? "0" : "-1")" @onclick="() => SelectAsync(date)" @onkeydown="args => HandleKeyDownAsync(date, args)">@date.Day</button>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    [CascadingParameter] private ShadcnContext ThemeContext { get; set; }
    [Parameter] public ShadcnCalendarSelectionMode Mode { get; set; } = ShadcnCalendarSelectionMode.Single;
    [Parameter] public ShadcnCalendarCaptionLayout CaptionLayout { get; set; } = ShadcnCalendarCaptionLayout.Label;
    [Parameter] public int? FromYear { get; set; }
    [Parameter] public int? ToYear { get; set; }
    [Parameter] public DateOnly? Value { get; set; }
    [Parameter] public EventCallback<DateOnly?> ValueChanged { get; set; }
    [Parameter] public ShadcnDateRange? Range { get; set; }
    [Parameter] public EventCallback<ShadcnDateRange?> RangeChanged { get; set; }
    [Parameter] public DateOnly VisibleMonth { get; set; } = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    [Parameter] public EventCallback<DateOnly> VisibleMonthChanged { get; set; }
    [Parameter] public DateOnly Today { get; set; } = DateOnly.FromDateTime(DateTime.Today);
    [Parameter] public CultureInfo Culture { get; set; } = CultureInfo.CurrentCulture;
    [Parameter] public DayOfWeek? FirstDayOfWeek { get; set; }
    [Parameter] public bool ShowOutsideDays { get; set; } = true;
    [Parameter] public bool ShowWeekNumbers { get; set; }
    [Parameter] public DateOnly? Min { get; set; }
    [Parameter] public DateOnly? Max { get; set; }
    [Parameter] public Func<DateOnly, bool>? IsDateDisabled { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Invalid { get; set; }
    [Parameter] public ShadcnDirection? Direction { get; set; }
    [Parameter] public string PreviousLabel { get; set; } = "Previous month";
    [Parameter] public string NextLabel { get; set; } = "Next month";
    [Parameter] public string WeekLabel { get; set; } = "Week";
    [Parameter] public string MonthSelectLabel { get; set; } = "Month";
    [Parameter] public string YearSelectLabel { get; set; } = "Year";
    [Parameter] public bool UseCultureCalendarYears { get; set; } = true;
    private DateOnly FocusedDate;
    private ElementReference Root;
    private IJSObjectReference? Module;
    private DateOnly? LastValue;
    private ShadcnDateRange? LastRange;
    private DateOnly LastVisibleMonth;
    private DateOnly _uncontrolledVisibleMonth;
    private DateOnly _lastVisibleMonthParameter;
    private bool _visibleMonthInitialized;
    private DateOnly? _uncontrolledValue;
    private DateOnly? _lastValueParameter;
    private bool _valueInitialized;
    private ShadcnDateRange? _uncontrolledRange;
    private ShadcnDateRange? _lastRangeParameter;
    private bool _rangeInitialized;
    private DateOnly? PendingFocus;
    private DateOnly? EffectiveValue => ValueChanged.HasDelegate ? Value : _uncontrolledValue;
    private ShadcnDateRange? EffectiveRange => RangeChanged.HasDelegate ? Range : _uncontrolledRange;
    private DateOnly EffectiveVisibleMonth => VisibleMonthChanged.HasDelegate ? NormalizeMonth(VisibleMonth) : _uncontrolledVisibleMonth;
    private DateOnly EffectiveMonth => NormalizeMonth(EffectiveVisibleMonth);
    private DayOfWeek EffectiveFirstDay => FirstDayOfWeek ?? Culture.DateTimeFormat.FirstDayOfWeek;
    private ShadcnDirection EffectiveDirection => Direction ?? ThemeContext.Direction;
    private string DirectionValue => EffectiveDirection switch { ShadcnDirection.LeftToRight => "ltr", ShadcnDirection.RightToLeft => "rtl", _ => throw new ArgumentOutOfRangeException(nameof(Direction), EffectiveDirection, "Unknown direction.") };
    private string MonthLabel => EffectiveMonth.ToString("MMMM yyyy", Culture);
    private int EffectiveFromYear => FromYear ?? Min?.Year ?? EffectiveMonth.Year - 100;
    private int EffectiveToYear => ToYear ?? Max?.Year ?? EffectiveMonth.Year + 100;
    private IReadOnlyList<ShadcnSelectOption<int>> MonthOptions => Enumerable.Range(1, 12).Select(month => new ShadcnSelectOption<int>(month, Culture.DateTimeFormat.GetMonthName(month))).ToArray();
    private IReadOnlyList<ShadcnSelectOption<int>> YearOptions => Enumerable.Range(EffectiveFromYear, EffectiveToYear - EffectiveFromYear + 1).Select(year => new ShadcnSelectOption<int>(year, FormatYear(year))).ToArray();
    private IReadOnlyDictionary<string, object> ForwardedAttributes => AttributesExcept("class", "style", "data-slot", "dir", "aria-invalid");
    private IReadOnlyList<(string Short, string Full)> Weekdays => Enumerable.Range(0, 7).Select(offset => (DayOfWeek)(((int)EffectiveFirstDay + offset) % 7)).Select(day => (Culture.DateTimeFormat.GetShortestDayName(day), Culture.DateTimeFormat.GetDayName(day))).ToArray();
    private IReadOnlyList<DateOnly[]> Weeks { get { var offset = ((int)EffectiveMonth.DayOfWeek - (int)EffectiveFirstDay + 7) % 7; var start = EffectiveMonth.AddDays(-offset); return Enumerable.Range(0, 6).Select(week => Enumerable.Range(0, 7).Select(day => start.AddDays(week * 7 + day)).ToArray()).ToArray(); } }
    private bool CanNavigatePrevious => Min is null || EffectiveMonth.AddDays(-1) >= Min.Value;
    private bool CanNavigateNext => Max is null || EffectiveMonth.AddMonths(1) <= Max.Value;
    protected override void OnParametersSet()
    {
        base.OnParametersSet(); _ = DirectionValue;
        var incomingVisibleMonth = NormalizeMonth(VisibleMonth);
        if (!_visibleMonthInitialized || VisibleMonthChanged.HasDelegate || incomingVisibleMonth != _lastVisibleMonthParameter)
            _uncontrolledVisibleMonth = incomingVisibleMonth;
        _lastVisibleMonthParameter = incomingVisibleMonth;
        _visibleMonthInitialized = true;
        if (!_valueInitialized || ValueChanged.HasDelegate || Value != _lastValueParameter)
            _uncontrolledValue = Value;
        _lastValueParameter = Value;
        _valueInitialized = true;
        if (!_rangeInitialized || RangeChanged.HasDelegate || !Equals(Range, _lastRangeParameter))
            _uncontrolledRange = Range;
        _lastRangeParameter = Range;
        _rangeInitialized = true;
        if (Min > Max) throw new ArgumentException("Min cannot be later than Max.");
        if (EffectiveRange?.End is not null && EffectiveRange.End.Value < EffectiveRange.Start) throw new ArgumentException("Range end cannot be earlier than range start.", nameof(Range));
        if (EffectiveFromYear > EffectiveToYear) throw new ArgumentException("FromYear cannot be later than ToYear.");
        if (FocusedDate == default || EffectiveValue != LastValue || !Equals(EffectiveRange, LastRange) || EffectiveMonth != LastVisibleMonth || !IsVisibleEnabled(FocusedDate))
        {
            var candidate = PendingFocus is not null && PendingFocus.Value.Year == EffectiveMonth.Year && PendingFocus.Value.Month == EffectiveMonth.Month ? PendingFocus.Value
                : EffectiveValue is not null && EffectiveValue.Value.Year == EffectiveMonth.Year && EffectiveValue.Value.Month == EffectiveMonth.Month ? EffectiveValue.Value
                : EffectiveRange?.Start is not null && EffectiveRange.Start.Year == EffectiveMonth.Year && EffectiveRange.Start.Month == EffectiveMonth.Month ? EffectiveRange.Start
                : Today.Year == EffectiveMonth.Year && Today.Month == EffectiveMonth.Month ? Today : EffectiveMonth;
            FocusedDate = FindEnabledInMonth(candidate);
        }
        LastValue = EffectiveValue; LastRange = EffectiveRange; LastVisibleMonth = EffectiveMonth;
    }
    private bool IsVisibleEnabled(DateOnly date)
    {
        var grid = Weeks;
        return date >= grid[0][0] && date <= grid[^1][^1] && !IsDisabled(date);
    }
    private DateOnly FindEnabledInMonth(DateOnly candidate)
    {
        var monthStart = EffectiveMonth;
        var monthEnd = EffectiveMonth.AddMonths(1).AddDays(-1);
        var lower = Min is not null && Min.Value > monthStart ? Min.Value : monthStart;
        var upper = Max is not null && Max.Value < monthEnd ? Max.Value : monthEnd;
        if (lower > upper) return FindEnabled(candidate, 1);
        var origin = candidate < lower ? lower : candidate > upper ? upper : candidate;
        if (!IsDisabled(origin)) return origin;
        var days = upper.DayNumber - lower.DayNumber;
        for (var distance = 1; distance <= days; distance++)
        {
            var next = origin.AddDays(distance);
            if (next <= upper && !IsDisabled(next)) return next;
            var previous = origin.AddDays(-distance);
            if (previous >= lower && !IsDisabled(previous)) return previous;
        }
        return FindEnabled(candidate, 1);
    }
    private bool IsDisabled(DateOnly date) => date < Min || date > Max || IsDateDisabled?.Invoke(date) == true;
    private bool IsSelected(DateOnly date) => Mode == ShadcnCalendarSelectionMode.Single ? EffectiveValue == date : EffectiveRange is not null && date >= EffectiveRange.Start && date <= (EffectiveRange.End ?? EffectiveRange.Start);
    private bool IsRangeStart(DateOnly date) => Mode == ShadcnCalendarSelectionMode.Range && EffectiveRange?.Start == date;
    private bool IsRangeEnd(DateOnly date) => Mode == ShadcnCalendarSelectionMode.Range && EffectiveRange?.End == date;
    private bool IsRangeMiddle(DateOnly date) => Mode == ShadcnCalendarSelectionMode.Range && EffectiveRange?.End is not null && date > EffectiveRange.Start && date < EffectiveRange.End;
    private bool IsCompletedRangeDate(DateOnly date) => Mode == ShadcnCalendarSelectionMode.Range && EffectiveRange?.End is not null && date >= EffectiveRange.Start && date <= EffectiveRange.End;
    private int WeekNumber(DateOnly date) => Culture.Calendar.GetWeekOfYear(date.ToDateTime(TimeOnly.MinValue), Culture.DateTimeFormat.CalendarWeekRule, EffectiveFirstDay);
    private async Task PreviousAsync() { if (CanNavigatePrevious && !Disabled) await SetVisibleMonthAsync(EffectiveMonth.AddMonths(-1)); }
    private async Task NextAsync() { if (CanNavigateNext && !Disabled) await SetVisibleMonthAsync(EffectiveMonth.AddMonths(1)); }
    private async Task ChangeMonthAsync(int month) { if (!Disabled && !ReadOnly && month is >= 1 and <= 12) await SetVisibleMonthAsync(new(EffectiveMonth.Year, month, 1)); }
    private async Task ChangeYearAsync(int year) { if (!Disabled && !ReadOnly && year >= EffectiveFromYear && year <= EffectiveToYear) await SetVisibleMonthAsync(new(year, EffectiveMonth.Month, 1)); }
    private async Task SetVisibleMonthAsync(DateOnly month)
    {
        var normalized = NormalizeMonth(month);
        if (VisibleMonthChanged.HasDelegate)
        {
            await VisibleMonthChanged.InvokeAsync(normalized);
            return;
        }

        if (_uncontrolledVisibleMonth == normalized) return;
        _uncontrolledVisibleMonth = normalized;
        await InvokeAsync(StateHasChanged);
    }
    private async Task SelectAsync(DateOnly date)
    {
        if (Disabled || ReadOnly || IsDisabled(date)) return;
        FocusedDate = date;
        if (Mode == ShadcnCalendarSelectionMode.Single)
        {
            if (ValueChanged.HasDelegate) await ValueChanged.InvokeAsync(date);
            else { _uncontrolledValue = date; await InvokeAsync(StateHasChanged); }
            return;
        }

        var current = EffectiveRange;
        var next = current is null || current.End is not null
            ? new ShadcnDateRange(date, null)
            : date < current.Start ? new(date, current.Start) : new(current.Start, date);
        if (RangeChanged.HasDelegate) await RangeChanged.InvokeAsync(next);
        else { _uncontrolledRange = next; await InvokeAsync(StateHasChanged); }
    }
    private async Task HandleKeyDownAsync(DateOnly date, KeyboardEventArgs args)
    {
        if (Disabled) return;
        var horizontal = EffectiveDirection == ShadcnDirection.RightToLeft ? -1 : 1;
        var requested = args.Key switch
        {
            "ArrowRight" => date.AddDays(horizontal), "ArrowLeft" => date.AddDays(-horizontal), "ArrowDown" => date.AddDays(7), "ArrowUp" => date.AddDays(-7),
            "Home" => date.AddDays(-((int)date.DayOfWeek - (int)EffectiveFirstDay + 7) % 7),
            "End" => date.AddDays(6 - ((int)date.DayOfWeek - (int)EffectiveFirstDay + 7) % 7),
            "PageUp" => args.ShiftKey ? date.AddYears(-1) : date.AddMonths(-1), "PageDown" => args.ShiftKey ? date.AddYears(1) : date.AddMonths(1), _ => FocusedDate
        };
        var direction = requested >= date ? 1 : -1;
        requested = ClampToBounds(requested);
        var focusTarget = FindEnabledWithinBounds(requested, direction);
        var gridStart = Weeks[0][0];
        var gridEnd = Weeks[^1][^1];
        if (focusTarget < gridStart || focusTarget > gridEnd)
        {
            PendingFocus = focusTarget;
            await SetVisibleMonthAsync(new(focusTarget.Year, focusTarget.Month, 1));
        }
        else
        {
            FocusedDate = focusTarget;
            if (FocusedDate.Year != EffectiveMonth.Year || FocusedDate.Month != EffectiveMonth.Month) await SetVisibleMonthAsync(new(FocusedDate.Year, FocusedDate.Month, 1));
        }
        if (args.Key is "Enter" or " ") await SelectAsync(FocusedDate);
        if (args.Key is "ArrowRight" or "ArrowLeft" or "ArrowDown" or "ArrowUp" or "Home" or "End" or "PageUp" or "PageDown")
        {
            PendingFocus = focusTarget;
            await InvokeAsync(StateHasChanged);
        }
    }
    private DateOnly ClampToBounds(DateOnly date) => date < Min ? Min!.Value : date > Max ? Max!.Value : date;
    private DateOnly FindEnabledWithinBounds(DateOnly candidate, int direction)
    {
        const int maximumSearchDaysPerDirection = 366;
        var lower = Min ?? DateOnly.MinValue;
        var upper = Max ?? DateOnly.MaxValue;
        var origin = candidate < lower ? lower : candidate > upper ? upper : candidate;
        if (!IsDisabled(origin)) return origin;
        var searched = 0;
        for (var dayNumber = origin.DayNumber + direction; dayNumber >= lower.DayNumber && dayNumber <= upper.DayNumber && searched < maximumSearchDaysPerDirection; dayNumber += direction, searched++)
        {
            var date = DateOnly.FromDayNumber(dayNumber);
            if (!IsDisabled(date)) return date;
        }
        searched = 0;
        for (var dayNumber = origin.DayNumber - direction; dayNumber >= lower.DayNumber && dayNumber <= upper.DayNumber && searched < maximumSearchDaysPerDirection; dayNumber -= direction, searched++)
        {
            var date = DateOnly.FromDayNumber(dayNumber);
            if (!IsDisabled(date)) return date;
        }
        return FocusedDate != default && !IsDisabled(FocusedDate) ? FocusedDate : origin;
    }
    private DateOnly FindEnabled(DateOnly candidate, int direction)
    {
        var grid = Weeks;
        var lower = grid[0][0] < (Min ?? grid[0][0]) ? Min!.Value : grid[0][0];
        var upper = grid[^1][^1] > (Max ?? grid[^1][^1]) ? Max!.Value : grid[^1][^1];
        var origin = candidate < lower ? lower : candidate > upper ? upper : candidate;
        if (!IsDisabled(origin)) return origin;
        var days = upper.DayNumber - lower.DayNumber;
        for (var distance = 1; distance <= days; distance++)
        {
            var primary = origin.AddDays(distance * direction);
            if (primary >= lower && primary <= upper && !IsDisabled(primary)) return primary;
            var secondary = origin.AddDays(-distance * direction);
            if (secondary >= lower && secondary <= upper && !IsDisabled(secondary)) return secondary;
        }
        return origin;
    }
    private string FormatYear(int year) => UseCultureCalendarYears ? Culture.Calendar.GetYear(new DateTime(year, 1, 1)).ToString(CultureInfo.InvariantCulture) : year.ToString(CultureInfo.InvariantCulture);
    private static DateOnly NormalizeMonth(DateOnly value) => value == default ? new(DateTime.Today.Year, DateTime.Today.Month, 1) : new(value.Year, value.Month, 1);
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (PendingFocus is null) return;
        var target = PendingFocus.Value;
        PendingFocus = null;
        Module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Maliev.ShadcnBlazor/js/shadcn-forms.js");
        await Module.InvokeVoidAsync("focusCalendarDay", Root, target.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture));
    }
    public async ValueTask DisposeAsync() { if (Module is not null) try { await Module.DisposeAsync(); } catch (JSDisconnectedException) { } }
}
