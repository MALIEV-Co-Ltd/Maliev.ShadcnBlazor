@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase

<CascadingValue Value="Context" IsFixed="true">
    <div @attributes="ForwardedAttributes" class="@MergeClass("shadcn-input-group")" style="@MergeStyle(null)" role="group" data-slot="input-group">@ChildContent</div>
</CascadingValue>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private ShadcnInputGroupContext Context { get; } = new();
    private IReadOnlyDictionary<string, object> ForwardedAttributes => AttributesExcept("role", "data-slot");
}
