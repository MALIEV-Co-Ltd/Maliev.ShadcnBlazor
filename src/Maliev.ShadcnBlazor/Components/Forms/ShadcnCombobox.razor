@typeparam TValue
@using System.Globalization
@using System.Linq.Expressions
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@implements IAsyncDisposable
@implements Maliev.ShadcnBlazor.Components.Primitives.IShadcnFocusable
@inject IJSRuntime JS
@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase

<div @ref="Root" class="@MergeClass("shadcn-combobox")" style="@MergeStyle(null)" data-slot="combobox" data-open="@(EffectiveOpen ? "true" : null)">
    @if (Multiple && EffectiveValues.Count > 0)
    {
        <div class="shadcn-combobox-chips" data-slot="combobox-chips">
            @foreach (var value in EffectiveValues)
            {
                var option = Options.FirstOrDefault(candidate => EqualityComparer<TValue>.Default.Equals(candidate.Value, value));
                <span class="shadcn-combobox-chip" data-slot="combobox-chip">@(option?.Text ?? Format(value))<button type="button" data-slot="combobox-chip-remove" aria-label="@($"Remove {option?.Text ?? Format(value)}")" disabled="@(EffectiveDisabled || ReadOnly)" @onclick="() => RemoveAsync(value)">×</button></span>
            }
        </div>
    }
    <div class="shadcn-input-group shadcn-combobox-input" data-slot="input-group">
        <input @ref="InputElement" @attributes="ForwardedAttributes" class="shadcn-input shadcn-combobox-control" data-slot="combobox-input" role="combobox" value="@DisplayQuery" placeholder="@Placeholder" disabled="@EffectiveDisabled" readonly="@ReadOnly" aria-required="@(Required ? "true" : null)" aria-autocomplete="list" aria-haspopup="listbox" aria-expanded="@EffectiveOpen.ToString().ToLowerInvariant()" aria-controls="@ListboxId" aria-activedescendant="@ActiveDescendant" aria-invalid="@(EffectiveInvalid ? "true" : null)" aria-describedby="@DescribedBy" @oninput="HandleInputAsync" @onfocus="OpenAsync" @onkeydown="HandleKeyDownAsync" />
        @if (ShowClear && (!string.IsNullOrEmpty(DisplayQuery) || SelectedOption is not null || Multiple && EffectiveValues.Count > 0) && !EffectiveDisabled && !ReadOnly)
        {
            <button type="button" data-slot="combobox-clear" aria-label="@ClearLabel" @onclick="ClearAsync">
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18" /></svg>
            </button>
        }
        @if (ShowTrigger) { <button type="button" data-slot="combobox-trigger" aria-label="@TriggerLabel" disabled="@(EffectiveDisabled || ReadOnly)" @onclick="ToggleOpenAsync"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg></button> }
    </div>
    @if (EffectiveOpen)
    {
        <div class="shadcn-combobox-content" data-slot="combobox-content">
            <div id="@ListboxId" class="shadcn-combobox-list" data-slot="combobox-list" role="listbox" aria-multiselectable="@(Multiple ? "true" : null)">
                @if (FilteredOptions.Count == 0) { <div data-slot="combobox-empty">@EmptyText</div> }
                @foreach (var group in GroupedOptions)
                {
                    <div role="group" aria-label="@group.Key" data-slot="combobox-group">
                    @if (!string.IsNullOrWhiteSpace(group.Key)) { <div data-slot="combobox-label">@group.Key</div> }
                    @foreach (var option in group)
                    {
                        var index = FilteredIndex(option);
                        <div id="@OptionId(index)" class="shadcn-combobox-item" data-slot="combobox-item" data-value="@Format(option.Value)" role="option" aria-selected="@IsSelected(option.Value).ToString().ToLowerInvariant()" aria-disabled="@(option.Disabled ? "true" : null)" data-active="@(index == ActiveIndex ? "true" : null)" @onclick="() => SelectAsync(option)">@(ItemTemplate is null ? option.Text : null)@if (ItemTemplate is not null) { @ItemTemplate(option) }@if (IsSelected(option.Value)) { <span aria-hidden="true">✓</span> }</div>
                    }
                    </div>
                }
            </div>
        </div>
    }
    @if (Multiple)
    {
        @if (Required) { <input class="shadcn-form-control-proxy" data-slot="combobox-required-control" tabindex="-1" aria-label="@Placeholder" value="@(EffectiveValues.Count == 0 ? string.Empty : "selected")" disabled="@EffectiveDisabled" required @oninvalid="FocusValidationTargetAsync" @oninvalid:preventDefault /> }
        @if (!string.IsNullOrWhiteSpace(Name)) { foreach (var value in EffectiveValues) { <input type="hidden" name="@Name" value="@Format(value)" disabled="@EffectiveDisabled" /> } }
    }
    else if (!string.IsNullOrWhiteSpace(Name))
    {
        <input class="shadcn-form-control-proxy" data-slot="combobox-form-control" tabindex="-1" aria-label="@Placeholder" name="@Name" value="@(SelectedOption is null ? string.Empty : Format(Value))" disabled="@EffectiveDisabled" required="@Required" @oninvalid="FocusValidationTargetAsync" @oninvalid:preventDefault />
    }
</div>

@code {
    /// <summary>Focuses the combobox text input.</summary>
    public ValueTask FocusAsync(bool preventScroll = false) => InputElement.FocusAsync(preventScroll);
    [CascadingParameter] private ShadcnFieldContext? FieldContext { get; set; }
    [CascadingParameter] private EditContext? EditContext { get; set; }
    [Parameter] public TValue Value { get; set; } = default!;
    [Parameter] public EventCallback<TValue> ValueChanged { get; set; }
    [Parameter] public Expression<Func<TValue>>? ValueExpression { get; set; }
    [Parameter] public IReadOnlyList<TValue> Values { get; set; } = [];
    [Parameter] public EventCallback<IReadOnlyList<TValue>> ValuesChanged { get; set; }
    [Parameter] public Expression<Func<IReadOnlyList<TValue>>>? ValuesExpression { get; set; }
    [Parameter] public IReadOnlyList<ShadcnComboboxOption<TValue>> Options { get; set; } = [];
    [Parameter] public bool Multiple { get; set; }
    [Parameter] public string Query { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> QueryChanged { get; set; }
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public bool ShowClear { get; set; }
    [Parameter] public bool ShowTrigger { get; set; } = true;
    [Parameter] public string Placeholder { get; set; } = "Select an option";
    [Parameter] public string EmptyText { get; set; } = "No items found.";
    [Parameter] public string ClearLabel { get; set; } = "Clear selection";
    [Parameter] public string TriggerLabel { get; set; } = "Toggle options";
    [Parameter] public string? Name { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Invalid { get; set; }
    [Parameter] public RenderFragment<ShadcnComboboxOption<TValue>>? ItemTemplate { get; set; }
    private readonly string ListboxId = $"shadcn-combobox-{Guid.NewGuid():N}";
    private int ActiveIndex;
    private bool EffectiveDisabled => Disabled || FieldContext?.Disabled == true;
    private bool EffectiveInvalid => Invalid || FieldContext?.Invalid == true || HasValidationMessages();
    private string? DescribedBy => MergeIds(FieldContext?.AriaDescribedBy, AttributeText("aria-describedby"));
    private ShadcnComboboxOption<TValue>? SelectedOption => Multiple ? null : Options.FirstOrDefault(option => EqualityComparer<TValue>.Default.Equals(option.Value, EffectiveValue));
    private string DisplayQuery => string.IsNullOrEmpty(EffectiveQuery) ? SelectedOption?.Text ?? string.Empty : EffectiveQuery;
    private IReadOnlyList<ShadcnComboboxOption<TValue>> FilteredOptions => Options.Where(option => string.IsNullOrWhiteSpace(EffectiveQuery) || option.Text.Contains(EffectiveQuery, StringComparison.CurrentCultureIgnoreCase)).ToArray();
    private IEnumerable<IGrouping<string, ShadcnComboboxOption<TValue>>> GroupedOptions => FilteredOptions.GroupBy(option => option.Group ?? string.Empty);
    private string? ActiveDescendant => EffectiveOpen && ActiveIndex >= 0 && ActiveIndex < FilteredOptions.Count ? OptionId(ActiveIndex) : null;
    private IReadOnlyDictionary<string, object> ForwardedAttributes => AttributesExcept("class", "style", "data-slot", "role", "value", "placeholder", "name", "disabled", "readonly", "required", "aria-required", "aria-autocomplete", "aria-haspopup", "aria-expanded", "aria-controls", "aria-activedescendant", "aria-invalid", "aria-describedby");
    private ElementReference Root;
    private ElementReference InputElement;
    private IJSObjectReference? Module;
    private DotNetObjectReference<ShadcnCombobox<TValue>>? SelfReference;
    private bool IsObserving;
    private EditContext? ValidationEditContext;
    private TValue _uncontrolledValue = default!;
    private IReadOnlyList<TValue> _uncontrolledValues = [];
    private string _uncontrolledQuery = string.Empty;
    private bool _uncontrolledOpen;
    private bool _stateInitialized;
    private TValue EffectiveValue => ValueChanged.HasDelegate ? Value : _uncontrolledValue;
    private IReadOnlyList<TValue> EffectiveValues => ValuesChanged.HasDelegate ? Values : _uncontrolledValues;
    private string EffectiveQuery => QueryChanged.HasDelegate ? Query : _uncontrolledQuery;
    private bool EffectiveOpen => OpenChanged.HasDelegate ? Open : _uncontrolledOpen;
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        EnsureValidationSubscription();
        if (!_stateInitialized)
        {
            _uncontrolledValue = Value;
            _uncontrolledValues = Values;
            _uncontrolledQuery = Query;
            _uncontrolledOpen = Open;
            _stateInitialized = true;
        }
        ActiveIndex = SelectedOption is null ? -1 : FilteredIndex(SelectedOption);
    }
    private void EnsureValidationSubscription()
    {
        if (ReferenceEquals(ValidationEditContext, EditContext)) return;
        if (ValidationEditContext is not null) ValidationEditContext.OnValidationStateChanged -= HandleValidationStateChanged;
        ValidationEditContext = EditContext;
        if (ValidationEditContext is not null) ValidationEditContext.OnValidationStateChanged += HandleValidationStateChanged;
    }
    private void HandleValidationStateChanged(object? sender, ValidationStateChangedEventArgs args) => _ = InvokeAsync(StateHasChanged);
    private bool IsSelected(TValue value) => Multiple ? EffectiveValues.Contains(value) : EqualityComparer<TValue>.Default.Equals(EffectiveValue, value);
    private static string Format(TValue value) => value is IFormattable formattable ? formattable.ToString(null, CultureInfo.InvariantCulture) : value?.ToString() ?? string.Empty;
    private string OptionId(int index) => $"{ListboxId}-option-{index}";
    private int FirstEnabled() { for (var i = 0; i < FilteredOptions.Count; i++) if (!FilteredOptions[i].Disabled) return i; return -1; }
    private int FilteredIndex(ShadcnComboboxOption<TValue> option) { var items = FilteredOptions; for (var i = 0; i < items.Count; i++) if (ReferenceEquals(items[i], option) || EqualityComparer<ShadcnComboboxOption<TValue>>.Default.Equals(items[i], option)) return i; return -1; }
    private int Move(int delta) { var items = FilteredOptions; if (items.Count == 0) return -1; var current = ActiveIndex; for (var count = 0; count < items.Count; count++) { current = (current + delta + items.Count) % items.Count; if (!items[current].Disabled) return current; } return ActiveIndex; }
    private async Task HandleInputAsync(ChangeEventArgs args) { if (EffectiveDisabled || ReadOnly) return; await SetQueryAsync(args.Value?.ToString() ?? string.Empty); if (!EffectiveOpen) await SetOpenAsync(true); }
    private async Task OpenAsync() { if (!EffectiveDisabled && !ReadOnly && !EffectiveOpen) await SetOpenAsync(true); }
    private async Task ToggleOpenAsync() { if (!EffectiveDisabled && !ReadOnly) await SetOpenAsync(!EffectiveOpen); }
    private async Task HandleKeyDownAsync(KeyboardEventArgs args) { if (EffectiveDisabled || ReadOnly) return; if (args.Key is "ArrowDown" or "ArrowUp" && !EffectiveOpen) await SetOpenAsync(true); ActiveIndex = args.Key switch { "ArrowDown" => Move(1), "ArrowUp" => Move(-1), "Home" => FirstEnabled(), "End" => LastEnabled(), _ => ActiveIndex }; if (args.Key is "Enter" && ActiveIndex >= 0) await SelectAsync(FilteredOptions[ActiveIndex]); if (args.Key is "Escape" or "Tab") await SetOpenAsync(false); }
    private Task FocusValidationTargetAsync(EventArgs _) => InputElement.FocusAsync().AsTask();
    private int LastEnabled() { for (var i = FilteredOptions.Count - 1; i >= 0; i--) if (!FilteredOptions[i].Disabled) return i; return -1; }
    private async Task SelectAsync(ShadcnComboboxOption<TValue> option) { if (EffectiveDisabled || ReadOnly || option.Disabled) return; if (Multiple) { var next = EffectiveValues.Contains(option.Value) ? EffectiveValues.Where(value => !EqualityComparer<TValue>.Default.Equals(value, option.Value)).ToArray() : [.. EffectiveValues, option.Value]; await SetValuesAsync(next); Notify(ValuesExpression); } else { await SetValueAsync(option.Value); Notify(ValueExpression); await SetOpenAsync(false); } await SetQueryAsync(string.Empty); }
    private async Task ClearAsync() { if (EffectiveDisabled || ReadOnly) return; if (Multiple) { await SetValuesAsync([]); Notify(ValuesExpression); } else { await SetValueAsync(default!); Notify(ValueExpression); } await SetQueryAsync(string.Empty); }
    private async Task RemoveAsync(TValue value) { if (EffectiveDisabled || ReadOnly) return; await SetValuesAsync(EffectiveValues.Where(item => !EqualityComparer<TValue>.Default.Equals(item, value)).ToArray()); Notify(ValuesExpression); }
    private async Task SetValueAsync(TValue value) { if (ValueChanged.HasDelegate) await ValueChanged.InvokeAsync(value); else { _uncontrolledValue = value; await InvokeAsync(StateHasChanged); } }
    private async Task SetValuesAsync(IReadOnlyList<TValue> values) { if (ValuesChanged.HasDelegate) await ValuesChanged.InvokeAsync(values); else { _uncontrolledValues = values; await InvokeAsync(StateHasChanged); } }
    private async Task SetQueryAsync(string value) { if (QueryChanged.HasDelegate) await QueryChanged.InvokeAsync(value); else { _uncontrolledQuery = value; await InvokeAsync(StateHasChanged); } }
    private async Task SetOpenAsync(bool value) { if (OpenChanged.HasDelegate) await OpenChanged.InvokeAsync(value); else { if (_uncontrolledOpen == value) return; _uncontrolledOpen = value; await InvokeAsync(StateHasChanged); } }
    private void Notify<TField>(Expression<Func<TField>>? expression) { if (EditContext is not null && expression is not null) EditContext.NotifyFieldChanged(FieldIdentifier.Create(expression)); }
    private bool HasValidationMessages() => EditContext is not null && (ValueExpression is not null && EditContext.GetValidationMessages(FieldIdentifier.Create(ValueExpression)).Any() || ValuesExpression is not null && EditContext.GetValidationMessages(FieldIdentifier.Create(ValuesExpression)).Any());
    private string? AttributeText(string name) => AdditionalAttributes?.FirstOrDefault(pair => string.Equals(pair.Key, name, StringComparison.OrdinalIgnoreCase)).Value?.ToString();
    private static string? MergeIds(params string?[] values) { var ids = values.Where(value => !string.IsNullOrWhiteSpace(value)).SelectMany(value => value!.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries)).Distinct(StringComparer.Ordinal).ToArray(); return ids.Length == 0 ? null : string.Join(' ', ids); }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Required || !string.IsNullOrWhiteSpace(Name)) { Module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Maliev.ShadcnBlazor/js/shadcn-forms.js"); await Module.InvokeVoidAsync("observeValidationProxies", Root, "[data-slot=\"combobox-input\"]"); }
        if (EffectiveOpen && !IsObserving) { Module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Maliev.ShadcnBlazor/js/shadcn-forms.js"); SelfReference ??= DotNetObjectReference.Create(this); await Module.InvokeVoidAsync("observePopupDismissal", Root, SelfReference, "combobox"); IsObserving = true; }
        else if (!EffectiveOpen && IsObserving && Module is not null) { await Module.InvokeVoidAsync("disconnectPopupDismissal", Root); IsObserving = false; }
    }
    [JSInvokable] public async Task DismissPopup() { if (EffectiveOpen) { await SetOpenAsync(false); if (Module is not null) await Module.InvokeVoidAsync("focusElement", InputElement); } }
    public async ValueTask DisposeAsync() { if (ValidationEditContext is not null) ValidationEditContext.OnValidationStateChanged -= HandleValidationStateChanged; if (Module is not null) { try { await Module.InvokeVoidAsync("disconnectValidationProxies", Root); await Module.InvokeVoidAsync("disconnectPopupDismissal", Root); } catch (JSDisconnectedException) { } try { await Module.DisposeAsync(); } catch (JSDisconnectedException) { } } SelfReference?.Dispose(); }
}
