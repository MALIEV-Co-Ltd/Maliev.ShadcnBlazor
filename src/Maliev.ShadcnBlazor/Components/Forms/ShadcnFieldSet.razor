@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase

<fieldset @attributes="ForwardedAttributes"
          class="@MergeClass("shadcn-field-set")"
          style="@MergeStyle(null)"
          data-slot="field-set"
          disabled="@Disabled">
    @ChildContent
</fieldset>

@code {
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private IReadOnlyDictionary<string, object> ForwardedAttributes => AttributesExcept("data-slot", "disabled");
}
