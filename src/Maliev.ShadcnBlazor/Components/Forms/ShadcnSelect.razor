@typeparam TValue
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using Microsoft.JSInterop
@implements IAsyncDisposable
@implements Maliev.ShadcnBlazor.Components.Primitives.IShadcnFocusable
@inject IJSRuntime JS
@inject IServiceProvider IdAllocator
@inherits ShadcnFormComponentBase<TValue>

<div @ref="Root" class="@MergeClass("shadcn-select")" style="@MergeStyle()" data-slot="select" data-open="@(EffectiveOpen ? "true" : null)" data-clearable="@(Clearable && SelectedOption is not null ? "true" : null)">
    <button @ref="Trigger" @attributes="ForwardedAttributes" class="shadcn-select-trigger" type="button" role="combobox" data-slot="select-trigger" data-size="@SizeValue" disabled="@EffectiveDisabled" aria-haspopup="listbox" aria-expanded="@EffectiveOpen.ToString().ToLowerInvariant()" aria-controls="@ListboxId" aria-activedescendant="@ActiveDescendant" aria-readonly="@(ReadOnly ? "true" : null)" aria-required="@(Required ? "true" : null)" aria-invalid="@(EffectiveInvalid ? "true" : null)" aria-describedby="@DescribedBy" @onclick="ToggleOpenAsync" @onkeydown="HandleKeyDownAsync">
        <span data-slot="select-value" data-placeholder="@(SelectedOption is null ? "true" : null)">@(SelectedOption?.Text ?? Placeholder)</span>
        <svg class="shadcn-select-trigger-icon" data-slot="select-trigger-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg>
    </button>
    @if (Clearable && SelectedOption is not null && !EffectiveDisabled && !ReadOnly)
    {
        <button class="shadcn-select-clear" data-slot="select-clear" type="button" aria-label="@ClearLabel" @onclick="ClearAsync" @onclick:stopPropagation="true">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
    }
    @if (EffectiveOpen)
    {
        <div class="shadcn-select-content" data-slot="select-content" popover="manual">
            <div id="@ListboxId" role="listbox" tabindex="-1">
                @foreach (var group in GroupedOptions)
                {
                    <div role="group" aria-label="@group.Key" data-slot="select-group">
                        @if (!string.IsNullOrWhiteSpace(group.Key)) { <div class="shadcn-select-label" data-slot="select-label">@group.Key</div> }
                        @if (Virtualize)
                        {
                            @if (ActiveOption is { } activeOption && string.Equals(activeOption.Group ?? string.Empty, group.Key, StringComparison.Ordinal))
                            {
                                <div id="@OptionId(ActiveIndex)" data-slot="select-active-option" style="@ActiveOptionStyle" role="option" aria-label="@activeOption.Text" aria-selected="@IsSelected(activeOption).ToString().ToLowerInvariant()" aria-disabled="@(activeOption.Disabled ? "true" : null)" aria-setsize="@Options.Count" aria-posinset="@(ActiveIndex + 1)">@activeOption.Text</div>
                            }
                            <Virtualize Items="@group.ToArray()" Context="option" ItemSize="@VirtualizationItemSize" SpacerElement="div">
                                @{ var index = OptionIndex(option); }
                                <div id="@VirtualizedOptionId(index)" class="shadcn-select-item" data-slot="select-item" data-value="@FormatFormValue(option.Value)" data-active="@(index == ActiveIndex ? "true" : null)" role="option" aria-hidden="@(index == ActiveIndex ? "true" : null)" aria-selected="@IsSelected(option).ToString().ToLowerInvariant()" aria-disabled="@(option.Disabled ? "true" : null)" aria-setsize="@Options.Count" aria-posinset="@(index + 1)" @onclick="() => SelectAsync(option)">
                                    @(ItemTemplate is null ? option.Text : null)@if (ItemTemplate is not null) { @ItemTemplate(option) }
                                    @if (IsSelected(option)) { <span class="shadcn-select-item-indicator" aria-hidden="true">✓</span> }
                                </div>
                            </Virtualize>
                        }
                        else
                        {
                            @foreach (var option in group)
                            {
                                var index = OptionIndex(option);
                                <div id="@OptionId(index)" class="shadcn-select-item" data-slot="select-item" data-value="@FormatFormValue(option.Value)" data-active="@(index == ActiveIndex ? "true" : null)" role="option" aria-selected="@IsSelected(option).ToString().ToLowerInvariant()" aria-disabled="@(option.Disabled ? "true" : null)" @onclick="() => SelectAsync(option)">
                                    @(ItemTemplate is null ? option.Text : null)@if (ItemTemplate is not null) { @ItemTemplate(option) }
                                    @if (IsSelected(option)) { <span class="shadcn-select-item-indicator" aria-hidden="true">✓</span> }
                                </div>
                            }
                        }
                    </div>
                }
            </div>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Name)) { <input class="shadcn-form-control-proxy" data-slot="select-form-control" tabindex="-1" aria-label="@Placeholder" name="@Name" value="@(SelectedOption is null ? string.Empty : CurrentValueAsString)" disabled="@EffectiveDisabled" required="@Required" @oninvalid="FocusValidationTargetAsync" @oninvalid:preventDefault /> }
</div>

@code {
    /// <summary>Focuses the select trigger.</summary>
    public ValueTask FocusAsync(bool preventScroll = false) => Trigger.FocusAsync(preventScroll);
    [Parameter] public IReadOnlyList<ShadcnSelectOption<TValue>> Options { get; set; } = [];
    [Parameter] public string Placeholder { get; set; } = "Select an option";
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public bool Clearable { get; set; }
    /// <summary>Gets or sets whether option rows are virtualized for large collections.</summary>
    [Parameter] public bool Virtualize { get; set; }
    /// <summary>Gets or sets the estimated height, in CSS pixels, of each virtualized option row.</summary>
    [Parameter] public float VirtualizationItemSize { get; set; } = 36f;
    [Parameter] public string ClearLabel { get; set; } = "Clear selection";
    [Parameter] public ShadcnControlSize Size { get; set; } = ShadcnControlSize.Default;
    [Parameter] public RenderFragment<ShadcnSelectOption<TValue>>? ItemTemplate { get; set; }
    private string ListboxId = null!;
    private ElementReference Root;
    private ElementReference Trigger;
    private IJSObjectReference? Module;
    private DotNetObjectReference<ShadcnSelect<TValue>>? SelfReference;
    private bool IsObserving;
    private bool _uncontrolledOpen;
    private bool _openInitialized;
    private bool _controlledOpenPending;
    private bool _requestedOpen;
    private bool _lastOpenParameter;
    private bool _openParameterInitialized;
    private bool _openedFromActivationKey;
    private int ActiveIndex;
    private const string ActiveOptionStyle = "position:absolute;inline-size:1px;block-size:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap;border:0";
    private ShadcnSelectOption<TValue>? SelectedOption => Options.FirstOrDefault(IsSelected);
    private ShadcnSelectOption<TValue>? ActiveOption => ActiveIndex >= 0 && ActiveIndex < Options.Count ? Options[ActiveIndex] : null;
    private IEnumerable<IGrouping<string, ShadcnSelectOption<TValue>>> GroupedOptions => Options.GroupBy(option => option.Group ?? string.Empty);
    private string SizeValue => Size switch { ShadcnControlSize.Default => "default", ShadcnControlSize.Small => "sm", _ => throw new ArgumentOutOfRangeException(nameof(Size), Size, "Unknown control size.") };
    private bool EffectiveOpen => OpenChanged.HasDelegate && _controlledOpenPending ? _requestedOpen : OpenChanged.HasDelegate ? Open : _uncontrolledOpen;
    private string? ActiveDescendant => EffectiveOpen && ActiveIndex >= 0 ? OptionId(ActiveIndex) : null;
    private IReadOnlyDictionary<string, object> ForwardedAttributes => AttributesExcept("class", "style", "type", "role", "data-slot", "data-size", "disabled", "aria-haspopup", "aria-expanded", "aria-controls", "aria-activedescendant", "aria-readonly", "aria-required", "aria-invalid", "aria-describedby");
    protected override void OnInitialized() => ListboxId = IdAllocator.NextId("shadcn-select");
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (!float.IsFinite(VirtualizationItemSize) || VirtualizationItemSize <= 0)
            throw new ArgumentOutOfRangeException(nameof(VirtualizationItemSize), VirtualizationItemSize, "Virtualization item size must be finite and greater than zero.");
        _ = SizeValue;
        if (!_openInitialized)
        {
            _uncontrolledOpen = Open;
            _openInitialized = true;
        }
        if (!_openParameterInitialized)
        {
            _lastOpenParameter = Open;
            _openParameterInitialized = true;
        }
        else if (Open != _lastOpenParameter)
        {
            _lastOpenParameter = Open;
            _controlledOpenPending = false;
        }
        if (_controlledOpenPending && Open == _requestedOpen)
            _controlledOpenPending = false;
        var selected = SelectedOption is null ? -1 : OptionIndex(SelectedOption);
        ActiveIndex = selected >= 0 ? selected : FirstEnabled();
    }
    private bool IsSelected(ShadcnSelectOption<TValue> option) => EqualityComparer<TValue>.Default.Equals(Value, option.Value);
    private int FirstEnabled() { for (var i = 0; i < Options.Count; i++) if (!Options[i].Disabled) return i; return -1; }
    private int OptionIndex(ShadcnSelectOption<TValue> option) { for (var i = 0; i < Options.Count; i++) if (ReferenceEquals(Options[i], option) || EqualityComparer<ShadcnSelectOption<TValue>>.Default.Equals(Options[i], option)) return i; return -1; }
    private async Task SetOpenAsync(bool value)
    {
        if (OpenChanged.HasDelegate)
        {
            _requestedOpen = value;
            _controlledOpenPending = true;
            await OpenChanged.InvokeAsync(value);
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (_uncontrolledOpen == value) return;
        _uncontrolledOpen = value;
        await InvokeAsync(StateHasChanged);
    }
    private async Task ToggleOpenAsync(MouseEventArgs args)
    {
        if (_openedFromActivationKey && args.Detail == 0)
        {
            _openedFromActivationKey = false;
            return;
        }
        _openedFromActivationKey = false;
        if (!EffectiveDisabled && !ReadOnly) await SetOpenAsync(!EffectiveOpen);
    }
    private async Task ClearAsync() { if (!EffectiveDisabled && !ReadOnly) await SetCurrentValueAsync(default!); }
    private async Task SelectAsync(ShadcnSelectOption<TValue> option) { if (EffectiveDisabled || ReadOnly || option.Disabled) return; await SetOpenAsync(false); await SetCurrentValueAsync(option.Value); if (Module is not null) await Module.InvokeVoidAsync("focusElement", Trigger); }
    private async Task HandleKeyDownAsync(KeyboardEventArgs args)
    {
        if (EffectiveDisabled || ReadOnly) return;
        if (!EffectiveOpen && args.Key is "Enter" or " ")
        {
            _openedFromActivationKey = true;
            await SetOpenAsync(true);
            return;
        }
        if (args.Key is "ArrowDown" or "ArrowUp" or "Home" or "End" && !EffectiveOpen) await SetOpenAsync(true);
        ActiveIndex = args.Key switch { "Home" => FirstEnabled(), "End" => LastEnabled(), "ArrowDown" => Move(1), "ArrowUp" => Move(-1), _ => ActiveIndex };
        if (args.Key.Length == 1 && args.Key != " ")
        {
            var match = Options.Select((option, index) => (option, index)).FirstOrDefault(candidate =>
                !candidate.option.Disabled && candidate.option.Text.StartsWith(args.Key, StringComparison.CurrentCultureIgnoreCase));
            if (match.option is not null) ActiveIndex = match.index;
        }
        if (args.Key is "Enter" or " " && ActiveIndex >= 0) await SelectAsync(Options[ActiveIndex]);
        if (args.Key == "Escape") await CloseAndFocusAsync();
        if (args.Key == "Tab" && EffectiveOpen) await SetOpenAsync(false);
    }
    private Task FocusValidationTargetAsync(EventArgs _) => Trigger.FocusAsync().AsTask();
    private string OptionId(int index) => $"{ListboxId}-option-{index}";
    private string VirtualizedOptionId(int index) => $"{OptionId(index)}-virtual";
    private async Task CloseAndFocusAsync() { await SetOpenAsync(false); if (Module is not null) await Module.InvokeVoidAsync("focusElement", Trigger); }
    private int LastEnabled() { for (var i = Options.Count - 1; i >= 0; i--) if (!Options[i].Disabled) return i; return -1; }
    private int Move(int delta) { if (Options.Count == 0) return -1; var current = ActiveIndex; for (var count = 0; count < Options.Count; count++) { current = (current + delta + Options.Count) % Options.Count; if (!Options[current].Disabled) return current; } return ActiveIndex; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!string.IsNullOrWhiteSpace(Name))
        {
            Module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Maliev.ShadcnBlazor/js/shadcn-forms.js");
            await Module.InvokeVoidAsync("observeValidationProxies", Root, "[data-slot=\"select-trigger\"]");
        }
        if (EffectiveOpen && !IsObserving)
        {
            Module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Maliev.ShadcnBlazor/js/shadcn-forms.js");
            SelfReference ??= DotNetObjectReference.Create(this);
            await Module.InvokeVoidAsync("observePopupDismissal", Root, SelfReference, "select");
            await Module.InvokeVoidAsync("promoteSelectPopup", Root);
            IsObserving = true;
        }
        else if (!EffectiveOpen && IsObserving && Module is not null)
        {
            await Module.InvokeVoidAsync("disconnectPopupDismissal", Root);
            IsObserving = false;
        }
    }

    [JSInvokable] public async Task DismissPopup() { if (EffectiveOpen) await CloseAndFocusAsync(); }

    public async ValueTask DisposeAsync()
    {
        Dispose();
        if (Module is not null) { try { await Module.InvokeVoidAsync("disconnectValidationProxies", Root); await Module.InvokeVoidAsync("disconnectPopupDismissal", Root); } catch (JSDisconnectedException) { } try { await Module.DisposeAsync(); } catch (JSDisconnectedException) { } }
        SelfReference?.Dispose();
    }
}
