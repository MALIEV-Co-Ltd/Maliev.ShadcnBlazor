@using Maliev.ShadcnBlazor.Components.Actions
@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase
<button @attributes="ForwardedAttributes" class="@MergeClass("shadcn-button shadcn-input-group-button")" style="@MergeStyle(null)" type="@Type" disabled="@Disabled" data-slot="input-group-button" data-size="@SizeValue" data-variant="@VariantValue" @onclick="OnClick" @onclick:stopPropagation="true">@ChildContent</button>
@code {
    [Parameter] public ShadcnInputGroupButtonSize Size { get; set; } = ShadcnInputGroupButtonSize.ExtraSmall;
    [Parameter] public ShadcnButtonVariant Variant { get; set; } = ShadcnButtonVariant.Ghost;
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private string SizeValue => Size switch { ShadcnInputGroupButtonSize.ExtraSmall => "xs", ShadcnInputGroupButtonSize.Small => "sm", ShadcnInputGroupButtonSize.IconExtraSmall => "icon-xs", ShadcnInputGroupButtonSize.IconSmall => "icon-sm", _ => throw new ArgumentOutOfRangeException(nameof(Size), Size, "Unknown input group button size.") };
    private string VariantValue => Variant switch
    {
        ShadcnButtonVariant.Default => "default",
        ShadcnButtonVariant.Destructive => "destructive",
        ShadcnButtonVariant.Outline => "outline",
        ShadcnButtonVariant.Secondary => "secondary",
        ShadcnButtonVariant.Ghost => "ghost",
        ShadcnButtonVariant.Link => "link",
        _ => throw new ArgumentOutOfRangeException(nameof(Variant), Variant, "Unknown input group button variant.")
    };
    private IReadOnlyDictionary<string, object> ForwardedAttributes => AttributesExcept("type", "disabled", "data-slot", "data-size", "data-variant");
    protected override void OnParametersSet() { base.OnParametersSet(); _ = SizeValue; _ = VariantValue; }
}
