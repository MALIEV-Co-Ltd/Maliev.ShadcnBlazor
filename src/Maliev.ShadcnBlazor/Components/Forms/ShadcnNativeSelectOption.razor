@typeparam TValue
@inherits Maliev.ShadcnBlazor.Components.Primitives.ShadcnComponentBase

<option @attributes="ForwardedAttributes"
        class="@MergeClass("shadcn-native-select-option")"
        style="@MergeStyle(null)"
        data-slot="native-select-option"
        value="@Value"
        disabled="@Disabled">@ChildContent</option>

@code {
    [Parameter, EditorRequired] public TValue Value { get; set; } = default!;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private IReadOnlyDictionary<string, object> ForwardedAttributes => AttributesExcept("data-slot", "value", "disabled");
}
