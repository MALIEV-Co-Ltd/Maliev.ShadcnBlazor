@using System.Globalization
@using Maliev.ShadcnBlazor.Components.Actions
@using Maliev.ShadcnBlazor.Components.Primitives
@inherits ShadcnComponentBase

<ShadcnInputGroup Class="@MergeClass("shadcn-secret-input")"
                  Style="@MergeStyle(null)"
                  data-revealed="@(EffectiveRevealed ? "true" : "false")"
                  data-mask-start="@MaskStart">
    <ShadcnInput TValue="string"
                 Value="DisplayValue"
                 ValueChanged="HandleValueChangedAsync"
                 Type="@InputType"
                 Name="@Name"
                 Placeholder="@Placeholder"
                 AutoComplete="@AutoComplete"
                 Disabled="@Disabled"
                 ReadOnly="@InputReadOnly"
                 Required="@Required"
                 Invalid="@Invalid"
                 AdditionalAttributes="InputAttributes" />
    <ShadcnInputGroupAddon Alignment="ShadcnInputGroupAlignment.InlineEnd">
        <ShadcnInputGroupButton Size="ShadcnInputGroupButtonSize.IconSmall"
                                Variant="ShadcnButtonVariant.Ghost"
                                Disabled="Disabled"
                                OnClick="ToggleRevealAsync"
                                data-secret-input-toggle
                                aria-label="@(EffectiveRevealed ? HideLabel : ShowLabel)"
                                aria-pressed="@EffectiveRevealed.ToString().ToLowerInvariant()">
            @if (EffectiveRevealed)
            {
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3l18 18M10.6 10.7a2 2 0 0 0 2.7 2.7M9.9 4.2A10.8 10.8 0 0 1 12 4c5.5 0 9 6 9 6a18 18 0 0 1-2.1 2.8M6.6 6.6C4.3 8.1 3 10 3 10s3.5 6 9 6a9.8 9.8 0 0 0 3-.5" /></svg>
            }
            else
            {
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z" /><circle cx="12" cy="12" r="3" /></svg>
            }
        </ShadcnInputGroupButton>
    </ShadcnInputGroupAddon>
</ShadcnInputGroup>
<span class="shadcn-sr-only" data-slot="secret-input-status" aria-live="polite">@(EffectiveRevealed ? RevealedStatus : HiddenStatus)</span>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public bool Revealed { get; set; }
    [Parameter] public EventCallback<bool> RevealedChanged { get; set; }
    [Parameter] public int MaskStart { get; set; }
    [Parameter] public string MaskCharacter { get; set; } = "•";
    [Parameter] public string? Name { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string AutoComplete { get; set; } = "current-password";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Invalid { get; set; }
    [Parameter] public string ShowLabel { get; set; } = "Show secret";
    [Parameter] public string HideLabel { get; set; } = "Hide secret";
    [Parameter] public string HiddenStatus { get; set; } = "Secret hidden";
    [Parameter] public string RevealedStatus { get; set; } = "Secret visible";

    private string _value = string.Empty;
    private string? _lastParameterValue;
    private bool _initialized;
    private bool _uncontrolledRevealed;
    private bool _revealInitialized;
    private bool _focused;
    private bool EffectiveRevealed => RevealedChanged.HasDelegate ? Revealed : _uncontrolledRevealed;
    private bool InputReadOnly => ReadOnly || !EffectiveRevealed && MaskStart > 0 && !_focused;
    private string InputType => EffectiveRevealed || MaskStart > 0 && !_focused ? "text" : "password";
    private string DisplayValue => EffectiveRevealed || _focused || MaskStart == 0 ? _value : Mask(_value);
    private IReadOnlyDictionary<string, object> ForwardedAttributes => AttributesExcept("class", "style", "data-revealed", "data-mask-start");
    private IReadOnlyDictionary<string, object> InputAttributes
    {
        get
        {
            var attributes = new Dictionary<string, object>(ForwardedAttributes, StringComparer.OrdinalIgnoreCase)
            {
                ["onfocus"] = EventCallback.Factory.Create<FocusEventArgs>(this, HandleFocus),
                ["onblur"] = EventCallback.Factory.Create<FocusEventArgs>(this, HandleBlur)
            };
            attributes.TryAdd("dir", "ltr");
            return attributes;
        }
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (MaskStart < 0) throw new ArgumentOutOfRangeException(nameof(MaskStart));
        if (string.IsNullOrEmpty(MaskCharacter) || StringInfo.ParseCombiningCharacters(MaskCharacter).Length != 1)
            throw new ArgumentException("MaskCharacter must contain exactly one text element.", nameof(MaskCharacter));
        if (!_initialized || !string.Equals(Value, _lastParameterValue, StringComparison.Ordinal))
        {
            _value = Value ?? string.Empty;
            _lastParameterValue = Value;
            _initialized = true;
        }
        if (!_revealInitialized)
        {
            _uncontrolledRevealed = Revealed;
            _revealInitialized = true;
        }
    }

    private async Task HandleValueChangedAsync(string value)
    {
        if (Disabled || ReadOnly) return;
        _value = value;
        if (ValueChanged.HasDelegate) await ValueChanged.InvokeAsync(value);
    }

    private void HandleFocus(FocusEventArgs _) { _focused = true; StateHasChanged(); }
    private void HandleBlur(FocusEventArgs _) { _focused = false; StateHasChanged(); }

    private async Task ToggleRevealAsync(MouseEventArgs _)
    {
        if (Disabled) return;
        var next = !EffectiveRevealed;
        if (RevealedChanged.HasDelegate) await RevealedChanged.InvokeAsync(next);
        else _uncontrolledRevealed = next;
    }

    private string Mask(string value)
    {
        var offsets = StringInfo.ParseCombiningCharacters(value);
        if (offsets.Length <= MaskStart) return value;
        var prefix = MaskStart == 0 ? string.Empty : StringInfo.GetNextTextElement(value, 0);
        if (MaskStart > 1)
            prefix = value[..offsets[MaskStart]];
        return prefix + string.Concat(Enumerable.Repeat(MaskCharacter, offsets.Length - MaskStart));
    }
}
