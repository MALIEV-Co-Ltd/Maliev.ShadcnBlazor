<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Maliev.ShadcnBlazor</PackageId>
    <VersionPrefix>1.0.9</VersionPrefix>
    <Authors>MALIEV Co., Ltd.</Authors>
    <Company>MALIEV Co., Ltd.</Company>
    <Description>Accessible, themeable Shadcn-inspired components for .NET 10 Blazor applications.</Description>
    <PackageTags>blazor;razor-components;shadcn;ui;accessibility;design-system</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/MALIEV-Co-Ltd/Maliev.ShadcnBlazor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MALIEV-Co-Ltd/Maliev.ShadcnBlazor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.3" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="all" />
    <PackageReference Include="MudBlazor" Version="9.7.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="Reference\shadcn-reference.json" />
    <None Remove="Reference\shadcn-reference.json" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" Link="LICENSE" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Link="THIRD-PARTY-NOTICES.md" />
    <Content Update="wwwroot\fonts\Geist-OFL.txt" Pack="true" PackagePath="licenses\Geist-OFL.txt" />
    <Content Update="wwwroot\fonts\Noto-Sans-Thai-OFL.txt" Pack="true" PackagePath="licenses\Noto-Sans-Thai-OFL.txt" />
    <Content Update="wwwroot\fonts\JetBrains-Mono-OFL.txt" Pack="true" PackagePath="licenses\JetBrains-Mono-OFL.txt" />
    <None Update="licenses\shadcn-ui-LICENSE.md" Pack="true" PackagePath="licenses\shadcn-ui-LICENSE.md" />
    <None Update="licenses\MudBlazor-LICENSE.txt" Pack="true" PackagePath="licenses\MudBlazor-LICENSE.txt" />
    <None Include="Reference\shadcn-reference.json" Pack="true" PackagePath="reference\shadcn-reference.json" />
  </ItemGroup>
</Project>
