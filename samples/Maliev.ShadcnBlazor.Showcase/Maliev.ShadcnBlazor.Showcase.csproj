<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <InvariantGlobalization>false</InvariantGlobalization>
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Theming\Presets\ThemeStudioPresetCatalog.json" />
    <ProjectReference Include="..\..\src\Maliev.ShadcnBlazor\Maliev.ShadcnBlazor.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Documentation\ComponentDocumentationCatalog.json" />
    <EmbeddedResource Include="..\..\docs\component-catalog.json" Link="Documentation\component-catalog.json" />
    <EmbeddedResource Include="ThemeScenarios\ThemeScenarioCatalog.json" />
    <Content Include="..\..\docs\component-catalog.json" Link="docs\component-catalog.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
