@inherits LayoutComponentBase
@inject ShowcaseState State
@implements IDisposable

<ShadcnThemeProvider IsDarkMode="@State.IsDarkMode" Direction="@State.Direction" Class="showcase-root">
    <div class="showcase-shell" data-testid="showcase-shell">
        <header class="showcase-header">
            <div class="showcase-header__inner">
                <a href="components/foundation" class="showcase-brand">
                    <span class="showcase-brand__mark" aria-hidden="true">M</span>
                    <span class="showcase-brand__copy">
                        <strong data-testid="showcase-title">Maliev Shadcn Blazor</strong>
                        <small>Base · Vega · Neutral</small>
                    </span>
                </a>

                <nav class="showcase-nav" aria-label="Component showcase">
                    <a href="components/foundation" class="showcase-nav__link">Foundation</a>
                    <a href="components/semantic-foundations" class="showcase-nav__link">Semantic components</a>
                    <a href="components/disclosure-and-navigation" class="showcase-nav__link">Navigation</a>
                </nav>

                <div class="showcase-actions">
                    <ShadcnButton data-testid="theme-toggle" Class="showcase-action" Variant="ShadcnButtonVariant.Outline" OnClick="State.ToggleTheme">
                        Toggle theme
                    </ShadcnButton>
                    <ShadcnButton data-testid="direction-toggle" Class="showcase-action" Variant="ShadcnButtonVariant.Outline" OnClick="State.ToggleDirection">
                        Toggle direction
                    </ShadcnButton>
                </div>
            </div>
        </header>

        <main class="showcase-main">@Body</main>

        <footer class="showcase-footer">
            Reusable Maliev Shadcn Blazor component conformance showcase.
        </footer>
    </div>
</ShadcnThemeProvider>

@code {
    protected override void OnInitialized() => State.Changed += OnChanged;

    private void OnChanged(object? sender, EventArgs args) => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => State.Changed -= OnChanged;
}
