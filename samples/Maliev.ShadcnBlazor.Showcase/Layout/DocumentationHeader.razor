@using Maliev.ShadcnBlazor.Showcase.Documentation
@inject ShowcaseState ThemeState
@implements IDisposable

<header class="documentation-header">
    <div class="documentation-header__leading">
        <button @ref="_catalogTrigger"
                type="button"
                class="documentation-trigger documentation-trigger--catalog"
                data-testid="catalog-trigger"
                aria-controls="documentation-catalog"
                aria-expanded="@State.CatalogOpen.ToString().ToLowerInvariant()"
                @onclick="ToggleCatalog">
            Components
        </button>
        <a class="documentation-brand" href="docs">Maliev Shadcn Blazor</a>
    </div>
    <div class="documentation-header__actions" role="group" aria-label="Documentation actions">
        <button @ref="_outlineTrigger"
                type="button"
                class="documentation-trigger documentation-trigger--outline"
                data-testid="outline-trigger"
                aria-controls="documentation-outline"
                aria-expanded="@State.OutlineOpen.ToString().ToLowerInvariant()"
                @onclick="ToggleOutline">
            On This Page
        </button>
        <button type="button" class="documentation-icon-action" data-testid="documentation-theme-toggle" aria-label="@(ThemeState.IsDarkMode ? "Use light theme" : "Use dark theme")" @onclick="ThemeState.ToggleTheme">
            @(ThemeState.IsDarkMode ? "Light" : "Dark")
        </button>
        <button type="button" class="documentation-icon-action" data-testid="documentation-direction-toggle" aria-label="@(ThemeState.Direction == ShadcnDirection.LeftToRight ? "Use right-to-left direction" : "Use left-to-right direction")" @onclick="ThemeState.ToggleDirection">
            @(ThemeState.Direction == ShadcnDirection.LeftToRight ? "RTL" : "LTR")
        </button>
    </div>
</header>

@code {
    private ElementReference _catalogTrigger;
    private ElementReference _outlineTrigger;

    [Parameter, EditorRequired]
    public DocumentationNavigationState State { get; set; } = null!;

    public ValueTask FocusCatalogTriggerAsync() => _catalogTrigger.FocusAsync();

    public ValueTask FocusOutlineTriggerAsync() => _outlineTrigger.FocusAsync();

    private void ToggleCatalog() => State.CatalogOpen = !State.CatalogOpen;

    private void ToggleOutline() => State.OutlineOpen = !State.OutlineOpen;

    protected override void OnInitialized() => ThemeState.Changed += OnThemeChanged;

    private void OnThemeChanged(object? sender, EventArgs args) => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => ThemeState.Changed -= OnThemeChanged;
}
