@using Maliev.ShadcnBlazor.Showcase.Documentation
@using Maliev.ShadcnBlazor.Components.Icons
@using Maliev.ShadcnBlazor.Icons.Tabler
@inject ShowcaseState ThemeState
@implements IDisposable

<header class="documentation-header">
    <div class="documentation-header__leading">
        <a class="documentation-brand" href="@(StudioMode ? "theme" : "docs")" aria-label="@(StudioMode ? "Theme Studio home" : "Shadcn Blazor documentation home")">
            <span class="documentation-brand__mark" aria-hidden="true">
                <img src="images/brand/MALIEV_BLACK.svg" alt="" />
            </span>
            <span>Shadcn Blazor</span>
        </a>
        @if (!StudioMode)
        {
        <button @ref="_catalogTrigger"
                type="button"
                class="documentation-trigger documentation-trigger--catalog"
                data-testid="catalog-trigger"
                aria-label="Open component catalog"
                aria-controls="documentation-catalog"
                aria-expanded="@State.CatalogOpen.ToString().ToLowerInvariant()"
                @onclick="ToggleCatalog">
            <svg class="documentation-trigger__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
            <span>Components</span>
        </button>
        }
        else
        {
            <a class="documentation-trigger documentation-trigger--catalog" data-testid="catalog-trigger" href="docs/components" aria-label="Open component documentation">
                <svg class="documentation-trigger__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
                <span>Components</span>
            </a>
        }
    </div>
    <nav class="documentation-topnav" aria-label="Primary documentation navigation">
        <a href="docs">Docs</a>
        <a href="docs/components" aria-current="@(!StudioMode ? "page" : null)">Components</a>
        <a href="theme" aria-current="@(StudioMode ? "page" : null)">Theme</a>
        <a href="https://github.com/MALIEV-Co-Ltd/Maliev.ShadcnBlazor" target="_blank" rel="noreferrer">GitHub</a>
    </nav>
    <div class="documentation-header__actions" role="group" aria-label="Documentation actions">
        @if (!StudioMode)
        {
        <button @ref="_outlineTrigger"
                type="button"
                class="documentation-trigger documentation-trigger--outline"
                data-testid="outline-trigger"
                aria-label="On This Page"
                aria-controls="documentation-outline"
                aria-expanded="@State.OutlineOpen.ToString().ToLowerInvariant()"
                @onclick="ToggleOutline">
            <svg class="documentation-trigger__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 6h12M8 12h12M8 18h12" /><circle cx="4" cy="6" r="1" fill="currentColor" stroke="none" /><circle cx="4" cy="12" r="1" fill="currentColor" stroke="none" /><circle cx="4" cy="18" r="1" fill="currentColor" stroke="none" /></svg>
            <span>On This Page</span>
        </button>
        }
        else
        {
            <button id="theme-settings-toggle" type="button" class="documentation-trigger documentation-trigger--outline" data-testid="theme-controls-toggle" aria-label="Toggle theme settings" aria-controls="theme-studio-sidebar-region" aria-expanded="@SettingsOpen.ToString().ToLowerInvariant()" @onclick="ToggleSettings">
                <svg class="documentation-trigger__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
                <span>Theme settings</span>
            </button>
        }
        <button type="button" class="documentation-icon-action" data-testid="documentation-theme-toggle" aria-label="@(ThemeState.IsDarkMode ? "Use light theme" : "Use dark theme")" title="@(ThemeState.IsDarkMode ? "Use light theme" : "Use dark theme")" @onclick="ThemeState.ToggleTheme">
            @if (ThemeState.IsDarkMode)
            {
                <svg class="documentation-icon-action__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="4" />
                    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
                </svg>
            }
            else
            {
                <svg class="documentation-icon-action__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
                </svg>
            }
        </button>
        <button type="button" class="documentation-icon-action" data-testid="documentation-direction-toggle" aria-label="@(ThemeState.Direction == ShadcnDirection.LeftToRight ? "Use right-to-left direction" : "Use left-to-right direction")" title="@(ThemeState.Direction == ShadcnDirection.LeftToRight ? "Use right-to-left direction" : "Use left-to-right direction")" @onclick="ThemeState.ToggleDirection">
            <ShadcnIcon Icon="@DirectionIcon" Size="20" Class="documentation-icon-action__icon" />
        </button>
    </div>
</header>

@code {
    private ElementReference _catalogTrigger;
    private ElementReference _outlineTrigger;
    private ShadcnIconData DirectionIcon => TablerIconCatalog.Instance.Get(
        ThemeState.Direction == ShadcnDirection.LeftToRight
            ? TablerIconNames.TextDirectionRtl
            : TablerIconNames.TextDirectionLtr);

    [Parameter, EditorRequired]
    public DocumentationNavigationState State { get; set; } = null!;
    [Parameter] public bool StudioMode { get; set; }
    [Parameter] public bool SettingsOpen { get; set; }
    [Parameter] public EventCallback ToggleSettings { get; set; }

    public ValueTask FocusCatalogTriggerAsync() => _catalogTrigger.FocusAsync();

    public ValueTask FocusOutlineTriggerAsync() => _outlineTrigger.FocusAsync();

    private void ToggleCatalog() => State.CatalogOpen = !State.CatalogOpen;

    private void ToggleOutline() => State.OutlineOpen = !State.OutlineOpen;

    protected override void OnInitialized() => ThemeState.Changed += OnThemeChanged;

    private void OnThemeChanged(object? sender, EventArgs args) => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => ThemeState.Changed -= OnThemeChanged;
}
