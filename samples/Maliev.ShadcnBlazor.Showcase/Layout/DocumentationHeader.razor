@using Maliev.ShadcnBlazor.Showcase.Documentation
@using Maliev.ShadcnBlazor.Components.Icons
@using Maliev.ShadcnBlazor.Components.DataDisplay
@using System.Reflection
@inject ShowcaseState ThemeState
@inject NavigationManager Navigation
@inject DocumentationPageState PageState
@implements IDisposable

<header class="documentation-header">
    <div class="documentation-header__leading">
        @if (StudioMode)
        {
        <button id="theme-settings-toggle"
                type="button"
                class="documentation-icon-action documentation-sidebar-toggle"
                data-testid="theme-controls-toggle"
                aria-label="Toggle theme settings"
                aria-controls="theme-studio-sidebar-region"
                aria-expanded="@SettingsOpen.ToString().ToLowerInvariant()"
                @onclick="ToggleSettings">
            <ShadcnIcon Icon="@ThemeSettingsIcon" Size="20" Class="documentation-icon-action__icon" />
        </button>
        }
        <a class="documentation-brand" href="@(StudioMode ? "theme" : "docs")" aria-label="@(StudioMode ? "Theme Studio home" : "Maliev Shadcn Blazor documentation home")">
            <span class="documentation-brand__mark" aria-hidden="true">
                <img src="images/brand/MALIEV_BLACK.svg" alt="" />
            </span>
            <span>Maliev Shadcn Blazor</span>
        </a>
        <a class="documentation-version-link"
           data-testid="documentation-version-link"
           href="@DocumentationVersionUrl"
           target="_blank"
           rel="noopener noreferrer"
           aria-label="Package release @DocumentationVersion">@DocumentationVersion</a>
        @if (!StudioMode)
        {
        <button @ref="_catalogTrigger"
                type="button"
                class="documentation-trigger documentation-trigger--catalog"
                data-testid="catalog-trigger"
                aria-label="Open component catalog"
                aria-controls="documentation-catalog"
                aria-expanded="@State.CatalogOpen.ToString().ToLowerInvariant()"
                @onclick="ToggleCatalog">
            <svg class="documentation-trigger__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
            <span>Components</span>
        </button>
        }
        else
        {
            <a class="documentation-trigger documentation-trigger--catalog" data-testid="catalog-trigger" href="docs/components" aria-label="Open component documentation">
                <ShadcnIcon Icon="@ComponentsIcon" Size="20" Class="documentation-trigger__icon" />
                <span>Components</span>
            </a>
        }
    </div>
    <nav class="documentation-topnav" aria-label="Primary documentation navigation">
        <a href="docs" aria-current="@(!StudioMode && IsDocsOverview ? "page" : null)">Docs</a>
        <a href="docs/components" aria-current="@(!StudioMode && IsComponentsRoute ? "page" : null)">Components</a>
        <a href="theme" aria-current="@(StudioMode ? "page" : null)">Theme</a>
        <a href="https://github.com/MALIEV-Co-Ltd/Maliev.ShadcnBlazor" target="_blank" rel="noreferrer">GitHub</a>
    </nav>
    <div class="documentation-header__actions" role="group" aria-label="Documentation actions">
        @if (!StudioMode && PageState.Sections.Count > 0)
        {
        <button @ref="_outlineTrigger"
                type="button"
                class="documentation-trigger documentation-trigger--outline"
                data-testid="outline-trigger"
                aria-label="On This Page"
                aria-controls="documentation-outline"
                aria-expanded="@State.OutlineOpen.ToString().ToLowerInvariant()"
                @onclick="ToggleOutline">
            <svg class="documentation-trigger__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 6h12M8 12h12M8 18h12" /><circle cx="4" cy="6" r="1" fill="currentColor" stroke="none" /><circle cx="4" cy="12" r="1" fill="currentColor" stroke="none" /><circle cx="4" cy="18" r="1" fill="currentColor" stroke="none" /></svg>
            <span>On This Page</span>
        </button>
        }
        <a class="documentation-kofi"
           data-testid="documentation-kofi-link"
           href="https://ko-fi.com/natthapolv"
           target="_blank"
           rel="noopener noreferrer"
           aria-label="Support my work on Ko-fi (opens in a new tab)"
           title="Support my work on Ko-fi">
            <span class="documentation-kofi__mark" aria-hidden="true">
                <img class="documentation-kofi__cup" src="images/brand/kofi-cup.png" width="1024" height="1024" alt="" />
                <svg class="documentation-kofi__heart" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 21s-7.5-4.35-9.33-8.36C1.2 9.42 2.57 5.5 6.36 4.74 8.4 4.33 10.2 5.2 12 7.1c1.8-1.9 3.6-2.77 5.64-2.36 3.79.76 5.16 4.68 3.69 7.9C19.5 16.65 12 21 12 21Z" />
                </svg>
            </span>
            <span class="documentation-kofi__label">Ko-fi</span>
        </a>
        <button type="button" class="documentation-icon-action" data-testid="documentation-theme-toggle" aria-label="@(ThemeState.IsDarkMode ? "Use light theme" : "Use dark theme")" title="@(ThemeState.IsDarkMode ? "Use light theme" : "Use dark theme")" @onclick="ThemeState.ToggleTheme">
            @if (ThemeState.IsDarkMode)
            {
                <svg class="documentation-icon-action__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="4" />
                    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
                </svg>
            }
            else
            {
                <svg class="documentation-icon-action__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
                </svg>
            }
        </button>
        <button type="button" class="documentation-icon-action" data-testid="documentation-direction-toggle" aria-label="@(ThemeState.Direction == ShadcnDirection.LeftToRight ? "Use right-to-left direction" : "Use left-to-right direction")" title="@(ThemeState.Direction == ShadcnDirection.LeftToRight ? "Use right-to-left direction" : "Use left-to-right direction")" @onclick="ThemeState.ToggleDirection">
            <ShadcnIcon Icon="@DirectionIcon" Size="20" Class="documentation-icon-action__icon" />
        </button>
    </div>
</header>

@code {
    private ElementReference _catalogTrigger;
    private ElementReference _outlineTrigger;
    private static readonly ShadcnIconData ComponentsIcon = new("lucide", "layout-grid", "0 0 24 24", """
        <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><rect width="7" height="7" x="3" y="3" rx="1" /><rect width="7" height="7" x="14" y="3" rx="1" /><rect width="7" height="7" x="14" y="14" rx="1" /><rect width="7" height="7" x="3" y="14" rx="1" /></g>
        """);
    private static readonly ShadcnIconData ThemeSettingsIcon = new("lucide", "sliders-horizontal", "0 0 24 24", """
        <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M10 5H3" /><path d="M12 19H3" /><path d="M14 3v4" /><path d="M16 17v4" /><path d="M21 12h-9" /><path d="M21 19h-5" /><path d="M21 5h-7" /><path d="M8 10v4" /><path d="M8 12H3" /></g>
        """);
    private static readonly ShadcnIconData RightToLeftIcon = new("tabler", "text-direction-rtl", "0 0 24 24", """
        <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M16 4h-6.5a3.5 3.5 0 0 0 0 7h.5" /><path d="M14 15v-11" /><path d="M10 15v-11" /><path d="M5 19h14" /><path d="M7 21l-2 -2l2 -2" /></g>
        """);
    private static readonly ShadcnIconData LeftToRightIcon = new("tabler", "text-direction-ltr", "0 0 24 24", """
        <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M5 19h14" /><path d="M17 21l2 -2l-2 -2" /><path d="M16 4h-6.5a3.5 3.5 0 0 0 0 7h.5" /><path d="M14 15v-11" /><path d="M10 15v-11" /></g>
        """);
    private ShadcnIconData DirectionIcon => ThemeState.Direction == ShadcnDirection.LeftToRight
        ? RightToLeftIcon
        : LeftToRightIcon;
    private string CurrentPath => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
    private bool IsDocsOverview => string.Equals(CurrentPath, "docs", StringComparison.OrdinalIgnoreCase);
    private bool IsComponentsRoute => CurrentPath.StartsWith("docs/components", StringComparison.OrdinalIgnoreCase);
    private static string DocumentationVersion { get; } = ResolveDocumentationVersion();
    private static string DocumentationVersionUrl => $"https://github.com/MALIEV-Co-Ltd/Maliev.ShadcnBlazor/releases/tag/{DocumentationVersion}";

    private static string ResolveDocumentationVersion()
    {
        var assembly = typeof(ShadcnDataTable<>).Assembly;
        var informational = assembly.GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion;
        var version = (informational ?? assembly.GetName().Version?.ToString(3) ?? "0.0.0").Split('+', 2)[0];
        return $"v{version}";
    }

    [Parameter, EditorRequired]
    public DocumentationNavigationState State { get; set; } = null!;
    [Parameter] public bool StudioMode { get; set; }
    [Parameter] public bool SettingsOpen { get; set; }
    [Parameter] public EventCallback ToggleSettings { get; set; }

    public ValueTask FocusCatalogTriggerAsync() => _catalogTrigger.FocusAsync();

    public ValueTask FocusOutlineTriggerAsync() => _outlineTrigger.FocusAsync();

    private void ToggleCatalog() => State.CatalogOpen = !State.CatalogOpen;

    private void ToggleOutline() => State.OutlineOpen = !State.OutlineOpen;

    protected override void OnInitialized()
    {
        ThemeState.Changed += OnThemeChanged;
        PageState.Changed += OnThemeChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnThemeChanged(object? sender, EventArgs args) => _ = InvokeAsync(StateHasChanged);
    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ThemeState.Changed -= OnThemeChanged;
        PageState.Changed -= OnThemeChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
