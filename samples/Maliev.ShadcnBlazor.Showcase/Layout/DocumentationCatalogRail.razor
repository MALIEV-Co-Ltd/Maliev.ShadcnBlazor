@using Maliev.ShadcnBlazor.Showcase.Documentation
@inject IComponentDocumentationCatalog Catalog
@inject NavigationManager Navigation
@implements IDisposable

<div class="documentation-catalog-rail">
    <div class="documentation-rail__heading">
        <div>
            <p class="documentation-eyebrow">Reference</p>
            <h2>Components</h2>
        </div>
        <button type="button" class="documentation-panel-close" aria-label="Close component catalog" @onclick="RequestCloseAsync">Close</button>
    </div>

    <label class="documentation-field">
        <span>Search components</span>
        <input type="search"
               value="@State.Query"
               placeholder="Search components"
               autocomplete="off"
               @oninput="OnQueryChanged" />
    </label>

    <div class="documentation-filters">
        <label class="documentation-field">
            <span>Category</span>
            <select value="@State.Category" @onchange="OnCategoryChanged">
                <option value="">All categories</option>
                @foreach (var category in Categories)
                {
                    <option value="@category">@category</option>
                }
            </select>
        </label>
        <label class="documentation-field">
            <span>Status</span>
            <select value="@StatusValue" @onchange="OnStatusChanged">
                <option value="">All statuses</option>
                <option value="Complete">Complete</option>
                <option value="Planned">Planned</option>
            </select>
        </label>
    </div>

    <p class="documentation-result-count" data-testid="documentation-result-count" role="status" aria-live="polite">
        @ResultAnnouncement
    </p>

    <ul class="documentation-component-list">
        @foreach (var component in Results)
        {
            <li>
                <a href="@component.DocumentationUrl"
                   aria-current="@(IsActive(component) ? "page" : null)"
                   @onclick="CloseCatalog">
                    <span>@component.Name</span>
                    <small>@component.Status</small>
                </a>
            </li>
        }
    </ul>
</div>

@code {
    [Parameter, EditorRequired]
    public DocumentationNavigationState State { get; set; } = null!;

    [Parameter, EditorRequired]
    public EventCallback CloseRequested { get; set; }

    private IReadOnlyList<string> Categories => Catalog.All
        .Select(entry => entry.Category)
        .Distinct(StringComparer.Ordinal)
        .Order(StringComparer.Ordinal)
        .ToArray();

    private IReadOnlyList<ComponentDocumentationEntry> Results => Catalog.Search(
        State.Query,
        new DocumentationCatalogFilter(Category: State.Category, Status: State.Status));

    private string StatusValue => State.Status?.ToString() ?? string.Empty;

    private string ResultAnnouncement => Results.Count == 1
        ? "1 component found"
        : $"{Results.Count} components found";

    protected override void OnInitialized()
    {
        State.Changed += OnStateChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    private bool IsActive(ComponentDocumentationEntry component)
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');
        return string.Equals(path, component.DocumentationUrl.TrimStart('/'), StringComparison.OrdinalIgnoreCase);
    }

    private void OnQueryChanged(ChangeEventArgs args) => State.Query = args.Value?.ToString() ?? string.Empty;

    private void OnCategoryChanged(ChangeEventArgs args) => State.Category = args.Value?.ToString();

    private void OnStatusChanged(ChangeEventArgs args) => State.Status =
        Enum.TryParse<ComponentDocumentationStatus>(args.Value?.ToString(), out var status) ? status : null;

    private Task RequestCloseAsync() => CloseRequested.InvokeAsync();

    private void CloseCatalog() => State.CatalogOpen = false;

    private void OnStateChanged(object? sender, EventArgs args) => _ = InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        State.Changed -= OnStateChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
