@using Maliev.ShadcnBlazor.Showcase.Documentation
@inherits LayoutComponentBase
@inject ShowcaseState ThemeState
@inject DocumentationPageState PageState
@inject NavigationManager Navigation
@inject IJSRuntime JavaScript
@implements IDisposable
@implements IAsyncDisposable

<ShadcnThemeProvider IsDarkMode="@ThemeState.IsDarkMode" Direction="@ThemeState.Direction" Class="documentation-root">
    <div class="documentation-shell" data-testid="documentation-workbench" data-documentation-route="@RouteKind" @onkeydown="HandleKeyDown">
        <a class="documentation-skip-link"
           href="#documentation-catalog"
           @onclick="OpenCatalogFromSkipLink"
           @onclick:preventDefault="true">Skip to component navigation</a>
        <a class="documentation-skip-link" href="#documentation-content">Skip to documentation content</a>

        <DocumentationHeader @ref="_header" State="@NavigationState" />

        <div class="documentation-workbench">
            <button type="button"
                    class="documentation-backdrop"
                    aria-label="Close open documentation panel"
                    data-open="@AnyDrawerOpen.ToString().ToLowerInvariant()"
                    @onclick="CloseActiveDrawerAsync"></button>

            <nav @ref="_catalogNavigation"
                 id="documentation-catalog"
                 class="documentation-catalog"
                 aria-label="Component documentation"
                 data-open="@NavigationState.CatalogOpen.ToString().ToLowerInvariant()"
                 tabindex="-1">
                <DocumentationCatalogRail State="@NavigationState" CloseRequested="CloseCatalogDrawerAsync" />
            </nav>

            <main id="documentation-content" class="documentation-content" tabindex="-1">
                @Body
            </main>

            <aside @ref="_outlineNavigation"
                   id="documentation-outline"
                   class="documentation-outline"
                   role="@(NavigationState.OutlineOpen ? "dialog" : null)"
                   aria-modal="@(NavigationState.OutlineOpen ? "true" : null)"
                   aria-labelledby="documentation-outline-title"
                   data-open="@NavigationState.OutlineOpen.ToString().ToLowerInvariant()"
                   tabindex="-1">
                <div class="documentation-panel-header">
                    <h2 id="documentation-outline-title">On This Page</h2>
                    <button type="button" class="documentation-panel-close" data-testid="outline-close" aria-label="Close page outline" @onclick="CloseOutlineDrawerAsync">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
                    </button>
                </div>
                <DocumentationOnThisPage State="@PageState" ShowHeading="false" />
            </aside>
        </div>
    </div>
</ShadcnThemeProvider>

@code {
    private DocumentationHeader? _header;
    private ElementReference _catalogNavigation;
    private ElementReference _outlineNavigation;
    private bool _focusCatalogAfterRender;
    private bool _outlineAttached;
    private IJSObjectReference? _drawerModule;
    private bool AnyDrawerOpen => NavigationState.CatalogOpen || NavigationState.OutlineOpen;
    private string RouteKind
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
            if (string.Equals(path, "docs", StringComparison.OrdinalIgnoreCase)) return "overview";
            if (string.Equals(path, "docs/components", StringComparison.OrdinalIgnoreCase)) return "catalog";
            return "detail";
        }
    }

    public DocumentationNavigationState NavigationState { get; } = new();

    protected override void OnInitialized()
    {
        NavigationState.Changed += OnChanged;
        ThemeState.Changed += OnChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (!string.Equals(args.Key, "Escape", StringComparison.Ordinal) || !AnyDrawerOpen)
            return;

        await CloseActiveDrawerAsync();
    }

    private async Task CloseActiveDrawerAsync()
    {
        if (NavigationState.CatalogOpen)
            await CloseCatalogDrawerAsync();
        else if (NavigationState.OutlineOpen)
            await CloseOutlineDrawerAsync();
    }

    private void OpenCatalogFromSkipLink()
    {
        _focusCatalogAfterRender = true;
        NavigationState.CatalogOpen = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusCatalogAfterRender)
        {
            _focusCatalogAfterRender = false;
            await _catalogNavigation.FocusAsync();
        }

        try
        {
            if (NavigationState.OutlineOpen && !_outlineAttached)
            {
                _drawerModule ??= await JavaScript.InvokeAsync<IJSObjectReference>("import", "./js/documentation-drawer.js");
                await _drawerModule.InvokeVoidAsync("attach", _outlineNavigation);
                _outlineAttached = true;
            }
            else if (!NavigationState.OutlineOpen && _outlineAttached && _drawerModule is not null)
            {
                await _drawerModule.InvokeVoidAsync("detach", _outlineNavigation);
                _outlineAttached = false;
            }
        }
        catch (JSException)
        {
            // Static rendering and bUnit do not provide a browser focus surface.
        }
        catch (InvalidOperationException)
        {
            // The layout can be disposed during a route transition.
        }
    }

    private async Task CloseCatalogDrawerAsync()
    {
        if (!NavigationState.CatalogOpen || _header is null)
            return;

        NavigationState.CatalogOpen = false;
        await InvokeAsync(StateHasChanged);
        await _header.FocusCatalogTriggerAsync();
    }

    private async Task CloseOutlineDrawerAsync()
    {
        if (!NavigationState.OutlineOpen || _header is null)
            return;

        NavigationState.OutlineOpen = false;
        await InvokeAsync(StateHasChanged);
        await _header.FocusOutlineTriggerAsync();
    }

    private void OnChanged(object? sender, EventArgs args) => _ = InvokeAsync(StateHasChanged);
    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        NavigationState.Changed -= OnChanged;
        ThemeState.Changed -= OnChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }

    public async ValueTask DisposeAsync()
    {
        Dispose();
        if (_drawerModule is null)
            return;
        try
        {
            if (_outlineAttached)
                await _drawerModule.InvokeVoidAsync("detach", _outlineNavigation);
            await _drawerModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The browser can disconnect while the documentation route changes.
        }
    }
}
