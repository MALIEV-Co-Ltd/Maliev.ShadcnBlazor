@namespace Maliev.ShadcnBlazor.Showcase.Components.Theming
@using System.Globalization
@using Maliev.ShadcnBlazor.Showcase.Documentation
@using Maliev.ShadcnBlazor.Showcase.ThemeScenarios
@inject IThemeScenarioRegistry Registry
@inject IComponentDocumentationCatalog Documentation

<section class="theme-scenario-browser"
         data-testid="theme-scenario-browser"
         lang="@Culture.TwoLetterISOLanguageName"
         aria-label="@Text("Component theme scenarios", "สถานการณ์ธีมของคอมโพเนนต์")">
    <header class="theme-scenario-browser__header">
        <div>
            <h1>@Text("Component matrix", "เมทริกซ์คอมโพเนนต์")</h1>
            <p>@Text("Inspect every package component against the active theme without leaving the Studio.", "ตรวจสอบทุกคอมโพเนนต์ของแพ็กเกจด้วยธีมปัจจุบันโดยไม่ต้องออกจากสตูดิโอ")</p>
        </div>
        <a class="theme-scenario-browser__direct-link"
           data-testid="theme-scenario-direct-link"
           href="@DirectLink">@Text("Direct link", "ลิงก์โดยตรง")</a>
    </header>

    <div class="theme-scenario-browser__layout">
        <nav class="theme-scenario-browser__catalog" aria-label="@Text("Scenario components", "คอมโพเนนต์สถานการณ์")">
            <label class="theme-scenario-browser__search">
                <span>@Text("Search components", "ค้นหาคอมโพเนนต์")</span>
                <ShadcnInput TValue="string"
                             Value="SearchQuery"
                             ValueChanged="SetSearch"
                             Type="search"
                             Placeholder="@Text("Search scenarios", "ค้นหาสถานการณ์")"
                             aria-label="@Text("Search component scenarios", "ค้นหาสถานการณ์คอมโพเนนต์")"
                             data-testid="theme-scenario-search" />
            </label>
            <div class="theme-scenario-browser__component-list">
                @foreach (var category in VisibleComponents.GroupBy(value => value.Category))
                {
                    <section class="theme-scenario-browser__category">
                        <h2>@category.Key</h2>
                        @foreach (var component in category)
                        {
                            <button type="button"
                                    class="theme-scenario-browser__component"
                                    data-theme-scenario-component="@component.Slug"
                                    data-active="@(component.Slug == Active.ComponentSlug ? "true" : null)"
                                    aria-current="@(component.Slug == Active.ComponentSlug ? "true" : null)"
                                    @onclick="() => SelectComponentAsync(component.Slug)">@component.Name</button>
                        }
                    </section>
                }
                @if (VisibleComponents.Count == 0)
                {
                    <p class="theme-scenario-browser__empty" role="status">@Text("No components match this search.", "ไม่พบคอมโพเนนต์ที่ตรงกับการค้นหา")</p>
                }
            </div>
        </nav>

        <div class="theme-scenario-browser__preview">
            <div class="theme-scenario-browser__tabs" role="tablist" aria-label="@Text("Scenario kind", "ชนิดสถานการณ์")">
                @foreach (var kind in Enum.GetValues<ThemeScenarioKind>())
                {
                    var scenario = ScenarioFor(Active.ComponentSlug, kind);
                    <ShadcnButton Variant="@(scenario.Id == Active.Id ? ShadcnButtonVariant.Secondary : ShadcnButtonVariant.Ghost)"
                                  Size="ShadcnButtonSize.Small"
                                  role="tab"
                                  aria-selected="@(scenario.Id == Active.Id ? "true" : "false")"
                                  data-testid="@($"theme-scenario-kind-{kind.ToString().ToLowerInvariant()}")"
                                  OnClick="@(() => SelectAsync(scenario))">@KindLabel(kind)</ShadcnButton>
                }
            </div>

            <ThemeScenarioHost @key="Active.Id" Scenario="Active" Culture="Culture" />

            <footer class="theme-scenario-browser__pagination" aria-label="@Text("Component navigation", "การนำทางคอมโพเนนต์")">
                <ShadcnButton Variant="ShadcnButtonVariant.Outline" Size="ShadcnButtonSize.Small" data-testid="theme-scenario-previous" OnClick="PreviousAsync">@Text("Previous", "ก่อนหน้า")</ShadcnButton>
                <span aria-live="polite">@(ActiveIndex + 1) / @OrderedComponents.Count</span>
                <ShadcnButton Variant="ShadcnButtonVariant.Outline" Size="ShadcnButtonSize.Small" data-testid="theme-scenario-next" OnClick="NextAsync">@Text("Next", "ถัดไป")</ShadcnButton>
            </footer>
        </div>
    </div>
</section>

@code {
    [Parameter] public string? ComponentSlug { get; set; }
    [Parameter] public string? ScenarioId { get; set; }
    [Parameter] public CultureInfo Culture { get; set; } = CultureInfo.GetCultureInfo("en-US");
    [Parameter] public EventCallback<ThemeScenarioSelection> SelectionChanged { get; set; }

    private string SearchQuery { get; set; } = string.Empty;
    private ThemeScenarioDefinition Active { get; set; } = null!;
    private IReadOnlyList<ComponentDocumentationEntry> OrderedComponents { get; set; } = [];
    private IReadOnlyList<ComponentDocumentationEntry> VisibleComponents { get; set; } = [];
    private bool _initialized;
    private string? _appliedComponentSlug;
    private string? _appliedScenarioId;
    private int ActiveIndex => Math.Max(0, OrderedComponents.ToList().FindIndex(value => value.Slug == Active.ComponentSlug));
    private string DirectLink => $"theme?component={Uri.EscapeDataString(Active.ComponentSlug)}&scenario={Uri.EscapeDataString(Active.Id)}";

    protected override void OnParametersSet()
    {
        OrderedComponents = Documentation.All.OrderBy(value => value.Name, StringComparer.OrdinalIgnoreCase).ToArray();
        if (!_initialized
            || !string.Equals(ComponentSlug, _appliedComponentSlug, StringComparison.Ordinal)
            || !string.Equals(ScenarioId, _appliedScenarioId, StringComparison.Ordinal))
        {
            var requestedComponent = OrderedComponents.FirstOrDefault(value => string.Equals(value.Slug, ComponentSlug, StringComparison.Ordinal))
                ?? OrderedComponents[0];
            Active = Registry.ForComponent(requestedComponent.Slug)
                .FirstOrDefault(value => string.Equals(value.Id, ScenarioId, StringComparison.Ordinal))
                ?? ScenarioFor(requestedComponent.Slug, ThemeScenarioKind.Default);
            _appliedComponentSlug = ComponentSlug;
            _appliedScenarioId = ScenarioId;
            _initialized = true;
        }
        ApplySearch();
    }

    private void SetSearch(string value)
    {
        SearchQuery = value ?? string.Empty;
        ApplySearch();
    }

    private void ApplySearch()
    {
        if (string.IsNullOrWhiteSpace(SearchQuery))
        {
            VisibleComponents = OrderedComponents;
            return;
        }

        var matches = Registry.Find(SearchQuery).Select(value => value.ComponentSlug).ToHashSet(StringComparer.Ordinal);
        VisibleComponents = OrderedComponents.Where(value => matches.Contains(value.Slug)).ToArray();
    }

    private Task SelectComponentAsync(string slug) => SelectAsync(ScenarioFor(slug, Active.Kind));
    private Task PreviousAsync() => SelectRelativeAsync(-1);
    private Task NextAsync() => SelectRelativeAsync(1);

    private Task SelectRelativeAsync(int delta)
    {
        var index = (ActiveIndex + delta + OrderedComponents.Count) % OrderedComponents.Count;
        return SelectAsync(ScenarioFor(OrderedComponents[index].Slug, Active.Kind));
    }

    private async Task SelectAsync(ThemeScenarioDefinition scenario)
    {
        Active = scenario;
        await SelectionChanged.InvokeAsync(new ThemeScenarioSelection(scenario.ComponentSlug, scenario.Id));
    }

    private ThemeScenarioDefinition ScenarioFor(string slug, ThemeScenarioKind kind) =>
        Registry.ForComponent(slug).Single(value => value.Kind == kind);

    private string KindLabel(ThemeScenarioKind kind) => kind switch
    {
        ThemeScenarioKind.Default => Text("Default", "ปกติ"),
        ThemeScenarioKind.Stress => Text("Stress", "กรณีซับซ้อน"),
        ThemeScenarioKind.Accessible => Text("Accessible", "การเข้าถึง"),
        _ => throw new ArgumentOutOfRangeException(nameof(kind))
    };

    private string Text(string english, string thai) =>
        string.Equals(Culture.TwoLetterISOLanguageName, "th", StringComparison.OrdinalIgnoreCase) ? thai : english;
}
