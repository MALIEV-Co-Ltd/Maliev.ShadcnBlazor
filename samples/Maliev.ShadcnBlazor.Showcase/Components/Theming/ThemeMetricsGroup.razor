@namespace Maliev.ShadcnBlazor.Showcase.Components.Theming

<section class="theme-inspector-group" data-testid="theme-metrics-@GroupId">
    <div class="theme-inspector-group__heading">
        <div>
            <h3>@Title</h3>
            <p>@Description</p>
        </div>
        <ShadcnButton Variant="ShadcnButtonVariant.Ghost"
                   Size="ShadcnButtonSize.Small"
                   aria-label="@($"Reset {Title}")"
                   data-testid="@ResetGroupTestId"
                   OnClick="() => State.ResetGroup(Group)">Reset group</ShadcnButton>
    </div>
    <div class="theme-control-grid">
        @foreach (var metric in Metrics)
        {
            var label = metric.Label;
            var testId = $"theme-metric-{metric.Name}";
            @if (metric.Property.PropertyType == typeof(ShadcnReducedMotionBehavior))
            {
                <label class="theme-native-control"><span>@label</span>
                <select class="shadcn-native-select"
                           value="@State.GetMetricEditorValue(metric.Name)"
                           @onchange="args => State.SetMetric(metric.Name, args.Value?.ToString() ?? string.Empty)"
                           aria-label="@label" data-theme-metric="@metric.Name" data-testid="@testId">
                    @foreach (var behavior in Enum.GetNames<ShadcnReducedMotionBehavior>())
                    {
                        <option value="@behavior">@behavior</option>
                    }
                </select></label>
            }
            else if (metric.Name == "motionEasing")
            {
                <label class="theme-native-control"><span>@label</span>
                <select class="shadcn-native-select"
                           value="@State.GetMetricEditorValue(metric.Name)"
                           @onchange="args => State.SetMetric(metric.Name, args.Value?.ToString() ?? string.Empty)"
                           aria-label="@label" data-theme-metric="@metric.Name" data-testid="@testId">
                    @foreach (var easing in Easings)
                    {
                        <option value="@easing">@easing</option>
                    }
                </select></label>
            }
            else
            {
                <label class="theme-native-control"><span>@label</span>
                <input class="shadcn-input" value="@State.GetMetricEditorValue(metric.Name)"
                       @onchange="args => State.SetMetric(metric.Name, args.Value?.ToString() ?? string.Empty)"
                       aria-label="@label" data-theme-metric="@metric.Name" data-testid="@testId" />
                </label>
            }
        }
    </div>
</section>

@code {
    private static readonly string[] Easings = ["linear", "ease", "ease-in", "ease-out", "ease-in-out"];

    [Parameter, EditorRequired] public ThemeStudioState State { get; set; } = null!;
    [Parameter] public ThemeStudioGroup Group { get; set; }

    private IEnumerable<ThemeStudioMetricDescriptor> Metrics => ThemeStudioMetadata.Metrics.Where(metric => metric.Group == Group);
    private string GroupId => Group.ToString().ToLowerInvariant();
    private string ResetGroupTestId => $"theme-reset-metrics-{GroupId}";
    private string Title => Group switch
    {
        ThemeStudioGroup.Typography => "Typography",
        ThemeStudioGroup.Geometry => "Geometry, density, and spacing",
        ThemeStudioGroup.Focus => "Focus",
        ThemeStudioGroup.Motion => "Motion",
        _ => Group.ToString()
    };
    private string Description => Group switch
    {
        ThemeStudioGroup.Typography => "Set the sans-serif and monospace font stacks.",
        ThemeStudioGroup.Geometry => "Tune radii, control heights, density, and spacing.",
        ThemeStudioGroup.Focus => "Keep keyboard focus visible across themes.",
        ThemeStudioGroup.Motion => "Set timing, easing, and reduced-motion behavior.",
        _ => string.Empty
    };
}
