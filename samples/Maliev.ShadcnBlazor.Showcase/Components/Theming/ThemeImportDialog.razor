@namespace Maliev.ShadcnBlazor.Showcase.Components.Theming
@using Maliev.ShadcnBlazor.Showcase.Export
@inject IJSRuntime JavaScript
@implements IAsyncDisposable

<dialog class="theme-transfer-dialog"
        id="theme-import-dialog"
        data-testid="theme-import-dialog"
        aria-labelledby="theme-import-title">
    <form method="dialog">
        <div class="theme-transfer-dialog__heading">
            <div>
                <span class="theme-inspector__eyebrow">Local JSON import</span>
                <h2 id="theme-import-title">Import a theme</h2>
            </div>
            <button type="button" class="theme-transfer-dialog__close" aria-label="Close theme import" @onclick="CloseAsync">×</button>
        </div>
        <p>Choose a canonical <code>theme.json</code> file. The file is validated before the current theme changes.</p>
        <label for="theme-import-file">Theme JSON file</label>
        <InputFile id="theme-import-file"
                   data-testid="theme-import-file"
                   accept="application/json,.json"
                   OnChange="ImportAsync" />
        <p class="theme-transfer-dialog__hint">Maximum file size: @ThemeImportService.MaxImportBytes bytes. JSON only; ZIP import is not supported.</p>
        <div class="theme-transfer-dialog__status"
             data-testid="theme-import-status"
             aria-live="polite"
             role="status">
            @foreach (var diagnostic in _diagnostics)
            {
                <p>@diagnostic</p>
            }
        </div>
    </form>
</dialog>

@code {
    [Parameter, EditorRequired] public ThemeStudioState State { get; set; } = null!;
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    private IReadOnlyList<string> _diagnostics = [];
    private readonly ThemeImportService _importer = new();
    private IJSObjectReference? _dialogModule;
    private DotNetObjectReference<ThemeImportDialog>? _selfReference;
    private bool _shown;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || Open == _shown)
            return;
        try
        {
            _dialogModule ??= await JavaScript.InvokeAsync<IJSObjectReference>("import", "./js/theme-transfer-dialog.js");
            if (_selfReference is null)
            {
                _selfReference = DotNetObjectReference.Create(this);
                await _dialogModule.InvokeVoidAsync("connect", "theme-import-dialog", _selfReference);
            }
            await _dialogModule.InvokeVoidAsync(Open ? "showModal" : "close", "theme-import-dialog");
            _shown = Open;
        }
        catch (Exception exception) when (exception is JSException or JSDisconnectedException or TaskCanceledException or OperationCanceledException)
        {
            _diagnostics = [$"Import dialog could not be {(Open ? "opened" : "closed")}: {exception.Message}"];
        }
    }

    private async Task ImportAsync(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (file.Size > ThemeImportService.MaxImportBytes)
        {
            _diagnostics = [$"Theme JSON exceeds the maximum import size of {ThemeImportService.MaxImportBytes} bytes. The current theme was not changed."];
            return;
        }

        try
        {
            await using var stream = file.OpenReadStream(ThemeImportService.MaxImportBytes);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            var result = _importer.Import(memory.ToArray(), file.Name, file.ContentType);
            if (!result.Succeeded || result.Theme is null)
            {
                _diagnostics = result.Diagnostics.Concat(["The current theme was not changed."]).ToArray();
                return;
            }

            if (!State.Import(result.Theme))
            {
                _diagnostics = [State.ImportDiagnostic ?? "The imported theme was not applied."];
                return;
            }

            _diagnostics = result.Diagnostics.Concat([$"Imported {file.Name} successfully."]).ToArray();
        }
        catch (IOException exception)
        {
            _diagnostics = [$"Theme file could not be read: {exception.Message}. The current theme was not changed."];
        }
    }

    private async Task CloseAsync()
    {
        if (_dialogModule is not null && _shown)
            await _dialogModule.InvokeVoidAsync("close", "theme-import-dialog");
        _shown = false;
        await OpenChanged.InvokeAsync(false);
    }

    [JSInvokable]
    public async Task OnNativeClosed()
    {
        if (_disposed || !_shown)
            return;
        _shown = false;
        await OpenChanged.InvokeAsync(false);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_dialogModule is null)
        {
            _selfReference?.Dispose();
            return;
        }
        try
        {
            await _dialogModule.InvokeVoidAsync("disconnect", "theme-import-dialog");
            await _dialogModule.DisposeAsync();
        }
        catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException or OperationCanceledException)
        {
        }
        finally
        {
            _selfReference?.Dispose();
        }
    }
}
