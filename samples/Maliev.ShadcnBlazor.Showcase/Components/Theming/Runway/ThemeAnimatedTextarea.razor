@namespace Maliev.ShadcnBlazor.Showcase.Components.Theming.Runway

<div class="theme-animated-textarea"
     data-animated-textarea
     data-interacted="@(_interacted ? "true" : "false")"
     @onpointerdown="Reveal"
     @onfocusin="Reveal">
    <ShadcnTextarea TValue="string"
                    Value="@Value"
                    ValueChanged="OnValueChanged"
                    Placeholder="@Placeholder"
                    ReadOnly="@ReadOnly"
                    Disabled="@Disabled" />
    @if (!_interacted && !string.IsNullOrEmpty(Value))
    {
        <span @key="_generation" class="theme-animated-textarea__ink" aria-hidden="true">@Value</span>
    }
</div>

@code {
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Disabled { get; set; }
    private string _previousValue = string.Empty;
    private bool _interacted;
    private int _generation;

    protected override void OnParametersSet()
    {
        if (string.Equals(_previousValue, Value, StringComparison.Ordinal)) return;
        _previousValue = Value;
        _interacted = false;
        _generation++;
    }

    private void Reveal() => _interacted = true;

    private async Task OnValueChanged(string? value)
    {
        _interacted = true;
        await ValueChanged.InvokeAsync(value ?? string.Empty);
    }
}
