@namespace Maliev.ShadcnBlazor.Showcase.Components.Theming.Runway
@using Maliev.ShadcnBlazor.Components.Layout
@using Maliev.ShadcnBlazor.Showcase.Theming.Runway
@inject IThemeUseCaseRegistry Registry
@inject ThemeRunwayState AnimationState
@implements IDisposable

<ShadcnRevealGroup Tag="section"
                   Class="theme-bento"
                   Paused="Paused"
                   ReducedMotion="ReducedMotion"
                   Threshold="0.08"
                   RootMargin="32px 0px"
                   Stagger="60"
                   Once="true"
                   aria-label="Curated realistic component use cases"
                   data-testid="theme-bento"
                   data-render-cycle="@_parameterCycle"
                   data-animation-paused="@(Paused ? "true" : "false")"
                   data-reduced-motion="@(ReducedMotion ? "true" : "false")">
    <ShadcnBentoGrid Class="theme-bento__grid" Columns="4" MediumColumns="2" Gap="1rem" Masonry="true">
        @foreach (var card in Registry.All.OrderBy(card => card.Order))
        {
            <ShadcnBentoItem @key="card.Id"
                             ColumnSpan="@ColumnSpan(card.Size)"
                             RowSpan="@RowSpan(card.Size)"
                             data-use-case-item="@card.Id">
                <ShadcnReveal @key="card.Id"
                              Class="theme-bento__reveal"
                              Effect="@RevealEffect(card.Order)"
                              Cascade="true">
                    <ThemeUseCaseCardHost Definition="card"
                                          Frame="AnimationState.Frame"
                                          Locale="Locale" />
                </ShadcnReveal>
            </ShadcnBentoItem>
        }
    </ShadcnBentoGrid>
</ShadcnRevealGroup>

@code {
    [Parameter] public ThemeStudioLocale Locale { get; set; }
    [Parameter] public bool Paused { get; set; }
    [Parameter] public bool ReducedMotion { get; set; }
    private int _parameterCycle;

    protected override void OnInitialized()
    {
        AnimationState.Changed += OnChanged;
        ApplyMotionSettings();
        AnimationState.Start();
    }

    protected override void OnParametersSet()
    {
        _parameterCycle++;
        ApplyMotionSettings();
    }

    private void ApplyMotionSettings()
    {
        AnimationState.SetPersistentPaused(Paused);
        AnimationState.SetReducedMotion(ReducedMotion);
    }

    private void OnChanged(object? sender, EventArgs args) => _ = InvokeAsync(StateHasChanged);

    private static int ColumnSpan(ThemeBentoSize size) => size == ThemeBentoSize.Wide ? 2 : 1;

    private static int RowSpan(ThemeBentoSize size) => size == ThemeBentoSize.Tall ? 2 : 1;

    private static ShadcnRevealEffect RevealEffect(int order) => (order % 5) switch
    {
        1 => ShadcnRevealEffect.Clip,
        2 => ShadcnRevealEffect.Scale,
        3 => ShadcnRevealEffect.Fade,
        _ => ShadcnRevealEffect.Rise
    };

    public void Dispose() => AnimationState.Changed -= OnChanged;
}
