@namespace Maliev.ShadcnBlazor.Showcase.Components.Theming.Runway
@using Maliev.ShadcnBlazor.Components.Icons
@using Maliev.ShadcnBlazor.Icons.Tabler

<div class="theme-preset-dock" aria-label="Active curated theme" data-testid="theme-preset-dock">
    <ShadcnIcon Icon="@PreviewIcon" Size="22" Class="theme-preset-dock__icon" Title="@($"{State.IconLibrary} factory icon")" />
    <div><span>Preset</span><strong>@PresetName</strong></div>
    <div><span>Style</span><strong>@State.StyleId</strong></div>
    <div><span>Accent</span><strong>@State.BaseColorId</strong></div>
    <div><span>Radius</span><strong>@PresetRadius</strong></div>
    <ShadcnButton Variant="ShadcnButtonVariant.Outline" Size="ShadcnButtonSize.Small" OnClick="Shuffle" data-testid="runway-shuffle">Shuffle</ShadcnButton>
    <ShadcnButton Variant="ShadcnButtonVariant.Outline" Size="ShadcnButtonSize.Small" OnClick="TogglePause" aria-pressed="@(State.Workbench.RunwayPaused ? "true" : "false")" data-testid="runway-dock-pause">@(State.Workbench.RunwayPaused ? "Resume" : "Pause")</ShadcnButton>
</div>

@code {
    [Parameter, EditorRequired] public ThemeStudioState State { get; set; } = null!;
    private string PresetName => State.CuratedPresets.FirstOrDefault(item => item.Id == State.SelectedPresetId)?.DisplayName ?? "Custom imported";
    private string PresetRadius => State.CuratedPresets.FirstOrDefault(item => item.Id == State.SelectedPresetId)?.Radius.ToString() ?? State.RadiusPreset.ToString();
    // These three reviewed geometries are extracted from the pinned companion packages. Keeping the preview
    // glyphs local prevents every visitor from downloading three complete optional catalogs at application boot.
    private static readonly ShadcnIconData LucideFactory = new("lucide", "factory", "0 0 24 24", """
        <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M12 16h.01" /><path d="M16 16h.01" /><path d="M3 19a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8.5a.5.5 0 0 0-.769-.422l-4.462 2.844A.5.5 0 0 1 15 10.5v-2a.5.5 0 0 0-.769-.422L9.77 10.922A.5.5 0 0 1 9 10.5V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2z" /><path d="M8 16h.01" /></g>
        """);
    private static readonly ShadcnIconData PhosphorFactory = new("phosphor", "factory", "0 0 256 256", """
        <g fill="currentColor"><path d="M116,176a8,8,0,0,1-8,8H80a8,8,0,0,1,0-16h28A8,8,0,0,1,116,176Zm60-8H148a8,8,0,0,0,0,16h28a8,8,0,0,0,0-16Zm72,48a8,8,0,0,1-8,8H16a8,8,0,0,1,0-16H32V88a8,8,0,0,1,12.8-6.4L96,120V88a8,8,0,0,1,12.8-6.4l38.74,29.05L159.1,29.74A16.08,16.08,0,0,1,174.94,16h18.12A16.08,16.08,0,0,1,208.9,29.74l15,105.13s.08.78.08,1.13v72h16A8,8,0,0,1,248,216Zm-85.86-94.4,8.53,6.4h36.11L193.06,32H174.94ZM48,208H208V144H168a8,8,0,0,1-4.8-1.6l-14.4-10.8,0,0L112,104v32a8,8,0,0,1-12.8,6.4L48,104Z" /></g>
        """);
    private static readonly ShadcnIconData HugeiconsFactory = new("hugeicons", "factory", "0 0 24 24", """
        <g fill="none"><path d="M9 13.5V9C9 8.05719 9 7.58579 8.70711 7.29289C8.41421 7 7.94281 7 7 7H5C4.05719 7 3.58579 7 3.29289 7.29289C3 7.58579 3 8.05719 3 9V18C3 19.8856 3 20.8284 3.58579 21.4142C4.17157 22 5.11438 22 7 22H9M9 13.5L12.3167 11.8416C13.4174 11.2913 13.9678 11.0161 14.3942 11.199C14.4853 11.2381 14.57 11.2905 14.6457 11.3545C15 11.6541 15 12.2694 15 13.5L18.1056 11.9472C19.4028 11.2986 20.0515 10.9743 20.5257 11.2674C21 11.5605 21 12.2857 21 13.7361V18C21 19.8856 21 20.8284 20.4142 21.4142C19.8284 22 18.8856 22 17 22H9M9 13.5V22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /><path d="M3 10H9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /><path d="M13 2H8C7.05719 2 6.58579 2 6.29289 2.29289C6 2.58579 6 3.05719 6 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /><path d="M16 2H17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /><path d="M11 5L17 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></g>
        """);
    private ShadcnIconData PreviewIcon => State.IconLibrary switch
    {
        ThemeStudioIconLibrary.Tabler => TablerIconCatalog.Instance.Get("building-factory"),
        ThemeStudioIconLibrary.Phosphor => PhosphorFactory,
        ThemeStudioIconLibrary.Hugeicons => HugeiconsFactory,
        _ => LucideFactory
    };
    private void Shuffle() => State.ShufflePreset();
    private void TogglePause() => State.Workbench.SetRunwayPaused(!State.Workbench.RunwayPaused);
}
