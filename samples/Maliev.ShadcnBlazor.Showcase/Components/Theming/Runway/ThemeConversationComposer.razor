@namespace Maliev.ShadcnBlazor.Showcase.Components.Theming.Runway
@using Maliev.ShadcnBlazor.Components.Icons
@using Maliev.ShadcnBlazor.Showcase.Theming.Runway
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="theme-runway-composer" @ref="_root">
    <ShadcnInput TValue="string" @bind-Value="_text" Placeholder="@T("Ask about this work order")" />
    <ShadcnButton Size="ShadcnButtonSize.Icon" aria-label="@T("Send message")" @onclick="SendAsync">
        <span data-theme-semantic-icon="send"><ShadcnIcon Icon="@SendIcon" Size="16" /></span>
    </ShadcnButton>
</div>

@code {
    [Parameter, EditorRequired] public EventCallback<string> OnSend { get; set; }
    [Parameter] public ThemeStudioLocale Locale { get; set; }
    [CascadingParameter(Name = "ThemeStudioIconLibrary")] public ThemeStudioIconLibrary IconLibrary { get; set; }
    private string _text = string.Empty;
    private ElementReference _root;
    private IJSObjectReference? _module;
    private IJSObjectReference? _scrollGuard;
    private ShadcnIconData SendIcon => ThemeStudioIconResolver.ResolveSemantic(IconLibrary, "send");
    private string T(string english) => ThemeRunwayCopy.Get(Locale, english);

    private async Task SendAsync()
    {
        var message = _text.Trim();
        if (message.Length == 0) return;
        _text = string.Empty;
        await OnSend.InvokeAsync(message);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/theme-studio.js");
        _scrollGuard = await _module.InvokeAsync<IJSObjectReference>("preservePreviewScrollOnInput", _root);
    }

    public async ValueTask DisposeAsync()
    {
        if (_scrollGuard is not null) { try { await _scrollGuard.InvokeVoidAsync("dispose"); await _scrollGuard.DisposeAsync(); } catch (JSDisconnectedException) { } }
        if (_module is not null) { try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { } }
    }
}
