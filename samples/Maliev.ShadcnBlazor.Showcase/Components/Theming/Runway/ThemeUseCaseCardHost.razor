            <ShadcnNavigationMenu Label="@T("Queue navigation")"><ShadcnNavigationMenuList><ShadcnNavigationMenuItem Value="active"><ShadcnNavigationMenuLink Href="#theme-category-overview" Class="shadcn-navigation-menu-link--trigger">@T("Active")</ShadcnNavigationMenuLink></ShadcnNavigationMenuItem><ShadcnNavigationMenuItem Value="archived"><ShadcnNavigationMenuLink Href="#theme-category-data" Class="shadcn-navigation-menu-link--trigger">@T("Archived")</ShadcnNavigationMenuLink></ShadcnNavigationMenuItem></ShadcnNavigationMenuList></ShadcnNavigationMenu>
