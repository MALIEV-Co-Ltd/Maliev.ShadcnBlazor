    private void SaveContact(MouseEventArgs _) => _contactStatus = "Production contact saved for {0}.";
    private void CancelContact(MouseEventArgs _) => _contactStatus = "Contact changes discarded.";
    private void ReleaseDrawerDispatch(MouseEventArgs _) => _drawerStatus = "Dispatch released to Kerry Express.";
    private void HoldDrawerDispatch(MouseEventArgs _) => _drawerStatus = "Dispatch remains on hold.";
