@namespace Maliev.ShadcnBlazor.Showcase.Components.Theming.Runway
@using System.Globalization
@using Maliev.ShadcnBlazor.Components.Conversation
@using Maliev.ShadcnBlazor.Components.DataDisplay
@using Maliev.ShadcnBlazor.Components.Icons
@using Maliev.ShadcnBlazor.Components.Overlays
@using Maliev.ShadcnBlazor.Showcase.Theming.Runway

<ShadcnCard Class="theme-use-case-card"
         data-use-case-id="@Definition.Id"
         data-bento-size="@Definition.Size.ToString().ToLowerInvariant()">
    @if (Definition.Id != "project-questionnaire")
    {
        <ShadcnCardHeader Class="theme-use-case-card__header">
            <ShadcnCardTitle>@Title</ShadcnCardTitle>
        </ShadcnCardHeader>
    }

    <ShadcnCardContent Class="theme-use-case-card__content">
    @switch (Definition.Id)
    {
        case "production-capacity":
            <div class="theme-runway-stat"><strong>@FormatPercent(Frame.CapacityPercent)</strong><span>5-axis capacity · Cell A3</span></div>
            <ShadcnProgress Class="theme-status-success" Value="@ClampPercent(Frame.CapacityPercent)"><ShadcnProgressLabel>Weekly capacity</ShadcnProgressLabel><ShadcnProgressValue /></ShadcnProgress>
            <div class="theme-use-case-card__actions"><ShadcnBadge Class="theme-status-success">On schedule</ShadcnBadge><ShadcnButton Size="ShadcnButtonSize.Small" Variant="ShadcnButtonVariant.Outline">Review plan</ShadcnButton></div>
            break;
        case "production-analytics":
            <ShadcnChart Class="theme-production-chart" Id="theme-production-analytics" Title="Completed operations" Description="Six-week output by production cell" Type="ShadcnChartType.Bar" Config="ProductionChartConfig" Categories="ProductionChartCategories" Series="ProductionChartSeries" ShowGrid="true" ShowMajorGrid="true" ShowMinorGrid="true" ShowPrimaryYAxis="true" ShowLegend="true" LegendInteractive="true" InitialWidth="520" InitialHeight="230" />
            break;
        case "operator-profile":
            <div class="theme-runway-profile"><ShadcnAvatar><ShadcnAvatarImage Source="images/avatars/operator-thai.png" Alt="Narin S., Thai CNC engineer" /><ShadcnAvatarFallback>NS</ShadcnAvatarFallback></ShadcnAvatar><div><strong>Narin S.</strong><span>CNC engineer · Samut Prakan</span></div></div>
            <label>Name<ThemeAnimatedInput Value="@(_profileName ?? "Narin S.")" ValueChanged="value => _profileName = value" /></label>
            <label>Shift<ThemeAnimatedInput Value="@ShiftValue" ReadOnly="true" /></label>
            <ShadcnButton Size="ShadcnButtonSize.Small">Save profile</ShadcnButton>
            break;
        case "drawing-attachment":
            <ShadcnAttachment Title="housing-rev-d.step" State="ShadcnAttachmentState.Uploading" Progress="@ClampPercent(Frame.UploadPercent)">
                <ShadcnAttachmentMedia><ShadcnIcon Icon="@FileIcon" Size="20" /></ShadcnAttachmentMedia>
                <ShadcnAttachmentContent><ShadcnAttachmentTitle>housing-rev-d.step</ShadcnAttachmentTitle><ShadcnAttachmentDescription>8.4 MB · STEP · uploading</ShadcnAttachmentDescription></ShadcnAttachmentContent>
                <ShadcnAttachmentActions><ShadcnAttachmentAction Action="ShadcnAttachmentActionKind.Cancel" AccessibleName="Cancel drawing upload">Cancel</ShadcnAttachmentAction></ShadcnAttachmentActions>
            </ShadcnAttachment>
            <ShadcnAttachment Title="inspection-plan.pdf" State="ShadcnAttachmentState.Done">
                <ShadcnAttachmentMedia><ShadcnIcon Icon="@FileIcon" Size="20" /></ShadcnAttachmentMedia>
                <ShadcnAttachmentContent><ShadcnAttachmentTitle>inspection-plan.pdf</ShadcnAttachmentTitle><ShadcnAttachmentDescription>1.2 MB · ready for review</ShadcnAttachmentDescription></ShadcnAttachmentContent>
                <ShadcnAttachmentActions><ShadcnAttachmentAction Action="ShadcnAttachmentActionKind.Remove" AccessibleName="Remove inspection plan">Remove</ShadcnAttachmentAction></ShadcnAttachmentActions>
            </ShadcnAttachment>
            break;
        case "quotation-files":
            <ShadcnDropzone Class="theme-runway-dropzone" Accept=".step,.stp,.pdf" Multiple="true" MaxFiles="5" MaxFileSize="20971520" Instructions="Drop production drawings here" Description="STEP or PDF · up to 20 MB" />
            <div class="theme-runway-file"><span>enclosure-rev-c.step</span><ShadcnBadge Variant="ShadcnBadgeVariant.Secondary">@FormatPercent(Frame.UploadPercent)</ShadcnBadge></div>
            <ShadcnProgress Value="@ClampPercent(Frame.UploadPercent)"><ShadcnProgressLabel>Upload progress</ShadcnProgressLabel></ShadcnProgress>
            break;
        case "inspection-table":
            <ShadcnTable Borders="true" ExpectedColumnCount="4">
                <ShadcnTableCaption>Latest dimensional checks</ShadcnTableCaption>
                <ShadcnTableHeader><ShadcnTableRow><ShadcnTableHead>Feature</ShadcnTableHead><ShadcnTableHead>Target</ShadcnTableHead><ShadcnTableHead>Measured</ShadcnTableHead><ShadcnTableHead>Status</ShadcnTableHead></ShadcnTableRow></ShadcnTableHeader>
                <ShadcnTableBody>
                    <ShadcnTableRow><ShadcnTableCell>Bore 4</ShadcnTableCell><ShadcnTableCell>25.000 mm</ShadcnTableCell><ShadcnTableCell>24.998 mm</ShadcnTableCell><ShadcnTableCell><ShadcnBadge Class="theme-status-success">Pass</ShadcnBadge></ShadcnTableCell></ShadcnTableRow>
                    <ShadcnTableRow><ShadcnTableCell>Datum A</ShadcnTableCell><ShadcnTableCell>0.020 mm</ShadcnTableCell><ShadcnTableCell>0.014 mm</ShadcnTableCell><ShadcnTableCell><ShadcnBadge Class="theme-status-success">Pass</ShadcnBadge></ShadcnTableCell></ShadcnTableRow>
                    <ShadcnTableRow><ShadcnTableCell>Surface</ShadcnTableCell><ShadcnTableCell>Ra 1.6</ShadcnTableCell><ShadcnTableCell>Ra 1.4</ShadcnTableCell><ShadcnTableCell><ShadcnBadge Variant="ShadcnBadgeVariant.Secondary">Review</ShadcnBadge></ShadcnTableCell></ShadcnTableRow>
                </ShadcnTableBody>
            </ShadcnTable>
            break;
        case "shipping-handoff":
            <label>Factory<ThemeAnimatedInput Value="@FactoryValue" ReadOnly="true" /></label>
            <div class="theme-runway-fields"><label>Dock<ThemeAnimatedInput Value="@DockValue" ReadOnly="true" /></label><label>Reference<ThemeAnimatedInput Value="@ReferenceValue" ReadOnly="true" /></label></div>
            <label class="theme-runway-check"><ShadcnCheckbox Value="@_saveAddress" ValueChanged="value => _saveAddress = value ?? false" /> Save as production handoff</label>
            <ShadcnButton Size="ShadcnButtonSize.Small" @onclick="ConfirmHandoff">Confirm address</ShadcnButton>
            @if (_handoffSaved) { <p class="theme-runway-action-status" role="status">Handoff saved for dispatch.</p> }
            break;
        case "quotation-data-table":
            <div class="theme-runway-table-summary"><span><strong>Quotation review queue</strong><small>Three active requests awaiting production decisions</small></span><ShadcnBadge Variant="ShadcnBadgeVariant.Secondary">3 active</ShadcnBadge></div>
            <ShadcnDataTable TItem="QuotationRow" Items="QuotationRows" Columns="QuotationColumns" RowKey="@(row => row.Id)" State="_quotationTableState" StateChanged="OnQuotationTableStateChanged" Selectable="true" FilterPlaceholder="Search quotations" EmptyText="No quotations found" />
            break;
        case "inspection-alerts":
            @foreach (var option in AlertOptions)
            {
                <label class="theme-runway-check"><ShadcnCheckbox Value="@option.Enabled" /><span><strong>@option.Label</strong><small>@option.Description</small></span></label>
            }
            <div class="theme-use-case-card__actions"><span>Quiet hours</span><ShadcnSwitch Value="true" aria-label="Use quiet hours" /></div>
            break;
        case "quality-alert":
            <ShadcnAlert Variant="ShadcnAlertVariant.Destructive"><ShadcnAlertTitle>Inspection hold</ShadcnAlertTitle><ShadcnAlertDescription>Bore 4 is 0.012 mm below the lower tolerance. Review the probe result before machining resumes.</ShadcnAlertDescription><ShadcnAlertAction><ShadcnButton Size="ShadcnButtonSize.Small" Variant="ShadcnButtonVariant.Outline">Open report</ShadcnButton></ShadcnAlertAction></ShadcnAlert>
            <ShadcnAlert><ShadcnAlertTitle>Calibration current</ShadcnAlertTitle><ShadcnAlertDescription>Probe P-08 was calibrated today at 08:10.</ShadcnAlertDescription></ShadcnAlert>
            break;
        case "deposit-approval":
            <div class="theme-runway-amount"><span>Manufacturing deposit</span><strong>฿48,500.00</strong></div>
            <ShadcnSeparator />
            <dl class="theme-runway-summary"><div><dt>Quotation</dt><dd>Q-2847</dd></div><div><dt>Due</dt><dd>23 Aug 2569</dd></div><div><dt>Terms</dt><dd>50% before production</dd></div></dl>
            <div class="theme-use-case-card__actions"><ShadcnButton Size="ShadcnButtonSize.Small" Variant="ShadcnButtonVariant.Outline" @onclick="ReviewDeposit">Review</ShadcnButton><ShadcnButton Size="ShadcnButtonSize.Small" Disabled="_depositApproved" @onclick="ApproveDeposit">@(_depositApproved ? "Approved" : "Approve deposit")</ShadcnButton></div>
            @if (_depositStatus is not null) { <p class="theme-runway-action-status" role="status">@_depositStatus</p> }
            break;
        case "assigned-reviewers":
            <ShadcnAvatarGroup Class="theme-runway-reviewer-avatars"><ShadcnAvatar Size="ShadcnAvatarSize.Small"><ShadcnAvatarImage Source="images/avatars/operator-thai.png" Alt="Nattapong, Thai machining reviewer" /><ShadcnAvatarFallback>NP</ShadcnAvatarFallback></ShadcnAvatar><ShadcnAvatar Size="ShadcnAvatarSize.Small"><ShadcnAvatarImage Source="images/avatars/reviewer-thai.png" Alt="Kanda, Thai quality reviewer" /><ShadcnAvatarFallback>KT</ShadcnAvatarFallback></ShadcnAvatar><ShadcnAvatar Size="ShadcnAvatarSize.Small"><ShadcnAvatarImage Source="images/avatars/coordinator-thai.png" Alt="Pim, Thai logistics reviewer" /><ShadcnAvatarFallback>PS</ShadcnAvatarFallback></ShadcnAvatar>@if (_reviewersExpanded) { <ShadcnAvatar Size="ShadcnAvatarSize.Small"><ShadcnAvatarFallback>SK</ShadcnAvatarFallback></ShadcnAvatar><ShadcnAvatar Size="ShadcnAvatarSize.Small"><ShadcnAvatarFallback>AP</ShadcnAvatarFallback></ShadcnAvatar><ShadcnAvatar Size="ShadcnAvatarSize.Small"><ShadcnAvatarFallback>TN</ShadcnAvatarFallback></ShadcnAvatar><ShadcnAvatar Size="ShadcnAvatarSize.Small"><ShadcnAvatarFallback>WR</ShadcnAvatarFallback></ShadcnAvatar> }<ShadcnAvatarGroupCount Size="ShadcnAvatarSize.Small" Expanded="_reviewersExpanded" ExpandLabel="Show four more reviewers" OnClick="ToggleReviewers">@(_reviewersExpanded ? "−4" : "+4")</ShadcnAvatarGroupCount></ShadcnAvatarGroup>
            <ul class="theme-runway-reviewers"><li><span>Nattapong · Machining</span><ShadcnBadge Class="theme-status-success">Ready</ShadcnBadge></li><li><span>Kanda · Quality</span><ShadcnBadge Variant="ShadcnBadgeVariant.Secondary">Reviewing</ShadcnBadge></li><li><span>Pim · Logistics</span><ShadcnBadge Variant="ShadcnBadgeVariant.Outline">Queued</ShadcnBadge></li></ul>
            <ShadcnButton Size="ShadcnButtonSize.Small" Variant="ShadcnButtonVariant.Outline">Manage reviewers</ShadcnButton>
            break;
        case "conversation-marker":
            <ShadcnMarker Variant="ShadcnMarkerVariant.Separator"><ShadcnMarkerContent>14:32 · WO-2418</ShadcnMarkerContent></ShadcnMarker>
            <div class="theme-runway-activity"><ShadcnAvatar Size="ShadcnAvatarSize.Small"><ShadcnAvatarImage Source="images/avatars/reviewer-thai.png" Alt="Kanda, Thai quality reviewer" /><ShadcnAvatarFallback>KT</ShadcnAvatarFallback></ShadcnAvatar><span><strong>Final inspection uploaded</strong><small>Kanda attached the signed dimensional report.</small></span><ShadcnBadge Class="theme-status-success">Ready</ShadcnBadge></div>
            <ShadcnMarker Variant="ShadcnMarkerVariant.Default" Live="true"><ShadcnMarkerIcon><span class="shadcn-marker-loader" aria-hidden="true"></span></ShadcnMarkerIcon><ShadcnMarkerContent Streaming="true">Dispatch team is preparing the Bangkok handoff</ShadcnMarkerContent></ShadcnMarker>
            break;
        case "work-order-navigation":
            <nav aria-label="Work order path" class="theme-runway-breadcrumb"><a href="theme" @onclick:preventDefault>Production</a><span>/</span><a href="theme" @onclick:preventDefault>Cell A3</a><span>/</span><strong>WO-2418</strong></nav>
            <div class="theme-runway-nav-list"><button type="button"><span><strong>Change process plan</strong><small>12 operations · revision C</small></span><ShadcnIcon Icon="@ChevronIcon" Size="16" /></button><button type="button"><span><strong>Schedule inspection</strong><small>Final dimensional report</small></span><ShadcnIcon Icon="@ChevronIcon" Size="16" /></button><button type="button"><span><strong>Release delivery</strong><small>Awaiting quality approval</small></span><ShadcnIcon Icon="@ChevronIcon" Size="16" /></button></div>
            break;
        case "machine-cell":
            <div class="theme-runway-machine"><div><strong>DMG MORI DMU 50</strong><span>5-axis milling · Cell A3</span></div></div>
            <div class="theme-runway-stat"><strong data-testid="machine-load-percent">@FormatPercent(Frame.CapacityPercent - 7)</strong><span>Spindle load</span></div>
            <ShadcnProgress Value="@ClampPercent(Frame.CapacityPercent - 7)"><ShadcnProgressLabel>Spindle load</ShadcnProgressLabel><ShadcnProgressValue /></ShadcnProgress>
            <ShadcnAlert><ShadcnAlertTitle>In-process inspection</ShadcnAlertTitle><ShadcnAlertDescription>Bore diameter within tolerance at 14:20.</ShadcnAlertDescription></ShadcnAlert>
            break;
        case "assistant-conversation":
            <div class="theme-runway-chat" aria-label="Assistant conversation preview">
                <ShadcnMessageScrollerProvider AutoScroll="true" DefaultScrollPosition="ShadcnMessageDefaultScrollPosition.End">
                    <ShadcnMessageScroller>
                        <ShadcnMessageScrollerViewport AccessibleName="Assistant conversation messages">
                            <ShadcnMessageScrollerContent>
                                <ShadcnMarker Variant="ShadcnMarkerVariant.Separator"><ShadcnMarkerContent>Today · WO-2418</ShadcnMarkerContent></ShadcnMarker>
                                <ShadcnMessageGroup>
                                    @foreach (var turn in _conversationTurns)
                                    {
                                        <ShadcnMessageScrollerItem @key="turn.Id" MessageId="@turn.Id" ScrollAnchor="@(turn.Id == _conversationTurns[^1].Id)">
                                            <ShadcnMessage Align="@(turn.Assistant ? ShadcnLogicalAlign.Start : ShadcnLogicalAlign.End)">
                                                @if (turn.Assistant)
                                                {
                                                    <ShadcnMessageAvatar><ShadcnAvatar Size="ShadcnAvatarSize.Small"><ShadcnAvatarImage Source="images/avatars/assistant-thai.png" Alt="MALIEV Assistant" /><ShadcnAvatarFallback>MA</ShadcnAvatarFallback></ShadcnAvatar></ShadcnMessageAvatar>
                                                }
                                                <ShadcnMessageContent><ShadcnMessageBody>
                                                    @if (turn.Assistant) { <ShadcnMessageHeader>MALIEV Assistant</ShadcnMessageHeader> }
                                                    <ShadcnBubble Align="@(turn.Assistant ? ShadcnLogicalAlign.Start : ShadcnLogicalAlign.End)" Variant="ShadcnBubbleVariant.Ghost"><ShadcnBubbleContent>
                                                        @if (turn.Assistant && turn.Id == _conversationTurns[^1].Id)
                                                        {
                                                            <span class="theme-runway-typing-text">@turn.Text</span>
                                                        }
                                                        else { @turn.Text }
                                                    </ShadcnBubbleContent></ShadcnBubble>
                                                </ShadcnMessageBody></ShadcnMessageContent>
                                            </ShadcnMessage>
                                        </ShadcnMessageScrollerItem>
                                    }
                                </ShadcnMessageGroup>
                            </ShadcnMessageScrollerContent>
                        </ShadcnMessageScrollerViewport>
                    </ShadcnMessageScroller>
                </ShadcnMessageScrollerProvider>
                <div class="theme-runway-composer"><ShadcnInput TValue="string" @bind-Value="_composerText" Placeholder="Ask about this work order" /><ShadcnButton Size="ShadcnButtonSize.Icon" aria-label="Send message" @onclick="SendConversationMessage"><ShadcnIcon Icon="@SendIcon" Size="16" /></ShadcnButton></div>
            </div>
            break;
        case "project-questionnaire":
            <ShadcnQuestionnaire Items="QuestionnaireItems" DefaultItem="scope" Shortcuts="ShadcnQuestionnaireShortcutMode.Numbers" AccessibleName="Production review questionnaire">
                <ShadcnQuestionnaireProgress AccessibleName="Questionnaire progress" />
                <ShadcnQuestionnaireItem Name="scope">
                    <ShadcnQuestionnaireTitle>Choose the review scope</ShadcnQuestionnaireTitle>
                    <ShadcnQuestionnaireDescription>Select the team that should inspect WO-2418.</ShadcnQuestionnaireDescription>
                    <ShadcnQuestionnaireChoices>
                        <ShadcnQuestionnaireChoice Value="machining">Machining<ShadcnQuestionnaireChoiceDescription>Toolpath and surface finish</ShadcnQuestionnaireChoiceDescription></ShadcnQuestionnaireChoice>
                        <ShadcnQuestionnaireChoice Value="quality">Quality<ShadcnQuestionnaireChoiceDescription>Dimensions and inspection evidence</ShadcnQuestionnaireChoiceDescription></ShadcnQuestionnaireChoice>
                    </ShadcnQuestionnaireChoices>
                    <ShadcnQuestionnaireError />
                </ShadcnQuestionnaireItem>
                <ShadcnQuestionnaireItem Name="notes">
                    <ShadcnQuestionnaireTitle>Add inspection notes</ShadcnQuestionnaireTitle>
                    <ShadcnQuestionnaireDescription>Include the customer-specific acceptance criteria.</ShadcnQuestionnaireDescription>
                    <ShadcnQuestionnaireInput AccessibleName="Inspection notes" />
                    <ShadcnQuestionnaireError />
                </ShadcnQuestionnaireItem>
                <ShadcnQuestionnaireActions><ShadcnQuestionnairePrevious>Back</ShadcnQuestionnairePrevious><ShadcnQuestionnaireSkip>Skip</ShadcnQuestionnaireSkip><ShadcnQuestionnaireNext>Next</ShadcnQuestionnaireNext><ShadcnQuestionnaireSubmit>Submit review</ShadcnQuestionnaireSubmit></ShadcnQuestionnaireActions>
            </ShadcnQuestionnaire>
            break;
        case "issue-report":
            <ShadcnAlert Variant="@(Frame.FormStep == 3 ? ShadcnAlertVariant.Destructive : ShadcnAlertVariant.Default)"><ShadcnAlertTitle>@(Frame.FormStep == 3 ? "Drawing revision required" : "Report a production issue")</ShadcnAlertTitle><ShadcnAlertDescription>Quality receives the machine, work order, and validation context.</ShadcnAlertDescription></ShadcnAlert>
            <label>Subject<ThemeAnimatedInput Value="@(Frame.FormStep > 0 ? "Tolerance mismatch on bore 4" : string.Empty)" Placeholder="Describe the issue" ReadOnly="true" /></label>
            <label>Details<ThemeAnimatedTextarea Value="@(Frame.FormStep > 1 ? "Measured 24.982 mm against 25.000 ±0.010 mm." : string.Empty)" Placeholder="Add inspection evidence" ReadOnly="true" /></label>
            <ShadcnButton Size="ShadcnButtonSize.Small" @onclick="SubmitIssue">Submit issue</ShadcnButton>
            @if (_issueSubmitted) { <p class="theme-runway-action-status" role="status">Issue sent to Quality.</p> }
            break;
        case "dispatch-confirmation":
            <ShadcnAlert><ShadcnAlertTitle>Release WO-2418 for dispatch?</ShadcnAlertTitle><ShadcnAlertDescription>Three packages passed final inspection. Kerry Express collection is scheduled for 16:00.</ShadcnAlertDescription></ShadcnAlert>
            <dl class="theme-runway-summary"><div><dt>Destination</dt><dd>Bang Na, Bangkok</dd></div><div><dt>Carrier</dt><dd>Kerry Express</dd></div></dl>
            <div class="theme-use-case-card__actions"><ShadcnButton Size="ShadcnButtonSize.Small" Variant="ShadcnButtonVariant.Outline" @onclick="CancelDispatch">Cancel</ShadcnButton><ShadcnButton Size="ShadcnButtonSize.Small" Disabled="_dispatchConfirmed" @onclick="ConfirmDispatch">@(_dispatchConfirmed ? "Dispatched" : "Confirm dispatch")</ShadcnButton></div>
            @if (_dispatchStatus is not null) { <p class="theme-runway-action-status" role="status">@_dispatchStatus</p> }
            break;
        case "quotation-actions":
            <p class="theme-use-case-card__description">Q-2847 · CNC enclosure · Revision C</p>
            <div class="theme-use-case-card__actions">
                <ShadcnBadge Variant="ShadcnBadgeVariant.Secondary">Draft</ShadcnBadge>
                <ShadcnDropdownMenu>
                    <ShadcnDropdownMenuTrigger>Actions</ShadcnDropdownMenuTrigger>
                    <ShadcnDropdownMenuContent>
                        <ShadcnDropdownMenuLabel>Quotation</ShadcnDropdownMenuLabel>
                        <ShadcnDropdownMenuItem>Open details</ShadcnDropdownMenuItem>
                        <ShadcnDropdownMenuItem>Duplicate revision</ShadcnDropdownMenuItem>
                        <ShadcnDropdownMenuSeparator />
                        <ShadcnDropdownMenuItem Variant="ShadcnMenuItemVariant.Destructive">Archive draft</ShadcnDropdownMenuItem>
                    </ShadcnDropdownMenuContent>
                </ShadcnDropdownMenu>
            </div>
            break;
        case "reviewer-details":
            <div class="theme-runway-profile">
                <ShadcnAvatar><ShadcnAvatarImage Source="images/avatars/reviewer-thai.png" Alt="Kanda, Thai quality reviewer" /><ShadcnAvatarFallback>KT</ShadcnAvatarFallback></ShadcnAvatar>
                <div>
                    <ShadcnHoverCard @bind-Open="_reviewerHoverOpen" OpenDelay="@TimeSpan.FromMilliseconds(100)">
                        <ShadcnHoverCardTrigger Href="#reviewer-details">Kanda T.</ShadcnHoverCardTrigger>
                        <ShadcnHoverCardContent>
                            <div class="theme-runway-profile"><ShadcnAvatar><ShadcnAvatarImage Source="images/avatars/reviewer-thai.png" Alt="Kanda, Thai quality reviewer" /><ShadcnAvatarFallback>KT</ShadcnAvatarFallback></ShadcnAvatar><div><strong>Kanda T.</strong><span>Quality engineer · 6 active reviews</span></div></div>
                        </ShadcnHoverCardContent>
                    </ShadcnHoverCard>
                    <span>Final dimensional review</span>
                </div>
            </div>
            <ShadcnTooltipProvider><ShadcnTooltip><ShadcnTooltipTrigger>Due 15:30</ShadcnTooltipTrigger><ShadcnTooltipContent>45 minutes remaining</ShadcnTooltipContent></ShadcnTooltip></ShadcnTooltipProvider>
            break;
        case "file-context":
            <ShadcnAttachment Title="enclosure-rev-c.step" State="ShadcnAttachmentState.Done">
                <ShadcnAttachmentMedia><ShadcnIcon Icon="@FileIcon" Size="20" /></ShadcnAttachmentMedia>
                <ShadcnAttachmentContent><ShadcnAttachmentTitle>enclosure-rev-c.step</ShadcnAttachmentTitle><ShadcnAttachmentDescription>Revision C · STEP · 8.4 MB</ShadcnAttachmentDescription></ShadcnAttachmentContent>
                <ShadcnAttachmentActions><ShadcnAttachmentAction Action="ShadcnAttachmentActionKind.Download" AccessibleName="Download revision C">Download</ShadcnAttachmentAction></ShadcnAttachmentActions>
            </ShadcnAttachment>
            <ShadcnContextMenu>
                <ShadcnContextMenuTrigger Class="theme-bento-context-target">
                    <div class="theme-drawing-review">
                        <div class="theme-drawing-review__meta"><ShadcnBadge Variant="ShadcnBadgeVariant.Secondary">2 comments</ShadcnBadge><span>Updated 14:32</span></div>
                        <div class="theme-runway-profile"><ShadcnAvatar Size="ShadcnAvatarSize.Small"><ShadcnAvatarImage Source="images/avatars/reviewer-thai.png" Alt="Kanda, Thai quality reviewer" /><ShadcnAvatarFallback>KT</ShadcnAvatarFallback></ShadcnAvatar><div><strong>Kanda T.</strong><span>Final dimensional review</span></div></div>
                        <span>Right-click this review summary for file actions</span>
                    </div>
                </ShadcnContextMenuTrigger>
                <ShadcnContextMenuContent>
                    <ShadcnContextMenuLabel>Drawing actions</ShadcnContextMenuLabel>
                    <ShadcnContextMenuItem>Open drawing</ShadcnContextMenuItem>
                    <ShadcnContextMenuItem>Rename</ShadcnContextMenuItem>
                    <ShadcnContextMenuSeparator />
                    <ShadcnContextMenuItem Variant="ShadcnMenuItemVariant.Destructive">Move to trash</ShadcnContextMenuItem>
                </ShadcnContextMenuContent>
            </ShadcnContextMenu>
            <div class="theme-use-case-card__actions"><span>Revision C is ready to inspect</span><ShadcnButton Size="ShadcnButtonSize.Small" Variant="ShadcnButtonVariant.Outline">Open viewer</ShadcnButton></div>
            break;
        case "contact-dialog":
            <p class="theme-use-case-card__description">Update the contact shown to the machining and dispatch teams.</p>
            <ShadcnDialog>
                <ShadcnDialogTrigger>Edit contact</ShadcnDialogTrigger>
                <ShadcnDialogContent ShowCloseButton="true" CloseLabel="Close contact editor">
                    <ShadcnDialogHeader><ShadcnDialogTitle>Production contact</ShadcnDialogTitle><ShadcnDialogDescription>Changes apply to work order WO-2418.</ShadcnDialogDescription></ShadcnDialogHeader>
                    <ShadcnFieldGroup><ShadcnField><ShadcnFieldLabel For="bento-contact-name">Name</ShadcnFieldLabel><ThemeAnimatedInput Id="bento-contact-name" @bind-Value="_contactName" /></ShadcnField><ShadcnField><ShadcnFieldLabel For="bento-contact-phone">Phone</ShadcnFieldLabel><ThemeAnimatedInput Id="bento-contact-phone" @bind-Value="_contactPhone" /></ShadcnField></ShadcnFieldGroup>
                    <ShadcnDialogFooter><ShadcnDialogClose>Cancel</ShadcnDialogClose><ShadcnDialogClose Variant="ShadcnButtonVariant.Default">Save contact</ShadcnDialogClose></ShadcnDialogFooter>
                </ShadcnDialogContent>
            </ShadcnDialog>
            break;
        case "dispatch-drawer":
            <p class="theme-use-case-card__description">Three inspected packages are ready for the Bangkok handoff.</p>
            <ShadcnDrawer>
                <ShadcnDrawerTrigger>Review dispatch</ShadcnDrawerTrigger>
                <ShadcnDrawerContent Class="theme-bento-dispatch-drawer">
                    <ShadcnDrawerHeader><ShadcnDrawerTitle>Confirm dispatch</ShadcnDrawerTitle><ShadcnDrawerDescription>Check the destination before releasing WO-2418.</ShadcnDrawerDescription></ShadcnDrawerHeader>
                    <div class="theme-bento-overlay-body"><dl class="theme-runway-summary"><div><dt>Destination</dt><dd>Bang Na, Bangkok</dd></div><div><dt>Carrier</dt><dd>Kerry Express</dd></div></dl></div>
                    <ShadcnDrawerFooter><ShadcnDrawerClose Variant="ShadcnButtonVariant.Outline">Cancel</ShadcnDrawerClose><ShadcnDrawerClose Variant="ShadcnButtonVariant.Default">Confirm dispatch</ShadcnDrawerClose></ShadcnDrawerFooter>
                </ShadcnDrawerContent>
            </ShadcnDrawer>
            break;
        case "delivery-sheet":
            <p class="theme-use-case-card__description">Friday, 28 August · 16:00 · Samut Prakan</p>
            <ShadcnSheet>
                <ShadcnSheetTrigger>Open schedule</ShadcnSheetTrigger>
                <ShadcnSheetContent CloseLabel="Close delivery schedule">
                    <ShadcnSheetHeader><ShadcnSheetTitle>Delivery schedule</ShadcnSheetTitle><ShadcnSheetDescription>Coordinate the inspection release and courier collection.</ShadcnSheetDescription></ShadcnSheetHeader>
                    <div class="theme-bento-overlay-body"><label>Production contact<ThemeAnimatedInput @bind-Value="_contactName" /></label><label class="theme-runway-check"><ShadcnCheckbox Value="true" /> Notify the project team</label></div>
                    <ShadcnSheetFooter><ShadcnSheetClose>Cancel</ShadcnSheetClose><ShadcnSheetClose Variant="ShadcnButtonVariant.Default">Save schedule</ShadcnSheetClose></ShadcnSheetFooter>
                </ShadcnSheetContent>
            </ShadcnSheet>
            break;
        case "tooltip-guidance":
            <p class="theme-use-case-card__description">Hover or focus the controls for concise inspection guidance.</p>
            <div class="theme-use-case-card__actions">
                <ShadcnTooltipProvider><ShadcnTooltip><ShadcnTooltipTrigger>Surface finish</ShadcnTooltipTrigger><ShadcnTooltipContent>Measure Ra across three traces</ShadcnTooltipContent></ShadcnTooltip></ShadcnTooltipProvider>
                <ShadcnTooltipProvider><ShadcnTooltip><ShadcnTooltipTrigger>Diameter</ShadcnTooltipTrigger><ShadcnTooltipContent>Target 25.000 ±0.010 mm</ShadcnTooltipContent></ShadcnTooltip></ShadcnTooltipProvider>
            </div>
            break;
        case "production-planning-suite":
            <ThemeOperationsConsole Kind="production" />
            break;
        case "quality-release-suite":
            <ThemeOperationsConsole Kind="quality" />
            break;
        case "customer-handoff-suite":
            <ThemeOperationsConsole Kind="handoff" />
            break;
    }
    </ShadcnCardContent>
</ShadcnCard>

