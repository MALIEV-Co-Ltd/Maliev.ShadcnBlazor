    private async Task HandleDropzoneSelectionAsync(ShadcnDropzoneSelection selection)
    {
        if (!selection.IsValid || selection.Files.Count == 0) return;
        _dropzoneFiles.Clear();
        _dropzoneFiles.AddRange(selection.Files.Select(file => new UploadedFile(Guid.NewGuid(), file.Name, file.Size, "Uploading")));
        _dropzoneFileName = selection.Files.Count == 1 ? selection.Files[0].Name : T("{0} production drawings", selection.Files.Count);
        _dropzoneProgress = 0;
        _dropzoneUploading = true;
        for (var progress = 10; progress <= 100; progress += 10)
        {
            await Task.Delay(80);
            _dropzoneProgress = progress;
            await InvokeAsync(StateHasChanged);
        }
        _dropzoneUploading = false;
        for (var index = 0; index < _dropzoneFiles.Count; index++) _dropzoneFiles[index] = _dropzoneFiles[index] with { Status = "Ready" };
    }
