@namespace Maliev.ShadcnBlazor.Showcase.Components.Theming.Runway
@using System.Globalization
@using Maliev.ShadcnBlazor.Components.Conversation
@using Maliev.ShadcnBlazor.Components.DataDisplay
@using Maliev.ShadcnBlazor.Components.Disclosure
@using Maliev.ShadcnBlazor.Components.Icons
@using Maliev.ShadcnBlazor.Components.Overlays
@using Maliev.ShadcnBlazor.Showcase.Theming.Runway

<ShadcnCard Class="theme-use-case-card"
         data-use-case-id="@Definition.Id"
         data-bento-size="@Definition.Size.ToString().ToLowerInvariant()">
    @if (Definition.Id != "project-questionnaire")
    {
        <ShadcnCardHeader Class="theme-use-case-card__header">
            <ShadcnCardTitle>@Title</ShadcnCardTitle>
        </ShadcnCardHeader>
    }

    <ShadcnCardContent Class="theme-use-case-card__content">
    @switch (Definition.Id)
    {
        case "production-capacity":
            <div class="theme-runway-stat"><strong>@FormatPercent(Frame.CapacityPercent)</strong><span>5-axis capacity · Cell A3</span></div>
            <ShadcnProgress Class="theme-status-success" Value="@ClampPercent(Frame.CapacityPercent)"><ShadcnProgressLabel>Weekly capacity</ShadcnProgressLabel><ShadcnProgressValue /></ShadcnProgress>
            <div class="theme-use-case-card__actions"><ShadcnBadge Class="theme-status-success">On schedule</ShadcnBadge><ShadcnButton Size="ShadcnButtonSize.Small" Variant="ShadcnButtonVariant.Outline" OnClick="TogglePlanReview">@(_planReviewOpen ? "Close plan" : "Review plan")</ShadcnButton></div>
            @if (_planReviewOpen) { <div class="theme-inline-detail" role="region" aria-label="Capacity plan review">Cell A3 can accept two additional work orders before Friday.</div> }
            break;
        case "production-analytics":
            <ShadcnChart Class="theme-production-chart" Id="theme-production-analytics" Title="Completed operations" Description="Six-week output by production cell" Type="ShadcnChartType.Bar" Config="ProductionChartConfig" Categories="ProductionChartCategories" Series="ProductionChartSeries" ShowGrid="true" ShowMajorGrid="true" ShowMinorGrid="true" ShowPrimaryYAxis="true" ShowLegend="true" LegendInteractive="true" InitialWidth="520" InitialHeight="230" />
            break;
        case "operator-profile":
            <div class="theme-runway-profile"><ShadcnAvatar><ShadcnAvatarImage Source="images/avatars/operator-thai.png" Alt="Narin S., Thai CNC engineer" /><ShadcnAvatarFallback>NS</ShadcnAvatarFallback></ShadcnAvatar><div><strong>Narin S.</strong><span>CNC engineer · Samut Prakan</span></div></div>
            <label>Name<ThemeAnimatedInput Value="@(_profileName ?? "Narin S.")" ValueChanged="value => _profileName = value" /></label>
            <label>Shift<ThemeAnimatedInput Value="@ShiftValue" ReadOnly="true" /></label>
            <ShadcnButton Size="ShadcnButtonSize.Small" ButtonType="ShadcnButtonType.Submit" BusyText="Saving" SuccessText="Saved" OnClick="SaveProfileAsync">Save profile</ShadcnButton>
            break;
        case "drawing-attachment":
            <ShadcnAttachment Title="housing-rev-d.step" State="ShadcnAttachmentState.Uploading" Progress="@ClampPercent(Frame.UploadPercent)">
                <ShadcnAttachmentMedia><ShadcnIcon Icon="@FileIcon" Size="20" /></ShadcnAttachmentMedia>
                <ShadcnAttachmentContent><ShadcnAttachmentTitle>housing-rev-d.step</ShadcnAttachmentTitle><ShadcnAttachmentDescription>8.4 MB · STEP · uploading</ShadcnAttachmentDescription></ShadcnAttachmentContent>
                <ShadcnAttachmentActions><ShadcnAttachmentAction Action="ShadcnAttachmentActionKind.Cancel" AccessibleName="Cancel drawing upload" OnAction="HandleAttachmentAction"><ShadcnIcon Icon="@XIcon" Size="16" /></ShadcnAttachmentAction></ShadcnAttachmentActions>
            </ShadcnAttachment>
            <ShadcnAttachment Title="inspection-plan.pdf" State="ShadcnAttachmentState.Done">
                <ShadcnAttachmentMedia><ShadcnIcon Icon="@FileIcon" Size="20" /></ShadcnAttachmentMedia>
                <ShadcnAttachmentContent><ShadcnAttachmentTitle>inspection-plan.pdf</ShadcnAttachmentTitle><ShadcnAttachmentDescription>1.2 MB · ready for review</ShadcnAttachmentDescription></ShadcnAttachmentContent>
                <ShadcnAttachmentActions><ShadcnAttachmentAction Action="ShadcnAttachmentActionKind.Remove" AccessibleName="Remove inspection plan" OnAction="HandleAttachmentAction"><ShadcnIcon Icon="@TrashIcon" Size="16" /></ShadcnAttachmentAction></ShadcnAttachmentActions>
            </ShadcnAttachment>
            break;
        case "quotation-files":
            <ShadcnDropzone Class="theme-runway-dropzone" Accept=".step,.stp,.pdf" Multiple="true" MaxFiles="5" MaxFileSize="20971520" Instructions="Drop production drawings here" Description="STEP or PDF · up to 20 MB" Loading="_dropzoneUploading" SelectionChanged="HandleDropzoneSelectionAsync" />
            <div class="theme-runway-file"><span>@_dropzoneFileName</span><ShadcnBadge Variant="ShadcnBadgeVariant.Secondary">@FormatPercent(DropzoneProgress)</ShadcnBadge></div>
            <ShadcnProgress Value="@DropzoneProgress"><ShadcnProgressLabel>Upload progress</ShadcnProgressLabel></ShadcnProgress>
            break;
        case "inspection-table":
            <ShadcnTable Borders="true" ExpectedColumnCount="4">
                <ShadcnTableCaption>Latest dimensional checks</ShadcnTableCaption>
                <ShadcnTableHeader><ShadcnTableRow><ShadcnTableHead>Feature</ShadcnTableHead><ShadcnTableHead>Target</ShadcnTableHead><ShadcnTableHead>Measured</ShadcnTableHead><ShadcnTableHead>Status</ShadcnTableHead></ShadcnTableRow></ShadcnTableHeader>
                <ShadcnTableBody>
                    <ShadcnTableRow><ShadcnTableCell>Bore 4</ShadcnTableCell><ShadcnTableCell>25.000 mm</ShadcnTableCell><ShadcnTableCell>24.998 mm</ShadcnTableCell><ShadcnTableCell><ShadcnBadge Class="theme-status-success">Pass</ShadcnBadge></ShadcnTableCell></ShadcnTableRow>
                    <ShadcnTableRow><ShadcnTableCell>Datum A</ShadcnTableCell><ShadcnTableCell>0.020 mm</ShadcnTableCell><ShadcnTableCell>0.014 mm</ShadcnTableCell><ShadcnTableCell><ShadcnBadge Class="theme-status-success">Pass</ShadcnBadge></ShadcnTableCell></ShadcnTableRow>
                    <ShadcnTableRow><ShadcnTableCell>Surface</ShadcnTableCell><ShadcnTableCell>Ra 1.6</ShadcnTableCell><ShadcnTableCell>Ra 1.4</ShadcnTableCell><ShadcnTableCell><ShadcnBadge Variant="ShadcnBadgeVariant.Secondary">Review</ShadcnBadge></ShadcnTableCell></ShadcnTableRow>
                </ShadcnTableBody>
            </ShadcnTable>
            break;
        case "shipping-handoff":
            <label>Factory<ThemeAnimatedInput Value="@FactoryValue" ReadOnly="true" /></label>
            <div class="theme-runway-fields"><label>Dock<ThemeAnimatedInput Value="@DockValue" ReadOnly="true" /></label><label>Reference<ThemeAnimatedInput Value="@ReferenceValue" ReadOnly="true" /></label></div>
            <label class="theme-runway-check"><ShadcnCheckbox Value="@_saveAddress" ValueChanged="value => _saveAddress = value ?? false" /> Save as production handoff</label>
            <ShadcnButton Size="ShadcnButtonSize.Small" ButtonType="ShadcnButtonType.Submit" BusyText="Confirming" SuccessText="Confirmed" OnClick="ConfirmHandoffAsync">Confirm address</ShadcnButton>
            @if (_handoffSaved) { <p class="theme-runway-action-status" role="status">Handoff saved for dispatch.</p> }
            break;
        case "quotation-data-table":
            <div class="theme-runway-table-summary"><span><strong>Quotation review queue</strong><small>Three active requests awaiting production decisions</small></span><ShadcnBadge Variant="ShadcnBadgeVariant.Secondary">3 active</ShadcnBadge></div>
            <ShadcnDataTable TItem="QuotationRow" Items="QuotationRows" Columns="QuotationColumns" RowKey="@(row => row.Id)" State="_quotationTableState" StateChanged="OnQuotationTableStateChanged" Selectable="true" FilterPlaceholder="Search quotations" EmptyText="No quotations found" />
            break;
        case "inspection-alerts":
            @for (var index = 0; index < AlertOptions.Length; index++)
            {
                var optionIndex = index;
                var option = AlertOptions[index];
                <label class="theme-runway-check"><ShadcnCheckbox Value="@_alertEnabled[index]" ValueChanged="value => SetAlertEnabled(optionIndex, value)" /><span><strong>@option.Label</strong><small>@option.Description</small></span></label>
            }
            <div class="theme-use-case-card__actions"><span>Quiet hours</span><ShadcnSwitch @bind-Value="_quietHours" aria-label="Use quiet hours" /></div>
            break;
        case "quality-alert":
            <ShadcnAlert Variant="ShadcnAlertVariant.Destructive"><ShadcnAlertTitle>Inspection hold</ShadcnAlertTitle><ShadcnAlertDescription>Bore 4 is 0.012 mm below the lower tolerance. Review the probe result before machining resumes.</ShadcnAlertDescription><ShadcnAlertAction><ShadcnButton Size="ShadcnButtonSize.Small" Variant="ShadcnButtonVariant.Outline" OnClick="ToggleInspectionReport">@(_inspectionReportOpen ? "Close report" : "Open report")</ShadcnButton></ShadcnAlertAction></ShadcnAlert>
            @if (_inspectionReportOpen) { <div class="theme-inline-detail" role="region" aria-label="Inspection report"><strong>Bore 4 probe report</strong><span>Measured 24.988 mm · lower limit 24.990 mm · hold active</span></div> }
            <ShadcnAlert><ShadcnAlertTitle>Calibration current</ShadcnAlertTitle><ShadcnAlertDescription>Probe P-08 was calibrated today at 08:10.</ShadcnAlertDescription></ShadcnAlert>
            break;
        case "deposit-approval":
            <div class="theme-runway-amount"><span>Manufacturing deposit</span><strong>฿48,500.00</strong></div>
            <ShadcnSeparator />
            <dl class="theme-runway-summary"><div><dt>Quotation</dt><dd>Q-2847</dd></div><div><dt>Due</dt><dd>23 Aug 2569</dd></div><div><dt>Terms</dt><dd>50% before production</dd></div></dl>
            <div class="theme-use-case-card__actions"><ShadcnButton Size="ShadcnButtonSize.Small" Variant="ShadcnButtonVariant.Outline" OnClick="ReviewDeposit">Review</ShadcnButton><ShadcnButton Size="ShadcnButtonSize.Small" Disabled="_depositApproved" OnClick="ApproveDeposit">@(_depositApproved ? "Approved" : "Approve deposit")</ShadcnButton></div>
            @if (_depositStatus is not null) { <p class="theme-runway-action-status" role="status">@_depositStatus</p> }
            break;
        case "assigned-reviewers":
            <ShadcnAvatarGroup Class="theme-runway-reviewer-avatars" Expanded="_reviewersExpanded" AutoCollapseAfter="@TimeSpan.FromSeconds(5)" OnAutoCollapse="CollapseReviewers"><ShadcnAvatar Size="ShadcnAvatarSize.Small"><ShadcnAvatarImage Source="images/avatars/operator-thai.png" Alt="Nattapong, Thai machining reviewer" /><ShadcnAvatarFallback>NP</ShadcnAvatarFallback></ShadcnAvatar><ShadcnAvatar Size="ShadcnAvatarSize.Small"><ShadcnAvatarImage Source="images/avatars/reviewer-thai.png" Alt="Kanda, Thai quality reviewer" /><ShadcnAvatarFallback>KT</ShadcnAvatarFallback></ShadcnAvatar><ShadcnAvatar Size="ShadcnAvatarSize.Small"><ShadcnAvatarImage Source="images/avatars/coordinator-thai.png" Alt="Pim, Thai logistics reviewer" /><ShadcnAvatarFallback>PS</ShadcnAvatarFallback></ShadcnAvatar>@if (_reviewersExpanded) { <ShadcnAvatar Size="ShadcnAvatarSize.Small"><ShadcnAvatarFallback>SK</ShadcnAvatarFallback></ShadcnAvatar><ShadcnAvatar Size="ShadcnAvatarSize.Small"><ShadcnAvatarFallback>AP</ShadcnAvatarFallback></ShadcnAvatar><ShadcnAvatar Size="ShadcnAvatarSize.Small"><ShadcnAvatarFallback>TN</ShadcnAvatarFallback></ShadcnAvatar><ShadcnAvatar Size="ShadcnAvatarSize.Small"><ShadcnAvatarFallback>WR</ShadcnAvatarFallback></ShadcnAvatar> } else { <ShadcnAvatarGroupCount Size="ShadcnAvatarSize.Small" ExpandLabel="Show four more reviewers" OnClick="ToggleReviewers">+4</ShadcnAvatarGroupCount> }</ShadcnAvatarGroup>
            <ul class="theme-runway-reviewers"><li><span>Nattapong · Machining</span><ShadcnBadge Class="theme-status-success">Ready</ShadcnBadge></li><li><span>Kanda · Quality</span><ShadcnBadge Variant="ShadcnBadgeVariant.Secondary">Reviewing</ShadcnBadge></li><li><span>Pim · Logistics</span><ShadcnBadge Variant="ShadcnBadgeVariant.Outline">Queued</ShadcnBadge></li></ul>
            <ShadcnButton Size="ShadcnButtonSize.Small" Variant="ShadcnButtonVariant.Outline" OnClick="ToggleReviewerManagement">@(_reviewerManagerOpen ? "Close reviewer management" : "Manage reviewers")</ShadcnButton>
            @if (_reviewerManagerOpen) { <div class="theme-inline-detail" role="region" aria-label="Reviewer management"><strong>Reviewer coverage</strong><span>Machining, Quality, and Logistics are assigned. Four alternates are available.</span></div> }
            break;
        case "conversation-marker":
            <ShadcnMarker Variant="ShadcnMarkerVariant.Separator"><ShadcnMarkerContent>14:32 · WO-2418</ShadcnMarkerContent></ShadcnMarker>
            <div class="theme-runway-activity"><ShadcnAvatar Size="ShadcnAvatarSize.Small"><ShadcnAvatarImage Source="images/avatars/reviewer-thai.png" Alt="Kanda, Thai quality reviewer" /><ShadcnAvatarFallback>KT</ShadcnAvatarFallback></ShadcnAvatar><span><strong>Final inspection uploaded</strong><small>Kanda attached the signed dimensional report.</small></span><ShadcnBadge Class="theme-status-success">Ready</ShadcnBadge></div>
            <ShadcnMarker Variant="ShadcnMarkerVariant.Default" Live="true"><ShadcnMarkerIcon><span class="shadcn-marker-loader" aria-hidden="true"></span></ShadcnMarkerIcon><ShadcnMarkerContent Streaming="true">Dispatch team is preparing the Bangkok handoff</ShadcnMarkerContent></ShadcnMarker>
            break;
        case "work-order-navigation":
            <nav aria-label="Work order path" class="theme-runway-breadcrumb"><a href="theme" @onclick="OpenProductionQueue" @onclick:preventDefault>Production</a><span>/</span><a href="theme" @onclick="OpenMachineCell" @onclick:preventDefault>Cell A3</a><span>/</span><strong>WO-2418</strong></nav>
            <ShadcnAccordion Values="@_openWorkflowSections" ValuesChanged="values => _openWorkflowSections = values" Label="Work order actions">
                <ShadcnAccordionItem Value="process"><ShadcnAccordionTrigger>Change process plan</ShadcnAccordionTrigger><ShadcnAccordionContent><p>12 operations · revision C</p><ShadcnButton Size="ShadcnButtonSize.Small" Variant="ShadcnButtonVariant.Outline" OnClick="OpenProcessPlan">Open process editor</ShadcnButton></ShadcnAccordionContent></ShadcnAccordionItem>
                <ShadcnAccordionItem Value="inspection"><ShadcnAccordionTrigger>Schedule inspection</ShadcnAccordionTrigger><ShadcnAccordionContent><p>Final dimensional report · Quality desk</p><ShadcnButton Size="ShadcnButtonSize.Small" Variant="ShadcnButtonVariant.Outline" OnClick="OpenInspectionSchedule">Choose inspection time</ShadcnButton></ShadcnAccordionContent></ShadcnAccordionItem>
                <ShadcnAccordionItem Value="delivery"><ShadcnAccordionTrigger>Release delivery</ShadcnAccordionTrigger><ShadcnAccordionContent><p>Awaiting quality approval</p><ShadcnButton Size="ShadcnButtonSize.Small" Variant="ShadcnButtonVariant.Outline" OnClick="OpenDeliveryRelease">Review release gate</ShadcnButton></ShadcnAccordionContent></ShadcnAccordionItem>
            </ShadcnAccordion>
            break;
        case "machine-cell":
            <div class="theme-runway-machine"><div><strong>DMG MORI DMU 50</strong><span>5-axis milling · Cell A3</span></div></div>
            <div class="theme-runway-stat"><strong data-testid="machine-load-percent">@FormatPercent(Frame.CapacityPercent - 7)</strong><span>Spindle load</span></div>
            <ShadcnProgress Value="@ClampPercent(Frame.CapacityPercent - 7)"><ShadcnProgressLabel>Spindle load</ShadcnProgressLabel><ShadcnProgressValue /></ShadcnProgress>
            <ShadcnAlert><ShadcnAlertTitle>In-process inspection</ShadcnAlertTitle><ShadcnAlertDescription>Bore diameter within tolerance at 14:20.</ShadcnAlertDescription></ShadcnAlert>
            break;
        case "assistant-conversation":
            <div class="theme-runway-chat" aria-label="Assistant conversation preview">
                <ShadcnMessageScrollerProvider AutoScroll="true" DefaultScrollPosition="ShadcnMessageDefaultScrollPosition.End">
                    <ShadcnMessageScroller>
                        <ShadcnMessageScrollerViewport AccessibleName="Assistant conversation messages">
                            <ShadcnMessageScrollerContent>
                                <ShadcnMarker Variant="ShadcnMarkerVariant.Separator"><ShadcnMarkerContent>Today · WO-2418</ShadcnMarkerContent></ShadcnMarker>
                                <ShadcnMessageGroup>
                                    @foreach (var turn in _conversationTurns)
                                    {
                                        <ShadcnMessageScrollerItem @key="turn.Id" MessageId="@turn.Id" ScrollAnchor="@(turn.Id == _conversationTurns[^1].Id)">
                                            <ShadcnMessage Align="@(turn.Assistant ? ShadcnLogicalAlign.Start : ShadcnLogicalAlign.End)">
                                                @if (turn.Assistant)
                                                {
                                                    <ShadcnMessageAvatar><ShadcnAvatar Size="ShadcnAvatarSize.Small"><ShadcnAvatarImage Source="images/avatars/assistant-thai.png" Alt="MALIEV Assistant" /><ShadcnAvatarFallback>MA</ShadcnAvatarFallback></ShadcnAvatar></ShadcnMessageAvatar>
                                                }
                                                <ShadcnMessageContent><ShadcnMessageBody>
                                                    @if (turn.Assistant) { <ShadcnMessageHeader>MALIEV Assistant</ShadcnMessageHeader> }
                                                    <ShadcnBubble Align="@(turn.Assistant ? ShadcnLogicalAlign.Start : ShadcnLogicalAlign.End)" Variant="@(turn.Assistant ? ShadcnBubbleVariant.Ghost : ShadcnBubbleVariant.Default)"><ShadcnBubbleContent>
                                                        @if (turn.Assistant && turn.Id == _conversationTurns[^1].Id)
                                                        {
                                                            <span class="theme-runway-typing-text">@turn.Text</span>
                                                        }
                                                        else { @turn.Text }
                                                    </ShadcnBubbleContent></ShadcnBubble>
                                                </ShadcnMessageBody>
                                                <ShadcnMessageFooter><ShadcnMessageActions><ShadcnMessageCopyAction Text="@turn.Text" /><ShadcnMessageReplyAction Quote="@turn.Text" OnReply="ReplyToConversation" /></ShadcnMessageActions></ShadcnMessageFooter>
                                                </ShadcnMessageContent>
                                            </ShadcnMessage>
                                        </ShadcnMessageScrollerItem>
                                    }
                                </ShadcnMessageGroup>
                            </ShadcnMessageScrollerContent>
                        </ShadcnMessageScrollerViewport>
                    </ShadcnMessageScroller>
                </ShadcnMessageScrollerProvider>
                <ThemeConversationComposer OnSend="SendConversationMessage" />
            </div>
            break;
        case "project-questionnaire":
            <ShadcnQuestionnaire Items="QuestionnaireItems" DefaultItem="scope" Shortcuts="ShadcnQuestionnaireShortcutMode.Numbers" AccessibleName="Production review questionnaire">
                <ShadcnQuestionnaireProgress AccessibleName="Questionnaire progress" />
                <ShadcnQuestionnaireItem Name="scope">
                    <ShadcnQuestionnaireTitle>Choose the review scope</ShadcnQuestionnaireTitle>
                    <ShadcnQuestionnaireDescription>Select the team that should inspect WO-2418.</ShadcnQuestionnaireDescription>
                    <ShadcnQuestionnaireChoices>
                        <ShadcnQuestionnaireChoice Value="machining">Machining<ShadcnQuestionnaireChoiceDescription>Toolpath and surface finish</ShadcnQuestionnaireChoiceDescription></ShadcnQuestionnaireChoice>
                        <ShadcnQuestionnaireChoice Value="quality">Quality<ShadcnQuestionnaireChoiceDescription>Dimensions and inspection evidence</ShadcnQuestionnaireChoiceDescription></ShadcnQuestionnaireChoice>
                    </ShadcnQuestionnaireChoices>
                    <ShadcnQuestionnaireError />
                </ShadcnQuestionnaireItem>
                <ShadcnQuestionnaireItem Name="notes">
                    <ShadcnQuestionnaireTitle>Add inspection notes</ShadcnQuestionnaireTitle>
                    <ShadcnQuestionnaireDescription>Include the customer-specific acceptance criteria.</ShadcnQuestionnaireDescription>
                    <ShadcnQuestionnaireInput AccessibleName="Inspection notes" />
                    <ShadcnQuestionnaireError />
                </ShadcnQuestionnaireItem>
                <ShadcnQuestionnaireActions><ShadcnQuestionnairePrevious>Back</ShadcnQuestionnairePrevious><ShadcnQuestionnaireSkip>Skip</ShadcnQuestionnaireSkip><ShadcnQuestionnaireNext>Next</ShadcnQuestionnaireNext><ShadcnQuestionnaireSubmit>Submit review</ShadcnQuestionnaireSubmit></ShadcnQuestionnaireActions>
            </ShadcnQuestionnaire>
            break;
        case "issue-report":
            <ShadcnAlert Variant="@(Frame.FormStep == 3 ? ShadcnAlertVariant.Destructive : ShadcnAlertVariant.Default)"><ShadcnAlertTitle>@(Frame.FormStep == 3 ? "Drawing revision required" : "Report a production issue")</ShadcnAlertTitle><ShadcnAlertDescription>Quality receives the machine, work order, and validation context.</ShadcnAlertDescription></ShadcnAlert>
            <label>Subject<ThemeAnimatedInput Value="@(Frame.FormStep > 0 ? "Tolerance mismatch on bore 4" : string.Empty)" Placeholder="Describe the issue" ReadOnly="true" /></label>
            <label>Details<ThemeAnimatedTextarea Value="@(Frame.FormStep > 1 ? "Measured 24.982 mm against 25.000 ±0.010 mm." : string.Empty)" Placeholder="Add inspection evidence" ReadOnly="true" /></label>
            <ShadcnButton Size="ShadcnButtonSize.Small" OnClick="SubmitIssue">Submit issue</ShadcnButton>
            @if (_issueSubmitted) { <p class="theme-runway-action-status" role="status">Issue sent to Quality.</p> }
            break;
        case "dispatch-confirmation":
            <ShadcnAlert><ShadcnAlertTitle>Release WO-2418 for dispatch?</ShadcnAlertTitle><ShadcnAlertDescription>Three packages passed final inspection. Kerry Express collection is scheduled for 16:00.</ShadcnAlertDescription></ShadcnAlert>
            <dl class="theme-runway-summary"><div><dt>Destination</dt><dd>Bang Na, Bangkok</dd></div><div><dt>Carrier</dt><dd>Kerry Express</dd></div></dl>
            <div class="theme-use-case-card__actions"><ShadcnButton Size="ShadcnButtonSize.Small" Variant="ShadcnButtonVariant.Outline" OnClick="CancelDispatch">Cancel</ShadcnButton><ShadcnButton Size="ShadcnButtonSize.Small" Disabled="_dispatchConfirmed" OnClick="ConfirmDispatch">@(_dispatchConfirmed ? "Dispatched" : "Confirm dispatch")</ShadcnButton></div>
            @if (_dispatchStatus is not null) { <p class="theme-runway-action-status" role="status">@_dispatchStatus</p> }
            break;
        case "quotation-actions":
            <p class="theme-use-case-card__description">Q-2847 · CNC enclosure · Revision C</p>
            <div class="theme-use-case-card__actions">
                <ShadcnBadge Variant="ShadcnBadgeVariant.Secondary">Draft</ShadcnBadge>
                <ShadcnDropdownMenu>
                    <ShadcnDropdownMenuTrigger>Actions</ShadcnDropdownMenuTrigger>
                    <ShadcnDropdownMenuContent>
                        <ShadcnDropdownMenuLabel>Quotation</ShadcnDropdownMenuLabel>
                        <ShadcnDropdownMenuItem OnSelect="OpenQuotationDetails">Open details</ShadcnDropdownMenuItem>
                        <ShadcnDropdownMenuItem OnSelect="DuplicateQuotationRevision">Duplicate revision</ShadcnDropdownMenuItem>
                        <ShadcnDropdownMenuSeparator />
                        <ShadcnDropdownMenuItem Variant="ShadcnMenuItemVariant.Destructive" OnSelect="ArchiveQuotationDraft">Archive draft</ShadcnDropdownMenuItem>
                    </ShadcnDropdownMenuContent>
                </ShadcnDropdownMenu>
            </div>
            break;
        case "reviewer-details":
            <div class="theme-runway-profile">
                <ShadcnAvatar><ShadcnAvatarImage Source="images/avatars/reviewer-thai.png" Alt="Kanda, Thai quality reviewer" /><ShadcnAvatarFallback>KT</ShadcnAvatarFallback></ShadcnAvatar>
                <div>
                    <ShadcnHoverCard @bind-Open="_reviewerHoverOpen" OpenDelay="@TimeSpan.FromMilliseconds(100)">
                        <ShadcnHoverCardTrigger Href="#reviewer-details">Kanda T.</ShadcnHoverCardTrigger>
                        <ShadcnHoverCardContent>
                            <div class="theme-runway-profile"><ShadcnAvatar><ShadcnAvatarImage Source="images/avatars/reviewer-thai.png" Alt="Kanda, Thai quality reviewer" /><ShadcnAvatarFallback>KT</ShadcnAvatarFallback></ShadcnAvatar><div><strong>Kanda T.</strong><span>Quality engineer · 6 active reviews</span></div></div>
                        </ShadcnHoverCardContent>
                    </ShadcnHoverCard>
                    <span>Final dimensional review</span>
                </div>
            </div>
            <ShadcnTooltipProvider><ShadcnTooltip @bind-Open="_dueTooltipOpen"><ShadcnTooltipTrigger @onclick="ToggleDueTooltip">Due 15:30</ShadcnTooltipTrigger><ShadcnTooltipContent>45 minutes remaining · click again to dismiss</ShadcnTooltipContent></ShadcnTooltip></ShadcnTooltipProvider>
            break;
        case "file-context":
            <ShadcnAttachment Title="enclosure-rev-c.step" State="ShadcnAttachmentState.Done">
                <ShadcnAttachmentMedia><ShadcnIcon Icon="@FileIcon" Size="20" /></ShadcnAttachmentMedia>
                <ShadcnAttachmentContent><ShadcnAttachmentTitle>enclosure-rev-c.step</ShadcnAttachmentTitle><ShadcnAttachmentDescription>Revision C · STEP · 8.4 MB</ShadcnAttachmentDescription></ShadcnAttachmentContent>
                <ShadcnAttachmentActions><ShadcnAttachmentAction Action="ShadcnAttachmentActionKind.Download" AccessibleName="Download revision C" OnAction="HandleAttachmentAction"><ShadcnIcon Icon="@DownloadIcon" Size="16" /></ShadcnAttachmentAction></ShadcnAttachmentActions>
            </ShadcnAttachment>
            <ShadcnContextMenu>
                <ShadcnContextMenuTrigger Class="theme-bento-context-target">
                    <div class="theme-drawing-review">
                        <div class="theme-drawing-review__meta"><ShadcnBadge Variant="ShadcnBadgeVariant.Secondary">2 comments</ShadcnBadge><span>Updated 14:32</span></div>
                        <div class="theme-runway-profile"><ShadcnAvatar Size="ShadcnAvatarSize.Small"><ShadcnAvatarImage Source="images/avatars/reviewer-thai.png" Alt="Kanda, Thai quality reviewer" /><ShadcnAvatarFallback>KT</ShadcnAvatarFallback></ShadcnAvatar><div><strong>Kanda T.</strong><span>Final dimensional review</span></div></div>
                        <span>Right-click this review summary for file actions</span>
                    </div>
                </ShadcnContextMenuTrigger>
                <ShadcnContextMenuContent>
                    <ShadcnContextMenuLabel>Drawing actions</ShadcnContextMenuLabel>
                    <ShadcnContextMenuItem OnSelect="OpenDrawing">Open drawing</ShadcnContextMenuItem>
                    <ShadcnContextMenuItem OnSelect="EnableDrawingRename">Rename</ShadcnContextMenuItem>
                    <ShadcnContextMenuSeparator />
                    <ShadcnContextMenuItem Variant="ShadcnMenuItemVariant.Destructive" OnSelect="TrashDrawing">Move to trash</ShadcnContextMenuItem>
                </ShadcnContextMenuContent>
            </ShadcnContextMenu>
            <div class="theme-use-case-card__actions"><span>Revision C is ready to inspect</span><ShadcnButton Size="ShadcnButtonSize.Small" Variant="ShadcnButtonVariant.Outline" OnClick="OpenDrawingViewer">Open viewer</ShadcnButton></div>
            <ShadcnDialog Open="_drawingViewerOpen" OpenChanged="SetDrawingViewerOpen">
                <ShadcnDialogContent Class="theme-drawing-viewer-dialog" ShowCloseButton="true" CloseLabel="Close drawing viewer">
                    <ShadcnDialogHeader>
                        <ShadcnDialogTitle>3D drawing review</ShadcnDialogTitle>
                        <ShadcnDialogDescription>Inspect enclosure-rev-c.step before releasing Revision C.</ShadcnDialogDescription>
                    </ShadcnDialogHeader>
                    <div class="theme-drawing-viewer">
                        <div class="theme-drawing-viewer__stage" data-section-view="@(_viewerSection ? "true" : "false")">
                            <svg viewBox="0 0 520 300" role="img" aria-label="Interactive 3D preview of the CNC enclosure">
                                <defs>
                                    <linearGradient id="viewer-face" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="currentColor" stop-opacity=".2"/><stop offset="1" stop-color="currentColor" stop-opacity=".04"/></linearGradient>
                                </defs>
                                <g class="theme-drawing-viewer__model" style="--viewer-rotation:@(_viewerRotation)deg;--viewer-zoom:@(_viewerZoom / 100d)">
                                    <path d="M128 84 302 45 406 112 232 158Z" fill="url(#viewer-face)" />
                                    <path d="M128 84v118l104 60V158Zm104 74v104l174-39V112Z" fill="currentColor" fill-opacity=".07" />
                                    <path d="M128 84 302 45l104 67v111l-174 39-104-60Z M232 158l174-46M232 158 128 84m104 74v104" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round" />
                                    <circle cx="268" cy="119" r="25" fill="none" stroke="currentColor" stroke-width="3" />
                                    <path d="M243 119h50M268 94v50" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="5 5" />
                                    @if (_viewerSection)
                                    {
                                        <path d="M178 92 352 53v108l-174 39Z" fill="var(--shadcn-primary)" fill-opacity=".18" stroke="var(--shadcn-primary)" stroke-width="2" stroke-dasharray="8 6" />
                                    }
                                </g>
                                <g class="theme-drawing-viewer__axes" aria-hidden="true"><path d="M52 248h44M52 248v-44M52 248l-22 14"/><text x="99" y="253">X</text><text x="47" y="198">Y</text><text x="18" y="274">Z</text></g>
                            </svg>
                            <div class="theme-drawing-viewer__hud"><span>ISO</span><span>@_viewerZoom%</span><span>Rotation @_viewerRotation°</span></div>
                        </div>
                        <aside class="theme-drawing-viewer__details" aria-label="Drawing metadata">
                            <dl><div><dt>Material</dt><dd>Aluminum 6061</dd></div><div><dt>Revision</dt><dd>C</dd></div><div><dt>Dimensions</dt><dd>320 × 180 × 96 mm</dd></div><div><dt>Tolerance</dt><dd>±0.02 mm</dd></div></dl>
                            <div class="theme-drawing-viewer__controls" role="toolbar" aria-label="3D viewer controls">
                                <ShadcnButton Size="ShadcnButtonSize.Small" Variant="ShadcnButtonVariant.Outline" OnClick="RotateDrawing">Rotate model</ShadcnButton>
                                <ShadcnButton Size="ShadcnButtonSize.Small" Variant="ShadcnButtonVariant.Outline" OnClick="ToggleSectionView">@(_viewerSection ? "Hide section" : "Section view")</ShadcnButton>
                                <ShadcnButton Size="ShadcnButtonSize.Small" Variant="ShadcnButtonVariant.Ghost" OnClick="ZoomOutDrawing" aria-label="Zoom out">−</ShadcnButton>
                                <ShadcnButton Size="ShadcnButtonSize.Small" Variant="ShadcnButtonVariant.Ghost" OnClick="ZoomInDrawing" aria-label="Zoom in">+</ShadcnButton>
                            </div>
                        </aside>
                    </div>
                    <ShadcnDialogFooter><ShadcnDialogClose>Close</ShadcnDialogClose><ShadcnDialogClose Variant="ShadcnButtonVariant.Default" OnClick="ApproveDrawing">Approve drawing</ShadcnDialogClose></ShadcnDialogFooter>
                </ShadcnDialogContent>
            </ShadcnDialog>
            break;
        case "contact-dialog":
            <p class="theme-use-case-card__description">Update the contact shown to the machining and dispatch teams.</p>
            <ShadcnDialog>
                <ShadcnDialogTrigger>Edit contact</ShadcnDialogTrigger>
                <ShadcnDialogContent ShowCloseButton="true" CloseLabel="Close contact editor">
                    <ShadcnDialogHeader><ShadcnDialogTitle>Production contact</ShadcnDialogTitle><ShadcnDialogDescription>Changes apply to work order WO-2418.</ShadcnDialogDescription></ShadcnDialogHeader>
                    <ShadcnFieldGroup><ShadcnField><ShadcnFieldLabel For="bento-contact-name">Name</ShadcnFieldLabel><ThemeAnimatedInput Id="bento-contact-name" @bind-Value="_contactName" /></ShadcnField><ShadcnField><ShadcnFieldLabel For="bento-contact-phone">Phone</ShadcnFieldLabel><ThemeAnimatedInput Id="bento-contact-phone" @bind-Value="_contactPhone" /></ShadcnField></ShadcnFieldGroup>
                    <ShadcnDialogFooter><ShadcnDialogClose OnClick="CancelContact">Cancel</ShadcnDialogClose><ShadcnDialogClose Variant="ShadcnButtonVariant.Default" OnClick="SaveContact">Save contact</ShadcnDialogClose></ShadcnDialogFooter>
                </ShadcnDialogContent>
            </ShadcnDialog>
            @if (_contactStatus is not null) { <p class="theme-runway-action-status" role="status">@_contactStatus</p> }
            break;
        case "dispatch-drawer":
            <p class="theme-use-case-card__description">Three inspected packages are ready for the Bangkok handoff.</p>
            <ShadcnDrawer>
                <ShadcnDrawerTrigger>Review dispatch</ShadcnDrawerTrigger>
                <ShadcnDrawerContent Class="theme-bento-dispatch-drawer">
                    <ShadcnDrawerHeader><ShadcnDrawerTitle>Confirm dispatch</ShadcnDrawerTitle><ShadcnDrawerDescription>Check the destination before releasing WO-2418.</ShadcnDrawerDescription></ShadcnDrawerHeader>
                    <div class="theme-bento-overlay-body"><dl class="theme-runway-summary"><div><dt>Destination</dt><dd>Bang Na, Bangkok</dd></div><div><dt>Carrier</dt><dd>Kerry Express</dd></div></dl></div>
                    <ShadcnDrawerFooter><ShadcnDrawerClose Variant="ShadcnButtonVariant.Outline" OnClick="HoldDrawerDispatch">Cancel</ShadcnDrawerClose><ShadcnDrawerClose Variant="ShadcnButtonVariant.Default" OnClick="ReleaseDrawerDispatch">Confirm dispatch</ShadcnDrawerClose></ShadcnDrawerFooter>
                </ShadcnDrawerContent>
            </ShadcnDrawer>
            @if (_drawerStatus is not null) { <p class="theme-runway-action-status" role="status">@_drawerStatus</p> }
            break;
        case "delivery-sheet":
            <p class="theme-use-case-card__description">Friday, 28 August · 16:00 · Samut Prakan</p>
            <ShadcnSheet>
                <ShadcnSheetTrigger>Open schedule</ShadcnSheetTrigger>
                <ShadcnSheetContent CloseLabel="Close delivery schedule">
                    <ShadcnSheetHeader><ShadcnSheetTitle>Delivery schedule</ShadcnSheetTitle><ShadcnSheetDescription>Coordinate the inspection release and courier collection.</ShadcnSheetDescription></ShadcnSheetHeader>
                    <div class="theme-bento-overlay-body"><label>Production contact<ThemeAnimatedInput @bind-Value="_contactName" /></label><label class="theme-runway-check"><ShadcnCheckbox Value="@_notifyProjectTeam" ValueChanged="value => _notifyProjectTeam = value ?? false" /> Notify the project team</label></div>
                    <ShadcnSheetFooter><ShadcnSheetClose OnClick="CancelSchedule">Cancel</ShadcnSheetClose><ShadcnSheetClose Variant="ShadcnButtonVariant.Default" OnClick="SaveSchedule">Save schedule</ShadcnSheetClose></ShadcnSheetFooter>
                </ShadcnSheetContent>
            </ShadcnSheet>
            @if (_scheduleStatus is not null) { <p class="theme-runway-action-status" role="status">@_scheduleStatus</p> }
            break;
        case "tooltip-guidance":
            <p class="theme-use-case-card__description">Hover or focus the controls for concise inspection guidance.</p>
            <div class="theme-use-case-card__actions">
                <ShadcnTooltipProvider><ShadcnTooltip><ShadcnTooltipTrigger>Surface finish</ShadcnTooltipTrigger><ShadcnTooltipContent>Measure Ra across three traces</ShadcnTooltipContent></ShadcnTooltip></ShadcnTooltipProvider>
                <ShadcnTooltipProvider><ShadcnTooltip><ShadcnTooltipTrigger>Diameter</ShadcnTooltipTrigger><ShadcnTooltipContent>Target 25.000 ±0.010 mm</ShadcnTooltipContent></ShadcnTooltip></ShadcnTooltipProvider>
            </div>
            break;
        case "production-planning-suite":
            <ThemeOperationsConsole Kind="production" />
            break;
        case "quality-release-suite":
            <ThemeOperationsConsole Kind="quality" />
            break;
        case "customer-handoff-suite":
            <ThemeOperationsConsole Kind="handoff" />
            break;
    }
    @if (_actionStatus is not null) { <p class="theme-runway-action-status" role="status">@_actionStatus</p> }
    </ShadcnCardContent>
</ShadcnCard>

@code {
    [Parameter, EditorRequired] public ThemeUseCaseDefinition Definition { get; set; } = null!;
    [Parameter, EditorRequired] public ThemeDemonstrationFrame Frame { get; set; } = null!;
    [Parameter] public ThemeStudioLocale Locale { get; set; }
    private string? _profileName;
    private bool _saveAddress = true;
    private bool _handoffSaved;
    private bool _depositApproved;
    private string? _depositStatus;
    private bool _dispatchConfirmed;
    private string? _dispatchStatus;
    private bool _reviewersExpanded;
    private bool _dueTooltipOpen;
    private IReadOnlyCollection<string> _openWorkflowSections = ["process"];
    private bool _issueSubmitted;
    private string _contactName = "Narin S.";
    private string _contactPhone = "+66 81 555 2418";
    private string? _contactStatus;
    private string? _drawerStatus;
    private string? _scheduleStatus;
    private bool _notifyProjectTeam = true;
    private bool _reviewerHoverOpen;
    private bool _planReviewOpen;
    private bool _inspectionReportOpen;
    private bool _drawingViewerOpen;
    private bool _viewerSection;
    private int _viewerRotation;
    private int _viewerZoom = 100;
    private bool _reviewerManagerOpen;
    private bool _quietHours = true;
    private bool _dropzoneUploading;
    private double _dropzoneProgress;
    private string _dropzoneFileName = "enclosure-rev-c.step";
    private readonly bool[] _alertEnabled = [true, true, false];
    private string? _actionStatus;
    private int _conversationSequence = 2;
    private string Title => Locale == ThemeStudioLocale.Thai ? Definition.ThaiTitle : Definition.EnglishTitle;
    private static readonly ShadcnIconData ChevronIcon = new("lucide", "chevron-right", "0 0 24 24", "<path d=\"m9 18 6-6-6-6\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\"/>");
    private static readonly ShadcnIconData FileIcon = new("lucide", "file", "0 0 24 24", "<path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z\" fill=\"none\" stroke=\"currentColor\" stroke-linejoin=\"round\" stroke-width=\"2\"/><path d=\"M14 2v6h6\" fill=\"none\" stroke=\"currentColor\" stroke-linejoin=\"round\" stroke-width=\"2\"/>");
    private static readonly ShadcnIconData XIcon = new("lucide", "x", "0 0 24 24", "<path d=\"M18 6 6 18M6 6l12 12\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"2\"/>");
    private static readonly ShadcnIconData TrashIcon = new("lucide", "trash-2", "0 0 24 24", "<path d=\"M3 6h18M8 6V4h8v2m-9 0 1 15h8l1-15M10 11v6m4-6v6\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\"/>");
    private static readonly ShadcnIconData DownloadIcon = new("lucide", "download", "0 0 24 24", "<path d=\"M12 3v12m0 0 5-5m-5 5-5-5M5 21h14\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\"/>");
    private sealed record QuotationRow(string Id, string Customer, string Status, double Amount);
    private static readonly QuotationRow[] QuotationRows =
    [
        new("Q-2847", "Siam Motion", "Review", 97000),
        new("Q-2851", "Apex Robotics", "Approved", 148500),
        new("Q-2854", "Thai Aero Parts", "Draft", 64200)
    ];
    private static readonly ShadcnDataTableColumn<QuotationRow>[] QuotationColumns =
    [
        new("id", "Quotation", row => row.Id) { Sortable = true },
        new("customer", "Customer", row => row.Customer) { Filterable = true },
        new("status", "Status", row => row.Status),
        new("amount", "Amount", row => $"฿{row.Amount:N0}") { Sortable = true, Alignment = ShadcnTableAlignment.End }
    ];
    private static readonly string[] ProductionChartCategories = ["W1", "W2", "W3", "W4", "W5", "W6"];
    private static readonly ShadcnChartConfig ProductionChartConfig = new()
    {
        ["milling"] = new("Milling") { Color = "var(--theme-production-milling)" },
        ["turning"] = new("Turning") { Color = "var(--theme-production-turning)" }
    };
    private static readonly ShadcnChartSeries[] ProductionChartSeries =
    [
        new("milling", [42, 55, 48, 63, 59, 72]),
        new("turning", [31, 37, 44, 39, 51, 56])
    ];
    private ShadcnDataTableState _quotationTableState = new() { PageSize = 3 };
    private sealed record ConversationTurn(string Id, string Text, bool Assistant);
    private readonly List<ConversationTurn> _conversationTurns =
    [
        new("conversation-user-1", "ตรวจสอบกำหนดส่ง WO-2418 ให้หน่อย", false),
        new("conversation-assistant-2", "กำหนดส่งยังเป็นวันศุกร์ เวลา 16:00 น. งานกัดเสร็จแล้วและกำลังรอรายงานตรวจสอบขั้นสุดท้าย", true)
    ];
    private static readonly string[] AssistantResponses =
    [
        "WO-2418 ผ่านงานกัดแล้ว ทีมคุณภาพกำลังตรวจมิติขั้นสุดท้าย และยังพร้อมส่งวันศุกร์เวลา 16:00 น.",
        "ฉันตรวจสอบคิวแล้ว งานนี้ไม่มีรายการค้างจากฝ่ายผลิต เหลือเพียงอนุมัติรายงานตรวจสอบก่อนจัดส่ง",
        "สถานะล่าสุดคือพร้อมส่งมอบ กรุณายืนยันผู้รับและจุดส่งที่บางนาเพื่อให้ทีมโลจิสติกส์ดำเนินการต่อ"
    ];
    private static readonly ShadcnQuestionnaireItemDefinition[] QuestionnaireItems =
    [
        new("scope", Required: true, Choices: [new("machining"), new("quality")]),
        new("notes", AllowsFreeform: true)
    ];
    private const string ShiftValue = "Night · Cell A3";
    private const string FactoryValue = "MALIEV · Samut Prakan";
    private const string DockValue = "B-04";
    private const string ReferenceValue = "WO-2418";
    private static double ClampPercent(double value) => Math.Clamp(value, 0, 100);
    private double DropzoneProgress => _dropzoneProgress > 0 ? _dropzoneProgress : ClampPercent(Frame.UploadPercent);
    private static string FormatPercent(double value) => $"{ClampPercent(value):0}%";
    private void SendConversationMessage(string message)
    {
        _conversationTurns.Add(new($"conversation-user-{++_conversationSequence}", message, false));
        var response = AssistantResponses[Random.Shared.Next(AssistantResponses.Length)];
        _conversationTurns.Add(new($"conversation-assistant-{++_conversationSequence}", response, true));
    }
    private void TogglePlanReview() => _planReviewOpen = !_planReviewOpen;
    private async Task SaveProfileAsync()
    {
        await Task.Delay(350);
        _actionStatus = $"Profile saved for {_profileName ?? "Narin S."}.";
    }
    private void ToggleInspectionReport() => _inspectionReportOpen = !_inspectionReportOpen;
    private async Task ConfirmHandoffAsync()
    {
        await Task.Delay(350);
        _handoffSaved = true;
    }
    private async Task HandleDropzoneSelectionAsync(ShadcnDropzoneSelection selection)
    {
        if (!selection.IsValid || selection.Files.Count == 0) return;
        _dropzoneFileName = selection.Files.Count == 1 ? selection.Files[0].Name : $"{selection.Files.Count} production drawings";
        _dropzoneProgress = 0;
        _dropzoneUploading = true;
        for (var progress = 10; progress <= 100; progress += 10)
        {
            await Task.Delay(80);
            _dropzoneProgress = progress;
            await InvokeAsync(StateHasChanged);
        }
        _dropzoneUploading = false;
    }
    private void ReviewDeposit()
    {
        _depositApproved = false;
        _depositStatus = "Deposit returned to pending approval.";
    }
    private void ApproveDeposit()
    {
        _depositApproved = true;
        _depositStatus = "Deposit approved for production.";
    }
    private void ConfirmDispatch()
    {
        _dispatchConfirmed = true;
        _dispatchStatus = "Dispatch confirmed for 16:00 collection.";
    }
    private void CancelDispatch()
    {
        _dispatchConfirmed = false;
        _dispatchStatus = "Dispatch held for another review.";
    }
    private void ToggleReviewers(MouseEventArgs _) => _reviewersExpanded = !_reviewersExpanded;
    private void CollapseReviewers() => _reviewersExpanded = false;
    private void ToggleDueTooltip(MouseEventArgs _) => _dueTooltipOpen = !_dueTooltipOpen;
    private void ReplyToConversation(string quote) => _actionStatus = $"Replying to: {quote}";
    private void ToggleReviewerManagement() => _reviewerManagerOpen = !_reviewerManagerOpen;
    private void SetAlertEnabled(int index, bool? value) => _alertEnabled[index] = value ?? false;
    private void SelectWorkflowAction(string status) => _actionStatus = status;
    private void OpenProcessPlan() => SelectWorkflowAction("Process plan opened.");
    private void OpenProductionQueue() => SelectWorkflowAction("Production queue opened.");
    private void OpenMachineCell() => SelectWorkflowAction("Cell A3 workspace opened.");
    private void OpenInspectionSchedule() => SelectWorkflowAction("Inspection scheduling opened.");
    private void OpenDeliveryRelease() => SelectWorkflowAction("Delivery release opened.");
    private void OpenQuotationDetails(MouseEventArgs _) => SelectWorkflowAction("Quotation details opened.");
    private void DuplicateQuotationRevision(MouseEventArgs _) => SelectWorkflowAction("Revision duplicated as a new draft.");
    private void ArchiveQuotationDraft(MouseEventArgs _) => SelectWorkflowAction("Draft archived.");
    private void OpenDrawing(MouseEventArgs _) => SelectWorkflowAction("Drawing opened in the review workspace.");
    private void EnableDrawingRename(MouseEventArgs _) => SelectWorkflowAction("Rename mode enabled.");
    private void TrashDrawing(MouseEventArgs _) => SelectWorkflowAction("Drawing moved to the review trash.");
    private void OpenDrawingViewer()
    {
        _drawingViewerOpen = true;
        _actionStatus = "3D drawing review opened.";
    }
    private Task SetDrawingViewerOpen(bool open)
    {
        _drawingViewerOpen = open;
        return Task.CompletedTask;
    }
    private void RotateDrawing() => _viewerRotation = (_viewerRotation + 45) % 360;
    private void ToggleSectionView() => _viewerSection = !_viewerSection;
    private void ZoomOutDrawing() => _viewerZoom = Math.Max(50, _viewerZoom - 10);
    private void ZoomInDrawing() => _viewerZoom = Math.Min(160, _viewerZoom + 10);
    private void ApproveDrawing(MouseEventArgs _) => _actionStatus = "Revision C approved for inspection.";
    private void HandleAttachmentAction(ShadcnAttachmentActionKind action) => _actionStatus = action switch
    {
        ShadcnAttachmentActionKind.Cancel => "Drawing upload cancelled.",
        ShadcnAttachmentActionKind.Remove => "Attachment removed from this review.",
        ShadcnAttachmentActionKind.Download => "Secure drawing download prepared.",
        _ => "Attachment action completed."
    };
    private void SubmitIssue() => _issueSubmitted = true;
    private void SaveContact(MouseEventArgs _) => _contactStatus = $"Production contact saved for {_contactName}.";
    private void CancelContact(MouseEventArgs _) => _contactStatus = "Contact changes discarded.";
    private void ReleaseDrawerDispatch(MouseEventArgs _) => _drawerStatus = "Dispatch released to Kerry Express.";
    private void HoldDrawerDispatch(MouseEventArgs _) => _drawerStatus = "Dispatch remains on hold.";
    private void SaveSchedule(MouseEventArgs _) => _scheduleStatus = _notifyProjectTeam
        ? "Delivery schedule saved and the project team notified."
        : "Delivery schedule saved without notifications.";
    private void CancelSchedule(MouseEventArgs _) => _scheduleStatus = "Schedule changes discarded.";
    private Task OnQuotationTableStateChanged(ShadcnDataTableState state)
    {
        _quotationTableState = state;
        return InvokeAsync(StateHasChanged);
    }
    private static readonly (string Label, string Description, bool Enabled)[] AlertOptions =
    [
        ("Inspection failures", "Immediate quality notification", true),
        ("Machine state changes", "Stops, holds, and resumptions", true),
        ("Routine progress", "Hourly production summary", false)
    ];
}
