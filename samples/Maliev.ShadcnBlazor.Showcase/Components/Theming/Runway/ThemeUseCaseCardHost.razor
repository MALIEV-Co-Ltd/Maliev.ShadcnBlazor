@namespace Maliev.ShadcnBlazor.Showcase.Components.Theming.Runway
@using System.Globalization
@using Maliev.ShadcnBlazor.Components.Actions
@using Maliev.ShadcnBlazor.Components.Content
@using Maliev.ShadcnBlazor.Components.Conversation
@using Maliev.ShadcnBlazor.Components.DataDisplay
@using Maliev.ShadcnBlazor.Components.Disclosure
@using Maliev.ShadcnBlazor.Components.Direction
@using Maliev.ShadcnBlazor.Components.Feedback.Toast
@using Maliev.ShadcnBlazor.Components.Forms
@using Maliev.ShadcnBlazor.Components.Icons
@using Maliev.ShadcnBlazor.Components.Layout
@using Maliev.ShadcnBlazor.Components.Navigation
@using Maliev.ShadcnBlazor.Components.Overlays
@using Maliev.ShadcnBlazor.Components.Typography
@using Maliev.ShadcnBlazor.Showcase.Components.Documentation
@using Maliev.ShadcnBlazor.Showcase.Theming.Runway
@inject IShadcnToastService Toasts

<ShadcnCard Class="theme-use-case-card"
         data-use-case-id="@Definition.Id"
         data-bento-size="@Definition.Size.ToString().ToLowerInvariant()">
    @if (Definition.Id != "project-questionnaire")
    {
        <ShadcnCardHeader Class="theme-use-case-card__header">
            <ShadcnCardTitle>@Title</ShadcnCardTitle>
        </ShadcnCardHeader>
    }

    <ShadcnCardContent Class="theme-use-case-card__content">
    @switch (Definition.Id)
    {
        case "production-capacity":
            <div class="theme-runway-stat"><strong>@FormatPercent(Frame.CapacityPercent)</strong><span>@T("5-axis capacity · Cell A3")</span></div>
            <ShadcnProgress Class="theme-status-success" Value="@ClampPercent(Frame.CapacityPercent)"><ShadcnProgressLabel>@T("Weekly capacity")</ShadcnProgressLabel><ShadcnProgressValue /></ShadcnProgress>
            <div class="theme-use-case-card__actions"><ShadcnBadge Class="theme-status-success">@T("On schedule")</ShadcnBadge><ShadcnButton Size="ShadcnButtonSize.Small" Variant="ShadcnButtonVariant.Outline" OnClick="TogglePlanReview"><span class="theme-workflow-inline-icon" data-theme-workflow-icon="@Definition.Id"><ShadcnIcon Icon="@WorkflowIcon" Size="15" /></span>@T(_planReviewOpen ? "Close plan" : "Review plan")</ShadcnButton></div>
            @if (_planReviewOpen) { <div class="theme-inline-detail" role="region" aria-label="@T("Capacity plan review")">@T("Cell A3 can accept two additional work orders before Friday.")</div> }
            break;
        case "production-analytics":
            <ShadcnChart Class="theme-production-chart" Id="theme-production-analytics" Title="@T("Completed operations")" Description="@T("Six-week output by production cell")" CategoryLabel="@T("Category")" Type="ShadcnChartType.Bar" Config="LocalizedProductionChartConfig" Categories="ProductionChartCategories" Series="ProductionChartSeries" ShowGrid="true" ShowMajorGrid="true" ShowMinorGrid="true" ShowPrimaryYAxis="true" ShowLegend="true" LegendInteractive="true" InitialWidth="520" InitialHeight="230" />
            break;
        case "operator-profile":
            <div class="theme-runway-profile"><ShadcnAvatar><ShadcnAvatarImage Source="images/avatars/operator-thai.png" Alt="Narin S., Thai CNC engineer" /><ShadcnAvatarFallback>NS</ShadcnAvatarFallback></ShadcnAvatar><div><strong>Narin S.</strong><span>@T("CNC engineer · Samut Prakan")</span></div></div>
            <label>@T("Name")<ThemeAnimatedInput Value="@(_profileName ?? "Narin S.")" ValueChanged="value => _profileName = value" /></label>
            <label>@T("Shift")<ThemeAnimatedInput Value="@T(ShiftValue)" ReadOnly="true" /></label>
            <ShadcnButton Size="ShadcnButtonSize.Small" ButtonType="ShadcnButtonType.Submit" BusyText="@T("Saving")" SuccessText="@T("Saved")" OnClick="SaveProfileAsync"><span class="theme-workflow-inline-icon" data-theme-workflow-icon="@Definition.Id"><ShadcnIcon Icon="@WorkflowIcon" Size="15" /></span>@T("Save profile")</ShadcnButton>
            break;
        case "drawing-attachment":
            <ShadcnAttachment Title="housing-rev-d.step" State="ShadcnAttachmentState.Uploading" Progress="@ClampPercent(Frame.UploadPercent)">
                <ShadcnAttachmentMedia><ShadcnIcon Icon="@FileIcon" Size="20" /></ShadcnAttachmentMedia>
                <ShadcnAttachmentContent><ShadcnAttachmentTitle>housing-rev-d.step</ShadcnAttachmentTitle><ShadcnAttachmentDescription>@T("8.4 MB · STEP · uploading")</ShadcnAttachmentDescription></ShadcnAttachmentContent>
                <ShadcnAttachmentActions><ShadcnAttachmentAction Action="ShadcnAttachmentActionKind.Cancel" AccessibleName="@T("Cancel drawing upload")" OnAction="HandleAttachmentAction"><ShadcnIcon Icon="@XIcon" Size="16" /></ShadcnAttachmentAction></ShadcnAttachmentActions>
            </ShadcnAttachment>
            <ShadcnAttachment Title="surface-scan.zip" State="ShadcnAttachmentState.Uploading">
                <ShadcnAttachmentMedia><ShadcnIcon Icon="@FileIcon" Size="20" /></ShadcnAttachmentMedia>
                <ShadcnAttachmentContent><ShadcnAttachmentTitle>surface-scan.zip</ShadcnAttachmentTitle><ShadcnAttachmentDescription>@T("Preparing secure upload…")</ShadcnAttachmentDescription></ShadcnAttachmentContent>
                <ShadcnAttachmentActions><ShadcnAttachmentAction Action="ShadcnAttachmentActionKind.Cancel" AccessibleName="@T("Cancel surface scan upload")" OnAction="HandleAttachmentAction"><ShadcnIcon Icon="@XIcon" Size="16" /></ShadcnAttachmentAction></ShadcnAttachmentActions>
            </ShadcnAttachment>
            <ShadcnAttachment Title="inspection-plan.pdf" State="ShadcnAttachmentState.Done">
                <ShadcnAttachmentMedia><ShadcnIcon Icon="@FileIcon" Size="20" /></ShadcnAttachmentMedia>
                <ShadcnAttachmentContent><ShadcnAttachmentTitle>inspection-plan.pdf</ShadcnAttachmentTitle><ShadcnAttachmentDescription>@T("1.2 MB · ready for review")</ShadcnAttachmentDescription></ShadcnAttachmentContent>
                <ShadcnAttachmentActions><ShadcnAttachmentAction Action="ShadcnAttachmentActionKind.Remove" AccessibleName="@T("Remove inspection plan")" OnAction="HandleAttachmentAction"><ShadcnIcon Icon="@TrashIcon" Size="16" /></ShadcnAttachmentAction></ShadcnAttachmentActions>
            </ShadcnAttachment>
            break;
        case "quotation-files":
            <ShadcnDropzone Class="theme-runway-dropzone" Accept=".step,.stp,.pdf" Multiple="true" MaxFiles="5" MaxFileSize="20971520" Instructions="@T("Drop production drawings here")" Description="@T("STEP or PDF · up to 20 MB")" Loading="_dropzoneUploading" SelectionChanged="HandleDropzoneSelectionAsync" />
            @if (_dropzoneFiles.Count > 0)
            {
                <ShadcnAttachmentGroup Class="theme-uploaded-files" AccessibleName="@T("Selected production drawings")">
                    @foreach (var file in _dropzoneFiles)
                    {
                        <ShadcnAttachment @key="file.Id" Title="@file.Name" State="@FileState(file)" Progress="@FileProgress(file)">
                            <ShadcnAttachmentMedia><ShadcnIcon Icon="@FileIcon" Size="18" /></ShadcnAttachmentMedia>
                            <ShadcnAttachmentContent>
                                <ShadcnAttachmentTitle>@file.Name</ShadcnAttachmentTitle>
                                <ShadcnAttachmentDescription>@FormatFileSize(file.Size) · @T(file.Status)</ShadcnAttachmentDescription>
                            </ShadcnAttachmentContent>
                            <ShadcnAttachmentActions>
                                <ShadcnAttachmentAction Action="ShadcnAttachmentActionKind.Remove" AccessibleName="@T("Remove {0}", file.Name)" OnAction="_ => RemoveUploadedFile(file.Id)"><ShadcnIcon Icon="@TrashIcon" Size="16" /></ShadcnAttachmentAction>
                            </ShadcnAttachmentActions>
                        </ShadcnAttachment>
                    }
                </ShadcnAttachmentGroup>
            }
            <div class="theme-runway-file"><span><span class="theme-workflow-inline-icon" data-theme-workflow-icon="@Definition.Id"><ShadcnIcon Icon="@WorkflowIcon" Size="16" /></span>@_dropzoneFileName</span><ShadcnBadge Variant="ShadcnBadgeVariant.Secondary">@FormatPercent(DropzoneProgress)</ShadcnBadge></div>
            <ShadcnProgress Value="@DropzoneProgress"><ShadcnProgressLabel>@T("Upload progress")</ShadcnProgressLabel></ShadcnProgress>
            break;
        case "inspection-table":
            <ShadcnTable Borders="true" ExpectedColumnCount="4">
                <ShadcnTableCaption>@T("Latest dimensional checks")</ShadcnTableCaption>
                <ShadcnTableHeader><ShadcnTableRow><ShadcnTableHead>@T("Feature")</ShadcnTableHead><ShadcnTableHead>@T("Target")</ShadcnTableHead><ShadcnTableHead>@T("Measured")</ShadcnTableHead><ShadcnTableHead>@T("Status")</ShadcnTableHead></ShadcnTableRow></ShadcnTableHeader>
                <ShadcnTableBody>
                    <ShadcnTableRow><ShadcnTableCell>@T("Bore 4")</ShadcnTableCell><ShadcnTableCell>25.000 mm</ShadcnTableCell><ShadcnTableCell>24.998 mm</ShadcnTableCell><ShadcnTableCell><ShadcnBadge Class="theme-status-success">@T("Pass")</ShadcnBadge></ShadcnTableCell></ShadcnTableRow>
                    <ShadcnTableRow><ShadcnTableCell>@T("Datum A")</ShadcnTableCell><ShadcnTableCell>0.020 mm</ShadcnTableCell><ShadcnTableCell>0.014 mm</ShadcnTableCell><ShadcnTableCell><ShadcnBadge Class="theme-status-success">@T("Pass")</ShadcnBadge></ShadcnTableCell></ShadcnTableRow>
                    <ShadcnTableRow><ShadcnTableCell>@T("Surface")</ShadcnTableCell><ShadcnTableCell>Ra 1.6</ShadcnTableCell><ShadcnTableCell>Ra 1.4</ShadcnTableCell><ShadcnTableCell><ShadcnBadge Variant="ShadcnBadgeVariant.Secondary">@T("Review")</ShadcnBadge></ShadcnTableCell></ShadcnTableRow>
                </ShadcnTableBody>
            </ShadcnTable>
            break;
        case "shipping-handoff":
            <label>@T("Factory")<ThemeAnimatedInput Value="@FactoryValue" ReadOnly="true" /></label>
            <div class="theme-runway-fields"><label>@T("Dock")<ThemeAnimatedInput Value="@DockValue" ReadOnly="true" /></label><label>@T("Reference")<ThemeAnimatedInput Value="@ReferenceValue" ReadOnly="true" /></label></div>
            <label class="theme-runway-check"><ShadcnCheckbox Value="@_saveAddress" ValueChanged="value => _saveAddress = value ?? false" /> @T("Save as production handoff")</label>
            <ShadcnButton Size="ShadcnButtonSize.Small" ButtonType="ShadcnButtonType.Submit" BusyText="@T("Confirming")" SuccessText="@T("Confirmed")" OnClick="ConfirmHandoffAsync"><span class="theme-workflow-inline-icon" data-theme-workflow-icon="@Definition.Id"><ShadcnIcon Icon="@WorkflowIcon" Size="15" /></span>@T("Confirm address")</ShadcnButton>
            @if (_handoffSaved) { <p class="theme-runway-action-status" role="status">@T("Handoff saved for dispatch.")</p> }
            break;
        case "quotation-data-table":
            <div class="theme-runway-table-summary"><span><strong>@T("Quotation review queue")</strong><small>@T("Three active requests awaiting production decisions")</small></span><ShadcnBadge Variant="ShadcnBadgeVariant.Secondary">@T("3 active")</ShadcnBadge></div>
            <ShadcnDataTable TItem="QuotationRow" Items="LocalizedQuotationRows" Columns="LocalizedQuotationColumns" RowKey="@(row => row.Id)" State="_quotationTableState" StateChanged="OnQuotationTableStateChanged" Selectable="true" FilterPlaceholder="@T("Search quotations")" EmptyText="@T("No quotations found")" />
            break;
        case "inspection-alerts":
            @for (var index = 0; index < AlertOptions.Length; index++)
            {
                var optionIndex = index;
                var option = AlertOptions[index];
                <label class="theme-runway-check"><ShadcnCheckbox Value="@_alertEnabled[index]" ValueChanged="value => SetAlertEnabled(optionIndex, value)" /><span><strong>@T(option.Label)</strong><small>@T(option.Description)</small></span></label>
            }
            <div class="theme-use-case-card__actions"><span>@T("Quiet hours")</span><ShadcnSwitch @bind-Value="_quietHours" aria-label="@T("Use quiet hours")" /></div>
            break;
        case "quality-alert":
            <ShadcnAlert Variant="ShadcnAlertVariant.Destructive"><ShadcnAlertTitle>@T("Inspection hold")</ShadcnAlertTitle><ShadcnAlertDescription>@T("Bore 4 is 0.012 mm below the lower tolerance. Review the probe result before machining resumes.")</ShadcnAlertDescription><ShadcnAlertAction><ShadcnButton Size="ShadcnButtonSize.Small" Variant="ShadcnButtonVariant.Outline" OnClick="ToggleInspectionReport">@T(_inspectionReportOpen ? "Close report" : "Open report")</ShadcnButton></ShadcnAlertAction></ShadcnAlert>
            @if (_inspectionReportOpen) { <div class="theme-inline-detail" role="region" aria-label="@T("Inspection report")"><strong>@T("Bore 4 probe report")</strong><span>@T("Measured 24.988 mm · lower limit 24.990 mm · hold active")</span></div> }
            <ShadcnAlert><ShadcnAlertTitle>@T("Calibration current")</ShadcnAlertTitle><ShadcnAlertDescription>@T("Probe P-08 was calibrated today at 08:10.")</ShadcnAlertDescription></ShadcnAlert>
            break;
        case "deposit-approval":
            <div class="theme-runway-amount"><span>@T("Manufacturing deposit")</span><strong>฿48,500.00</strong></div>
            <ShadcnSeparator />
            <dl class="theme-runway-summary"><div><dt>@T("Quotation")</dt><dd>Q-2847</dd></div><div><dt>@T("Due")</dt><dd>@T("23 Aug 2569")</dd></div><div><dt>@T("Terms")</dt><dd>@T("50% before production")</dd></div></dl>
            <div class="theme-use-case-card__actions"><ShadcnButton Size="ShadcnButtonSize.Small" Variant="ShadcnButtonVariant.Outline" OnClick="ReviewDeposit">@T("Review")</ShadcnButton><ShadcnButton Size="ShadcnButtonSize.Small" Disabled="_depositApproved" OnClick="ApproveDeposit">@T(_depositApproved ? "Approved" : "Approve deposit")</ShadcnButton></div>
            @if (_depositStatus is not null) { <p class="theme-runway-action-status" role="status">@T(_depositStatus)</p> }
            break;
        case "assigned-reviewers":
            <ShadcnAvatarGroup Class="theme-runway-reviewer-avatars" Expanded="_reviewersExpanded" AutoCollapseAfter="@TimeSpan.FromSeconds(5)" OnAutoCollapse="CollapseReviewers"><ShadcnAvatar Size="ShadcnAvatarSize.Small"><ShadcnAvatarImage Source="images/avatars/operator-thai.png" Alt="Nattapong, Thai machining reviewer" /><ShadcnAvatarFallback>NP</ShadcnAvatarFallback></ShadcnAvatar><ShadcnAvatar Size="ShadcnAvatarSize.Small"><ShadcnAvatarImage Source="images/avatars/reviewer-thai.png" Alt="Kanda, Thai quality reviewer" /><ShadcnAvatarFallback>KT</ShadcnAvatarFallback></ShadcnAvatar><ShadcnAvatar Size="ShadcnAvatarSize.Small"><ShadcnAvatarImage Source="images/avatars/coordinator-thai.png" Alt="Pim, Thai logistics reviewer" /><ShadcnAvatarFallback>PS</ShadcnAvatarFallback></ShadcnAvatar>@if (_reviewersExpanded) { <ShadcnAvatar Size="ShadcnAvatarSize.Small"><ShadcnAvatarFallback>SK</ShadcnAvatarFallback></ShadcnAvatar><ShadcnAvatar Size="ShadcnAvatarSize.Small"><ShadcnAvatarFallback>AP</ShadcnAvatarFallback></ShadcnAvatar><ShadcnAvatar Size="ShadcnAvatarSize.Small"><ShadcnAvatarFallback>TN</ShadcnAvatarFallback></ShadcnAvatar><ShadcnAvatar Size="ShadcnAvatarSize.Small"><ShadcnAvatarFallback>WR</ShadcnAvatarFallback></ShadcnAvatar> } else { <ShadcnAvatarGroupCount Size="ShadcnAvatarSize.Small" ExpandLabel="@T("Show four more reviewers")" OnClick="ToggleReviewers">+4</ShadcnAvatarGroupCount> }</ShadcnAvatarGroup>
            <ul class="theme-runway-reviewers"><li><span>@T("Nattapong · Machining")</span><ShadcnBadge Class="theme-status-success">@T("Ready")</ShadcnBadge></li><li><span>@T("Kanda · Quality")</span><ShadcnBadge Variant="ShadcnBadgeVariant.Secondary">@T("Reviewing")</ShadcnBadge></li><li><span>@T("Pim · Logistics")</span><ShadcnBadge Variant="ShadcnBadgeVariant.Outline">@T("Queued")</ShadcnBadge></li></ul>
            <ShadcnButton Size="ShadcnButtonSize.Small" Variant="ShadcnButtonVariant.Outline" OnClick="ToggleReviewerManagement">@T(_reviewerManagerOpen ? "Close reviewer management" : "Manage reviewers")</ShadcnButton>
            @if (_reviewerManagerOpen) { <div class="theme-inline-detail" role="region" aria-label="@T("Reviewer management")"><strong>@T("Reviewer coverage")</strong><span>@T("Machining, Quality, and Logistics are assigned. Four alternates are available.")</span></div> }
            break;
        case "conversation-marker":
            <ShadcnMarker Variant="ShadcnMarkerVariant.Separator"><ShadcnMarkerContent>14:32 · WO-2418</ShadcnMarkerContent></ShadcnMarker>
            <div class="theme-runway-activity"><ShadcnAvatar Size="ShadcnAvatarSize.Small"><ShadcnAvatarImage Source="images/avatars/reviewer-thai.png" Alt="Kanda, Thai quality reviewer" /><ShadcnAvatarFallback>KT</ShadcnAvatarFallback></ShadcnAvatar><span><strong>@T("Final inspection uploaded")</strong><small>@T("Kanda attached the signed dimensional report.")</small></span><ShadcnBadge Class="theme-status-success">@T("Ready")</ShadcnBadge></div>
            <ShadcnMarker Variant="ShadcnMarkerVariant.Default" Live="true"><ShadcnMarkerIcon><span class="shadcn-marker-loader" aria-hidden="true"></span></ShadcnMarkerIcon><ShadcnMarkerContent Streaming="true">@T("Dispatch team is preparing the Bangkok handoff")</ShadcnMarkerContent></ShadcnMarker>
            break;
        case "work-order-navigation":
            <nav aria-label="@T("Work order path")" class="theme-runway-breadcrumb"><a href="theme" @onclick="OpenProductionQueue" @onclick:preventDefault>@T("Production")</a><span>/</span><a href="theme" @onclick="OpenMachineCell" @onclick:preventDefault>@T("Cell A3")</a><span>/</span><strong>WO-2418</strong></nav>
            <ShadcnAccordion Values="@_openWorkflowSections" ValuesChanged="values => _openWorkflowSections = values" Label="@T("Work order actions")">
                <ShadcnAccordionItem Value="process"><ShadcnAccordionTrigger>@T("Change process plan")</ShadcnAccordionTrigger><ShadcnAccordionContent><p>@T("12 operations · revision C")</p><ShadcnButton Size="ShadcnButtonSize.Small" Variant="ShadcnButtonVariant.Outline" OnClick="OpenProcessPlan">@T("Open process editor")</ShadcnButton></ShadcnAccordionContent></ShadcnAccordionItem>
                <ShadcnAccordionItem Value="inspection"><ShadcnAccordionTrigger>@T("Schedule inspection")</ShadcnAccordionTrigger><ShadcnAccordionContent><p>@T("Final dimensional report · Quality desk")</p><ShadcnButton Size="ShadcnButtonSize.Small" Variant="ShadcnButtonVariant.Outline" OnClick="OpenInspectionSchedule">@T("Choose inspection time")</ShadcnButton></ShadcnAccordionContent></ShadcnAccordionItem>
                <ShadcnAccordionItem Value="delivery"><ShadcnAccordionTrigger>@T("Release delivery")</ShadcnAccordionTrigger><ShadcnAccordionContent><p>@T("Awaiting quality approval")</p><ShadcnButton Size="ShadcnButtonSize.Small" Variant="ShadcnButtonVariant.Outline" OnClick="OpenDeliveryRelease">@T("Review release gate")</ShadcnButton></ShadcnAccordionContent></ShadcnAccordionItem>
            </ShadcnAccordion>
            <ShadcnDialog Open="_processEditorOpen" OpenChanged="SetProcessEditorOpen">
                <ShadcnDialogContent Class="theme-process-editor" ShowCloseButton="true" CloseLabel="@T("Close process editor")">
                    <ShadcnDialogHeader><ShadcnDialogTitle>@T("Process plan editor")</ShadcnDialogTitle><ShadcnDialogDescription>@T("Update the machining sequence for WO-2418 revision C.")</ShadcnDialogDescription></ShadcnDialogHeader>
                    <div class="theme-process-editor__steps"><label>@T("Operation 10")<ThemeAnimatedInput Value="@T("5-axis finish milling")" /></label><label>@T("Machine")<ThemeAnimatedInput Value="DMG MORI DMU 50" /></label><label>@T("Inspection gate")<ThemeAnimatedInput Value="@T("Probe bore 4 before release")" /></label></div>
                    <ShadcnDialogFooter><ShadcnDialogClose Variant="ShadcnButtonVariant.Outline">@T("Cancel")</ShadcnDialogClose><ShadcnDialogClose Variant="ShadcnButtonVariant.Default" OnClick="SaveProcessPlan">@T("Save revision")</ShadcnDialogClose></ShadcnDialogFooter>
                </ShadcnDialogContent>
            </ShadcnDialog>
            break;
        case "machine-cell":
            <div class="theme-runway-machine"><div><strong>DMG MORI DMU 50</strong><span>@T("5-axis milling · Cell A3")</span></div></div>
            <div class="theme-runway-stat"><strong data-testid="machine-load-percent">@FormatPercent(Frame.CapacityPercent - 7)</strong><span>@T("Spindle load")</span></div>
            <ShadcnProgress Value="@ClampPercent(Frame.CapacityPercent - 7)"><ShadcnProgressLabel>@T("Spindle load")</ShadcnProgressLabel><ShadcnProgressValue /></ShadcnProgress>
            <ShadcnAlert><ShadcnAlertTitle>@T("In-process inspection")</ShadcnAlertTitle><ShadcnAlertDescription>@T("Bore diameter within tolerance at 14:20.")</ShadcnAlertDescription></ShadcnAlert>
            break;
        case "assistant-conversation":
            <div class="theme-runway-chat" aria-label="@T("Assistant conversation preview")">
                <ShadcnMessageScrollerProvider AutoScroll="true" DefaultScrollPosition="ShadcnMessageDefaultScrollPosition.End">
                    <ShadcnMessageScroller>
                        <ShadcnMessageScrollerViewport AccessibleName="@T("Assistant conversation messages")">
                            <ShadcnMessageScrollerContent>
                                <ShadcnMarker Variant="ShadcnMarkerVariant.Separator"><ShadcnMarkerContent>@T("Today · WO-2418")</ShadcnMarkerContent></ShadcnMarker>
                                <ShadcnMessageGroup>
                                    @foreach (var turn in _conversationTurns)
                                    {
                                        <ShadcnMessageScrollerItem @key="turn.Id" MessageId="@turn.Id" ScrollAnchor="@(turn.Id == _conversationTurns[^1].Id)">
                                            <ShadcnMessage Align="@(turn.Assistant ? ShadcnLogicalAlign.Start : ShadcnLogicalAlign.End)">
                                                @if (turn.Assistant)
                                                {
                                                    <ShadcnMessageAvatar><ShadcnAvatar Size="ShadcnAvatarSize.Small"><ShadcnAvatarImage Source="images/avatars/assistant-thai.png" Alt="@T("MALIEV Assistant")" /><ShadcnAvatarFallback>MA</ShadcnAvatarFallback></ShadcnAvatar></ShadcnMessageAvatar>
                                                }
                                                <ShadcnMessageContent><ShadcnMessageBody>
                                                    @if (turn.Assistant) { <ShadcnMessageHeader>@T("MALIEV Assistant")</ShadcnMessageHeader> }
                                                    <ShadcnBubble Align="@(turn.Assistant ? ShadcnLogicalAlign.Start : ShadcnLogicalAlign.End)" Variant="@(turn.Assistant ? ShadcnBubbleVariant.Ghost : ShadcnBubbleVariant.Default)"><ShadcnBubbleContent>
                                                        @if (!string.IsNullOrWhiteSpace(TurnReplyText(turn)))
                                                        {
                                                            <ShadcnMessageReplyQuote Quote="@(TurnReplyText(turn)!)" Label="@T("Replying to")" />
                                                        }
                                                        @if (turn.Assistant && turn.Id == _conversationTurns[^1].Id)
                                                        {
                                                            <ThemeTypingText Class="theme-runway-typing-text" Text="@TurnText(turn)" />
                                                        }
                                                        else { @TurnText(turn) }
                                                    </ShadcnBubbleContent></ShadcnBubble>
                                                </ShadcnMessageBody>
                                                <ShadcnMessageFooter><ShadcnMessageActions><ShadcnMessageCopyAction Text="@TurnText(turn)" Label="@T("Copy message")" CopiedLabel="@T("Copied")" FailedLabel="@T("Copy failed")" /><ShadcnMessageReplyAction Quote="@TurnText(turn)" Label="@T("Reply to message")" OnReply="ReplyToConversation" /></ShadcnMessageActions></ShadcnMessageFooter>
                                                </ShadcnMessageContent>
                                            </ShadcnMessage>
                                        </ShadcnMessageScrollerItem>
                                    }
                                </ShadcnMessageGroup>
                            </ShadcnMessageScrollerContent>
                        </ShadcnMessageScrollerViewport>
                    </ShadcnMessageScroller>
                </ShadcnMessageScrollerProvider>
                @if (!string.IsNullOrWhiteSpace(_replyQuote)) { <ShadcnMessageReplyQuote Quote="@_replyQuote" Label="@T("Replying to")" DismissLabel="@T("Cancel reply")" OnDismiss="ClearReply" /> }
                <ThemeConversationComposer Locale="Locale" OnSend="SendConversationMessage" />
            </div>
            break;
        case "project-questionnaire":
            @if (_questionnaireResult is null)
            {
                <ShadcnQuestionnaire @key="_questionnaireVersion" Items="QuestionnaireItems" DefaultItem="scope" Shortcuts="ShadcnQuestionnaireShortcutMode.Numbers" AccessibleName="@T("Production review questionnaire")" OnSubmit="SubmitQuestionnaire">
                    <ShadcnQuestionnaireProgress AccessibleName="@T("Questionnaire progress")" />
                    <ShadcnQuestionnaireItem Name="scope">
                        <ShadcnQuestionnaireTitle>@T("Choose the review scope")</ShadcnQuestionnaireTitle>
                        <ShadcnQuestionnaireDescription>@T("Select the team that should inspect WO-2418.")</ShadcnQuestionnaireDescription>
                        <ShadcnQuestionnaireChoices>
                            <ShadcnQuestionnaireChoice Value="machining" HideIndicator="true">@T("Machining")<ShadcnQuestionnaireChoiceDescription>@T("Toolpath and surface finish")</ShadcnQuestionnaireChoiceDescription></ShadcnQuestionnaireChoice>
                            <ShadcnQuestionnaireChoice Value="quality" HideIndicator="true">@T("Quality")<ShadcnQuestionnaireChoiceDescription>@T("Dimensions and inspection evidence")</ShadcnQuestionnaireChoiceDescription></ShadcnQuestionnaireChoice>
                        </ShadcnQuestionnaireChoices>
                        <ShadcnQuestionnaireError />
                    </ShadcnQuestionnaireItem>
                    <ShadcnQuestionnaireItem Name="notes">
                        <ShadcnQuestionnaireTitle>@T("Add inspection notes")</ShadcnQuestionnaireTitle>
                        <ShadcnQuestionnaireDescription>@T("Include the customer-specific acceptance criteria.")</ShadcnQuestionnaireDescription>
                        <ShadcnQuestionnaireInput AccessibleName="@T("Inspection notes")" />
                        <ShadcnQuestionnaireError />
                    </ShadcnQuestionnaireItem>
                    <ShadcnQuestionnaireActions><ShadcnQuestionnairePrevious>@T("Back")</ShadcnQuestionnairePrevious><ShadcnQuestionnaireSkip>@T("Skip")</ShadcnQuestionnaireSkip><ShadcnQuestionnaireNext>@T("Next")</ShadcnQuestionnaireNext><ShadcnQuestionnaireSubmit>@T("Submit review")</ShadcnQuestionnaireSubmit></ShadcnQuestionnaireActions>
                </ShadcnQuestionnaire>
            }
            else
            {
                <section class="theme-questionnaire-completion" role="region" aria-label="@T("Review submission summary")">
                    <span class="shadcn-questionnaire-progress">3 / 3</span>
