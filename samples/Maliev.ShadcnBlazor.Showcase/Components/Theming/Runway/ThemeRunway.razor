@namespace Maliev.ShadcnBlazor.Showcase.Components.Theming.Runway
@using Maliev.ShadcnBlazor.Showcase.Theming.Runway
@using Maliev.ShadcnBlazor.Showcase.ThemeScenarios
@inject IThemeUseCaseRegistry Registry
@inject IThemeScenarioRegistry ScenarioRegistry
@inject ThemeRunwayState RunwayState
@inject IJSRuntime JavaScript
@implements IAsyncDisposable

<section @ref="_root"
         class="theme-runway"
         aria-label="Curated realistic component use cases"
         data-testid="theme-runway"
         data-runway-paused="@(Paused ? "true" : "false")"
         data-reduced-motion="@(ReducedMotion ? "true" : "false")">
    <div class="theme-runway__columns" data-testid="theme-runway-columns">
        <div class="theme-runway__viewport" data-runway-track="left">
            <div class="theme-runway__track" data-runway-sequence>
                @foreach (var card in LeftCards)
                {
                    <ThemeUseCaseCardHost @key="card.Id" Definition="card" Frame="RunwayState.Frame" Locale="Locale" />
                }
                @foreach (var scenario in LeftScenarios)
                {
                    <ThemeScenarioRunwayCard @key="scenario.Id" Scenario="scenario" Locale="Locale" InstanceId="@($"left-{scenario.Id}")" Active="@IsScenarioActive($"left-{scenario.Id}")" />
                }
                <div class="theme-runway__mirror" aria-hidden="true" inert>
                    @foreach (var card in LeftCards)
                    {
                        <ThemeUseCaseCardHost @key="@($"mirror-left-{card.Id}")" Definition="card" Frame="RunwayState.Frame" Locale="Locale" IsMirror="true" />
                    }
                    @foreach (var scenario in LeftScenarios)
                    {
                        <ThemeScenarioRunwayCard @key="@($"mirror-left-{scenario.Id}")" Scenario="scenario" Locale="Locale" InstanceId="@($"mirror-left-{scenario.Id}")" Active="@IsScenarioActive($"mirror-left-{scenario.Id}")" IsMirror="true" />
                    }
                </div>
            </div>
        </div>
        <div class="theme-runway__viewport" data-runway-track="right">
            <div class="theme-runway__track" data-runway-sequence>
                @foreach (var card in RightCards)
                {
                    <ThemeUseCaseCardHost @key="card.Id" Definition="card" Frame="RunwayState.Frame" Locale="Locale" />
                }
                @foreach (var scenario in RightScenarios)
                {
                    <ThemeScenarioRunwayCard @key="scenario.Id" Scenario="scenario" Locale="Locale" InstanceId="@($"right-{scenario.Id}")" Active="@IsScenarioActive($"right-{scenario.Id}")" />
                }
                <div class="theme-runway__mirror" aria-hidden="true" inert>
                    @foreach (var card in RightCards)
                    {
                        <ThemeUseCaseCardHost @key="@($"mirror-right-{card.Id}")" Definition="card" Frame="RunwayState.Frame" Locale="Locale" IsMirror="true" />
                    }
                    @foreach (var scenario in RightScenarios)
                    {
                        <ThemeScenarioRunwayCard @key="@($"mirror-right-{scenario.Id}")" Scenario="scenario" Locale="Locale" InstanceId="@($"mirror-right-{scenario.Id}")" Active="@IsScenarioActive($"mirror-right-{scenario.Id}")" IsMirror="true" />
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="theme-runway__mobile" data-testid="theme-runway-mobile">
        @foreach (var card in Registry.All)
        {
            <ThemeUseCaseCardHost @key="@($"mobile-{card.Id}")" Definition="card" Frame="RunwayState.Frame" Locale="Locale" />
        }
        @foreach (var scenario in ScenarioRegistry.All)
        {
            <ThemeScenarioRunwayCard @key="@($"mobile-{scenario.Id}")" Scenario="scenario" Locale="Locale" InstanceId="@($"mobile-{scenario.Id}")" Active="@IsScenarioActive($"mobile-{scenario.Id}")" />
        }
    </div>
</section>

@code {
    [Parameter] public ThemeStudioLocale Locale { get; set; }
    [Parameter] public bool Paused { get; set; }
    [Parameter] public bool ReducedMotion { get; set; }
    private ElementReference _root;
    private IJSObjectReference? _module;
    private IJSObjectReference? _controller;
    private DotNetObjectReference<ThemeRunway>? _self;
    private bool _systemReducedMotion;
    private readonly HashSet<string> _activeScenarioInstances = new(StringComparer.Ordinal);
    private IReadOnlyList<ThemeUseCaseDefinition> LeftCards => Registry.All.Where(card => card.Track == ThemeRunwayTrack.Left).ToArray();
    private IReadOnlyList<ThemeUseCaseDefinition> RightCards => Registry.All.Where(card => card.Track == ThemeRunwayTrack.Right).ToArray();
    private IReadOnlyList<ThemeScenarioDefinition> LeftScenarios => ScenarioRegistry.All.Where((_, index) => index % 2 == 0).ToArray();
    private IReadOnlyList<ThemeScenarioDefinition> RightScenarios => ScenarioRegistry.All.Where((_, index) => index % 2 != 0).ToArray();

    protected override void OnInitialized()
    {
        RunwayState.Changed += OnChanged;
        RunwayState.SetPersistentPaused(Paused);
        RunwayState.SetReducedMotion(ReducedMotion || _systemReducedMotion);
        RunwayState.Start();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JavaScript.InvokeAsync<IJSObjectReference>("import", "./js/theme-studio-runway.js");
            _self = DotNetObjectReference.Create(this);
            _controller = await _module.InvokeAsync<IJSObjectReference>("attachRunway", _root, _self);
            return;
        }

        if (_controller is not null)
            await _controller.InvokeVoidAsync("refresh");
    }

    protected override async Task OnParametersSetAsync()
    {
        RunwayState.SetPersistentPaused(Paused);
        RunwayState.SetReducedMotion(ReducedMotion || _systemReducedMotion);
        if (_controller is not null)
            await _controller.InvokeVoidAsync("setPersistentPaused", Paused || ReducedMotion);
    }

    [JSInvokable]
    public void SetInteractionPaused(bool paused) => RunwayState.SetInteractionPaused(paused);

    [JSInvokable]
    public void SetSystemReducedMotion(bool reduced)
    {
        _systemReducedMotion = reduced;
        RunwayState.SetReducedMotion(ReducedMotion || _systemReducedMotion);
    }

    [JSInvokable]
    public void SetVisibleScenarios(string[] instanceIds)
    {
        var next = instanceIds.ToHashSet(StringComparer.Ordinal);
        if (_activeScenarioInstances.SetEquals(next)) return;
        _activeScenarioInstances.Clear();
        _activeScenarioInstances.UnionWith(next);
        _ = InvokeAsync(StateHasChanged);
    }

    private bool IsScenarioActive(string instanceId) => _activeScenarioInstances.Contains(instanceId);

    private void OnChanged(object? sender, EventArgs args) => _ = InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        RunwayState.Changed -= OnChanged;
        if (_controller is not null) await _controller.InvokeVoidAsync("dispose");
        if (_controller is not null) await _controller.DisposeAsync();
        if (_module is not null) await _module.DisposeAsync();
        _self?.Dispose();
    }
}
