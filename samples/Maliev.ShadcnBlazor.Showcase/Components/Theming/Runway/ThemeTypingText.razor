@namespace Maliev.ShadcnBlazor.Showcase.Components.Theming.Runway
@using System.Globalization
@using System.Text.RegularExpressions

<span class="@Class" data-typing-text aria-hidden="true">
    @foreach (var token in _tokens)
    {
        <span class="@(token.KeepTogether ? "theme-typing-word" : "theme-typing-flow")">
            @foreach (var glyph in token.Glyphs)
            {
                <span class="theme-typing-glyph" style="@GlyphStyle(glyph.Index)">@glyph.Value</span>
            }
        </span>
    }
</span>

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = string.Empty;
    [Parameter] public string? Class { get; set; }

    private string _renderedText = string.Empty;
    private IReadOnlyList<TypingToken> _tokens = [];

    protected override void OnParametersSet()
    {
        if (string.Equals(_renderedText, Text, StringComparison.Ordinal))
        {
            return;
        }

        _renderedText = Text;
        _tokens = Tokenize(Text);
    }

    private static IReadOnlyList<TypingToken> Tokenize(string text)
    {
        var tokens = new List<TypingToken>();
        var index = 0;
        foreach (var segment in Regex.Split(text, "(\\s+)"))
        {
            if (segment.Length == 0) continue;
            var glyphs = new List<TypingGlyph>();
            var elements = StringInfo.GetTextElementEnumerator(segment);
            while (elements.MoveNext()) glyphs.Add(new TypingGlyph(index++, elements.GetTextElement()));
            var latinWord = !string.IsNullOrWhiteSpace(segment) && segment.All(character => character <= '\u024f');
            tokens.Add(new TypingToken(latinWord, glyphs));
        }
        return tokens;
    }

    private static string GlyphStyle(int index) => $"--theme-typing-index: {index.ToString(CultureInfo.InvariantCulture)}";

    private sealed record TypingGlyph(int Index, string Value);
    private sealed record TypingToken(bool KeepTogether, IReadOnlyList<TypingGlyph> Glyphs);
}
