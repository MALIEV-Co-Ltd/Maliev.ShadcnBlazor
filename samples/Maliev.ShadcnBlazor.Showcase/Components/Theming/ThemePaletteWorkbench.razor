@namespace Maliev.ShadcnBlazor.Showcase.Components.Theming
@using Maliev.ShadcnBlazor.Components.Disclosure
@using System.Diagnostics
@implements IDisposable

<section id="theme-palette-workbench"
         class="theme-palette-workbench"
         aria-labelledby="theme-palette-workbench-title"
         data-testid="theme-palette-workbench">
    <header class="theme-palette-workbench__header">
        <div>
            <h2 id="theme-palette-workbench-title">@Copy.MainColor</h2>
            <p>@Copy.MainColorHelp</p>
        </div>
    </header>

    <div class="theme-palette-workbench__body">
        <ThemePaletteAnchorEditor State="State"
                                  Role="ShadcnPaletteAnchorRole.Brand"
                                  Copy="Copy"
                                  ShowLockControl="false"
                                  Announce="Announce" />

        <label class="theme-palette-workbench__harmony">
            <span>@Copy.Harmony</span>
            <ShadcnSelect TValue="ShadcnPaletteHarmony"
                          Value="State.PaletteHarmony"
                          ValueChanged="SetHarmonyAsync"
                          Open="_harmonyOpen"
                          OpenChanged="SetHarmonyOpenAsync"
                          Options="HarmonyOptions"
                          Size="ShadcnControlSize.Small"
                          aria-label="@Copy.Harmony"
                          data-testid="theme-palette-harmony" />
        </label>

        <ShadcnButton Variant="ShadcnButtonVariant.Default"
                      Size="ShadcnButtonSize.Small"
                      Disabled="_generating"
                      data-testid="theme-palette-generate"
                      OnClick="GenerateAsync">
            @(_generating ? Copy.DerivingPalette : Copy.GenerateFromMainColor)
        </ShadcnButton>

        <div class="theme-palette-workbench__derived">
            <strong>@Copy.DerivedColors</strong>
            <div class="theme-palette-workbench__strip" role="img" aria-label="@Copy.DerivedColors">
                @foreach (var role in Roles)
                {
                    <span style="@SwatchStyle(role)"></span>
                }
            </div>
        </div>

        <ShadcnCollapsible Open="_advancedOpen"
                            OpenChanged="SetAdvancedOpen"
                            Class="theme-palette-workbench__advanced"
                            data-testid="theme-palette-advanced">
            <ShadcnCollapsibleTrigger Class="theme-palette-workbench__advanced-trigger">
                <span>@Copy.AdvancedColors</span>
                <span aria-hidden="true">⌄</span>
            </ShadcnCollapsibleTrigger>
            <ShadcnCollapsibleContent>
                <div class="theme-palette-workbench__anchors">
                    @foreach (var role in DerivedRoles)
                    {
                        <ThemePaletteAnchorEditor @key="role"
                                                  State="State"
                                                  Role="role"
                                                  Copy="Copy"
                                                  Announce="Announce" />
                    }
                </div>
            </ShadcnCollapsibleContent>
        </ShadcnCollapsible>

        <section class="theme-palette-workbench__diagnostics" aria-labelledby="theme-palette-diagnostics-title">
            <h3 id="theme-palette-diagnostics-title">@Copy.ValidationSummary</h3>
            @if (State.PaletteContrastReady)
            {
                <p data-palette-contrast="ready">@Copy.ContrastReady</p>
            }
            else
            {
                <p data-palette-contrast="review">@Copy.NeedsReview</p>
                @if (BlockingDiagnostics.Count > 0)
                {
                    <ul>
                        @foreach (var diagnostic in BlockingDiagnostics)
                        {
                            <li>
                                <code>@diagnostic.Path</code>
                                <span>@Copy.DiagnosticMessage(diagnostic)</span>
                            </li>
                        }
                    </ul>
                }
            }
        </section>
    </div>

    <p class="theme-palette-workbench__status"
       role="status"
       aria-live="polite"
       aria-atomic="true"
       data-testid="theme-palette-status">@_announcement</p>
</section>

@code {
    [Parameter, EditorRequired] public ThemeStudioState State { get; set; } = null!;

    private static readonly IReadOnlyList<ShadcnPaletteAnchorRole> Roles = Enum.GetValues<ShadcnPaletteAnchorRole>();
    private static readonly IReadOnlyList<ShadcnPaletteAnchorRole> DerivedRoles = Roles
        .Where(role => role != ShadcnPaletteAnchorRole.Brand)
        .ToArray();
    private string _announcement = string.Empty;
    private bool _harmonyOpen;
    private bool _advancedOpen;
    private bool _generating;
    private long _nextGenerationAllowedAt;
    private ThemeStudioLocale _locale;
    private bool _disposed;
    private ThemeStudioPaletteCopy Copy => ThemeStudioPaletteCopy.For(State.Locale);
    private IReadOnlyList<ShadcnThemeValidationMessage> BlockingDiagnostics => State.PaletteReviewDiagnostics;
    private IReadOnlyList<ShadcnSelectOption<ShadcnPaletteHarmony>> HarmonyOptions =>
        Enum.GetValues<ShadcnPaletteHarmony>()
            .Select(value => new ShadcnSelectOption<ShadcnPaletteHarmony>(value, Copy.HarmonyName(value)))
            .ToArray();

    protected override void OnInitialized()
    {
        _locale = State.Locale;
        State.Changed += OnStateChanged;
    }

    private void OnStateChanged(object? sender, EventArgs args)
    {
        if (_disposed)
            return;
        if (_locale != State.Locale)
        {
            _locale = State.Locale;
            _announcement = string.Empty;
        }
        _ = InvokeAsync(StateHasChanged);
    }

    private string SwatchStyle(ShadcnPaletteAnchorRole role) => $"background-color: {State.PaletteAnchors.Get(role)}";
    private Task Announce(string message) { _announcement = message; return InvokeAsync(StateHasChanged); }

    private async Task SetHarmonyAsync(ShadcnPaletteHarmony harmony)
    {
        _announcement = State.SetPaletteHarmony(harmony)
            ? $"{Copy.Harmony}: {Copy.HarmonyName(harmony)}"
            : Copy.ErrorPrefix;
        _harmonyOpen = false;
        await InvokeAsync(StateHasChanged);
    }

    private Task SetHarmonyOpenAsync(bool open)
    {
        _harmonyOpen = open;
        return InvokeAsync(StateHasChanged);
    }

    private Task SetAdvancedOpen(bool open)
    {
        _advancedOpen = open;
        return Task.CompletedTask;
    }

    private Task GenerateAsync()
    {
        var now = Stopwatch.GetTimestamp();
        if (_generating || now < _nextGenerationAllowedAt)
            return Task.CompletedTask;

        _generating = true;
        try
        {
            _announcement = State.GeneratePaletteFromMainColor(out var seed)
                ? Copy.GeneratedStatusForSeed(seed)
                : Copy.ErrorPrefix;
        }
        finally
        {
            _generating = false;
            _nextGenerationAllowedAt = Stopwatch.GetTimestamp() + (Stopwatch.Frequency / 2);
        }
        return InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _disposed = true;
        State.Changed -= OnStateChanged;
    }
}
