@namespace Maliev.ShadcnBlazor.Showcase.Components.Theming

<aside class="theme-inspector" id="theme-controls" aria-labelledby="theme-inspector-title" data-testid="theme-inspector">
    <div class="theme-inspector__sticky-heading">
        <div>
            <span class="theme-inspector__eyebrow">Live configuration</span>
            <h2 id="theme-inspector-title">Theme controls</h2>
        </div>
        <span class="theme-dirty-indicator" data-dirty="@(State.IsDirty ? "true" : "false")">@(State.IsDirty ? "Edited" : "Preset")</span>
    </div>

    <div class="theme-inspector-actions">
        <MudSelect T="string"
                   Value="@State.SelectedPresetId"
                   ValueChanged="value => State.ApplyPreset(value ?? ShadcnThemePresets.BaseVegaNeutral.Id)"
                   Label="Theme preset"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   aria-label="Theme preset"
                   data-testid="theme-preset">
            @foreach (var preset in ShadcnThemePresets.All)
            {
                <MudSelectItem T="string" Value="@preset.Id">@preset.DisplayName</MudSelectItem>
            }
        </MudSelect>
        <div class="theme-history-actions">
            <MudButton Variant="Variant.Outlined" Disabled="@(!State.CanUndo)" aria-label="Undo theme change" data-testid="theme-undo" OnClick="() => State.Undo()">Undo</MudButton>
            <MudButton Variant="Variant.Outlined" Disabled="@(!State.CanRedo)" aria-label="Redo theme change" data-testid="theme-redo" OnClick="() => State.Redo()">Redo</MudButton>
            <MudButton Variant="Variant.Outlined" Disabled="@(!State.IsDirty)" aria-label="Reset entire theme" data-testid="theme-reset-all" OnClick="State.ResetAll">Reset all</MudButton>
        </div>
        <div class="theme-transfer-actions">
            <button type="button" data-testid="theme-import-open" aria-haspopup="dialog" @onclick="() => _importOpen = true">Import JSON</button>
            <button type="button" data-testid="theme-code-open" aria-haspopup="dialog" @onclick="() => _codeOpen = true">Get code</button>
            <button type="button" data-testid="theme-export-open" aria-haspopup="dialog" @onclick="() => _exportOpen = true">Export bundle</button>
        </div>
    </div>

    <ThemeValidationSummary State="State" />
    <ThemeGeneratorOptions State="State" />
    <ThemeColorGroup State="State" Scheme="ThemeStudioScheme.Light" Group="ThemeStudioGroup.Colors" />
    <ThemeColorGroup State="State" Scheme="ThemeStudioScheme.Dark" Group="ThemeStudioGroup.Colors" />
    <ThemeMetricsGroup State="State" Group="ThemeStudioGroup.Typography" />
    <ThemeMetricsGroup State="State" Group="ThemeStudioGroup.Geometry" />
    <ThemeColorGroup State="State" Scheme="ThemeStudioScheme.Light" Group="ThemeStudioGroup.Shadows" />
    <ThemeColorGroup State="State" Scheme="ThemeStudioScheme.Dark" Group="ThemeStudioGroup.Shadows" />
    <ThemeMetricsGroup State="State" Group="ThemeStudioGroup.Focus" />
    <ThemeMetricsGroup State="State" Group="ThemeStudioGroup.Motion" />
    <ThemeImportDialog State="State" @bind-Open="_importOpen" />
    <ThemeCodeDialog State="State" @bind-Open="_codeOpen" />
    <ThemeExportDialog State="State" @bind-Open="_exportOpen" />
</aside>

@code {
    [Parameter, EditorRequired] public ThemeStudioState State { get; set; } = null!;
    private bool _importOpen;
    private bool _codeOpen;
    private bool _exportOpen;
}
