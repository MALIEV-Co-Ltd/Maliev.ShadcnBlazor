@namespace Maliev.ShadcnBlazor.Showcase.Components.Theming
@using Maliev.ShadcnBlazor.Showcase.Export
@inject IJSRuntime JavaScript
@implements IAsyncDisposable

<dialog class="theme-transfer-dialog"
        id="theme-export-dialog"
        data-testid="theme-export-dialog"
        @onkeydown:stopPropagation="true"
        aria-labelledby="theme-export-title">
    <form method="dialog">
        <div class="theme-transfer-dialog__heading">
            <div>
                <span class="theme-inspector__eyebrow">Integration bundle</span>
                <h2 id="theme-export-title">Export the applied theme</h2>
            </div>
            <button type="button" class="theme-transfer-dialog__close" aria-label="Close theme export" @onclick="CloseAsync">×</button>
        </div>
        <p>Review the deterministic file inventory and validation result before downloading.</p>

        @if (_bundle is not null)
        {
            <p><strong>@_bundle.Validation.Errors.Count errors</strong> · @_bundle.Validation.Warnings.Count warnings · @_bundle.Validation.ContrastResults.Count(item => item.Passes)/@_bundle.Validation.ContrastResults.Count contrast checks pass</p>
            <ul class="theme-bundle-inventory" aria-label="Bundle files">
                @foreach (var file in _bundle.Files)
                {
                    <li data-bundle-path="@file.Path"><code>@file.Path</code><span>@file.Size bytes</span></li>
                }
            </ul>
            @if (_bundle.Validation.Warnings.Count > 0)
            {
                <label class="theme-transfer-dialog__acknowledgement">
                    <input type="checkbox"
                           data-testid="theme-export-warning-ack"
                           @bind="_warningsAcknowledged" />
                    I reviewed the contrast warnings recorded in README.md.
                </label>
            }
            <button type="button"
                    class="theme-transfer-dialog__primary"
                    data-testid="theme-download"
                    disabled="@(!CanDownload)"
                    @onclick="DownloadAsync">
                Download integration bundle
            </button>
        }
        else
        {
            <p>The current applied theme could not be prepared for export.</p>
        }

        <p data-testid="theme-export-status" aria-live="polite" role="status">@_status</p>
    </form>
</dialog>

@code {
    [Parameter, EditorRequired] public ThemeStudioState State { get; set; } = null!;
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    private ThemeBundle? _bundle;
    private IJSObjectReference? _module;
    private IJSObjectReference? _dialogModule;
    private DotNetObjectReference<ThemeExportDialog>? _selfReference;
    private bool _warningsAcknowledged;
    private string _status = string.Empty;
    private bool _disposed;
    private bool _shown;
    private bool CanDownload => _bundle is not null && _bundle.Validation.IsValid &&
                                (_bundle.Validation.Warnings.Count == 0 || _warningsAcknowledged);

    protected override void OnParametersSet()
    {
        if (!Open)
            return;

        try
        {
            // State.Applied is intentionally the only source. Editor-local invalid text cannot enter a bundle.
            _bundle = ThemeBundleBuilder.Build(
                State.CreateDocument(),
                new ThemeBundleOptions(State.SelectedPresetId, typeof(ShadcnThemeProvider).Assembly.GetName().Version?.ToString(3) ?? "1.0.0"));
            _warningsAcknowledged = _bundle.Validation.Warnings.Count == 0;
            _status = $"Bundle preview ready: {_bundle.Files.Count} files, {_bundle.ZipBytes.Length} bytes.";
        }
        catch (Exception exception) when (exception is ArgumentException or InvalidOperationException)
        {
            _bundle = null;
            _status = $"Bundle preparation failed: {exception.Message}";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || Open == _shown)
            return;
        try
        {
            _dialogModule ??= await JavaScript.InvokeAsync<IJSObjectReference>("import", "./js/theme-transfer-dialog.js");
            if (_selfReference is null)
            {
                _selfReference = DotNetObjectReference.Create(this);
                await _dialogModule.InvokeVoidAsync("connect", "theme-export-dialog", _selfReference);
            }
            await _dialogModule.InvokeVoidAsync(Open ? "showModal" : "close", "theme-export-dialog");
            _shown = Open;
        }
        catch (Exception exception) when (exception is JSException or JSDisconnectedException or TaskCanceledException or OperationCanceledException)
        {
            _status = $"Export dialog could not be {(Open ? "opened" : "closed")}: {exception.Message}";
        }
    }

    private async Task DownloadAsync()
    {
        if (!CanDownload || _bundle is null || _disposed)
            return;

        try
        {
            _module ??= await JavaScript.InvokeAsync<IJSObjectReference>("import", "./js/shadcn-download.js");
            await _module.InvokeVoidAsync("downloadBytes", _bundle.FileName, "application/zip", _bundle.ZipBytes);
            _status = $"Downloaded {_bundle.FileName}.";
        }
        catch (Exception exception) when (exception is JSException or JSDisconnectedException or TaskCanceledException or OperationCanceledException)
        {
            _status = exception is TaskCanceledException or OperationCanceledException
                ? "Bundle download was cancelled. You can try again."
                : $"Bundle download failed: {exception.Message}";
        }
    }

    private async Task CloseAsync()
    {
        if (_dialogModule is not null && _shown)
            await _dialogModule.InvokeVoidAsync("close", "theme-export-dialog");
        _shown = false;
        await OpenChanged.InvokeAsync(false);
    }

    [JSInvokable]
    public async Task OnNativeClosed()
    {
        if (_disposed || !_shown)
            return;
        _shown = false;
        await OpenChanged.InvokeAsync(false);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is null)
        {
            if (_dialogModule is null)
            {
                _selfReference?.Dispose();
                return;
            }
        }
        try
        {
            if (_module is not null)
                await _module.DisposeAsync();
            if (_dialogModule is not null)
            {
                await _dialogModule.InvokeVoidAsync("disconnect", "theme-export-dialog");
                await _dialogModule.DisposeAsync();
            }
        }
        catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException or OperationCanceledException)
        {
        }
        finally
        {
            _selfReference?.Dispose();
        }
    }
}
