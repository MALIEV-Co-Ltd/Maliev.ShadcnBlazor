@namespace Maliev.ShadcnBlazor.Showcase.Components.Theming
@inject IJSRuntime JavaScript
@implements IAsyncDisposable

<section @ref="_root"
         class="theme-palette-summary"
         data-testid="theme-palette-summary"
         aria-labelledby="theme-palette-summary-title">
    <div class="theme-palette-summary__copy">
        <strong id="theme-palette-summary-title">@Copy.ActivePalette</strong>
        <span data-palette-contrast="@(ContrastReady ? "ready" : "review")">
            @(ContrastReady ? Copy.ContrastReady : Copy.NeedsReview)
        </span>
    </div>
    <div class="theme-palette-summary__swatches" aria-hidden="true">
        @foreach (var role in Roles)
        {
            <span class="theme-palette-summary__swatch"
                  data-palette-summary-swatch="@RoleKey(role)"
                  style="@SwatchStyle(role)"></span>
        }
    </div>
    <ShadcnButton id="theme-palette-customize"
                  Variant="ShadcnButtonVariant.Outline"
                  Size="ShadcnButtonSize.Small"
                  aria-expanded="@(State.Workbench.PaletteWorkbenchOpen ? "true" : "false")"
                  aria-controls="theme-palette-workbench"
                  data-testid="theme-palette-customize"
                  OnClick="State.Workbench.OpenPaletteWorkbench">
        @Copy.CustomizePalette
    </ShadcnButton>
</section>

@code {
    [Parameter, EditorRequired] public ThemeStudioState State { get; set; } = null!;

    private ElementReference _root;
    private IJSObjectReference? _module;
    private IJSObjectReference? _binding;
    private bool _disposed;
    private long _bindingGeneration;
    private ThemeStudioPaletteCopy Copy => ThemeStudioPaletteCopy.For(State.Locale);
    private bool ContrastReady => State.Validation.IsValid && State.PaletteDiagnostics.Count == 0;
    private static readonly IReadOnlyList<ShadcnPaletteAnchorRole> Roles = Enum.GetValues<ShadcnPaletteAnchorRole>();
    private string SwatchStyle(ShadcnPaletteAnchorRole role) => $"background-color: {State.PaletteAnchors.Get(role)}";
    private static string RoleKey(ShadcnPaletteAnchorRole role) => role.ToString().ToLowerInvariant();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed)
            return;
        var generation = ++_bindingGeneration;
        IJSObjectReference? module = null;
        IJSObjectReference? binding = null;
        try
        {
            module = await JavaScript.InvokeAsync<IJSObjectReference>("import", "./js/theme-studio.js");
            if (_disposed || generation != _bindingGeneration)
                return;
            binding = await module.InvokeAsync<IJSObjectReference>("bindPaletteTrigger", _root);
            if (_disposed || generation != _bindingGeneration)
                return;
            _module = module;
            module = null;
            _binding = binding;
            binding = null;
        }
        catch (Exception exception) when ((exception is JSDisconnectedException or ObjectDisposedException) &&
                                          (_disposed || generation != _bindingGeneration)) { }
        finally
        {
            if (binding is not null)
                await DisposeBindingAsync(binding);
            if (module is not null)
                await DisposeReferenceAsync(module);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _bindingGeneration++;
        if (_binding is not null)
            await DisposeBindingAsync(_binding);
        if (_module is not null)
            await DisposeReferenceAsync(_module);
    }

    private static async ValueTask DisposeBindingAsync(IJSObjectReference binding)
    {
        try { await binding.InvokeVoidAsync("dispose"); }
        catch (Exception exception) when (exception is JSDisconnectedException or ObjectDisposedException) { }
        await DisposeReferenceAsync(binding);
    }

    private static async ValueTask DisposeReferenceAsync(IJSObjectReference reference)
    {
        try { await reference.DisposeAsync(); }
        catch (Exception exception) when (exception is JSDisconnectedException or ObjectDisposedException) { }
    }
}
