@namespace Maliev.ShadcnBlazor.Showcase.Components.Theming
@using Maliev.ShadcnBlazor.Components.Disclosure

<ShadcnCollapsible Open="State.Workbench.PaletteWorkbenchOpen"
                    OpenChanged="SetOpenAsync"
                    Class="theme-palette-summary"
                    data-testid="theme-palette-summary">
    <div class="theme-palette-summary__copy">
        <strong id="theme-palette-summary-title">@Copy.ActivePalette</strong>
        <small data-testid="theme-palette-identity">@Copy.PaletteIdentity(State.Document)</small>
        <span data-palette-contrast="@(State.PaletteContrastReady ? "ready" : "review")">
            @(State.PaletteContrastReady ? Copy.ContrastReady : Copy.NeedsReview)
        </span>
    </div>
    <div class="theme-palette-summary__swatches" role="img" aria-label="@Copy.ActivePalette">
        @foreach (var role in Roles)
        {
            <span class="theme-palette-summary__swatch"
                  data-palette-summary-swatch="@RoleKey(role)"
                  style="@SwatchStyle(role)"></span>
        }
    </div>
    <ShadcnCollapsibleTrigger id="theme-palette-customize"
                              Class="theme-palette-summary__trigger"
                              data-testid="theme-palette-customize">
        <span>@Copy.CustomizePalette</span>
        <span class="theme-palette-summary__trigger-symbol" aria-hidden="true">⌄</span>
    </ShadcnCollapsibleTrigger>
    <ShadcnCollapsibleContent>
        <ThemePaletteWorkbench State="State" />
    </ShadcnCollapsibleContent>
</ShadcnCollapsible>

@code {
    [Parameter, EditorRequired] public ThemeStudioState State { get; set; } = null!;

    private ThemeStudioPaletteCopy Copy => ThemeStudioPaletteCopy.For(State.Locale);
    private static readonly IReadOnlyList<ShadcnPaletteAnchorRole> Roles = Enum.GetValues<ShadcnPaletteAnchorRole>();
    private string SwatchStyle(ShadcnPaletteAnchorRole role) => $"background-color: {State.PaletteAnchors.Get(role)}";
    private static string RoleKey(ShadcnPaletteAnchorRole role) => role.ToString().ToLowerInvariant();

    private Task SetOpenAsync(bool open)
    {
        if (open)
            State.Workbench.OpenPaletteWorkbench();
        else
            State.Workbench.ClosePaletteWorkbench();
        return Task.CompletedTask;
    }
}
