@namespace Maliev.ShadcnBlazor.Showcase.Components.Theming
@using Maliev.ShadcnBlazor.Components.Icons
@using Maliev.ShadcnBlazor.Components.Navigation.Sidebar

<ShadcnSidebarProvider id="theme-studio-sidebar-region"
                       Open="State.Workbench.SidebarOpen"
                       OpenChanged="SetOpen"
                       MobileOpen="State.Workbench.SidebarOpen"
                       MobileOpenChanged="SetOpen"
                       Width="20rem"
                       IconWidth="3.5rem"
                       MobileWidth="min(22rem, 92vw)"
                       ToggleLabel="Toggle theme settings"
                       CloseLabel="Close theme settings"
                       Class="theme-studio-sidebar-provider"
                       @onpointerenter="PreviewSidebar"
                       @onpointerleave="EndSidebarPreview">
    <ShadcnSidebar Id="theme-settings-navigation" Label="Theme settings" Variant="ShadcnSidebarVariant.Sidebar" Collapsible="ShadcnSidebarCollapsible.OffCanvas" Class="theme-studio-sidebar" data-testid="theme-studio-sidebar" data-preview-expanded="@(_previewExpanded ? "true" : "false")" data-focus-return-id="theme-settings-toggle">
    <ShadcnSidebarHeader><div class="theme-studio-sidebar__heading">
        <strong>Theme settings</strong>
        <ShadcnSidebarTrigger TargetId="theme-settings-navigation" Class="theme-studio-sidebar__collapse" data-testid="theme-sidebar-collapse" />
    </div></ShadcnSidebarHeader>
    <nav class="theme-studio-sidebar__compact-menu" data-testid="theme-sidebar-compact-menu" aria-label="Theme setting sections">
        <ShadcnSidebarTrigger TargetId="theme-settings-navigation" Class="theme-studio-sidebar__compact-action" data-testid="theme-sidebar-rail-toggle" />
        @foreach (var item in CompactItems)
        {
            <a class="theme-studio-sidebar__compact-action" href="@item.Href" aria-label="@item.Label" title="@item.Label">
                <ShadcnIcon Icon="@item.Icon" Size="18" />
            </a>
        }
    </nav>
    <ShadcnSidebarContent><ThemeInspector State="State" /></ShadcnSidebarContent>
    <ShadcnSidebarRail TargetId="theme-settings-navigation" />
    </ShadcnSidebar>
</ShadcnSidebarProvider>

@code {
    [Parameter, EditorRequired] public ThemeStudioState State { get; set; } = null!;
    private bool _previewExpanded;
    private Task SetOpen(bool open) { _previewExpanded = false; State.Workbench.SetSidebarOpen(open); return Task.CompletedTask; }
    private void PreviewSidebar() { if (!State.Workbench.SidebarOpen) _previewExpanded = true; }
    private void EndSidebarPreview() => _previewExpanded = false;

    private static readonly ShadcnIconData PreviewIcon = new("lucide", "monitor", "0 0 24 24", "<rect width=\"20\" height=\"14\" x=\"2\" y=\"3\" rx=\"2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><path d=\"M8 21h8m-4-4v4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/>");
    private static readonly ShadcnIconData PaletteIcon = new("lucide", "palette", "0 0 24 24", "<path d=\"M12 22a10 10 0 1 1 10-10c0 2.2-1.8 4-4 4h-1.8a2 2 0 0 0-1.8 2.8A2.3 2.3 0 0 1 12 22Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><circle cx=\"7.5\" cy=\"10.5\" r=\"1\"/><circle cx=\"10.5\" cy=\"6.5\" r=\"1\"/><circle cx=\"15.5\" cy=\"7.5\" r=\"1\"/>");
    private static readonly ShadcnIconData TypeIcon = new("lucide", "type", "0 0 24 24", "<path d=\"M4 7V4h16v3M9 20h6M12 4v16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/>");
    private static readonly ShadcnIconData ShapesIcon = new("lucide", "shapes", "0 0 24 24", "<circle cx=\"6\" cy=\"6\" r=\"3\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><rect x=\"13\" y=\"3\" width=\"6\" height=\"6\" rx=\"1\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><path d=\"m6 14-3 6h6l-3-6Zm10-1 4 7h-8l4-7Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/>");
    private static readonly ShadcnIconData AccessibilityIcon = new("lucide", "accessibility", "0 0 24 24", "<circle cx=\"12\" cy=\"4\" r=\"2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><path d=\"M5 8h14m-7 0v5m0 0-4 7m4-7 4 7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/>");
    private static readonly ShadcnIconData TransferIcon = new("lucide", "file-code", "0 0 24 24", "<path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><path d=\"M14 2v6h6m-7 5 2 2-2 2m-4 0-2-2 2-2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/>");
    private static readonly IReadOnlyList<CompactItem> CompactItems =
    [
        new("Preview", "#theme-controls", PreviewIcon),
        new("Theme preset", "#theme-settings-preset", PaletteIcon),
        new("Typography", "#theme-settings-typography", TypeIcon),
        new("Icon library", "#theme-settings-icons", ShapesIcon),
        new("Accessibility", "#theme-settings-accessibility", AccessibilityIcon),
        new("Import and export", "#theme-settings-transfer", TransferIcon)
    ];
    private sealed record CompactItem(string Label, string Href, ShadcnIconData Icon);

}
