@namespace Maliev.ShadcnBlazor.Showcase.Components.Theming
@using Maliev.ShadcnBlazor.Showcase.Theming.Fonts
@implements IAsyncDisposable
@inject GoogleFontCatalogService Catalog
@inject IJSRuntime JavaScript

@code {
    [Parameter, EditorRequired] public ThemeStudioState State { get; set; } = null!;
    private IJSObjectReference? _module;
    private string? _appliedStylesheet;
    private string? _selectionFingerprint;
    private long _selectionGeneration;
    private bool _pending = true;
    private bool _disposed;

    protected override void OnParametersSet()
    {
        var fingerprint = string.Join('\n',
            State.Typography.Body.GoogleFontsId,
            State.Typography.ThaiFallback.GoogleFontsId,
            State.Typography.Code.GoogleFontsId);
        if (string.Equals(fingerprint, _selectionFingerprint, StringComparison.Ordinal))
            return;
        _selectionFingerprint = fingerprint;
        _selectionGeneration++;
        _pending = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_pending || _disposed)
            return;
        _pending = false;
        var generation = _selectionGeneration;
        var stylesheet = await Catalog.CreateStylesheetAsync(State.Typography);
        if (_disposed || generation != _selectionGeneration || string.Equals(stylesheet, _appliedStylesheet, StringComparison.Ordinal))
            return;
        _appliedStylesheet = stylesheet;
        _module ??= await JavaScript.InvokeAsync<IJSObjectReference>("import", "./js/theme-studio.js");
        if (stylesheet is null)
        {
            State.UseBundledFonts();
            await _module.InvokeVoidAsync("loadGoogleFonts", null, 5000);
            return;
        }

        var request = State.BeginFontLoad(stylesheet);
        var result = await _module.InvokeAsync<string>("loadGoogleFonts", stylesheet, 5000);
        if (_disposed || generation != _selectionGeneration)
            return;
        var status = result switch
        {
            "loaded" => ThemeStudioFontLoadState.Loaded,
            "timeout" => ThemeStudioFontLoadState.TimedOut,
            _ => ThemeStudioFontLoadState.Failed
        };
        State.CompleteFontLoad(request, status);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
}
