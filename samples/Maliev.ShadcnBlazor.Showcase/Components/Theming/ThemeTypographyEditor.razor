@namespace Maliev.ShadcnBlazor.Showcase.Components.Theming
@using System.Globalization
@using Maliev.ShadcnBlazor.Components.Disclosure
@using Maliev.ShadcnBlazor.Components.Icons
@using Maliev.ShadcnBlazor.Showcase.Theming.Fonts
@inject GoogleFontCatalogService CatalogService

<section class="theme-inspector-group theme-typography-editor"
         aria-labelledby="@(ShowHeading ? "theme-typography-title" : null)"
         aria-label="@(ShowHeading ? null : "Typography settings")"
         data-testid="theme-typography-editor">
    @if (ShowHeading)
    {
    <div class="theme-inspector-group__heading">
        <div>
            <h3 id="theme-typography-title">Typography</h3>
            <p>Choose body, Thai fallback, and code families. Semantic role overrides stay optional.</p>
        </div>
        <ShadcnButton Variant="ShadcnButtonVariant.Ghost" Size="ShadcnButtonSize.Small" aria-label="Reset typography" data-testid="theme-reset-metrics-typography" OnClick="() => State.ResetGroup(ThemeStudioGroup.Typography)">Reset</ShadcnButton>
    </div>
    }
    else
    {
        <div class="theme-typography-editor__intro">
            <p>Choose body, Thai fallback, and code families. Semantic role overrides stay optional.</p>
            <ShadcnButton Variant="ShadcnButtonVariant.Ghost" Size="ShadcnButtonSize.Small" aria-label="Reset typography" data-testid="theme-reset-metrics-typography" OnClick="() => State.ResetGroup(ThemeStudioGroup.Typography)">Reset</ShadcnButton>
        </div>
    }

    <div class="theme-font-current" aria-label="Selected font families">
        @foreach (var slot in Enum.GetValues<ThemeStudioFontSlot>())
        {
            <button type="button" class="theme-font-slot" data-active="@(_slot == slot ? "true" : "false")" aria-pressed="@(_slot == slot ? "true" : "false")" data-testid="theme-font-slot-@SlotId(slot)" @onclick="() => _slot = slot">
                <span>@SlotLabel(slot)</span><strong>@Selection(slot).Family.Split(',')[0].Trim(' ', '\'')</strong>
            </button>
        }
    </div>

    <label class="theme-font-search">
        <span>Search checked-in catalog</span>
        <ShadcnInput TValue="string" Value="@_query" ValueChanged="Search" Placeholder="Search 1,800+ families" aria-label="Search font catalog" data-testid="theme-font-search" />
    </label>
    <div class="theme-font-filters">
        <label><ShadcnCheckbox Value="@_thaiOnly" ValueChanged="value => _thaiOnly = value ?? false" aria-label="Only fonts with Thai support" /> Thai support</label>
        <label><ShadcnCheckbox Value="@_variableOnly" ValueChanged="value => _variableOnly = value ?? false" aria-label="Only variable fonts" /> Variable only</label>
    </div>

    <p class="theme-font-status" role="status" aria-live="polite" data-testid="theme-font-catalog-status">@CatalogStatus</p>
    @if (_catalog is not null)
    {
        <ul class="theme-font-results" aria-label="@ResultsLabel" data-testid="theme-font-results">
            @foreach (var entry in Results)
            {
                <li>
                    <button type="button" aria-pressed="@IsSelected(entry)" data-selected="@(IsSelected(entry) ? "true" : "false")" data-testid="theme-font-result-@entry.Id" @onclick="() => Select(entry)">
                        <span>@entry.Family</span><small>@entry.Category · @string.Join(", ", entry.Subsets.Take(3))</small>
                    </button>
                </li>
            }
        </ul>
    }
    <p class="theme-font-load-status" role="status" aria-live="polite" data-state="@State.FontLoadState.ToString().ToLowerInvariant()" data-testid="theme-font-load-status">@FontLoadStatus</p>

    <ShadcnCollapsible Open="false" Class="theme-typography-advanced" data-testid="theme-advanced-typography">
        <ShadcnCollapsibleTrigger Class="theme-inspector-disclosure__trigger"><span><strong>Advanced role overrides</strong><small>Weight, scale, line height, and tracking</small></span><ShadcnIcon Icon="@ChevronIcon" Size="16" /></ShadcnCollapsibleTrigger>
        <ShadcnCollapsibleContent><div class="theme-role-list" aria-label="Semantic typography roles">
            @foreach (var role in Enum.GetValues<ShadcnTypographyRole>())
            {
                var style = State.Typography.Roles[role];
                <fieldset class="theme-role-card" data-testid="theme-role-@RoleId(role)">
                    <legend>@RoleLabel(role)</legend>
                    <label><span>Weight</span><ShadcnSelect TValue="int" Value="style.Weight" ValueChanged="value => ChangeWeight(role, value)" Options="WeightOptions" Size="ShadcnControlSize.Small" aria-label="@($"{RoleLabel(role)} weight")" data-testid="@($"theme-role-{RoleId(role)}-weight")" /></label>
                    <label><span>Scale</span><input type="number" min="0.625" max="4" step="0.025" value="@Format(style.Scale)" aria-label="@($"{RoleLabel(role)} scale")" data-testid="theme-role-@RoleId(role)-scale" @onchange="args => ChangeRole(role, nameof(style.Scale), args)" /></label>
                    <label><span>Line</span><input type="number" min="1" max="2.5" step="0.05" value="@Format(style.LineHeight)" aria-label="@($"{RoleLabel(role)} line height")" data-testid="theme-role-@RoleId(role)-line-height" @onchange="args => ChangeRole(role, nameof(style.LineHeight), args)" /></label>
                    <label><span>Tracking</span><input type="number" min="-0.1" max="0.2" step="0.005" value="@Format(style.LetterSpacingEm)" aria-label="@($"{RoleLabel(role)} letter spacing")" data-testid="theme-role-@RoleId(role)-letter-spacing" @onchange="args => ChangeRole(role, nameof(style.LetterSpacingEm), args)" /></label>
                </fieldset>
            }
        </div></ShadcnCollapsibleContent>
    </ShadcnCollapsible>
    @if (_roleDiagnostic is not null)
    {
        <p class="theme-font-status" role="alert">@_roleDiagnostic</p>
    }
</section>

@code {
    [Parameter, EditorRequired] public ThemeStudioState State { get; set; } = null!;
    [Parameter] public bool ShowHeading { get; set; } = true;
    private GoogleFontCatalog? _catalog;
    private ThemeStudioFontSlot _slot;
    private string _query = string.Empty;
    private bool _thaiOnly;
    private bool _variableOnly;
    private string? _roleDiagnostic;
    private static readonly IReadOnlyList<ShadcnSelectOption<int>> WeightOptions = Enumerable.Range(1, 9).Select(value => value * 100).Select(value => new ShadcnSelectOption<int>(value, value.ToString(CultureInfo.InvariantCulture))).ToArray();
    private static readonly string[] RecommendedFontIds =
    [
        "geist",
        "inter",
        "dm-sans",
        "manrope",
        "plus-jakarta-sans",
        "ibm-plex-sans",
        "source-sans-3",
        "space-grotesk",
        "noto-sans-thai",
        "prompt"
    ];
    private static readonly ShadcnIconData ChevronIcon = new("lucide", "chevron-down", "0 0 24 24", "<path d=\"m6 9 6 6 6-6\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\"/>");
    protected override async Task OnInitializedAsync() => _catalog = await CatalogService.GetAsync();

    private IReadOnlyList<GoogleFontCatalogEntry> Results => _catalog is null
        ? []
        : IsBrowsingRecommendations
            ? RecommendedFontIds
                .Select(id => _catalog.Entries.FirstOrDefault(entry => string.Equals(entry.Id, id, StringComparison.Ordinal)))
                .Where(entry => entry is not null)
                .Cast<GoogleFontCatalogEntry>()
                .ToArray()
            : _catalog.Search(
                _query,
                _thaiOnly || _slot == ThemeStudioFontSlot.ThaiFallback ? "thai" : null,
                _variableOnly).Take(12).ToArray();
    private bool IsBrowsingRecommendations => string.IsNullOrWhiteSpace(_query) && !_thaiOnly && !_variableOnly;
    private string ResultsLabel => IsBrowsingRecommendations ? "Recommended font families" : "Font search results";

    private string CatalogStatus => _catalog switch
    {
        null => "Loading local font catalog…",
        { Source: GoogleFontCatalogSource.BundledFallback } => "Local catalog unavailable. Three bundled, offline-safe families remain available.",
        _ when IsBrowsingRecommendations => $"{Results.Count} recommended families shown. Search {_catalog.Entries.Count:N0} checked-in families for more.",
        _ => $"{Results.Count} of {_catalog.Entries.Count} local families shown."
    };

    private string FontLoadStatus => State.FontLoadState switch
    {
        ThemeStudioFontLoadState.Bundled => "Bundled fonts are ready offline.",
        ThemeStudioFontLoadState.Loading => "Loading the selected web font…",
        ThemeStudioFontLoadState.Loaded => "Selected web font loaded.",
        _ => State.FontLoadDiagnostic ?? "The fallback font remains active."
    };

    private void Search(string? value) => _query = value ?? string.Empty;
    private void Select(GoogleFontCatalogEntry entry) => State.SetTypographyFont(_slot, entry.ToSelection(_slot));
    private bool IsSelected(GoogleFontCatalogEntry entry) => string.Equals(Selection(_slot).GoogleFontsId, entry.Id, StringComparison.Ordinal) ||
        entry.IsBundled && Selection(_slot).Family.Contains(entry.Family, StringComparison.Ordinal);
    private ShadcnFontSelection Selection(ThemeStudioFontSlot slot) => slot switch
    {
        ThemeStudioFontSlot.Body => State.Typography.Body,
        ThemeStudioFontSlot.ThaiFallback => State.Typography.ThaiFallback,
        ThemeStudioFontSlot.Code => State.Typography.Code,
        _ => throw new ArgumentOutOfRangeException(nameof(slot), slot, null)
    };

    private void ChangeRole(ShadcnTypographyRole role, string property, ChangeEventArgs args)
    {
        var current = State.Typography.Roles[role];
        if (!double.TryParse(args.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var value))
        {
            _roleDiagnostic = $"{RoleLabel(role)} {property} must be numeric.";
            return;
        }
        var next = property switch
        {
            nameof(current.Weight) when value is >= 100 and <= 900 && value % 100 == 0 => current with { Weight = (int)value },
            nameof(current.Scale) when value is >= 0.625 and <= 4 => current with { Scale = value },
            nameof(current.LineHeight) when value is >= 1 and <= 2.5 => current with { LineHeight = value },
            nameof(current.LetterSpacingEm) when value is >= -0.1 and <= 0.2 => current with { LetterSpacingEm = value },
            _ => null
        };
        if (next is null)
        {
            _roleDiagnostic = $"{RoleLabel(role)} {property} is outside the supported range.";
            return;
        }
        _roleDiagnostic = null;
        State.SetTypographyRole(role, next);
    }

    private void ChangeWeight(ShadcnTypographyRole role, int weight)
    {
        var current = State.Typography.Roles[role];
        _roleDiagnostic = null;
        State.SetTypographyRole(role, current with { Weight = weight });
    }

    private static string Format(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);
    private static string SlotId(ThemeStudioFontSlot slot) => slot.ToString().ToLowerInvariant();
    private static string SlotLabel(ThemeStudioFontSlot slot) => slot switch { ThemeStudioFontSlot.ThaiFallback => "Thai fallback", _ => slot.ToString() };
    private static string RoleId(ShadcnTypographyRole role) => role switch
    {
        ShadcnTypographyRole.Heading1 => "heading-1",
        ShadcnTypographyRole.Heading2 => "heading-2",
        ShadcnTypographyRole.Heading3 => "heading-3",
        ShadcnTypographyRole.Heading4To6 => "heading-4-to-6",
        _ => role.ToString().ToLowerInvariant()
    };
    private static string RoleLabel(ShadcnTypographyRole role) => role switch { ShadcnTypographyRole.Heading4To6 => "Heading 4–6", _ => role.ToString().Replace("Heading", "Heading ", StringComparison.Ordinal) };
}
