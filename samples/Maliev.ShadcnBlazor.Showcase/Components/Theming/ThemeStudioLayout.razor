@namespace Maliev.ShadcnBlazor.Showcase.Components.Theming
@using Maliev.ShadcnBlazor.Showcase.Documentation
@inherits LayoutComponentBase
@implements IDisposable
@inject ThemeStudioState State
@inject ShowcaseState ShellState

<ShadcnThemeProvider IsDarkMode="ShellState.IsDarkMode" Direction="ShellState.Direction" Class="documentation-root theme-studio-provider">
    <div class="showcase-shell theme-studio-shell">
        <DocumentationHeader State="NavigationState" StudioMode="true" SettingsOpen="State.Workbench.SidebarOpen" ToggleSettings="State.Workbench.ToggleSidebar" />
        <main class="showcase-main theme-studio-main">@Body</main>
        <footer class="showcase-footer">Maliev.ShadcnBlazor Theme Studio · local and deterministic</footer>
    </div>
</ShadcnThemeProvider>

@code {
    public DocumentationNavigationState NavigationState { get; } = new();
    protected override void OnInitialized() { State.Changed += OnChanged; ShellState.Changed += OnChanged; }

    private void OnChanged(object? sender, EventArgs args) => _ = InvokeAsync(StateHasChanged);
    public void Dispose() { State.Changed -= OnChanged; ShellState.Changed -= OnChanged; }
}
