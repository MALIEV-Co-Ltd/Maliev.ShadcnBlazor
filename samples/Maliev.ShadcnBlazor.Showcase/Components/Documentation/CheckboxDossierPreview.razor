@using Maliev.ShadcnBlazor.Components.Selection

<label class="action-control-label" data-testid="checkbox-dossier-preview">
    <ShadcnCheckbox Value="CurrentValue" ValueChanged="HandleChanged" Disabled="Disabled" ReadOnly="ReadOnly" Invalid="Invalid" Name="terms" AdditionalAttributes="Attributes" />
    <span>Accept terms</span>
</label>

@code {
    [Parameter] public bool? Value { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Invalid { get; set; }
    private bool? CurrentValue;
    private bool? LastValue;
    protected override void OnParametersSet() { if (Value != LastValue) CurrentValue = Value; LastValue = Value; }
    private Task HandleChanged(bool? value) { CurrentValue = value; return Task.CompletedTask; }
    private IReadOnlyDictionary<string, object> Attributes => new Dictionary<string, object> { ["data-testid"] = "action-checkbox", ["aria-label"] = "Accept terms" };
}
