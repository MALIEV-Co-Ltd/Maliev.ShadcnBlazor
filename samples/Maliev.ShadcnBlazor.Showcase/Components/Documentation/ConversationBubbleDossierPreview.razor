@using Maliev.ShadcnBlazor.Components.Conversation

<ShadcnBubbleGroup Class="showcase-bubble-thread" data-reveal="true">
    <ShadcnBubble Variant="SentVariant" Align="ShadcnLogicalAlign.End" data-bubble-index="0" data-bubble-role="outgoing">
        <ShadcnBubbleContent>Hey there! what's up?</ShadcnBubbleContent>
    </ShadcnBubble>

    <ShadcnBubble Variant="ReceivedVariant" Align="IncomingAlign" data-bubble-index="1" data-bubble-role="incoming">
        <ShadcnBubbleContent>Hey! Want to see chat bubbles?</ShadcnBubbleContent>
        <ShadcnBubbleReactions Side="ReactionSide" Align="IncomingAlign" AccessibleName="Reactions for the message">
            <ShadcnBubbleReaction Fallback="👍"
                                  AccessibleName="Thumbs up reaction"
                                  Count="_thumbsUpCount"
                                  Pressed="_thumbsUpPressed"
                                  PressedChanged="SetThumbsUp">
                <ShowcaseReactionGlyph Kind="thumbs-up" />
            </ShadcnBubbleReaction>
        </ShadcnBubbleReactions>
    </ShadcnBubble>

    <ShadcnBubble Variant="ReceivedVariant" Align="IncomingAlign" data-bubble-index="2" data-bubble-role="incoming">
        <ShadcnBubbleContent>I can group messages, switch sides, and keep the whole thread easy to scan.</ShadcnBubbleContent>
    </ShadcnBubble>

    <ShadcnBubble Variant="SentVariant" Align="ShadcnLogicalAlign.End" data-bubble-index="3" data-bubble-role="outgoing">
        <ShadcnBubbleContent OnActivate="Noop">Sure. Hit me with your best demo.</ShadcnBubbleContent>
    </ShadcnBubble>

    <ShadcnBubble Variant="ReceivedVariant" Align="IncomingAlign" data-bubble-index="4" data-bubble-role="incoming">
        <ShadcnBubbleContent>Yes. You are reading a demo that is demoing itself. Very meta. Very on-brand.</ShadcnBubbleContent>
        <ShadcnBubbleReactions Side="ReactionSide" Align="IncomingAlign" AccessibleName="Reactions for the message">
            <ShadcnBubbleReaction Fallback="❤️"
                                  AccessibleName="Heart reaction"
                                  Count="_heartCount"
                                  Pressed="_heartPressed"
                                  PressedChanged="SetHeart"
                                  data-testid="bubble-reaction-heart">
                <ShowcaseReactionGlyph Kind="heart" />
            </ShadcnBubbleReaction>
            <ShadcnBubbleReaction Fallback="😂"
                                  AccessibleName="Laughing reaction"
                                  Count="_laughCount"
                                  Pressed="_laughPressed"
                                  PressedChanged="SetLaugh">
                <ShowcaseReactionGlyph Kind="laugh" />
            </ShadcnBubbleReaction>
            <ShadcnBubbleReactionOverflow Count="2">
                <ShadcnBubbleReaction Fallback="🔥"
                                      AccessibleName="Fire reaction"
                                      Count="_fireCount"
                                      Pressed="_firePressed"
                                      PressedChanged="SetFire"
                                      data-testid="bubble-reaction-fire">
                    <ShowcaseReactionGlyph Kind="fire" />
                </ShadcnBubbleReaction>
                <ShadcnBubbleReaction Fallback="👀"
                                      AccessibleName="Eyes reaction"
                                      Count="_eyesCount"
                                      Pressed="_eyesPressed"
                                      PressedChanged="SetEyes"
                                      data-testid="bubble-reaction-eyes">
                    <ShowcaseReactionGlyph Kind="eyes" />
                </ShadcnBubbleReaction>
            </ShadcnBubbleReactionOverflow>
        </ShadcnBubbleReactions>
    </ShadcnBubble>
</ShadcnBubbleGroup>

@code {
    [Parameter] public ShadcnBubbleVariant SentVariant { get; set; } = ShadcnBubbleVariant.Default;
    [Parameter] public ShadcnBubbleVariant ReceivedVariant { get; set; } = ShadcnBubbleVariant.Ghost;
    [Parameter] public bool AlignIncomingEnd { get; set; }
    [Parameter] public bool ReactionsTop { get; set; }

    private int _thumbsUpCount = 1;
    private int _heartCount = 2;
    private int _laughCount = 1;
    private int _fireCount = 1;
    private int _eyesCount = 1;
    private bool _thumbsUpPressed;
    private bool _heartPressed;
    private bool _laughPressed;
    private bool _firePressed;
    private bool _eyesPressed;

    private ShadcnLogicalAlign IncomingAlign => AlignIncomingEnd ? ShadcnLogicalAlign.End : ShadcnLogicalAlign.Start;
    private ShadcnReactionSide ReactionSide => ReactionsTop ? ShadcnReactionSide.Top : ShadcnReactionSide.Bottom;

    private void SetThumbsUp(bool pressed) => SetReaction(ref _thumbsUpPressed, ref _thumbsUpCount, pressed);
    private void SetHeart(bool pressed) => SetReaction(ref _heartPressed, ref _heartCount, pressed);
    private void SetLaugh(bool pressed) => SetReaction(ref _laughPressed, ref _laughCount, pressed);
    private void SetFire(bool pressed) => SetReaction(ref _firePressed, ref _fireCount, pressed);
    private void SetEyes(bool pressed) => SetReaction(ref _eyesPressed, ref _eyesCount, pressed);

    private static void SetReaction(ref bool current, ref int count, bool pressed)
    {
        if (current == pressed)
            return;

        current = pressed;
        count += pressed ? 1 : -1;
    }

    private static void Noop() { }
}
