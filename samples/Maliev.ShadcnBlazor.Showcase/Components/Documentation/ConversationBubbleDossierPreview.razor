@using Maliev.ShadcnBlazor.Components.Conversation

<ShadcnBubbleGroup Class="showcase-bubble-thread" data-reveal="true">
    <ShadcnBubble Variant="SentVariant" Align="ShadcnLogicalAlign.End" data-bubble-index="0" data-bubble-role="outgoing">
        <ShadcnBubbleContent>Hey there! what's up?</ShadcnBubbleContent>
    </ShadcnBubble>

    <ShadcnBubble Variant="ReceivedVariant" Align="IncomingAlign" data-bubble-index="1" data-bubble-role="incoming">
        <ShadcnBubbleContent>Hey! Want to see chat bubbles?</ShadcnBubbleContent>
        <ShadcnBubbleReactions Side="ReactionSide" Align="IncomingAlign" AccessibleName="Reactions for the message">
            @foreach (var reaction in _firstMessageReactions)
            {
                <ShadcnBubbleReaction @key="reaction.Key"
                                      Fallback="@ReactionFallback(reaction.Key)"
                                      AccessibleName="@ReactionAccessibleName(reaction.Key)"
                                      Count="@reaction.Value.Count"
                                      Pressed="@reaction.Value.Pressed"
                                      PressedChanged="pressed => SetReaction(_firstMessageReactions, reaction.Key, pressed)"
                                      data-reaction-key="@reaction.Key">
                    <ShowcaseReactionGlyph Kind="@reaction.Key" />
                </ShadcnBubbleReaction>
            }
            <ShowcaseBubbleReactionPicker ReactionSelected="value => AddReaction(_firstMessageReactions, value)"
                                          IsSelected="_firstMessageReactions.ContainsKey" />
        </ShadcnBubbleReactions>
    </ShadcnBubble>

    <ShadcnBubble Variant="ReceivedVariant" Align="IncomingAlign" data-bubble-index="2" data-bubble-role="incoming">
        <ShadcnBubbleContent>I can group messages, switch sides, and keep the whole thread easy to scan.</ShadcnBubbleContent>
        <ShadcnBubbleReactions Side="ReactionSide" Align="IncomingAlign" AccessibleName="Reactions for the message">
            @foreach (var reaction in _secondMessageReactions)
            {
                <ShadcnBubbleReaction @key="reaction.Key"
                                      Fallback="@ReactionFallback(reaction.Key)"
                                      AccessibleName="@ReactionAccessibleName(reaction.Key)"
                                      Count="@reaction.Value.Count"
                                      Pressed="@reaction.Value.Pressed"
                                      PressedChanged="pressed => SetReaction(_secondMessageReactions, reaction.Key, pressed)"
                                      data-reaction-key="@reaction.Key">
                    <ShowcaseReactionGlyph Kind="@reaction.Key" />
                </ShadcnBubbleReaction>
            }
            <ShowcaseBubbleReactionPicker ReactionSelected="value => AddReaction(_secondMessageReactions, value)"
                                          IsSelected="_secondMessageReactions.ContainsKey" />
        </ShadcnBubbleReactions>
    </ShadcnBubble>

    <ShadcnBubble Variant="SentVariant" Align="ShadcnLogicalAlign.End" data-bubble-index="3" data-bubble-role="outgoing">
        <ShadcnBubbleContent OnActivate="Noop">Sure. Hit me with your best demo.</ShadcnBubbleContent>
    </ShadcnBubble>

    <ShadcnBubble Variant="ReceivedVariant" Align="IncomingAlign" data-bubble-index="4" data-bubble-role="incoming">
        <ShadcnBubbleContent>Yes. You are reading a demo that is demoing itself. Very meta. Very on-brand.</ShadcnBubbleContent>
        <ShadcnBubbleReactions Side="ReactionSide" Align="IncomingAlign" AccessibleName="Reactions for the message">
            @foreach (var reaction in _lastMessageReactions.Take(2))
            {
                <ShadcnBubbleReaction @key="reaction.Key"
                                      Fallback="@ReactionFallback(reaction.Key)"
                                      AccessibleName="@ReactionAccessibleName(reaction.Key)"
                                      Count="@reaction.Value.Count"
                                      Pressed="@reaction.Value.Pressed"
                                      PressedChanged="pressed => SetReaction(_lastMessageReactions, reaction.Key, pressed)"
                                      data-reaction-key="@reaction.Key"
                                      data-testid="@ReactionTestId(reaction.Key)">
                    <ShowcaseReactionGlyph Kind="@reaction.Key" />
                </ShadcnBubbleReaction>
            }
            <ShadcnBubbleReactionOverflow Count="2">
                @foreach (var reaction in _lastMessageReactions.Skip(2).Take(2))
                {
                    <ShadcnBubbleReaction @key="reaction.Key"
                                          Fallback="@ReactionFallback(reaction.Key)"
                                          AccessibleName="@ReactionAccessibleName(reaction.Key)"
                                          Count="@reaction.Value.Count"
                                          Pressed="@reaction.Value.Pressed"
                                          PressedChanged="pressed => SetReaction(_lastMessageReactions, reaction.Key, pressed)"
                                          data-reaction-key="@reaction.Key"
                                          data-testid="@ReactionTestId(reaction.Key)">
                        <ShowcaseReactionGlyph Kind="@reaction.Key" />
                    </ShadcnBubbleReaction>
                }
            </ShadcnBubbleReactionOverflow>
            <ShowcaseBubbleReactionPicker ReactionSelected="value => AddReaction(_lastMessageReactions, value)"
                                          IsSelected="_lastMessageReactions.ContainsKey" />
        </ShadcnBubbleReactions>
    </ShadcnBubble>
</ShadcnBubbleGroup>

@code {
    [Parameter] public ShadcnBubbleVariant SentVariant { get; set; } = ShadcnBubbleVariant.Default;
    [Parameter] public ShadcnBubbleVariant ReceivedVariant { get; set; } = ShadcnBubbleVariant.Secondary;
    [Parameter] public bool AlignIncomingEnd { get; set; }
    [Parameter] public bool ReactionsTop { get; set; }

    private readonly Dictionary<string, ReactionState> _firstMessageReactions = new()
    {
        ["thumbs-up"] = new(1)
    };
    private readonly Dictionary<string, ReactionState> _secondMessageReactions = [];
    private readonly Dictionary<string, ReactionState> _lastMessageReactions = new()
    {
        ["heart"] = new(2),
        ["laugh"] = new(1),
        ["fire"] = new(1),
        ["eyes"] = new(1)
    };

    private ShadcnLogicalAlign IncomingAlign => AlignIncomingEnd ? ShadcnLogicalAlign.End : ShadcnLogicalAlign.Start;
    private ShadcnReactionSide ReactionSide => ReactionsTop ? ShadcnReactionSide.Top : ShadcnReactionSide.Bottom;

    private static void AddReaction(IDictionary<string, ReactionState> reactions, string key)
    {
        if (!reactions.TryGetValue(key, out var reaction))
        {
            reactions.Add(key, new(1, true));
            return;
        }

        if (reaction.Pressed)
            return;

        reaction.Pressed = true;
        reaction.Count++;
    }

    private static void SetReaction(IReadOnlyDictionary<string, ReactionState> reactions, string key, bool pressed)
    {
        var reaction = reactions[key];
        if (reaction.Pressed == pressed)
            return;

        reaction.Pressed = pressed;
        reaction.Count += pressed ? 1 : -1;
    }

    private static string ReactionAccessibleName(string key) => key switch
    {
        "thumbs-up" => "Thumbs up reaction",
        "heart" => "Heart reaction",
        "laugh" => "Laughing reaction",
        "fire" => "Fire reaction",
        "eyes" => "Eyes reaction",
        _ => throw new ArgumentOutOfRangeException(nameof(key), key, "Unknown reaction.")
    };

    private static string ReactionFallback(string key) => key switch
    {
        "thumbs-up" => "👍",
        "heart" => "❤️",
        "laugh" => "😂",
        "fire" => "🔥",
        "eyes" => "👀",
        _ => throw new ArgumentOutOfRangeException(nameof(key), key, "Unknown reaction.")
    };

    private static string? ReactionTestId(string key) => key switch
    {
        "heart" => "bubble-reaction-heart",
        "fire" => "bubble-reaction-fire",
        "eyes" => "bubble-reaction-eyes",
        _ => null
    };

    private sealed class ReactionState(int count, bool pressed = false)
    {
        public int Count { get; set; } = count;
        public bool Pressed { get; set; } = pressed;
    }

    private static void Noop() { }
}
