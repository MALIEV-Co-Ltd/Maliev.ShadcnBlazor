@inject IShadcnToastService Toasts

<div class="showcase-toast-demo" data-testid="toast-dossier-preview">
    <ShadcnButton OnClick="Show">บันทึกใบงาน — Save work order</ShadcnButton>
    <ShadcnToaster MaximumVisible="MaximumVisible" Placement="Placement" ReducedMotion="ReducedMotion" CloseLabel="ปิดการแจ้งเตือน" ViewportLabel="การแจ้งเตือน" />
</div>

@code {
    [Parameter] public int MaximumVisible { get; set; } = 3;
    [Parameter] public ShadcnToastPlacement Placement { get; set; } = ShadcnToastPlacement.BottomEnd;
    [Parameter] public bool ReducedMotion { get; set; }
    [Parameter] public ShadcnToastType Type { get; set; } = ShadcnToastType.Success;
    [Parameter] public ShadcnToastPriority Priority { get; set; } = ShadcnToastPriority.Normal;
    private void Show() => Toasts.Show(new(
        "บันทึกใบงานแล้ว — Work order saved",
        Description: "ใบงาน WO-2048 พร้อมส่งให้ฝ่ายผลิต",
        Type: Type,
        ActionLabel: "เลิกทำ",
        Action: UndoAsync,
        Priority: Priority));

    private Task UndoAsync()
    {
        Toasts.Show(new(
            "ยกเลิกการบันทึกแล้ว — Save undone",
            Description: "ใบงาน WO-2048 กลับสู่ฉบับร่าง",
            Type: ShadcnToastType.Info));
        return Task.CompletedTask;
    }
}
