@switch (Kind)
{
    case "thumbs-up":
        <svg class="showcase-reaction-glyph showcase-reaction-glyph--thumbs-up" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M8.5 10.5v9h-3v-9zM10 10.5l3.8-7.1a1.5 1.5 0 0 1 2.8 1l-.8 4.1h4.1a2 2 0 0 1 2 2.4l-1.3 6.3a3 3 0 0 1-2.9 2.4H8.5" />
        </svg>
        break;
    case "heart":
        <svg class="showcase-reaction-glyph showcase-reaction-glyph--heart" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M20.8 5.8a5.2 5.2 0 0 0-7.4 0L12 7.2l-1.4-1.4a5.2 5.2 0 1 0-7.4 7.4L12 22l8.8-8.8a5.2 5.2 0 0 0 0-7.4Z" />
        </svg>
        break;
    case "laugh":
        <svg class="showcase-reaction-glyph showcase-reaction-glyph--laugh" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="9" />
            <path d="M8.2 9.3 6.8 8.1M15.8 9.3l1.4-1.2M7.7 13.2c.8 3 2.2 4.3 4.3 4.3s3.5-1.3 4.3-4.3Z" />
        </svg>
        break;
    case "fire":
        <svg class="showcase-reaction-glyph showcase-reaction-glyph--fire" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M13.4 2.8c.5 3.2-1.4 4.1-2.4 5.7-.8 1.3-.7 2.8.2 3.7.1-1.8 1.3-2.6 2.3-3.4.9 1.5 3.4 2.7 3.4 6a5 5 0 1 1-9.8-1.4c.6-2.4 2.6-3.9 3.6-5.8.8-1.5 1.2-3.2.6-4.8 1.1.5 1.7 1.1 2.1 2.2Z" />
        </svg>
        break;
    case "eyes":
        <svg class="showcase-reaction-glyph showcase-reaction-glyph--eyes" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <ellipse cx="7.5" cy="12" rx="5" ry="7" />
            <ellipse cx="16.5" cy="12" rx="5" ry="7" />
            <circle cx="8.5" cy="12" r="2" />
            <circle cx="17.5" cy="12" r="2" />
        </svg>
        break;
    default:
        throw new ArgumentOutOfRangeException(nameof(Kind), Kind, "Unknown showcase reaction glyph.");
}

@code {
    [Parameter, EditorRequired] public string Kind { get; set; } = string.Empty;
}
