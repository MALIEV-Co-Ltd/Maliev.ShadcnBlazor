@using Maliev.ShadcnBlazor.Components.DataDisplay
@using Maliev.ShadcnBlazor.Showcase.Documentation.Api

<section class="component-api" aria-labelledby="component-api-title" data-testid="component-api">
    <h2 id="component-api-title">Public API</h2>
    @foreach (var descriptor in Descriptors)
    {
        <section class="component-api__type" aria-labelledby="@($"api-{descriptor.Name}")">
            <h3 id="@($"api-{descriptor.Name}")"><code>@descriptor.Name</code></h3>
            @if (descriptor.Parameters.Count == 0)
            {
                <p>No component parameters.</p>
            }
            else
            {
                <div class="component-api__scroller" tabindex="0" role="region" aria-label="@descriptor.Name parameters">
                    <ShadcnTable Class="component-api__table">
                        <ShadcnTableHeader>
                            <ShadcnTableRow>
                                <ShadcnTableHead>Parameter</ShadcnTableHead>
                                <ShadcnTableHead>Type</ShadcnTableHead>
                                <ShadcnTableHead>Default</ShadcnTableHead>
                                <ShadcnTableHead>Binding</ShadcnTableHead>
                                <ShadcnTableHead>Description and constraints</ShadcnTableHead>
                            </ShadcnTableRow>
                        </ShadcnTableHeader>
                        <ShadcnTableBody>
                            @foreach (var parameter in descriptor.Parameters)
                            {
                                <ShadcnTableRow AdditionalAttributes="@(new Dictionary<string, object>
                                {
                                    ["data-testid"] = "api-row",
                                    ["data-parameter"] = parameter.Name
                                })">
                                    <ShadcnTableHead Scope="ShadcnTableHeadScope.Row">
                                        <code>@parameter.Name</code>
                                        @if (parameter.Required)
                                        {
                                            <span class="component-api__required">required</span>
                                        }
                                    </ShadcnTableHead>
                                    <ShadcnTableCell><code>@parameter.FriendlyType</code></ShadcnTableCell>
                                    <ShadcnTableCell><code>@parameter.DefaultValue</code></ShadcnTableCell>
                                    <ShadcnTableCell>
                                        @if (parameter.BindingPair is null)
                                        {
                                            <span class="component-api__empty">—</span>
                                        }
                                        else
                                        {
                                            <code>@parameter.BindingPair</code>
                                        }
                                    </ShadcnTableCell>
                                    <ShadcnTableCell>
                                        <span class="component-api__description">@parameter.Description</span>
                                        @if (!string.IsNullOrWhiteSpace(parameter.Constraints))
                                        {
                                            <span class="component-api__constraint">@parameter.Constraints</span>
                                        }
                                    </ShadcnTableCell>
                                </ShadcnTableRow>
                            }
                        </ShadcnTableBody>
                    </ShadcnTable>
                </div>
            }
        </section>
    }
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ComponentApiDescriptor> Descriptors { get; set; } = [];
}
