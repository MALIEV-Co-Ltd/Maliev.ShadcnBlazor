@using Maliev.ShadcnBlazor.Showcase.Documentation.Examples

<section class="component-preview" aria-labelledby="@HeadingId" data-testid="component-preview">
    <div class="component-dossier__heading">
        <div>
            <h2 id="@HeadingId">@Example.Title</h2>
            <p>@Example.Description</p>
        </div>
        <ul class="component-state-tags" aria-label="Covered states">
            @foreach (var tag in Example.StateTags)
            {
                <li>@tag</li>
            }
        </ul>
    </div>

    @if (Example.Controls.Count > 0)
    {
        <form class="component-preview__controls" aria-label="Preview parameters" @onsubmit:preventDefault="true">
            @foreach (var control in Example.Controls)
            {
                <div class="component-preview__control">
                    @if (control.Kind == ComponentParameterControlKind.Toggle)
                    {
                        <label for="@control.Id">
                            <input id="@control.Id"
                                   data-testid="control-@control.Id"
                                   type="checkbox"
                                   disabled="@(!control.IsEnabled)"
                                   checked="@bool.Parse(control.Value)"
                                   @onchange="args => Update(control, args.Value?.ToString() ?? bool.FalseString)" />
                            @control.Label
                        </label>
                    }
                    else if (control.Kind == ComponentParameterControlKind.Number)
                    {
                        <label for="@control.Id">@control.Label</label>
                        <input id="@control.Id"
                               data-testid="control-@control.Id"
                               type="number"
                               disabled="@(!control.IsEnabled)"
                               value="@control.Value"
                               @onchange="args => Update(control, args.Value?.ToString() ?? string.Empty)" />
                    }
                    else
                    {
                        <label for="@control.Id">@control.Label</label>
                        <ShadcnSelect TValue="string"
                                      id="@control.Id"
                                      data-testid="@($"control-{control.Id}")"
                                      aria-label="@control.Label"
                                      Disabled="@(!control.IsEnabled)"
                                      Value="@control.Value"
                                      ValueChanged="value => Update(control, value)"
                                      Options="@SelectOptions(control)"
                                      Size="ShadcnControlSize.Small" />
                    }
                </div>
            }
        </form>
    }

    <div class="component-preview__canvas" data-testid="component-preview-canvas">
        @Example.Preview
    </div>

    <section class="component-preview__source" aria-labelledby="@SourceHeadingId">
        <h3 id="@SourceHeadingId">Example source</h3>
        <ComponentCodeExample Title="@Example.Title"
                              Source="@Example.RazorSource"
                              Collapsible="true"
                              Summary="View complete source"
                              TestId="example-source" />
    </section>
</section>

@code {
    [Parameter, EditorRequired] public ComponentExampleDefinition Example { get; set; } = null!;

    [Parameter] public EventCallback SourceChanged { get; set; }

    private string HeadingId => $"{Example.Id}-title";

    private string SourceHeadingId => $"{Example.Id}-source-title";

    private static IReadOnlyList<ShadcnSelectOption<string>> SelectOptions(ComponentParameterControl control) =>
        control.Options.Select(option => new ShadcnSelectOption<string>(option, option)).ToArray();

    private async Task Update(ComponentParameterControl control, string value)
    {
        control.Apply(value);
        StateHasChanged();

        if (SourceChanged.HasDelegate)
            await SourceChanged.InvokeAsync();
    }
}
