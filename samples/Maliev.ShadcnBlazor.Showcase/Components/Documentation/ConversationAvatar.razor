@using Maliev.ShadcnBlazor.Components.Content
@using Maliev.ShadcnBlazor.Components.Conversation

<ShadcnMessageAvatar>
    <ShadcnAvatar Size="ShadcnAvatarSize.Small">
        @if (!string.IsNullOrWhiteSpace(Source))
        {
            <ShadcnAvatarImage Class="showcase-message-avatar-image" Source="@Source" Alt="@Alt" data-avatar="@AvatarId" />
        }
        <ShadcnAvatarFallback Class="showcase-message-avatar-fallback" data-avatar="@(string.IsNullOrWhiteSpace(Source) ? AvatarId : null)">@Fallback</ShadcnAvatarFallback>
    </ShadcnAvatar>
</ShadcnMessageAvatar>

@code {
    [Parameter, EditorRequired] public string AvatarId { get; set; } = string.Empty;
    [Parameter] public string Source { get; set; } = string.Empty;
    [Parameter] public string Alt { get; set; } = string.Empty;
    [Parameter] public string Fallback { get; set; } = "?";
}
