@using Maliev.ShadcnBlazor.Components.Navigation

<li>
    <ShadcnNavigationMenuLink Href="@Href" Class="showcase-navigation-menu__status-link">
        @if (Icon == "alert")
        {
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 8v5m0 3h.01" /></svg>
        }
        else if (Icon == "progress")
        {
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke-dasharray="4 3" /></svg>
        }
        else
        {
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="m8 12 2.5 2.5L16 9" /></svg>
        }
        <span>@State</span>
    </ShadcnNavigationMenuLink>
</li>

@code {
    [Parameter, EditorRequired] public string Href { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string State { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Icon { get; set; } = string.Empty;
}
