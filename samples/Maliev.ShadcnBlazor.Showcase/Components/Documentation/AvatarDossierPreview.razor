<div class="showcase-avatar-demo" data-testid="avatar-dossier-preview">
    @if (Group)
    {
        <ShadcnAvatarGroup>
            <ShadcnAvatar Size="Size">
                <ShadcnAvatarImage Source="@(Failed ? "/missing-avatar.webp" : "/images/avatars/operator-thai.png")" Alt="Thai operator" />
                <ShadcnAvatarFallback>
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <circle cx="12" cy="8" r="3.25" fill="currentColor" opacity=".9" />
                        <path d="M5.5 20c.7-4 2.9-6 6.5-6s5.8 2 6.5 6" fill="currentColor" opacity=".65" />
                    </svg>
                </ShadcnAvatarFallback>
                @if (Badge) { <ShadcnAvatarBadge /> }
            </ShadcnAvatar>
            <ShadcnAvatar Size="Size">
                <ShadcnAvatarImage Source="/images/avatars/reviewer-thai.png" Alt="Thai quality reviewer" />
                <ShadcnAvatarFallback>
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <circle cx="12" cy="8" r="3.25" fill="currentColor" opacity=".9" />
                        <path d="M5.5 20c.7-4 2.9-6 6.5-6s5.8 2 6.5 6" fill="currentColor" opacity=".65" />
                    </svg>
                </ShadcnAvatarFallback>
            </ShadcnAvatar>
            <ShadcnAvatar Size="Size">
                <ShadcnAvatarImage Source="/images/avatars/coordinator-thai.png" Alt="Thai project coordinator" />
                <ShadcnAvatarFallback>
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <circle cx="12" cy="8" r="3.25" fill="currentColor" opacity=".9" />
                        <path d="M5.5 20c.7-4 2.9-6 6.5-6s5.8 2 6.5 6" fill="currentColor" opacity=".65" />
                    </svg>
                </ShadcnAvatarFallback>
            </ShadcnAvatar>
            <ShadcnAvatarGroupCount Size="Size">+2</ShadcnAvatarGroupCount>
        </ShadcnAvatarGroup>
    }
    else
    {
        @Avatar("/images/avatars/operator-thai.png", "Thai operator", Failed, Badge)
    }
</div>

@code {
    [Parameter] public ShadcnAvatarSize Size { get; set; }
    [Parameter] public bool Failed { get; set; }
    [Parameter] public bool Badge { get; set; }
    [Parameter] public bool Group { get; set; }

    private RenderFragment Avatar(string source, string alt, bool failed, bool badge) => @<ShadcnAvatar Size="Size">
        <ShadcnAvatarImage Source="@(failed ? "/missing-avatar.webp" : source)" Alt="@alt" />
        <ShadcnAvatarFallback>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <circle cx="12" cy="8" r="3.25" fill="currentColor" opacity=".9" />
                <path d="M5.5 20c.7-4 2.9-6 6.5-6s5.8 2 6.5 6" fill="currentColor" opacity=".65" />
            </svg>
        </ShadcnAvatarFallback>
        @if (badge) { <ShadcnAvatarBadge /> }
    </ShadcnAvatar>;
}
