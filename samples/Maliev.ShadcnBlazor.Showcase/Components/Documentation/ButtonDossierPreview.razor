@using Maliev.ShadcnBlazor.Components.Actions

<div class="showcase-button-dossier" data-testid="button-dossier-preview">
    <header class="showcase-button-dossier__intro">
        <div>
            <h3>Production order #4189</h3>
            <p>Use the same action vocabulary across a review workflow: save, remove, inspect, and reveal more.</p>
        </div>
        <span class="showcase-button-dossier__context">Revision C · 3 files ready</span>
    </header>
    <section class="showcase-button-dossier__section" aria-labelledby="button-variants-title">
        <h3 id="button-variants-title">Variants</h3>
        <div class="showcase-button-dossier__grid">
            @foreach (var variant in Enum.GetValues<ShadcnButtonVariant>())
            {
                <div class="showcase-button-dossier__sample">
                    <ShadcnButton Variant="variant" Disabled="Disabled" PointerCursor="true" Href="@(variant == ShadcnButtonVariant.Link ? "#usage" : null)" OnClick="@(args => Announce(ButtonLabel(variant)))" AdditionalAttributes="Attributes(variant.ToString())">@ButtonLabel(variant)</ShadcnButton>
                    <span>@VariantLabel(variant)</span>
                </div>
            }
        </div>
    </section>
    <section class="showcase-button-dossier__section" aria-labelledby="button-icon-sizes-title">
        <h3 id="button-icon-sizes-title">Icon sizes</h3>
        <div class="showcase-button-dossier__icon-sizes">
            @foreach (var size in new[] { ShadcnButtonSize.IconExtraSmall, ShadcnButtonSize.IconSmall, ShadcnButtonSize.Icon, ShadcnButtonSize.IconLarge })
            {
                <div class="showcase-button-dossier__sample">
                    <ShadcnButton Size="size" Variant="ShadcnButtonVariant.Outline" Disabled="Disabled" PointerCursor="true" LeadingIcon="SaveIcon" OnClick="@(args => Announce($"Save drawing ({SizeLabel(size)})"))" AdditionalAttributes="IconAttributes(size)" />
                    <span>@SizeLabel(size)</span>
                </div>
            }
        </div>
    </section>
    <section class="showcase-button-dossier__section" aria-labelledby="button-sizes-title">
        <h3 id="button-sizes-title">Sizes</h3>
        <div class="showcase-button-dossier__sizes">
            @foreach (var size in new[] { ShadcnButtonSize.ExtraSmall, ShadcnButtonSize.Small, ShadcnButtonSize.Default, ShadcnButtonSize.Large })
            {
                <div class="showcase-button-dossier__sample">
                    <ShadcnButton Size="size" Variant="ShadcnButtonVariant.Outline" Disabled="Disabled" PointerCursor="true" OnClick="@(args => Announce($"Save changes ({SizeLabel(size)})"))">Save changes</ShadcnButton>
                    <span>@SizeLabel(size)</span>
                </div>
            }
        </div>
    </section>
    <section class="showcase-button-dossier__section" aria-labelledby="button-focus-title">
        <h3 id="button-focus-title">Programmatic focus</h3>
        <p dir="auto">Capture the component with <code>@@ref</code>, then request focus without assigning or querying a DOM ID.</p>
        <div class="showcase-button-dossier__focus-actions">
            <ShadcnButton Variant="ShadcnButtonVariant.Outline" Disabled="Disabled" OnClick="@(_ => FocusPrimaryActionAsync())" data-testid="button-focus-request">Move focus to primary action</ShadcnButton>
            <ShadcnButton @ref="_primaryAction" Disabled="Disabled" data-testid="button-focus-target">Primary action</ShadcnButton>
        </div>
    </section>
    <p class="showcase-button-dossier__status" data-testid="button-last-action" role="status" aria-live="polite">
        <span>Last action</span>
        <strong>@(LastAction ?? "Choose an enabled action to try it")</strong>
    </p>
</div>

@code {
    [Parameter] public bool Disabled { get; set; }

    private ShadcnButton? _primaryAction;
    private string? LastAction { get; set; }

    private async Task FocusPrimaryActionAsync()
    {
        if (_primaryAction is not null)
            await _primaryAction.FocusAsync(preventScroll: true);
    }

    private static RenderFragment SaveIcon => builder => builder.AddMarkupContent(0, """
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"></path>
            <path d="M17 21v-8H7v8"></path>
            <path d="M7 3v5h8"></path>
        </svg>
        """);

    private void Announce(string action) => LastAction = $"{action} pressed";

    private static string ButtonLabel(ShadcnButtonVariant variant) => variant switch
    {
        ShadcnButtonVariant.Destructive => "Delete",
        ShadcnButtonVariant.Link => "View details",
        ShadcnButtonVariant.Ghost => "More actions",
        _ => "Save changes"
    };

    private static string VariantLabel(ShadcnButtonVariant variant) => variant switch
    {
        ShadcnButtonVariant.Default => "Default",
        ShadcnButtonVariant.Destructive => "Destructive",
        ShadcnButtonVariant.Outline => "Outline",
        ShadcnButtonVariant.Secondary => "Secondary",
        ShadcnButtonVariant.Ghost => "Ghost",
        ShadcnButtonVariant.Link => "Link",
        _ => variant.ToString()
    };

    private static string SizeLabel(ShadcnButtonSize size) => size switch
    {
        ShadcnButtonSize.ExtraSmall => "Extra small",
        ShadcnButtonSize.Small => "Small",
        ShadcnButtonSize.Default => "Default",
        ShadcnButtonSize.Large => "Large",
        ShadcnButtonSize.IconExtraSmall => "Icon extra small",
        ShadcnButtonSize.IconSmall => "Icon small",
        ShadcnButtonSize.Icon => "Icon default",
        ShadcnButtonSize.IconLarge => "Icon large",
        _ => size.ToString()
    };

    private static IReadOnlyDictionary<string, object> Attributes(string variant) => new Dictionary<string, object>
    {
        ["data-testid"] = $"button-variant-{variant.ToLowerInvariant()}",
        ["aria-label"] = ButtonLabel(Enum.Parse<ShadcnButtonVariant>(variant))
    };

    private static IReadOnlyDictionary<string, object> IconAttributes(ShadcnButtonSize size) => new Dictionary<string, object>
    {
        ["data-testid"] = $"button-icon-{size.ToString().ToLowerInvariant()}",
        ["aria-label"] = $"Save drawing ({SizeLabel(size)})"
    };
}
