@using Maliev.ShadcnBlazor.Components.Typography

<section class="component-code" aria-labelledby="@HeadingId">
    <div class="component-code__header">
        @if (Nested)
        {
            <h3 id="@HeadingId">@Heading</h3>
        }
        else
        {
            <h2 id="@HeadingId">@Heading</h2>
        }
    </div>
    <ShadcnCodeBlock Class="component-code__surface"
                     Source="@Source"
                     Language="@Language"
                     Sources="@Sources" />
</section>

@code {
    [Parameter] public string Title { get; set; } = "Component";

    [Parameter] public string Heading { get; set; } = "Code";

    [Parameter] public bool Nested { get; set; }

    [Parameter, EditorRequired] public string Source { get; set; } = string.Empty;

    [Parameter] public string Language { get; set; } = "razor";

    [Parameter] public IReadOnlyDictionary<string, string>? Sources { get; set; }

    private string HeadingId => $"{Sanitize(Title)}-code-title";

    private static string Sanitize(string value) => string.Concat(value.ToLowerInvariant().Select(character =>
        char.IsLetterOrDigit(character) ? character : '-')).Trim('-');
}
