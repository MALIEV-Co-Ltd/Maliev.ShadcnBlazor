@using Maliev.ShadcnBlazor.Components.Navigation

<section class="showcase-pagination-demo" aria-labelledby="pagination-preview-title">
    <div class="showcase-pagination-demo__header">
        <div>
            <h3 id="pagination-preview-title">Production quotations</h3>
            <p aria-live="polite">Page @_page of @TotalPages · @TotalItems quotations</p>
        </div>
        <span class="showcase-pagination-demo__range">@RangeStart–@RangeEnd of @TotalItems</span>
    </div>

    <div class="showcase-pagination-demo__list">
        @foreach (var quotation in Quotations)
        {
            <article>
                <div>
                    <strong>@quotation.Id</strong>
                    <span>@quotation.Name</span>
                </div>
                <span>@quotation.Status</span>
            </article>
        }
    </div>

    <ShadcnPagination Label="Production quotation pages">
        <ShadcnPaginationPages TotalPages="TotalPages"
                               CurrentPage="_page"
                               CurrentPageChanged="HandlePageChangedAsync"
                               VisiblePageCount="VisiblePageCount"
                               Disabled="Disabled" />
    </ShadcnPagination>
</section>

@code {
    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public EventCallback<int> CurrentPageChanged { get; set; }
    [Parameter] public int TotalPages { get; set; } = 1;
    [Parameter] public int TotalItems { get; set; } = 1;
    [Parameter] public int PageSize { get; set; } = 8;
    [Parameter] public int VisiblePageCount { get; set; } = 5;
    [Parameter] public bool Disabled { get; set; }

    private int _page = 1;
    private int _lastReceivedPage = 1;
    private bool _initialized;

    private int RangeStart => Math.Min(((_page - 1) * PageSize) + 1, TotalItems);
    private int RangeEnd => Math.Min(_page * PageSize, TotalItems);

    private IReadOnlyList<Quotation> Quotations =>
    [
        new($"Q-{2400 + (_page * 3) - 2}", "CNC enclosure", "Drawing review"),
        new($"Q-{2400 + (_page * 3) - 1}", "Fixture plate", "Ready to quote"),
        new($"Q-{2400 + (_page * 3)}", "Inspection jig", "Material check")
    ];

    protected override void OnParametersSet()
    {
        if (!_initialized || CurrentPage != _lastReceivedPage)
        {
            _page = Math.Clamp(CurrentPage, 1, TotalPages);
            _lastReceivedPage = _page;
            _initialized = true;
        }
    }

    private async Task HandlePageChangedAsync(int page)
    {
        _page = page;
        _lastReceivedPage = page;
        await CurrentPageChanged.InvokeAsync(page);
    }

    private sealed record Quotation(string Id, string Name, string Status);
}
