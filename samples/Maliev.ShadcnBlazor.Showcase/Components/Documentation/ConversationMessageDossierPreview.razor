@using Maliev.ShadcnBlazor.Components.Conversation

<div class="showcase-message-dossier" data-testid="showcase-message-dossier">
    <ShadcnMessageGroup class="showcase-message-thread">
        <ShadcnMessage Align="ShadcnLogicalAlign.Start" data-sender="engineer" aria-label="วิศวกร MALIEV · ข้อความ 1">
            @if (Avatars)
            {
                <ConversationAvatar AvatarId="operator" Source="images/avatars/operator-thai.png" Alt="นที · วิศวกร" Fallback="นท" />
            }
            <ShadcnMessageContent>
                <ShadcnMessageBody>
                    <ShadcnMessageHeader>วิศวกร MALIEV</ShadcnMessageHeader>
                    <ShadcnBubble Variant="ShadcnBubbleVariant.Muted" Align="ShadcnLogicalAlign.Start" data-testid="engineer-message-1">
                        <ShadcnBubbleContent dir="auto">ตรวจสอบไฟล์แล้ว 3 รายการ</ShadcnBubbleContent>
                    </ShadcnBubble>
                </ShadcnMessageBody>
                @if (FooterActions)
                {
                    <ShadcnMessageFooter data-visibility="@(AlwaysShowActions ? "always" : null)">
                        <ShadcnMessageActions>
                            <ShadcnMessageCopyAction Text="ตรวจสอบไฟล์แล้ว 3 รายการ" data-testid="message-copy" />
                            <ShadcnMessageReplyAction Quote="ตรวจสอบไฟล์แล้ว 3 รายการ" OnReply="ReplyTo" data-testid="message-reply" />
                        </ShadcnMessageActions>
                    </ShadcnMessageFooter>
                }
            </ShadcnMessageContent>
        </ShadcnMessage>

        <ShadcnMessage Align="ShadcnLogicalAlign.Start"
                       Class="showcase-message-continuation"
                       data-sender="engineer"
                       data-continuation="true"
                       aria-label="วิศวกร MALIEV · ข้อความ 2">
            <ShadcnMessageContent>
                <ShadcnMessageBody>
                    <ShadcnBubble Variant="ShadcnBubbleVariant.Muted" Align="ShadcnLogicalAlign.Start" data-testid="engineer-message-2">
                        <ShadcnBubbleContent dir="auto">กำลังตรวจสอบค่าความคลาดเคลื่อนต่อ</ShadcnBubbleContent>
                    </ShadcnBubble>
                </ShadcnMessageBody>
                @if (FooterActions)
                {
                    <ShadcnMessageFooter data-visibility="@(AlwaysShowActions ? "always" : null)">
                        <ShadcnMessageActions>
                            <ShadcnMessageCopyAction Text="กำลังตรวจสอบค่าความคลาดเคลื่อนต่อ" data-testid="message-copy" />
                            <ShadcnMessageReplyAction Quote="กำลังตรวจสอบค่าความคลาดเคลื่อนต่อ" OnReply="ReplyTo" data-testid="message-reply" />
                        </ShadcnMessageActions>
                    </ShadcnMessageFooter>
                }
            </ShadcnMessageContent>
        </ShadcnMessage>

        <ShadcnMessage Align="ShadcnLogicalAlign.Start">
            @if (Avatars)
            {
                <ConversationAvatar AvatarId="placeholder" Alt="มาลี · ผู้ประสานงาน" Fallback="ม" />
            }
            <ShadcnMessageContent>
                <ShadcnMessageBody>
                    <ShadcnMessageHeader>ผู้ประสานงาน</ShadcnMessageHeader>
                    <ShadcnBubble Variant="ShadcnBubbleVariant.Muted" Align="ShadcnLogicalAlign.Start">
                        <ShadcnBubbleContent dir="auto">พร้อมส่งแบบให้ตรวจ</ShadcnBubbleContent>
                    </ShadcnBubble>
                </ShadcnMessageBody>
                @if (FooterActions)
                {
                    <ShadcnMessageFooter data-visibility="@(AlwaysShowActions ? "always" : null)">
                        <ShadcnMessageActions>
                            <ShadcnMessageCopyAction Text="พร้อมส่งแบบให้ตรวจ" data-testid="message-copy" />
                            <ShadcnMessageReplyAction Quote="พร้อมส่งแบบให้ตรวจ" OnReply="ReplyTo" data-testid="message-reply" />
                        </ShadcnMessageActions>
                    </ShadcnMessageFooter>
                }
            </ShadcnMessageContent>
        </ShadcnMessage>

        <ShadcnMessage Align="ShadcnLogicalAlign.End">
            @if (Avatars)
            {
                <ConversationAvatar AvatarId="assistant" Source="images/avatars/assistant-thai.png" Alt="MALIEV Assistant" Fallback="MA" />
            }
            <ShadcnMessageContent>
                <ShadcnMessageBody>
                    <ShadcnMessageHeader>MALIEV Assistant</ShadcnMessageHeader>
                    <ShadcnBubble Variant="ShadcnBubbleVariant.Default" Align="ShadcnLogicalAlign.End">
                        <ShadcnBubbleContent dir="auto">Sure. I’ll keep the thread easy to scan.</ShadcnBubbleContent>
                    </ShadcnBubble>
                </ShadcnMessageBody>
                @if (FooterActions)
                {
                    <ShadcnMessageFooter data-visibility="@(AlwaysShowActions ? "always" : null)">
                        <ShadcnMessageActions>
                            <ShadcnMessageCopyAction Text="Sure. I’ll keep the thread easy to scan." data-testid="message-copy" />
                            <ShadcnMessageReplyAction Quote="Sure. I’ll keep the thread easy to scan." OnReply="ReplyTo" data-testid="message-reply" />
                        </ShadcnMessageActions>
                        <ShadcnMessageStatus>ส่งแล้ว · 10:42</ShadcnMessageStatus>
                    </ShadcnMessageFooter>
                }
            </ShadcnMessageContent>
        </ShadcnMessage>

        @if (!string.IsNullOrWhiteSpace(_replyText))
        {
            <ShadcnMessageReplyQuote Quote="@_replyText" OnDismiss="ClearReply" data-testid="message-reply-quote" />
        }
    </ShadcnMessageGroup>
</div>

@code {
    [Parameter] public bool Avatars { get; set; } = true;
    [Parameter] public bool FooterActions { get; set; } = true;
    [Parameter] public bool AlwaysShowActions { get; set; }

    private string? _replyText;

    private void ReplyTo(string text) => _replyText = text;
    private void ClearReply() => _replyText = null;
}
