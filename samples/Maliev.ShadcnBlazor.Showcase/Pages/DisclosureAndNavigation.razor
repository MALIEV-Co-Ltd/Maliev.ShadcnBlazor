@page "/components/disclosure-and-navigation"
@using global::Maliev.ShadcnBlazor.Components.Disclosure
@using global::Maliev.ShadcnBlazor.Components.Navigation
@using global::Maliev.ShadcnBlazor.Components.Navigation.Sidebar

<PageTitle>Disclosure and navigation - Shadcn Blazor</PageTitle>
<div class="documentation-page" data-testid="disclosure-navigation-fixture">
<header><p class="documentation-eyebrow">Plan 6 component family</p><h1>Disclosure and navigation</h1><p>Nine native Blazor disclosure, navigation, scrolling, resizing, and application-shell components audited against Shadcn Base/Vega.</p></header>
<section><h2>Installation</h2><pre><code>dotnet add package Maliev.ShadcnBlazor
@@using Maliev.ShadcnBlazor.Components.Disclosure
@@using Maliev.ShadcnBlazor.Components.Navigation
@@using Maliev.ShadcnBlazor.Components.Navigation.Sidebar</code></pre><p>Load <code>shadcn-disclosure-navigation.css</code>. Package JavaScript is imported on demand.</p></section>

<section data-component="accordion"><h2>Accordion</h2><label><input type="checkbox" @bind="AccordionMultiple" /> Multiple</label><ShadcnAccordion Values="AccordionValues" ValuesChanged="SetAccordion" Multiple="AccordionMultiple" Label="Manufacturing questions"><ShadcnAccordionItem Value="shipping"><ShadcnAccordionTrigger>Shipping</ShadcnAccordionTrigger><ShadcnAccordionContent>Ships from Thailand.</ShadcnAccordionContent></ShadcnAccordionItem><ShadcnAccordionItem Value="quality"><ShadcnAccordionTrigger>Quality ภาษาไทย</ShadcnAccordionTrigger><ShadcnAccordionContent>Inspection included.</ShadcnAccordionContent></ShadcnAccordionItem></ShadcnAccordion></section>
<section data-component="collapsible"><h2>Collapsible</h2><label><input type="checkbox" @bind="CollapsibleOpen" /> Open</label><ShadcnCollapsible @bind-Open="CollapsibleOpen"><ShadcnCollapsibleTrigger>Project files</ShadcnCollapsibleTrigger><ShadcnCollapsibleContent>Drawing.step</ShadcnCollapsibleContent></ShadcnCollapsible></section>
<section data-component="breadcrumb"><h2>Breadcrumb</h2><ShadcnBreadcrumb Label="Project breadcrumb"><ShadcnBreadcrumbList><ShadcnBreadcrumbItem><ShadcnBreadcrumbLink Href=".">Home</ShadcnBreadcrumbLink></ShadcnBreadcrumbItem><ShadcnBreadcrumbSeparator /><ShadcnBreadcrumbItem><ShadcnBreadcrumbEllipsis Label="More locations" /></ShadcnBreadcrumbItem><ShadcnBreadcrumbSeparator /><ShadcnBreadcrumbItem><ShadcnBreadcrumbPage>Quotation</ShadcnBreadcrumbPage></ShadcnBreadcrumbItem></ShadcnBreadcrumbList></ShadcnBreadcrumb></section>
<section data-component="pagination"><h2>Pagination</h2><label>Current page <input type="number" min="1" max="12" @bind="CurrentPage" /></label><ShadcnPagination Label="Quotation pages"><ShadcnPaginationPages TotalPages="12" @bind-CurrentPage="CurrentPage" VisiblePageCount="5" /></ShadcnPagination></section>
<section data-component="tabs"><h2>Tabs</h2><label>Selected <select @bind="TabValue"><option value="overview">Overview</option><option value="history">History</option></select></label><ShadcnTabs @bind-Value="TabValue"><ShadcnTabsList Label="Project views"><ShadcnTabsTrigger Value="overview">Overview</ShadcnTabsTrigger><ShadcnTabsTrigger Value="history">History</ShadcnTabsTrigger></ShadcnTabsList><ShadcnTabsContent Value="overview">Current project state.</ShadcnTabsContent><ShadcnTabsContent Value="history">Project history.</ShadcnTabsContent></ShadcnTabs></section>
<section data-component="navigation-menu"><h2>Navigation Menu</h2><label>Open value <select @bind="MenuValue"><option value="">Closed</option><option value="services">Services</option></select></label><ShadcnNavigationMenu @bind-Value="MenuValue" Label="Services"><ShadcnNavigationMenuList><ShadcnNavigationMenuItem Value="services"><ShadcnNavigationMenuTrigger>Services</ShadcnNavigationMenuTrigger><ShadcnNavigationMenuContent><ShadcnNavigationMenuLink Href="#cnc" Current="true">CNC machining</ShadcnNavigationMenuLink></ShadcnNavigationMenuContent></ShadcnNavigationMenuItem></ShadcnNavigationMenuList><ShadcnNavigationMenuIndicator /><ShadcnNavigationMenuViewport /></ShadcnNavigationMenu></section>
<section data-component="resizable"><h2>Resizable</h2><p>Sizes: @string.Join(" / ", PanelSizes.Select(value => $"{value:0}%"))</p><div style="height: 10rem"><ShadcnResizableGroup @bind-Sizes="PanelSizes"><ShadcnResizablePanel Id="queue" MinimumSize="20" MaximumSize="80">Queue</ShadcnResizablePanel><ShadcnResizableHandle WithHandle="true" Label="Resize queue" /><ShadcnResizablePanel Id="detail" MinimumSize="20" MaximumSize="80">Detail</ShadcnResizablePanel></ShadcnResizableGroup></div></section>
<section data-component="scroll-area"><h2>Scroll Area</h2><ShadcnScrollArea Type="ShadcnScrollAreaType.Always" Style="height: 8rem"><ShadcnScrollAreaViewport Label="Material catalog"><p>Aluminum 6061 · CNC milling</p><p>Stainless 316L · Corrosion-resistant assemblies</p><p>Titanium Grade 5 · Lightweight structural parts</p><p>Brass C360 · Precision turned fittings</p><p>PEEK · High-temperature polymer components</p><p>ABS · Durable production prototypes</p><p>รายการวัสดุที่พร้อมผลิตในประเทศไทย</p></ShadcnScrollAreaViewport><ShadcnScrollAreaScrollbar><ShadcnScrollAreaThumb /></ShadcnScrollAreaScrollbar><ShadcnScrollAreaCorner /></ShadcnScrollArea></section>
<section data-component="sidebar"><h2>Sidebar</h2><label><input type="checkbox" @bind="SidebarOpen" /> Expanded</label><div style="min-height: 15rem"><ShadcnSidebarProvider @bind-Open="SidebarOpen" @bind-MobileOpen="SidebarMobileOpen" ToggleLabel="Toggle workspace" CloseLabel="Close workspace"><ShadcnSidebar Label="Workspace" Variant="ShadcnSidebarVariant.Floating" Collapsible="ShadcnSidebarCollapsible.Icon"><ShadcnSidebarHeader>MALIEV</ShadcnSidebarHeader><ShadcnSidebarContent><ShadcnSidebarGroup><ShadcnSidebarGroupLabel>Operations</ShadcnSidebarGroupLabel><ShadcnSidebarGroupContent><ShadcnSidebarMenu><ShadcnSidebarMenuItem><ShadcnSidebarMenuButton Active="true">Quotations</ShadcnSidebarMenuButton></ShadcnSidebarMenuItem></ShadcnSidebarMenu></ShadcnSidebarGroupContent></ShadcnSidebarGroup></ShadcnSidebarContent></ShadcnSidebar><ShadcnSidebarTrigger /><ShadcnSidebarInset Role="region" aria-label="Workspace content">Workspace content</ShadcnSidebarInset></ShadcnSidebarProvider></div></section>
<section dir="rtl"><h2>RTL and ภาษาไทย</h2><p>Logical CSS, horizontal keys, icons, mobile edges, and resize deltas follow direction.</p></section>
<section><h2>Accessibility</h2><p>Native landmarks, ordered lists, disclosure relationships, tab semantics, focus order, modal focus containment, and localizable accessible names are built in.</p><h3>Keyboard support</h3><p>Arrow keys, Home/End, Enter/Space, Escape, Tab, pointer and touch resizing are covered by each component state machine.</p><h3>Customization</h3><p>Use typed variants and orientations, controlled bindings, composable slots, Class, Style, AdditionalAttributes, semantic tokens, localization, and persistence interfaces.</p><h3>Pinned source</h3><p>Compared to commit <code>6261bd89f72d794aea491482cc2acfd8dc3d63e2</code> and Vega styles.</p></section>
</div>
@code {
    private bool AccordionMultiple { get; set; } private IReadOnlyCollection<string> AccordionValues { get; set; } = ["shipping"]; private bool CollapsibleOpen { get; set; } = true; private int CurrentPage { get; set; } = 2; private string TabValue { get; set; } = "overview"; private string? MenuValue { get; set; } = "services"; private IReadOnlyList<double> PanelSizes { get; set; } = [40, 60]; private bool SidebarOpen { get; set; } = true; private bool SidebarMobileOpen { get; set; }
    private Task SetAccordion(IReadOnlyCollection<string> values) { AccordionValues = values; return Task.CompletedTask; }
}
