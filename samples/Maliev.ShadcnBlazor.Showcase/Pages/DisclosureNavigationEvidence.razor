@page "/evidence/disclosure-navigation"
@using global::Maliev.ShadcnBlazor.Components.Disclosure
@using global::Maliev.ShadcnBlazor.Components.Navigation
@using global::Maliev.ShadcnBlazor.Components.Navigation.Sidebar
@inject ShowcaseState State

<PageTitle>Disclosure navigation evidence</PageTitle>
<main class="evidence-fixture" data-testid="disclosure-navigation-evidence">
    <section data-pair-id="accordion-open" class="evidence-crop evidence-standard"><ShadcnAccordion Values="@(new[] { "shipping" })"><ShadcnAccordionItem Value="shipping"><ShadcnAccordionTrigger>Shipping details</ShadcnAccordionTrigger><ShadcnAccordionContent>Delivery is scheduled for Friday.</ShadcnAccordionContent></ShadcnAccordionItem><ShadcnAccordionItem Value="quality"><ShadcnAccordionTrigger>Quality report</ShadcnAccordionTrigger><ShadcnAccordionContent>Inspection passed.</ShadcnAccordionContent></ShadcnAccordionItem></ShadcnAccordion></section>
    <section data-pair-id="breadcrumb-current" class="evidence-crop evidence-standard"><ShadcnBreadcrumb><ShadcnBreadcrumbList><ShadcnBreadcrumbItem><ShadcnBreadcrumbLink Href="#home">Home</ShadcnBreadcrumbLink></ShadcnBreadcrumbItem><ShadcnBreadcrumbSeparator /><ShadcnBreadcrumbItem><ShadcnBreadcrumbLink Href="#parts">Parts</ShadcnBreadcrumbLink></ShadcnBreadcrumbItem><ShadcnBreadcrumbSeparator /><ShadcnBreadcrumbItem><ShadcnBreadcrumbPage>Housing</ShadcnBreadcrumbPage></ShadcnBreadcrumbItem></ShadcnBreadcrumbList></ShadcnBreadcrumb></section>
    <section data-pair-id="collapsible-open" class="evidence-crop evidence-standard"><ShadcnCollapsible Open="true"><ShadcnCollapsibleTrigger>Machine details</ShadcnCollapsibleTrigger><ShadcnCollapsibleContent>Cell A is ready for production.</ShadcnCollapsibleContent></ShadcnCollapsible></section>
    <section data-pair-id="navigation-menu-open" class="evidence-crop evidence-standard"><ShadcnNavigationMenu Value="components"><ShadcnNavigationMenuList><ShadcnNavigationMenuItem Value="components"><ShadcnNavigationMenuTrigger>Components</ShadcnNavigationMenuTrigger><ShadcnNavigationMenuContent><div class="navigation-content"><ShadcnNavigationMenuLink Href="#accordion">Accordion</ShadcnNavigationMenuLink><ShadcnNavigationMenuLink Href="#tabs">Tabs</ShadcnNavigationMenuLink></div></ShadcnNavigationMenuContent></ShadcnNavigationMenuItem><ShadcnNavigationMenuItem Value="docs"><ShadcnNavigationMenuLink Href="#docs">Documentation</ShadcnNavigationMenuLink></ShadcnNavigationMenuItem></ShadcnNavigationMenuList><ShadcnNavigationMenuViewport /></ShadcnNavigationMenu></section>
    <section data-pair-id="pagination-current" class="evidence-crop evidence-standard"><ShadcnPagination><ShadcnPaginationContent><ShadcnPaginationItem><ShadcnPaginationPrevious Href="#previous" /></ShadcnPaginationItem><ShadcnPaginationItem><ShadcnPaginationLink Href="#one" Current="true">1</ShadcnPaginationLink></ShadcnPaginationItem><ShadcnPaginationItem><ShadcnPaginationLink Href="#two">2</ShadcnPaginationLink></ShadcnPaginationItem><ShadcnPaginationItem><ShadcnPaginationNext Href="#next" /></ShadcnPaginationItem></ShadcnPaginationContent></ShadcnPagination></section>
    <section data-pair-id="resizable-horizontal" class="evidence-crop evidence-resizable"><ShadcnResizableGroup Sizes="@(new[] { 35d, 65d })"><ShadcnResizablePanel Id="queue"><div class="panel-content">Queue</div></ShadcnResizablePanel><ShadcnResizableHandle WithHandle="true" /><ShadcnResizablePanel Id="production"><div class="panel-content">Production</div></ShadcnResizablePanel></ShadcnResizableGroup></section>
    <section data-pair-id="scroll-area-scrolled" class="evidence-crop evidence-scroll"><ShadcnScrollArea Type="ShadcnScrollAreaType.Always" Style="width:100%;height:100%"><ShadcnScrollAreaViewport><div class="scroll-content">Scrollable production history</div></ShadcnScrollAreaViewport><ShadcnScrollAreaScrollbar Orientation="ShadcnScrollAreaOrientation.Horizontal"><ShadcnScrollAreaThumb /></ShadcnScrollAreaScrollbar><ShadcnScrollAreaCorner /></ShadcnScrollArea></section>
    <section data-pair-id="tabs-vertical" class="evidence-crop evidence-standard"><ShadcnTabs Value="overview" Orientation="ShadcnTabsOrientation.Vertical"><ShadcnTabsList><ShadcnTabsTrigger Value="overview">Overview</ShadcnTabsTrigger><ShadcnTabsTrigger Value="quality">Quality</ShadcnTabsTrigger><ShadcnTabsTrigger Value="disabled" Disabled="true">Disabled</ShadcnTabsTrigger></ShadcnTabsList><ShadcnTabsContent Value="overview">Current production overview.</ShadcnTabsContent><ShadcnTabsContent Value="quality">Quality metrics.</ShadcnTabsContent></ShadcnTabs></section>
    <section data-pair-id="sidebar-expanded" class="evidence-crop evidence-sidebar"><ShadcnSidebarProvider Open="true" Style="min-height:0;height:420px"><ShadcnSidebar Collapsible="ShadcnSidebarCollapsible.Icon" Style="min-height:0;height:420px"><ShadcnSidebarContent><ShadcnSidebarGroup><ShadcnSidebarGroupLabel>Production</ShadcnSidebarGroupLabel><ShadcnSidebarGroupContent><ShadcnSidebarMenu><ShadcnSidebarMenuItem><ShadcnSidebarMenuButton Active="true">Dashboard</ShadcnSidebarMenuButton></ShadcnSidebarMenuItem><ShadcnSidebarMenuItem><ShadcnSidebarMenuButton>Orders</ShadcnSidebarMenuButton></ShadcnSidebarMenuItem></ShadcnSidebarMenu></ShadcnSidebarGroupContent></ShadcnSidebarGroup></ShadcnSidebarContent></ShadcnSidebar><ShadcnSidebarInset><header class="sidebar-header"><ShadcnSidebarTrigger /></header><div class="sidebar-body">Production workspace</div></ShadcnSidebarInset></ShadcnSidebarProvider></section>
</main>

@code {
    [SupplyParameterFromQuery(Name = "theme")] public string? RequestedTheme { get; set; }
    [SupplyParameterFromQuery(Name = "dir")] public string? RequestedDirection { get; set; }

    protected override void OnParametersSet()
    {
        State.SetTheme(string.Equals(RequestedTheme, "dark", StringComparison.OrdinalIgnoreCase));
        State.SetDirection(string.Equals(RequestedDirection, "rtl", StringComparison.OrdinalIgnoreCase) ? ShadcnDirection.RightToLeft : ShadcnDirection.LeftToRight);
    }
}
