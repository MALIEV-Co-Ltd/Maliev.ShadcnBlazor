@page "/theme"
@layout ThemeStudioLayout
@implements IDisposable
@inject ThemeStudioState State
@inject MockSiteState MockSites
@inject ILogger<ThemeStudio> Logger

<PageTitle>Theme Studio - Maliev Shadcn Blazor</PageTitle>

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="preload" as="style" href="@GoogleFontsStylesheet" />
    <link rel="stylesheet" href="@GoogleFontsStylesheet" />
</HeadContent>

<a class="documentation-skip-link" href="#theme-preview">Skip to theme preview</a>
<a class="documentation-skip-link" href="#theme-controls">Skip to theme controls</a>

<div class="theme-studio" data-testid="theme-studio" lang="@LocaleCode">
    <header class="theme-studio-appbar">
        <div class="theme-studio-appbar__brand">
            <span class="theme-studio-appbar__mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false"><path d="M12 3 14.2 9.8 21 12l-6.8 2.2L12 21l-2.2-6.8L3 12l6.8-2.2L12 3Z" /></svg>
            </span>
            <div>
                <strong>Theme Studio</strong>
                <span>@Text("Maliev.ShadcnBlazor theme builder", "ตัวสร้างธีม Maliev.ShadcnBlazor")</span>
            </div>
        </div>
        <div class="theme-studio-appbar__actions">
            <a class="theme-studio-docs-link" href="docs">Component docs</a>
            <button type="button"
                    class="theme-studio-controls-toggle"
                    data-testid="theme-controls-toggle"
                    aria-controls="theme-controls"
                    aria-expanded="@ControlsExpanded"
                    @onclick="ToggleControls">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
                <span>@(_controlsOpen ? "Hide controls" : "Show controls")</span>
            </button>
        </div>
    </header>

    <PreviewToolbar State="State" />

    <div class="theme-studio-workbench" data-controls-open="@ControlsExpanded">
        <div class="theme-inspector-drawer" aria-hidden="@ControlsHidden">
            <ThemeInspector State="State" />
        </div>
        <main class="theme-preview-region" id="theme-preview" tabindex="-1">
            <div class="theme-preview-stage"
                 data-testid="theme-preview-stage"
                 data-preview-width="@State.Viewport.Width"
                 style="@($"--theme-preview-width: {State.Viewport.Width}px")">
                <div class="theme-preview-settings" data-testid="theme-generator-summary" aria-label="Active generator settings">
                    <span><strong>Style</strong> @State.StyleId</span>
                    <span><strong>Base</strong> @State.BaseColorId</span>
                    <span><strong>Icons</strong> @State.IconLibrary</span>
                    <span><strong>Menu</strong> @State.MenuAccent / @State.MenuColor</span>
                    <span><strong>Radius</strong> @State.RadiusPreset</span>
                </div>
                <div class="theme-preview-scope">
                    <MockSiteHost State="MockSites" Mockup="State.SelectedMockup" Locale="State.Locale" Viewport="State.Viewport" />
                </div>
            </div>
        </main>
    </div>
</div>

@code {
    private bool _initialized;
    private bool _controlsOpen = true;
    private bool _persisting;
    private bool _persistRequested;
    private bool _disposed;
    private Task _persistenceTask = Task.CompletedTask;
    private string LocaleCode => State.Locale == ThemeStudioLocale.Thai ? "th" : "en";
    private static string GoogleFontsStylesheet => $"https://fonts.googleapis.com/css2?family={string.Join("&family=", ThemeStudioFontPreset.All.Concat(ThemeStudioFontPreset.MonospaceAll).Select(font => font.GoogleFontsFamily))}&display=swap";

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnStateChanged;
        _selectedMockup = State.SelectedMockup;
        await State.InitializeAsync();
        if (_disposed) return;
        _initialized = true;
    }

    private void OnStateChanged(object? sender, EventArgs args)
    {
        if (_disposed) return;
        if (_selectedMockup != State.SelectedMockup)
        {
            MockSites.Reset(State.SelectedMockup);
            _selectedMockup = State.SelectedMockup;
        }
        var shouldPersist = _initialized;
        _persistenceTask = ObservePersistenceAsync(shouldPersist);
    }

    private async Task ObservePersistenceAsync(bool shouldPersist)
    {
        try
        {
            await InvokeAsync(async () =>
            {
                if (_disposed) return;
                StateHasChanged();
                if (!shouldPersist) return;
                _persistRequested = true;
                await DrainPersistenceAsync();
            });
        }
        catch (Exception exception) when (_disposed &&
            exception is ObjectDisposedException or TaskCanceledException or OperationCanceledException)
        {
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Theme Studio persistence failed.");
            if (_disposed) return;

            State.ReportStorageDiagnostic($"Theme could not be saved locally: {exception.Message}");
            try
            {
                await InvokeAsync(StateHasChanged);
            }
            catch (Exception renderException) when (_disposed &&
                renderException is ObjectDisposedException or TaskCanceledException or OperationCanceledException)
            {
            }
            catch (Exception renderException)
            {
                Logger.LogError(renderException, "Theme Studio persistence diagnostic could not be rendered.");
            }
        }
    }

    private async Task DrainPersistenceAsync()
    {
        if (_persisting || _disposed)
            return;

        _persisting = true;
        try
        {
            while (!_disposed && _persistRequested)
            {
                _persistRequested = false;
                await State.PersistAsync();
                if (!_disposed)
                    StateHasChanged();
            }
        }
        finally
        {
            _persisting = false;
        }
    }

    private string Text(string english, string thai) => State.Locale == ThemeStudioLocale.Thai ? thai : english;
    private string ControlsExpanded => _controlsOpen ? "true" : "false";
    private string ControlsHidden => _controlsOpen ? "false" : "true";
    private ThemeStudioMockup _selectedMockup;

    private void ToggleControls() => _controlsOpen = !_controlsOpen;

    public void Dispose()
    {
        _disposed = true;
        _persistRequested = false;
        State.Changed -= OnStateChanged;
    }
}
