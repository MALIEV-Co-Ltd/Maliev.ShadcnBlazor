@page "/theme"
@layout ThemeStudioLayout
@implements IDisposable
@implements IAsyncDisposable
@inject ThemeStudioState State
@inject ShowcaseState ShellState
@inject ILogger<ThemeStudio> Logger
@inject IJSRuntime JavaScript
@using Maliev.ShadcnBlazor.Components.Styling

<PageTitle>Theme Studio - Maliev Shadcn Blazor</PageTitle>
<a class="documentation-skip-link" href="#theme-preview">Skip to theme preview</a>
<a class="documentation-skip-link" href="#theme-controls">Skip to theme controls</a>

<div class="theme-studio" data-testid="theme-studio" data-sidebar-open="@(State.Workbench.SidebarOpen ? "true" : "false")" data-pointer-interaction-active="@(State.IsPointerInteractionActive ? "true" : "false")" lang="@LocaleCode" @onkeydown="HandleWorkbenchKeyDownAsync">
    <ThemeFontLoader State="State" />
    <div class="theme-studio-workbench"
         data-controls-open="@(State.Workbench.SidebarOpen ? "true" : "false")"
         data-palette-open="@(State.Workbench.PaletteWorkbenchOpen ? "true" : "false")">
        <ThemeStudioSidebar State="State" />
        <ThemePaletteWorkbench State="State" />
        <section class="theme-preview-region" id="theme-preview" tabindex="-1" aria-label="Theme preview" style="@($"--theme-preview-width: {State.Viewport.Width}px")">
            <div class="theme-preview-stage" data-testid="theme-preview-stage" data-preview-width="@State.Viewport.Width" style="@($"--theme-preview-width: {State.Viewport.Width}px")">
                <div class="shadcn-scope theme-preview-scope"
                     style="@TypographyStyle"
                     data-shadcn-scope
                     data-shadcn-theme="@(State.EffectiveDarkMode ? "dark" : "light")"
                     data-shadcn-reduced-motion="@(State.Workbench.ReducedMotion ? "always" : "system")"
                     dir="@(State.Direction == ShadcnDirection.RightToLeft ? "rtl" : "ltr")"
                     data-testid="theme-preview-scope"
                     data-theme-style="@State.StyleId"
                     data-theme-base-color="@State.BaseColorId"
                     data-theme-icon-library="@State.IconLibrary.ToString().ToLowerInvariant()"
                     data-preview-reduced-motion="@(State.Workbench.ReducedMotion ? "true" : "false")"
                     data-preview-high-contrast="@(State.Workbench.HighContrastPreview ? "true" : "false")">
                    <ShadcnVisualStyleScope VisualStyle="State.VisualStyle"
                                            ColorTreatment="State.ColorTreatment"
                                            Depth="State.DepthTreatment"
                                            Motion="State.MotionTreatment"
                                            Intensity="State.StyleIntensity"
                                            data-testid="theme-visual-style-scope">
                        <CascadingValue Value="PreviewContext">
                            <CascadingValue Name="ThemeStudioIconLibrary" Value="State.IconLibrary">
                                <ThemeBento Locale="State.Locale" Paused="State.Workbench.RunwayPaused" ReducedMotion="State.Workbench.ReducedMotion" />
                            </CascadingValue>
                        </CascadingValue>
                    </ShadcnVisualStyleScope>
                </div>
            </div>
        </section>
    </div>
</div>

@code {
    private bool _initialized;
    private bool _persisting;
    private bool _persistRequested;
    private bool _disposed;
    private Task _persistenceTask = Task.CompletedTask;
    private IJSObjectReference? _module;
    private string LocaleCode => State.Locale == ThemeStudioLocale.Thai ? "th" : "en";
    private string TypographyStyle => ShadcnThemeCssWriter.WriteProperties(State.Document, State.EffectiveDarkMode);
    private ShadcnContext PreviewContext => new(State.EffectiveDarkMode, State.Direction);
    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnStateChanged;
        ShellState.Changed += OnShellChanged;
        State.SetDirection(ShellState.Direction);
        State.SetMode(ShellState.IsDarkMode ? ThemeStudioMode.Dark : ThemeStudioMode.Light);
        await State.InitializeAsync();
        if (_disposed) return;
        _initialized = true;
    }

    private void OnShellChanged(object? sender, EventArgs args)
    {
        State.SetDirection(ShellState.Direction);
        State.SetMode(ShellState.IsDarkMode ? ThemeStudioMode.Dark : ThemeStudioMode.Light);
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnStateChanged(object? sender, EventArgs args)
    {
        if (_disposed) return;
        _persistenceTask = ObservePersistenceAsync(_initialized && !State.IsPointerInteractionActive);
    }

    private async Task ObservePersistenceAsync(bool shouldPersist)
    {
        try
        {
            await InvokeAsync(async () =>
            {
                if (_disposed) return;
                StateHasChanged();
                if (!shouldPersist) return;
                _persistRequested = true;
                await DrainPersistenceAsync();
            });
        }
        catch (Exception exception) when (_disposed && exception is ObjectDisposedException or TaskCanceledException or OperationCanceledException) { }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Theme Studio persistence failed.");
            if (_disposed) return;
            State.ReportStorageDiagnostic($"Theme could not be saved locally: {exception.Message}");
            try { await InvokeAsync(StateHasChanged); }
            catch (Exception renderException) when (_disposed && renderException is ObjectDisposedException or TaskCanceledException or OperationCanceledException) { }
            catch (Exception renderException) { Logger.LogError(renderException, "Theme Studio persistence diagnostic could not be rendered."); }
        }
    }

    private async Task DrainPersistenceAsync()
    {
        if (_persisting || _disposed) return;
        _persisting = true;
        try { while (!_disposed && _persistRequested) { _persistRequested = false; await State.PersistAsync(); } }
        finally { _persisting = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JavaScript.InvokeAsync<IJSObjectReference>("import", "./js/theme-studio.js");
            if (await _module.InvokeAsync<bool>("isDesktopWorkbench")) State.Workbench.OpenSidebar();
            await _module.InvokeVoidAsync("resetInitialPreviewScroll");
        }
    }

    private Task CloseSettingsAsync()
    {
        if (!State.Workbench.SidebarOpen) return Task.CompletedTask;
        State.Workbench.CloseSidebar();
        return Task.CompletedTask;
    }

    private async Task HandleWorkbenchKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Escape" && State.Workbench.SidebarOpen) await CloseSettingsAsync();
    }

    public void Dispose()
    {
        _disposed = true;
        _persistRequested = false;
        State.Changed -= OnStateChanged;
        ShellState.Changed -= OnShellChanged;
    }

    public async ValueTask DisposeAsync()
    {
        Dispose();
        if (_module is null) return;
        try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
    }
}
